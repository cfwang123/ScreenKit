<Window x:Class="WpfOCR.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WpfOCR — 截图识别"
        Height="720" Width="1180"
        MinHeight="520" MinWidth="860"
        WindowStartupLocation="Manual"
        Background="{StaticResource BgApp}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        AllowDrop="True">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- 顶部菜单：全部功能入口 -->
		<Menu x:Name="mnmain" Grid.Row="0" Padding="4,2" Background="{StaticResource BgPanel}"
		      BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,0,1"
		      FontSize="13" FontFamily="Segoe UI, Microsoft YaHei UI">
			<MenuItem x:Name="mnfile" Header="文件(_F)">
				<MenuItem x:Name="mnpaste" Header="粘贴图片(_V)" InputGestureText="Ctrl+V"
				          ToolTip="从剪贴板粘贴图片"/>
				<MenuItem x:Name="mnsaveclip" Header="保存图片(_S)"
				          ToolTip="将当前图片保存为 PNG/JPEG/BMP 文件"/>
				<Separator/>
				<MenuItem x:Name="mnpdf" Header="PDF 识别工作台(_P)…"
				          ToolTip="识别、编辑、存草稿、导出可检索 PDF"/>
				<Separator/>
				<MenuItem x:Name="mnexit" Header="退出(_X)" InputGestureText="Alt+F4"/>
			</MenuItem>
			<MenuItem x:Name="mncap" Header="截图(_C)"
			          AutomationProperties.AutomationId="menu.capture">
				<MenuItem x:Name="mncapture" Header="截图识别(_O)"
				          AutomationProperties.AutomationId="menu.ocr"
				          AutomationProperties.Name="截图识别"
				          ToolTip="区域截图并识别文字"/>
				<MenuItem x:Name="mnsnap" Header="截图标注(_A)"
				          AutomationProperties.AutomationId="menu.snap"
				          AutomationProperties.Name="截图标注"
				          ToolTip="微信式截图：框选 / 标注 / 复制 / 保存"/>
				<MenuItem x:Name="mnboard" Header="屏幕画板(_B)"
				          AutomationProperties.AutomationId="menu.board"
				          AutomationProperties.Name="屏幕画板"
				          ToolTip="截取全屏静止画面，直接画图标注"/>
				<MenuItem x:Name="mnlongshot" Header="长截图(_L)…"
				          AutomationProperties.AutomationId="menu.longshot"
				          ToolTip="点选窗口后自动滚动拼接长图（仅截图，不 OCR）"/>
				<MenuItem x:Name="mnsnapshots" Header="截图历史(_H)"
				          AutomationProperties.AutomationId="menu.snapshots"
				          AutomationProperties.Name="截图历史"
				          ToolTip="打开 screenshots 截图历史文件夹"/>
				<Separator/>
				<!-- 二选一 radio：Icon 用 RadioButton；StaysOpenOnClick 点后不关菜单 -->
				<MenuItem x:Name="mnsnapcopyimg" Header="截图完成 · 复制为图片"
				          StaysOpenOnClick="True"
				          AutomationProperties.AutomationId="menu.snapcopyimg">
					<MenuItem.Icon>
						<RadioButton x:Name="rbsnapcopyimg" GroupName="SnapCopyMenu"
						             IsChecked="True" IsHitTestVisible="False" Focusable="False"
						             VerticalAlignment="Center"/>
					</MenuItem.Icon>
				</MenuItem>
				<MenuItem x:Name="mnsnapcopyfile" Header="截图完成 · 复制为文件"
				          StaysOpenOnClick="True"
				          AutomationProperties.AutomationId="menu.snapcopyfile">
					<MenuItem.Icon>
						<RadioButton x:Name="rbsnapcopyfile" GroupName="SnapCopyMenu"
						             IsHitTestVisible="False" Focusable="False"
						             VerticalAlignment="Center"/>
					</MenuItem.Icon>
				</MenuItem>
				<Separator/>
				<MenuItem x:Name="mnrecord" Header="录屏(_R)…"
				          AutomationProperties.AutomationId="menu.record"
				          AutomationProperties.Name="录屏"
				          ToolTip="点选/框选区域后录制 MP4"/>
				<MenuItem x:Name="mnrecordopt" Header="录屏选项(_E)…"
				          AutomationProperties.AutomationId="menu.recordopt"
				          AutomationProperties.Name="录屏选项"
				          ToolTip="编码 / 帧率 / CRF / 最大宽高"/>
			</MenuItem>
			<MenuItem x:Name="mnedit" Header="编辑(_E)">
				<MenuItem x:Name="mncopytext" Header="复制文字(_T)" InputGestureText="Ctrl+C"
				          ToolTip="有图上选区时复制选中行，否则复制全部结果"/>
				<MenuItem x:Name="mncopyimg" Header="复制图片(_I)"
				          ToolTip="将当前图片以文件形式复制到剪贴板（可粘贴到资源管理器）"/>
				<Separator/>
				<MenuItem x:Name="mntoggletext" Header="显示文字叠加(_W)" IsCheckable="True" IsChecked="True"
				          ToolTip="叠加识别文字（Umi 黑底白字）；在文字上拖选"/>
				<Separator/>
				<MenuItem x:Name="mncancelocr" Header="取消识别(_N)" IsEnabled="False"
				          ToolTip="取消当前识别（推理中可能需等本轮结束）"/>
			</MenuItem>
			<MenuItem x:Name="mntools" Header="工具(_T)">
				<MenuItem x:Name="mnsettings" Header="参数设置(_S)…"
				          ToolTip="检测阈值、热键、HTTP、PDF 等"/>
				<MenuItem x:Name="mninstall" Header="安装功能(_I)…"
				          AutomationProperties.AutomationId="menu.install"
				          ToolTip="安装 OCR/ASR 模型、GPU、核显等组件（中文系统优先国内镜像）"/>
				<MenuItem x:Name="mndiag" Header="诊断(_D)…"
				          ToolTip="CUDA / DirectML / 路径 / 显示器 DPI"/>
				<Separator/>
				<MenuItem x:Name="mnlang" Header="界面语言(_L)">
					<MenuItem x:Name="mnlangzh" Header="中文" IsCheckable="True" IsChecked="True"/>
					<MenuItem x:Name="mnlangen" Header="English" IsCheckable="True"/>
				</MenuItem>
				<Separator/>
				<MenuItem x:Name="mnupdate" Header="检查更新(_U)…"
				          AutomationProperties.AutomationId="menu.update"
				          ToolTip="从 GitHub Releases 检查并下载更新"/>
				<MenuItem x:Name="mnabout" Header="关于(_A)…"
				          ToolTip="版本与许可证"/>
			</MenuItem>
		</Menu>

		<!-- 主体：TabControl 贴窗边缘；Logo/模型栏在 Tab 内容内 -->
		<TabControl x:Name="maintabs" Grid.Row="1" Margin="0" Padding="0"
		            BorderThickness="0">
				<!-- Tab 1：截图识别 -->
				<TabItem x:Name="tabocr" Header="截图识别">
					<Grid Margin="8">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="*"/>
						</Grid.RowDefinitions>

						<!-- Logo + 模型/语言/设备 + 状态（在 Tab 内） -->
						<DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="True">
							<StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
								<Border Background="{StaticResource Accent}" CornerRadius="8" Padding="10,6" Margin="0,0,10,0">
									<TextBlock Text="OCR" Foreground="White" FontWeight="Bold" FontSize="14"/>
								</Border>
								<TextBlock x:Name="lbbrand" Text="截图识别" FontSize="18" FontWeight="SemiBold"
								           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
							</StackPanel>

							<StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Right" Margin="8,0,0,0">
								<TextBlock x:Name="lbpack" Text="模型" FontSize="12" Foreground="{StaticResource TextMuted}"
								           VerticalAlignment="Center" Margin="0,0,4,0"/>
								<ComboBox x:Name="epack" Width="132" Height="30" Margin="0,0,8,0"
								          VerticalContentAlignment="Center" FontSize="12"
								          DisplayMemberPath="DisplayName" ToolTip="模型包"/>
								<TextBlock x:Name="lbvariant" Text="语言" FontSize="12" Foreground="{StaticResource TextMuted}"
								           VerticalAlignment="Center" Margin="0,0,4,0"/>
								<ComboBox x:Name="evariant" Width="128" Height="30" Margin="0,0,8,0"
								          VerticalContentAlignment="Center" FontSize="12"
								          DisplayMemberPath="Title" ToolTip="语言 / 模型变体"/>
								<TextBlock x:Name="lbdevice" Text="设备" FontSize="12" Foreground="{StaticResource TextMuted}"
								           VerticalAlignment="Center" Margin="0,0,4,0"/>
								<ComboBox x:Name="edevice" Width="100" Height="30" Margin="0,0,8,0"
								          VerticalContentAlignment="Center" FontSize="12" ToolTip="推理设备：NVIDIA GPU / 核显 DirectML / CPU">
									<ComboBoxItem x:Name="edevgpu" Content="GPU" Tag="Gpu" ToolTip="NVIDIA CUDA"/>
									<ComboBoxItem x:Name="edevigpu" Content="核显" Tag="IntelGpu" ToolTip="Intel 核显等 DirectML 加速"/>
									<ComboBoxItem x:Name="edevcpu" Content="CPU" Tag="Cpu"/>
								</ComboBox>
								<TextBlock x:Name="lbdetlen" Text="边长" FontSize="12" Foreground="{StaticResource TextMuted}"
								           VerticalAlignment="Center" Margin="0,0,4,0"
								           ToolTip="检测边长上限：越大越准越慢，大图/拼图建议 1600+"/>
								<ComboBox x:Name="edetlen" Width="72" Height="30" Margin="0,0,0,0"
								          VerticalContentAlignment="Center" FontSize="12"
								          ToolTip="检测边长上限（DetLimitSideLen）">
									<ComboBoxItem Content="960" Tag="960"/>
									<ComboBoxItem Content="1024" Tag="1024"/>
									<ComboBoxItem Content="1280" Tag="1280"/>
									<ComboBoxItem Content="1600" Tag="1600"/>
									<ComboBoxItem Content="1920" Tag="1920"/>
									<ComboBoxItem Content="2560" Tag="2560"/>
								</ComboBox>
							</StackPanel>

							<TextBlock x:Name="lbstatus" Text="就绪" Margin="16,0,12,0" FontSize="12"
							           Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"
							           TextTrimming="CharacterEllipsis"/>
						</DockPanel>

						<!-- 左图 + 右文 -->
						<Grid Grid.Row="1">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" MinWidth="360"/>
							<ColumnDefinition Width="10"/>
							<ColumnDefinition Width="360" MinWidth="280"/>
						</Grid.ColumnDefinitions>

						<!-- 左侧图片区 -->
						<Border Grid.Column="0" Background="{StaticResource BgPanel}" CornerRadius="12"
						        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"
						        SnapsToDevicePixels="True">
							<Grid>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="*"/>
								</Grid.RowDefinitions>

								<Border Grid.Row="0" Background="{StaticResource BgToolbar}"
								        BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,0,1"
								        CornerRadius="12,12,0,0" Padding="8,5">
									<DockPanel>
										<StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
											<Button x:Name="bcapture" Style="{StaticResource ToolBtnSm}"
											        AutomationProperties.AutomationId="btn.capture"
											        AutomationProperties.Name="截图识别"
											        ToolTip="区域截图并识别">
												<StackPanel Orientation="Horizontal">
													<TextBlock Text="✂" FontSize="11" Margin="0,0,4,0"/>
													<TextBlock x:Name="tbcapture" Text="截图识别" FontSize="12"/>
												</StackPanel>
											</Button>
											<Button x:Name="bsnap" Style="{StaticResource ToolBtnSm}"
											        AutomationProperties.AutomationId="btn.snap"
											        AutomationProperties.Name="截图标注"
											        ToolTip="微信式截图标注">
												<StackPanel Orientation="Horizontal">
													<TextBlock Text="✎" FontSize="11" Margin="0,0,4,0"/>
													<TextBlock x:Name="tbsnap" Text="截图标注" FontSize="12"/>
												</StackPanel>
											</Button>
											<Button x:Name="bpaste" Style="{StaticResource ToolBtnSm}" ToolTip="粘贴图片 (Ctrl+V)">
												<StackPanel Orientation="Horizontal">
													<TextBlock Text="📋" FontSize="11" Margin="0,0,4,0"/>
													<TextBlock x:Name="tbpaste" Text="粘贴" FontSize="12"/>
												</StackPanel>
											</Button>
											<Button x:Name="bcopyimg" Style="{StaticResource ToolBtnSm}"
											        ToolTip="以文件形式复制当前图片到剪贴板（可粘贴到资源管理器）">
												<StackPanel Orientation="Horizontal">
													<TextBlock Text="🖼" FontSize="11" Margin="0,0,4,0"/>
													<TextBlock x:Name="tbcopyimg" Text="复制图" FontSize="12"/>
												</StackPanel>
											</Button>
											<Button x:Name="bsaveclip" Style="{StaticResource ToolBtnSm}"
											        ToolTip="将当前图片保存到文件">
												<StackPanel Orientation="Horizontal">
													<TextBlock Text="💾" FontSize="11" Margin="0,0,4,0"/>
													<TextBlock x:Name="tbsave" Text="保存" FontSize="12"/>
												</StackPanel>
											</Button>
											<ToggleButton x:Name="btoggletext" Style="{StaticResource ToolToggleSm}"
											              IsChecked="True"
											              ToolTip="叠加识别文字；在文字上拖选">
												<StackPanel Orientation="Horizontal">
													<TextBlock Text="🔤" FontSize="11" Margin="0,0,4,0"/>
													<TextBlock x:Name="tbtext" Text="文字" FontSize="12"/>
												</StackPanel>
											</ToggleButton>
										</StackPanel>
										<StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
										            VerticalAlignment="Center" HorizontalAlignment="Right">
											<TextBlock x:Name="lbimgsize" FontSize="11"
											           Foreground="{StaticResource TextMuted}"
											           Text="— × —" ToolTip="图片原始分辨率（像素）"
											           VerticalAlignment="Center" Margin="0,0,10,0"/>
											<TextBlock x:Name="lbzoom" FontSize="11"
											           Foreground="{StaticResource TextMuted}"
											           Text="100%" ToolTip="当前缩放"/>
										</StackPanel>
									</DockPanel>
								</Border>

								<Border Grid.Row="1" Background="{StaticResource BgImage}" CornerRadius="0,0,12,12"
								        ClipToBounds="True">
									<Grid x:Name="pviewport" Background="Transparent"
									      ClipToBounds="True"
									      AllowDrop="True"
									      Cursor="Hand">
										<Canvas x:Name="pstage" RenderTransformOrigin="0,0"
										        HorizontalAlignment="Left" VerticalAlignment="Top">
											<Canvas.RenderTransform>
												<TransformGroup>
													<ScaleTransform x:Name="tfscale" ScaleX="1" ScaleY="1"/>
													<TranslateTransform x:Name="tfpan" X="0" Y="0"/>
												</TransformGroup>
											</Canvas.RenderTransform>
											<Image x:Name="imgview" Stretch="Fill" SnapsToDevicePixels="True"
											       RenderOptions.BitmapScalingMode="HighQuality"/>
											<Canvas x:Name="poverlay"/>
										</Canvas>
										<TextBlock x:Name="lbhint"
										           Text="菜单「截图」识别 / 标注 ·「文件」粘贴 / PDF&#x0a;也可拖入图片 · 滚轮缩放 · 文字拖选 · Ctrl+C 复制"
										           Foreground="#8A93A3" FontSize="14"
										           HorizontalAlignment="Center" VerticalAlignment="Center"
										           TextAlignment="Center" LineHeight="24"/>
									</Grid>
								</Border>
							</Grid>
						</Border>

						<GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch"
						              Background="Transparent" ShowsPreview="False"/>

						<!-- 右侧结果 -->
						<Border Grid.Column="2" Background="{StaticResource BgPanel}" CornerRadius="12"
						        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1">
							<Grid Margin="14">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="*"/>
								</Grid.RowDefinitions>

								<DockPanel Grid.Row="0" Margin="0,0,0,10">
									<TextBlock x:Name="lbresulttitle" Text="识别结果" FontSize="15" FontWeight="SemiBold"
									           Foreground="{StaticResource TextPrimary}"
									           VerticalAlignment="Center"/>
									<Border x:Name="bocrrunningbadge" DockPanel.Dock="Right"
									        Visibility="Collapsed" CornerRadius="10"
									        Background="#DBEAFE" Padding="8,3" Margin="8,0,0,0"
									        VerticalAlignment="Center">
										<StackPanel Orientation="Horizontal">
											<Ellipse Width="6" Height="6" Fill="#3B82F6" Margin="0,0,6,0"
											         VerticalAlignment="Center"/>
											<TextBlock x:Name="lbocrrunningbadge" Text="识别中" FontSize="11" FontWeight="SemiBold"
											           Foreground="#2563EB" VerticalAlignment="Center"/>
										</StackPanel>
									</Border>
								</DockPanel>

								<DockPanel Grid.Row="1" Margin="0,0,0,10">
									<Button x:Name="bcopy" Content="复制" Style="{StaticResource GhostBtn}"
									        DockPanel.Dock="Right" Margin="0" Padding="10,4"
									        VerticalAlignment="Center"
									        ToolTip="有图上选区时复制选中行，否则复制全部结果 (Ctrl+C)"/>
									<StackPanel>
										<TextBlock x:Name="lbmeta" FontSize="12"
										           Foreground="{StaticResource TextMuted}"
										           TextWrapping="Wrap"
										           Text="推理 — · 端到端 — | 置信度 —"/>
										<TextBlock x:Name="lbtime" FontSize="11" Margin="0,3,0,0"
										           Foreground="#A0AEC0" Text="—"/>
									</StackPanel>
								</DockPanel>

								<Border Grid.Row="2" Background="#F8FAFC" CornerRadius="10"
								        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1">
									<Grid>
										<TextBox x:Name="eresult"
										         TextWrapping="Wrap"
										         AcceptsReturn="True"
										         VerticalScrollBarVisibility="Auto"
										         HorizontalScrollBarVisibility="Disabled"
										         BorderThickness="0"
										         Background="Transparent"
										         Padding="12"
										         FontSize="14"
										         Foreground="{StaticResource TextPrimary}"
										         IsReadOnly="False"
										         IsInactiveSelectionHighlightEnabled="True"
										         VerticalContentAlignment="Top"/>
										<Border x:Name="pocrrunning" Visibility="Collapsed"
										        Background="#F2F8FAFC" CornerRadius="10"
										        BorderBrush="#BFDBFE" BorderThickness="1">
											<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
											            Margin="20">
												<Grid Width="48" Height="48" HorizontalAlignment="Center" Margin="0,0,0,16">
													<Ellipse Width="48" Height="48"
													         Stroke="#DBEAFE" StrokeThickness="3"/>
													<Ellipse Width="48" Height="48"
													         Stroke="#3B82F6" StrokeThickness="3"
													         StrokeDashArray="12 20" StrokeStartLineCap="Round"
													         RenderTransformOrigin="0.5,0.5">
														<Ellipse.RenderTransform>
															<RotateTransform x:Name="tfocrspin"/>
														</Ellipse.RenderTransform>
													</Ellipse>
												</Grid>
												<TextBlock x:Name="lbocrruntitle" Text="正在识别中…"
												           FontSize="15" FontWeight="SemiBold"
												           Foreground="{StaticResource TextPrimary}"
												           HorizontalAlignment="Center" Margin="0,0,0,6"/>
												<TextBlock x:Name="lbocrrunhint" Text="检测 · 方向 · 识别"
												           FontSize="12" Foreground="{StaticResource TextMuted}"
												           HorizontalAlignment="Center" Margin="0,0,0,14"
												           TextAlignment="Center"/>
												<ProgressBar x:Name="pocrbar" IsIndeterminate="True"
												             Height="3" Width="160" BorderThickness="0"
												             Background="#E2E8F0" Foreground="#3B82F6"
												             Margin="0,0,0,16"/>
												<Button x:Name="bcancelocrpanel" Content="取消识别"
												        Style="{StaticResource ToolBtnSm}"
												        HorizontalAlignment="Center"
												        Padding="14,5"
												        ToolTip="取消当前识别（推理中可能需等本轮结束）"/>
											</StackPanel>
										</Border>
									</Grid>
								</Border>
							</Grid>
						</Border>
						</Grid>
					</Grid>
				</TabItem>

				<!-- Tab：语音合成（SAPI / Sherpa-ONNX） -->
				<TabItem x:Name="tabtts" Header="语音合成">
					<Grid Margin="12">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="*"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
						</Grid.RowDefinitions>

						<DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
							<TextBlock x:Name="lbttsbrand" Text="语音合成" FontSize="18" FontWeight="SemiBold"
							           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"
							           Margin="0,0,16,0"/>
							<TextBlock x:Name="lbttsstatus" Text="就绪" FontSize="12"
							           Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
						</DockPanel>

						<!-- 引擎 / 模型 / 发音人 / GPU -->
						<Border Grid.Row="1" Background="{StaticResource BgPanel}" CornerRadius="12"
						        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"
						        Padding="12" Margin="0,0,0,10">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto"/>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="12"/>
									<ColumnDefinition Width="Auto"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
								</Grid.RowDefinitions>

								<TextBlock Grid.Row="0" Grid.Column="0" Text="引擎" FontWeight="SemiBold"
								           VerticalAlignment="Center" Margin="0,0,8,8"/>
								<ComboBox x:Name="ettsengine" Grid.Row="0" Grid.Column="1" Height="32"
								          VerticalContentAlignment="Center" Margin="0,0,0,8"/>

								<TextBlock Grid.Row="0" Grid.Column="3" Text="计算设备" FontWeight="SemiBold"
								           VerticalAlignment="Center" Margin="0,0,8,8"/>
								<ComboBox x:Name="ettscompute" Grid.Row="0" Grid.Column="4" Height="32"
								          VerticalContentAlignment="Center" Margin="0,0,0,8"
								          ToolTip="Sherpa：自动 CUDA→核显 DirectML→CPU；与 OCR 共用 onnxgpu64/onnxdml64（同进程互斥）"/>

								<TextBlock Grid.Row="1" Grid.Column="0" Text="筛选" FontWeight="SemiBold"
								           VerticalAlignment="Center" Margin="0,0,8,8"/>
								<DockPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" Margin="0,0,0,8">
									<ComboBox x:Name="ettslang" MinWidth="140" Height="32" Margin="0,0,8,0"
									          VerticalContentAlignment="Center"
									          ToolTip="按语言筛选。列表为当前引擎可用语言（SAPI / WinRT / Sherpa 并集）"/>
									<ComboBox x:Name="ettsgender" Width="110" Height="32"
									          VerticalContentAlignment="Center"
									          ToolTip="按性别筛选发音人"/>
									<TextBlock Text="WinRT=系统语言包 · Sherpa=tts_config" FontSize="11"
									           Foreground="{StaticResource TextMuted}"
									           VerticalAlignment="Center" Margin="12,0,0,0"/>
								</DockPanel>

								<TextBlock Grid.Row="2" Grid.Column="0" Text="模型" FontWeight="SemiBold"
								           VerticalAlignment="Center" Margin="0,0,8,8"/>
								<ComboBox x:Name="ettsmodel" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4"
								          Height="32" VerticalContentAlignment="Center" Margin="0,0,0,8"
								          DisplayMemberPath="DisplayName"
								          ToolTip="扫描程序目录 ttsmodels（可联接至中央库）"/>

								<TextBlock Grid.Row="3" Grid.Column="0" Text="发音人" FontWeight="SemiBold"
								           VerticalAlignment="Center" Margin="0,0,8,8"/>
								<ComboBox x:Name="ettsvoice" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="4"
								          Height="32" VerticalContentAlignment="Center" Margin="0,0,0,8"
								          DisplayMemberPath="DisplayName"
								          ToolTip="显示名含中文名与属性（女·中 / 男·英）"/>

								<TextBlock Grid.Row="4" Grid.Column="0" Text="语速" FontWeight="SemiBold"
								           VerticalAlignment="Center" Margin="0,0,8,0"/>
								<DockPanel Grid.Row="4" Grid.Column="1" Margin="0,0,0,0">
									<TextBlock x:Name="lbttsrate" DockPanel.Dock="Right" Width="48" Text="1.0x"
									           VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
									<Slider x:Name="ettsrate" Minimum="0.5" Maximum="2.0" TickFrequency="0.1"
									        IsSnapToTickEnabled="True" Value="1.0" VerticalAlignment="Center"/>
								</DockPanel>

								<TextBlock Grid.Row="4" Grid.Column="3" Text="音量" FontWeight="SemiBold"
								           VerticalAlignment="Center" Margin="0,0,8,0"/>
								<DockPanel Grid.Row="4" Grid.Column="4">
									<TextBlock x:Name="lbttsvol" DockPanel.Dock="Right" Width="36" Text="100"
									           VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"
									           ToolTip="SAPI 音量 0–100"/>
									<Slider x:Name="ettsvol" Minimum="0" Maximum="100" TickFrequency="5"
									        IsSnapToTickEnabled="True" Value="100" VerticalAlignment="Center"
									        ToolTip="SAPI 音量（Sherpa 为波形原始电平）"/>
								</DockPanel>
							</Grid>
						</Border>

						<Border Grid.Row="2" Background="{StaticResource BgPanel}" CornerRadius="12"
						        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" Padding="12">
							<Grid>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="*"/>
								</Grid.RowDefinitions>
								<TextBlock Grid.Row="0" Text="合成文本" FontWeight="SemiBold"
								           Margin="0,0,0,8" VerticalAlignment="Center"/>
								<TextBox x:Name="ettstext" Grid.Row="1"
								         TextWrapping="Wrap" AcceptsReturn="True"
								         VerticalScrollBarVisibility="Auto"
								         BorderBrush="{StaticResource BorderSoft}"
								         Padding="10" FontSize="14"
								         Foreground="{StaticResource TextPrimary}"
								         ToolTip="朗读时按句分段高亮；超出可视区时自动滚到段首。句末：。！？；… 与换行"/>
							</Grid>
						</Border>

						<DockPanel Grid.Row="3" Margin="0,10,0,0" LastChildFill="True">
							<StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
								<TextBlock Text="MP3 码率" FontSize="12" Foreground="{StaticResource TextMuted}"
								           VerticalAlignment="Center" Margin="0,0,8,0"/>
								<ComboBox x:Name="ettskbps" Width="100" Height="28"
								          VerticalContentAlignment="Center"
								          ToolTip="导出 MP3 时的目标码率（kbps）"/>
							</StackPanel>
							<TextBlock x:Name="lbttshint" FontSize="11" Foreground="{StaticResource TextMuted}"
							           VerticalAlignment="Center" TextWrapping="Wrap" Margin="16,0,0,0"
							           Text="Sherpa 模型目录：程序旁 ttsmodels。GPU 需 onnxgpu64 + CUDA。"/>
						</DockPanel>

						<StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,12,0,0">
							<Button x:Name="bttsspeak" Content="朗读" Style="{StaticResource PrimaryBtn}"
							        Width="88" Margin="0,0,8,0" ToolTip="从开头朗读；暂停中则继续"/>
							<Button x:Name="bttspause" Content="暂停" Style="{StaticResource ToolBtn}"
							        Width="72" Margin="0,0,8,0" IsEnabled="False"
							        ToolTip="暂停 / 继续当前句"/>
							<Button x:Name="bttsprev" Content="上一句" Style="{StaticResource ToolBtn}"
							        Width="72" Margin="0,0,8,0" IsEnabled="False"
							        ToolTip="跳到上一句并播放"/>
							<Button x:Name="bttsnext" Content="下一句" Style="{StaticResource ToolBtn}"
							        Width="72" Margin="0,0,8,0" IsEnabled="False"
							        ToolTip="跳到下一句并播放"/>
							<Button x:Name="bttsstop" Content="停止" Style="{StaticResource ToolBtn}"
							        Width="72" Margin="0,0,8,0"/>
							<Button x:Name="bttsexport" Content="导出 MP3…" Style="{StaticResource ToolBtn}"
							        Width="100" Margin="0,0,8,0" ToolTip="按句分段合成后合并导出 MP3"/>
							<Button x:Name="bttsreload" Content="刷新模型" Style="{StaticResource ToolBtn}"
							        Width="88" Margin="0,0,0,0" ToolTip="重新扫描 ttsmodels"/>
						</StackPanel>
					</Grid>
				</TabItem>

				<!-- Tab：语音识别（子 Tab：识别 / 生成字幕） -->
				<TabItem x:Name="tabasr" Header="语音识别">
					<Grid Margin="12">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="*"/>
						</Grid.RowDefinitions>

						<DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
							<TextBlock Text="语音识别" FontSize="18" FontWeight="SemiBold"
							           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"
							           Margin="0,0,16,0"/>
							<TextBlock x:Name="lbasrstatus" Text="就绪" FontSize="12"
							           Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
						</DockPanel>

						<!-- 共用：模型 / 设备 / 语言 -->
						<Border Grid.Row="1" Background="{StaticResource BgPanel}" CornerRadius="12"
						        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"
						        Padding="12" Margin="0,0,0,10">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto"/>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="12"/>
									<ColumnDefinition Width="Auto"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
								</Grid.RowDefinitions>

								<TextBlock Grid.Row="0" Grid.Column="0" Text="计算设备" FontWeight="SemiBold"
								           VerticalAlignment="Center" Margin="0,0,8,8"/>
								<ComboBox x:Name="easrcompute" Grid.Row="0" Grid.Column="1" Height="32"
								          VerticalContentAlignment="Center" Margin="0,0,0,8"
								          ToolTip="与 OCR/TTS 共用 onnxgpu64 / onnxdml64"/>

								<TextBlock Grid.Row="0" Grid.Column="3" Text="语言" FontWeight="SemiBold"
								           VerticalAlignment="Center" Margin="0,0,8,8"/>
								<ComboBox x:Name="easrlang" Grid.Row="0" Grid.Column="4" Height="32"
								          VerticalContentAlignment="Center" Margin="0,0,0,8"
								          ToolTip="SenseVoice：auto / zh / en / ja / ko / yue"/>

								<TextBlock Grid.Row="1" Grid.Column="0" Text="流式模型" FontWeight="SemiBold"
								           VerticalAlignment="Center" Margin="0,0,8,8"/>
								<ComboBox x:Name="easrmodelstream" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
								          Height="32" VerticalContentAlignment="Center" Margin="0,0,8,8"
								          DisplayMemberPath="ListName"
								          ToolTip="热键语音输入用（OnlineRecognizer 流式包，如 zipformer 流式）"/>
								<Button x:Name="basrreload" Grid.Row="1" Grid.Column="4" Content="刷新模型"
								        Style="{StaticResource ToolBtn}" Height="32" Margin="0,0,0,8"
								        ToolTip="重新扫描 asrmodels"/>

								<TextBlock Grid.Row="2" Grid.Column="0" Text="离线模型" FontWeight="SemiBold"
								           VerticalAlignment="Center" Margin="0,0,8,8"/>
								<ComboBox x:Name="easrmodel" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4"
								          Height="32" VerticalContentAlignment="Center" Margin="0,0,0,8"
								          DisplayMemberPath="ListName"
								          ToolTip="文件识别 / 批量字幕用（离线：SenseVoice / Whisper 等）"/>

								<TextBlock Grid.Row="3" Grid.Column="0" Text="选项" FontWeight="SemiBold"
								           VerticalAlignment="Center" Margin="0,0,8,0"/>
								<StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="4"
								            Orientation="Horizontal">
									<CheckBox x:Name="casritn" Content="逆文本归一化 (ITN/标点)"
									          IsChecked="True" VerticalAlignment="Center"
									          ToolTip="SenseVoice 推荐开启，输出含标点与阿拉伯数字"/>
									<TextBlock x:Name="lbasrhint" FontSize="11" Margin="16,0,0,0"
									           VerticalAlignment="Center" TextWrapping="Wrap"
									           Foreground="{StaticResource TextMuted}"
									           Text="模型：程序旁 asrmodels"/>
								</StackPanel>
							</Grid>
						</Border>

						<TabControl x:Name="asrsubtabs" Grid.Row="2" Margin="0" Padding="0"
						            Background="Transparent" BorderThickness="0">
							<!-- 子 Tab1：识别 -->
							<TabItem x:Name="tabasrrec" Header="识别">
								<Grid Margin="0,10,0,0">
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto"/>
										<RowDefinition Height="*"/>
										<RowDefinition Height="Auto"/>
									</Grid.RowDefinitions>

									<Border Grid.Row="0" Background="{StaticResource BgPanel}" CornerRadius="12"
									        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"
									        Padding="12" Margin="0,0,0,10">
										<StackPanel>
											<DockPanel Margin="0,0,0,8">
												<TextBlock Text="音视频" FontWeight="SemiBold"
												           VerticalAlignment="Center" Margin="0,0,12,0"/>
												<Button x:Name="basropen" Content="打开文件…" Style="{StaticResource ToolBtn}"
												        DockPanel.Dock="Left" Height="32" Padding="12,0" Margin="0,0,8,0"
												        ToolTip="打开音频或视频；也可拖到窗口"/>
												<TextBlock Text="声音来源" FontWeight="SemiBold"
												           VerticalAlignment="Center" Margin="0,0,8,0"/>
												<ComboBox x:Name="easrsource" Width="148" Height="32" Margin="0,0,8,0"
												          VerticalContentAlignment="Center"
												          ToolTip="录音与「系统实时字幕」共用：麦克风 / 系统扬声器环回 / 两者混合">
													<ComboBoxItem Content="麦克风" Tag="Mic" IsSelected="True"/>
													<ComboBoxItem Content="系统声音" Tag="System"/>
													<ComboBoxItem Content="麦克风+系统声音" Tag="MicAndSystem"/>
												</ComboBox>
												<Button x:Name="basrrec" Content="录音" Style="{StaticResource ToolBtn}"
												        DockPanel.Dock="Left" Height="32" Padding="12,0" Margin="0,0,8,0"
												        AutomationProperties.AutomationId="basrrec"
												        ToolTip="按所选来源录音，再点一次结束并识别"/>
												<Button x:Name="basrlive" Content="系统实时字幕" Style="{StaticResource ToolBtn}"
												        DockPanel.Dock="Left" Height="32" Padding="12,0" Margin="0,0,8,0"
												        AutomationProperties.AutomationId="basrlive"
												        ToolTip="流式识别所选声音来源；桌面透明字幕窗 + 下方识别结果。全局热键默认 Ctrl+Alt+B（设置可改）"/>
												<Button x:Name="basrlivestyle" Content="字幕样式" Style="{StaticResource ToolBtn}"
												        DockPanel.Dock="Left" Height="32" Padding="12,0" Margin="0,0,8,0"
												        AutomationProperties.AutomationId="basrlivestyle"
												        ToolTip="桌面字幕：字体/颜色/大小/位置（仿桌面歌词）"/>
												<TextBlock x:Name="lbasrfile" VerticalAlignment="Center"
												           Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
												           Text="未选择文件"/>
											</DockPanel>
										</StackPanel>
									</Border>

									<Border Grid.Row="1" Background="{StaticResource BgPanel}" CornerRadius="12"
									        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" Padding="12">
										<Grid>
											<Grid.RowDefinitions>
												<RowDefinition Height="Auto"/>
												<RowDefinition Height="*"/>
											</Grid.RowDefinitions>
											<DockPanel Grid.Row="0" Margin="0,0,0,8">
												<TextBlock Text="识别结果" FontWeight="SemiBold" VerticalAlignment="Center"/>
												<Button x:Name="basrcopy" Content="复制" Style="{StaticResource ToolBtnSm}"
												        DockPanel.Dock="Right" Margin="0" Padding="10,4"/>
											</DockPanel>
											<TextBox x:Name="easrtext" Grid.Row="1"
											         TextWrapping="Wrap" AcceptsReturn="True"
											         VerticalScrollBarVisibility="Auto"
											         IsReadOnly="True"
											         BorderBrush="{StaticResource BorderSoft}"
											         Padding="10" FontSize="14"
											         Foreground="{StaticResource TextPrimary}"/>
										</Grid>
									</Border>

									<StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
										<Button x:Name="basrrun" Content="识别" Style="{StaticResource PrimaryBtn}"
										        Width="96" Margin="0,0,8,0" ToolTip="识别当前文件或最近一次录音"/>
										<Button x:Name="basrstop" Content="停止录音" Style="{StaticResource ToolBtn}"
										        Width="96" Margin="0,0,8,0" IsEnabled="False"/>
										<Button x:Name="basrclear" Content="清空结果" Style="{StaticResource ToolBtn}"
										        Width="96"/>
									</StackPanel>
								</Grid>
							</TabItem>

							<!-- 子 Tab2：批量生成字幕 -->
							<TabItem x:Name="tabasrsrt" Header="生成字幕">
								<Grid Margin="0,10,0,0">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" MinWidth="220"/>
										<ColumnDefinition Width="12"/>
										<ColumnDefinition Width="*" MinWidth="260"/>
									</Grid.ColumnDefinitions>

									<!-- 左：文件列表 -->
									<Border Grid.Column="0" Background="{StaticResource BgPanel}" CornerRadius="12"
									        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" Padding="12">
										<Grid>
											<Grid.RowDefinitions>
												<RowDefinition Height="Auto"/>
												<RowDefinition Height="*"/>
												<RowDefinition Height="Auto"/>
											</Grid.RowDefinitions>
											<DockPanel Grid.Row="0" Margin="0,0,0,8">
												<TextBlock Text="音视频列表" FontWeight="SemiBold" VerticalAlignment="Center"/>
												<TextBlock x:Name="lbasrtcount" DockPanel.Dock="Right"
												           FontSize="12" Foreground="{StaticResource TextMuted}"
												           VerticalAlignment="Center" Text="0 个"/>
											</DockPanel>
											<ListBox x:Name="easrtlist" Grid.Row="1"
											         AllowDrop="True"
											         BorderBrush="{StaticResource BorderSoft}"
											         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
											         ToolTip="拖入多个音视频文件">
												<ListBox.ItemTemplate>
													<DataTemplate>
														<StackPanel Margin="2,4">
															<TextBlock Text="{Binding FileName}" FontWeight="SemiBold"
															           TextWrapping="Wrap"/>
															<TextBlock Text="{Binding StatusLine}" FontSize="11"
															           Foreground="{StaticResource TextMuted}"
															           TextWrapping="Wrap" Margin="0,2,0,0"/>
														</StackPanel>
													</DataTemplate>
												</ListBox.ItemTemplate>
											</ListBox>
											<StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
												<Button x:Name="basrtadd" Content="添加…" Style="{StaticResource ToolBtn}"
												        Height="32" Padding="12,0" Margin="0,0,8,0"/>
												<Button x:Name="basrtremove" Content="移除" Style="{StaticResource ToolBtn}"
												        Height="32" Padding="12,0" Margin="0,0,8,0"/>
												<Button x:Name="basrtclear" Content="清空列表" Style="{StaticResource ToolBtn}"
												        Height="32" Padding="12,0"/>
											</StackPanel>
										</Grid>
									</Border>

									<!-- 右：输出与进度 -->
									<Border Grid.Column="2" Background="{StaticResource BgPanel}" CornerRadius="12"
									        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" Padding="12">
										<Grid>
											<Grid.RowDefinitions>
												<RowDefinition Height="Auto"/>
												<RowDefinition Height="Auto"/>
												<RowDefinition Height="Auto"/>
												<RowDefinition Height="*"/>
												<RowDefinition Height="Auto"/>
											</Grid.RowDefinitions>

											<TextBlock Grid.Row="0" Text="输出" FontWeight="SemiBold" Margin="0,0,0,8"/>
											<StackPanel Grid.Row="1" Margin="0,0,0,12">
												<CheckBox x:Name="casrtsamedir" Content="输出到源文件同目录（同名 .srt）"
												          IsChecked="True" Margin="0,0,0,8"/>
												<DockPanel>
													<Button x:Name="basrtbrowse" Content="浏览…" Style="{StaticResource ToolBtn}"
													        DockPanel.Dock="Right" Height="32" Padding="12,0" Margin="8,0,0,0"
													        IsEnabled="False"/>
													<TextBox x:Name="easrtoutdir" Height="32"
													         VerticalContentAlignment="Center" Padding="8,0"
													         IsEnabled="False"
													         ToolTip="自定义输出目录；关闭「同目录」后可用"/>
												</DockPanel>
											</StackPanel>

											<StackPanel Grid.Row="2" Margin="0,0,0,12">
												<TextBlock Text="当前文件" FontWeight="SemiBold" Margin="0,0,0,6"/>
												<TextBlock x:Name="lbasrtfile" FontSize="12" TextWrapping="Wrap"
												           Foreground="{StaticResource TextMuted}"
												           Text="—"/>
												<ProgressBar x:Name="pasrtfile" Height="8" Minimum="0" Maximum="100"
												             Value="0" Margin="0,6,0,4"/>
												<TextBlock x:Name="lbasrtfilepct" FontSize="11"
												           Foreground="{StaticResource TextMuted}" Text="0%"/>
												<TextBlock Text="总进度" FontWeight="SemiBold" Margin="0,12,0,6"/>
												<ProgressBar x:Name="pasrttotal" Height="8" Minimum="0" Maximum="100"
												             Value="0" Margin="0,0,0,4"/>
												<TextBlock x:Name="lbasrttotalpct" FontSize="11"
												           Foreground="{StaticResource TextMuted}" Text="0 / 0"/>
											</StackPanel>

											<StackPanel Grid.Row="3">
												<TextBlock x:Name="lbasrtdetail" FontSize="12" TextWrapping="Wrap"
												           Foreground="{StaticResource TextMuted}"
												           Text="拖入音视频后点「开始」。"/>
												<TextBlock x:Name="lbasrtlatest" FontSize="13" Margin="0,10,0,0"
												           TextWrapping="Wrap"
												           Foreground="{StaticResource TextPrimary}"
												           Text="最新：—"/>
											</StackPanel>

											<StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,12,0,0">
												<Button x:Name="basrtstart" Content="开始" Style="{StaticResource PrimaryBtn}"
												        Width="96" Margin="0,0,8,0"
												        ToolTip="按列表顺序依次生成同名 .srt"/>
												<Button x:Name="basrtstop" Content="中止" Style="{StaticResource ToolBtn}"
												        Width="96" IsEnabled="False"/>
											</StackPanel>
										</Grid>
									</Border>
								</Grid>
							</TabItem>
						</TabControl>
					</Grid>
				</TabItem>

				<!-- Tab：翻译（Opus-MT 中英） -->
				<TabItem x:Name="tabtr" Header="翻译">
					<Grid Margin="12">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="*"/>
							<RowDefinition Height="Auto"/>
						</Grid.RowDefinitions>

						<DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
							<TextBlock Text="翻译" FontSize="18" FontWeight="SemiBold"
							           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"
							           Margin="0,0,16,0"/>
							<TextBlock x:Name="lbtrstatus" Text="就绪" FontSize="12"
							           Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
						</DockPanel>

						<Border Grid.Row="1" Background="{StaticResource BgPanel}" CornerRadius="12"
						        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"
						        Padding="12" Margin="0,0,0,10">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto"/>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="12"/>
									<ColumnDefinition Width="Auto"/>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="12"/>
									<ColumnDefinition Width="Auto"/>
									<ColumnDefinition Width="200"/>
									<ColumnDefinition Width="12"/>
									<ColumnDefinition Width="Auto"/>
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
								</Grid.RowDefinitions>

								<TextBlock Grid.Row="0" Grid.Column="0" Text="源语言" FontWeight="SemiBold"
								           VerticalAlignment="Center" Margin="0,0,8,8"/>
								<ComboBox x:Name="etrsrclng" Grid.Row="0" Grid.Column="1" Height="32"
								          VerticalContentAlignment="Center" Margin="0,0,0,8"
								          ToolTip="先选源语言；「自动」仅支持中英互译（按汉字占比判定）"/>
								<TextBlock Grid.Row="0" Grid.Column="3" Text="目标语言" FontWeight="SemiBold"
								           VerticalAlignment="Center" Margin="0,0,8,8"/>
								<ComboBox x:Name="etrdstlng" Grid.Row="0" Grid.Column="4" Height="32"
								          VerticalContentAlignment="Center" Margin="0,0,0,8"
								          ToolTip="根据已安装模型与源语言列出可选目标；自动=中英互译"/>
								<TextBlock Grid.Row="0" Grid.Column="6" Text="计算设备" FontWeight="SemiBold"
								           VerticalAlignment="Center" Margin="0,0,8,8"/>
								<ComboBox x:Name="etrcompute" Grid.Row="0" Grid.Column="7" Height="32"
								          VerticalContentAlignment="Center" Margin="0,0,0,8"
								          ToolTip="翻译走 Python+PyTorch，不用 onnxgpu64。GPU 需 CUDA 版 torch（非 +cpu）。核显需 torch-directml。"/>
								<Button x:Name="btrreload" Grid.Row="0" Grid.Column="9" Content="刷新模型"
								        Style="{StaticResource ToolBtn}" Height="32" Margin="0,0,0,8"
								        ToolTip="重新扫描 translatemodels"/>

								<TextBlock Grid.Row="1" Grid.Column="0" Text="模型" FontWeight="SemiBold"
								           VerticalAlignment="Center" Margin="0,0,8,0"/>
								<ComboBox x:Name="etrmodel" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="9" Height="32"
								          VerticalContentAlignment="Center" Margin="0,0,0,8"
								          DisplayMemberPath="ListName"
								          ToolTip="由源/目标语言自动匹配；可手动改选同向模型"/>

								<TextBlock x:Name="lbtrhint" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="10"
								           FontSize="11" Foreground="{StaticResource TextMuted}"
								           TextWrapping="Wrap"
								           Text="模型：translatemodels。GPU≠onnxgpu64（那是 OCR 的 ORT）；翻译 GPU 需 pip 安装 CUDA 版 torch。"/>
							</Grid>
						</Border>

						<Grid Grid.Row="2">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="8"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>

							<Border Grid.Column="0" Background="{StaticResource BgPanel}" CornerRadius="12"
							        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" Padding="12">
								<Grid>
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto"/>
										<RowDefinition Height="*"/>
									</Grid.RowDefinitions>
									<DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
										<TextBlock Text="原文" FontWeight="SemiBold" VerticalAlignment="Center"/>
										<Button x:Name="btrpaste" DockPanel.Dock="Right" Content="粘贴"
										        Style="{StaticResource ToolBtn}" Height="28" Padding="10,4"
										        ToolTip="从剪贴板粘贴到原文"/>
										<Button x:Name="btrfromocr" DockPanel.Dock="Right" Content="从 OCR"
										        Style="{StaticResource ToolBtn}" Height="28" Padding="10,4" Margin="0,0,6,0"
										        ToolTip="填入截图识别结果文本"/>
										<Button x:Name="btrclear" DockPanel.Dock="Right" Content="清空"
										        Style="{StaticResource ToolBtn}" Height="28" Padding="10,4" Margin="0,0,6,0"/>
									</DockPanel>
									<TextBox x:Name="etrsrc" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap"
									         VerticalScrollBarVisibility="Auto" FontSize="14"
									         BorderThickness="0" Background="Transparent"
									         VerticalContentAlignment="Top"/>
								</Grid>
							</Border>

							<Border Grid.Column="2" Background="{StaticResource BgPanel}" CornerRadius="12"
							        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" Padding="12">
								<Grid>
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto"/>
										<RowDefinition Height="*"/>
									</Grid.RowDefinitions>
									<DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
										<TextBlock Text="译文" FontWeight="SemiBold" VerticalAlignment="Center"/>
										<Button x:Name="btrcopy" DockPanel.Dock="Right" Content="复制译文"
										        Style="{StaticResource ToolBtn}" Height="28" Padding="10,4"/>
									</DockPanel>
									<TextBox x:Name="etrdst" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap"
									         VerticalScrollBarVisibility="Auto" FontSize="14"
									         IsReadOnly="True" BorderThickness="0" Background="Transparent"
									         VerticalContentAlignment="Top"/>
								</Grid>
							</Border>
						</Grid>

						<StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
							<Button x:Name="btrgo" Content="翻译" Style="{StaticResource PrimaryBtn}"
							        Width="100" Margin="0,0,8,0" ToolTip="按所选方向翻译原文"/>
							<Button x:Name="btrpingpong" Content="来回翻译20次" Style="{StaticResource ToolBtn}"
							        Width="120" Margin="0,0,8,0"
							        ToolTip="正向+反向往返 20 次，弹出窗口显示每一步中间结果"/>
							<Button x:Name="btrswap" Content="交换语言" Style="{StaticResource ToolBtn}"
							        Width="96" Margin="0,0,8,0" ToolTip="交换源/目标语言；若有译文则与原文对调"/>
							<Button x:Name="btrstop" Content="取消" Style="{StaticResource ToolBtn}"
							        Width="80" IsEnabled="False"/>
						</StackPanel>
					</Grid>
				</TabItem>
		</TabControl>
	</Grid>
</Window>

