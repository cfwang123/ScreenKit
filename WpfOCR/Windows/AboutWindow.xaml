<Window x:Class="WpfOCR.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于"
        Height="520" Width="520"
        MinHeight="400" MinWidth="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BgApp}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        ShowInTaskbar="False">
	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- 标题区 -->
		<DockPanel Grid.Row="0" Margin="0,0,0,12">
			<Border DockPanel.Dock="Left" Background="{StaticResource Accent}" CornerRadius="10"
			        Padding="12,8" Margin="0,0,14,0" VerticalAlignment="Center">
				<TextBlock Text="OCR" Foreground="White" FontWeight="Bold" FontSize="16"/>
			</Border>
			<StackPanel VerticalAlignment="Center">
				<TextBlock x:Name="lbname" Text="WpfOCR" FontSize="18" FontWeight="SemiBold"
				           Foreground="{StaticResource TextPrimary}"/>
				<TextBlock x:Name="lbver" Text="Version —" FontSize="13" Margin="0,4,0,0"
				           Foreground="{StaticResource TextMuted}"/>
				<TextBlock x:Name="lbcopy" Text="" FontSize="12" Margin="0,6,0,0"
				           Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>
			</StackPanel>
		</DockPanel>

		<TextBlock x:Name="lblicensehead" Grid.Row="1" Text="许可证" FontWeight="SemiBold"
		           FontSize="13" Margin="0,0,0,6" Foreground="{StaticResource TextPrimary}"/>

		<Border Grid.Row="2" Background="{StaticResource BgPanel}" CornerRadius="10"
		        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1">
			<ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
				<TextBox x:Name="elicense" IsReadOnly="True" TextWrapping="Wrap"
				         BorderThickness="0" Background="Transparent"
				         FontFamily="Consolas, Cascadia Mono, Microsoft YaHei UI"
				         FontSize="12" Foreground="{StaticResource TextPrimary}"
				         VerticalScrollBarVisibility="Disabled"
				         HorizontalScrollBarVisibility="Disabled"
				         AcceptsReturn="True"/>
			</ScrollViewer>
		</Border>

		<DockPanel Grid.Row="3" Margin="0,14,0,0" LastChildFill="False">
			<Button x:Name="bthird" Content="第三方说明…" Style="{StaticResource ToolBtn}"
			        DockPanel.Dock="Left" Padding="12,6" Margin="0,0,8,0"/>
			<Button x:Name="bopenlic" Content="打开 LICENSE" Style="{StaticResource ToolBtn}"
			        DockPanel.Dock="Left" Padding="12,6"/>
			<Button x:Name="bok" Content="确定" Style="{StaticResource PrimaryBtn}"
			        DockPanel.Dock="Right" Width="96" Padding="12,6"
			        IsDefault="True" IsCancel="True"/>
		</DockPanel>
	</Grid>
</Window>
