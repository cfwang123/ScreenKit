<Window x:Class="WpfOCR.TtsExportProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="正在合成语音"
        Width="420" Height="220"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BgApp}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        Closing="onclosing">
	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<TextBlock x:Name="lbphase" Grid.Row="0" FontSize="15" FontWeight="SemiBold"
		           Foreground="{StaticResource TextPrimary}"
		           Text="正在准备朗读引擎…" TextWrapping="Wrap" Margin="0,0,0,10"/>

		<ProgressBar x:Name="pbar" Grid.Row="1" Height="10" Minimum="0" Maximum="100"
		             Value="0" Margin="0,0,0,6"/>

		<DockPanel Grid.Row="2" Margin="0,0,0,10">
			<TextBlock x:Name="lbpct" DockPanel.Dock="Right" FontSize="12"
			           Foreground="{StaticResource TextMuted}" Text="0%"/>
			<TextBlock FontSize="12" Foreground="{StaticResource TextMuted}" Text="进度"/>
		</DockPanel>

		<TextBlock x:Name="lbdetail" Grid.Row="3" FontSize="12" LineHeight="20"
		           Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
		           VerticalAlignment="Top"/>

		<Button x:Name="bcancel" Grid.Row="4" Content="取消" Width="100" Height="32"
		        HorizontalAlignment="Right" Style="{StaticResource ToolBtn}"
		        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"
		        Click="oncancel" IsCancel="True"/>
	</Grid>
</Window>
