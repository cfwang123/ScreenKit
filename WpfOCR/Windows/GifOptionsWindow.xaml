<Window x:Class="WpfOCR.GifOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GIF 录屏选项"
        Width="420"
        MinWidth="380" MinHeight="240"
        MaxHeight="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource BgApp}"
        FontFamily="Segoe UI, Microsoft YaHei UI">
	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="*" MinHeight="120"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
		              HorizontalScrollBarVisibility="Disabled"
		              Padding="0,0,4,0">
			<StackPanel>
				<TextBlock FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,14"
				           TextWrapping="Wrap"
				           Text="录制固定 24fps；此处设置预览/导出的默认输出帧率与尺寸上限。"/>

				<Grid Margin="0,0,0,10">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" MinWidth="108"/>
						<ColumnDefinition Width="88"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>
					<TextBlock Grid.Column="0" Text="默认输出帧率" FontWeight="SemiBold"
					           VerticalAlignment="Center" Margin="0,0,8,0"/>
					<TextBox x:Name="efps" Grid.Column="1" Height="30" Padding="6,4" Text="8"
					         BorderBrush="{StaticResource BorderSoft}"
					         VerticalContentAlignment="Center" Margin="0,0,10,0"/>
					<TextBlock Grid.Column="2" Text="1 ~ 24 · 默认 8（预览窗可改）"
					           FontSize="12" Foreground="{StaticResource TextMuted}"
					           VerticalAlignment="Center" TextWrapping="Wrap"/>
				</Grid>

				<CheckBox x:Name="emaxen" Content="限制最大宽高（等比 fit 到框内）"
				          Margin="0,0,0,8" IsChecked="True"/>
				<Grid Margin="0,0,0,6" IsEnabled="{Binding ElementName=emaxen, Path=IsChecked}">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="16"/>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>
					<TextBlock Grid.Column="0" Text="最大宽" FontSize="12"
					           Foreground="{StaticResource TextMuted}"
					           VerticalAlignment="Center" Margin="0,0,8,0"/>
					<TextBox x:Name="emaxw" Grid.Column="1" Height="30" Padding="6,4" Text="1280"
					         BorderBrush="{StaticResource BorderSoft}" VerticalContentAlignment="Center"/>
					<TextBlock Grid.Column="3" Text="最大高" FontSize="12"
					           Foreground="{StaticResource TextMuted}"
					           VerticalAlignment="Center" Margin="0,0,8,0"/>
					<TextBox x:Name="emaxh" Grid.Column="4" Height="30" Padding="6,4" Text="720"
					         BorderBrush="{StaticResource BorderSoft}" VerticalContentAlignment="Center"/>
				</Grid>
				<TextBlock FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
				           Margin="0,0,0,4"
				           Text="例如 1280×720：更大选区会缩小进该范围，不放大。"/>
			</StackPanel>
		</ScrollViewer>

		<StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
			<Button x:Name="bcancel" Content="取消" Style="{StaticResource ToolBtn}" Width="88" Margin="0,0,8,0"
			        IsCancel="True"/>
			<Button x:Name="bok" Content="确定" Style="{StaticResource PrimaryBtn}" Width="88" Margin="0"
			        IsDefault="True"/>
		</StackPanel>
	</Grid>
</Window>
