<Window x:Class="WpfOCR.RecordOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="录屏选项"
        Width="440"
        MinWidth="400" MinHeight="320"
        MaxHeight="720"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource BgApp}"
        FontFamily="Segoe UI, Microsoft YaHei UI">
	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="*" MinHeight="180"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
		              HorizontalScrollBarVisibility="Disabled"
		              Padding="0,0,4,0">
			<StackPanel>
				<!-- 编码：label + combobox 半宽 -->
				<TextBlock Text="编码" FontWeight="SemiBold" Margin="0,0,0,6"/>
				<Grid Margin="0,0,0,4">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>
					<ComboBox x:Name="ecodec" Grid.Column="0" Height="32"
					          VerticalContentAlignment="Center">
						<ComboBoxItem Content="x264 (H.264，兼容性好)" Tag="x264" IsSelected="True"/>
						<ComboBoxItem Content="x265 (H.265/HEVC，更小体积)" Tag="x265"/>
					</ComboBox>
				</Grid>
				<TextBlock FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,14"
				           TextWrapping="Wrap"
				           Text="x265 需要 ffmpeg64 含 libx265；若打开失败会提示。"/>

				<!-- 数值行：label: textbox  range/unit -->
				<Grid Margin="0,0,0,10">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" MinWidth="108"/>
						<ColumnDefinition Width="88"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>
					<TextBlock Grid.Column="0" Text="帧率 (FPS)" FontWeight="SemiBold"
					           VerticalAlignment="Center" Margin="0,0,8,0"/>
					<TextBox x:Name="efps" Grid.Column="1" Height="30" Padding="6,4" Text="24"
					         BorderBrush="{StaticResource BorderSoft}"
					         VerticalContentAlignment="Center" Margin="0,0,10,0"/>
					<TextBlock Grid.Column="2" Text="5 ~ 60" FontSize="12"
					           Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"
					           TextWrapping="Wrap"/>
				</Grid>

				<Grid Margin="0,0,0,4">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" MinWidth="108"/>
						<ColumnDefinition Width="88"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>
					<TextBlock Grid.Column="0" Text="CRF" FontWeight="SemiBold"
					           VerticalAlignment="Center" Margin="0,0,8,0"/>
					<TextBox x:Name="ecrf" Grid.Column="1" Height="30" Padding="6,4" Text="28"
					         BorderBrush="{StaticResource BorderSoft}"
					         VerticalContentAlignment="Center" Margin="0,0,10,0"/>
					<TextBlock Grid.Column="2" Text="0 ~ 51 · 质量/体积，越大文件越小"
					           FontSize="12" Foreground="{StaticResource TextMuted}"
					           VerticalAlignment="Center" TextWrapping="Wrap"/>
				</Grid>
				<TextBlock FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,14"
				           TextWrapping="Wrap"
				           Text="0 最清晰最大；18~28 常用。"/>

				<!-- 声音 -->
				<TextBlock Text="声音" FontWeight="SemiBold" Margin="0,0,0,6"/>
				<CheckBox x:Name="eauden" Content="录制声音" Margin="0,0,0,8" IsChecked="True"/>
				<Grid Margin="0,0,0,10">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>
					<ComboBox x:Name="eaudsrc" Grid.Column="0" Height="32"
					          VerticalContentAlignment="Center"
					          ToolTip="扬声器=系统正在播放的声音（环回）"
					          IsEnabled="{Binding ElementName=eauden, Path=IsChecked}">
						<ComboBoxItem Content="扬声器(听到的内容)" Tag="Speakers" IsSelected="True"/>
						<ComboBoxItem Content="麦克风" Tag="Mic"/>
						<ComboBoxItem Content="麦克风 + 扬声器" Tag="MicAndSpeakers"/>
					</ComboBox>
				</Grid>

				<Grid Margin="0,0,0,10"
				      IsEnabled="{Binding ElementName=eauden, Path=IsChecked}">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" MinWidth="108"/>
						<ColumnDefinition Width="88"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>
					<TextBlock Grid.Column="0" Text="码率 (kbps)" FontWeight="SemiBold"
					           VerticalAlignment="Center" Margin="0,0,8,0"/>
					<TextBox x:Name="eaudkbps" Grid.Column="1" Height="30" Padding="6,4" Text="96"
					         BorderBrush="{StaticResource BorderSoft}"
					         VerticalContentAlignment="Center" Margin="0,0,10,0"/>
					<TextBlock Grid.Column="2" Text="8 ~ 128 · 语音 32~64，音乐 96~128"
					           FontSize="12" Foreground="{StaticResource TextMuted}"
					           VerticalAlignment="Center" TextWrapping="Wrap"/>
				</Grid>

				<Grid Margin="0,0,0,10"
				      IsEnabled="{Binding ElementName=eauden, Path=IsChecked}">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" MinWidth="108"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>
					<TextBlock Grid.Column="0" Text="采样率 (Hz)" FontWeight="SemiBold"
					           VerticalAlignment="Center" Margin="0,0,8,0"/>
					<ComboBox x:Name="eaudhz" Grid.Column="1" Height="32"
					          VerticalContentAlignment="Center"
					          ToolTip="规范化输出采样率" Margin="0,0,10,0"/>
					<TextBlock Grid.Column="2" Text="默认 22050，越低越省体积"
					           FontSize="12" Foreground="{StaticResource TextMuted}"
					           VerticalAlignment="Center" TextWrapping="Wrap"/>
				</Grid>

				<CheckBox x:Name="eaudmono" Content="单声道"
				          Margin="0,0,0,4" IsChecked="False"
				          IsEnabled="{Binding ElementName=eauden, Path=IsChecked}"/>
				<TextBlock FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,14"
				           TextWrapping="Wrap"
				           Text="低码率（如 32kbps）建议开单声道，同等码率更清晰；音乐保留立体声。"/>

				<!-- 最大宽高：label + input 同一行 -->
				<CheckBox x:Name="emaxen" Content="限制最大宽高（等比 fit 到框内）"
				          Margin="0,0,0,8" IsChecked="False"/>
				<Grid Margin="0,0,0,6" IsEnabled="{Binding ElementName=emaxen, Path=IsChecked}">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="16"/>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>
					<TextBlock Grid.Column="0" Text="最大宽" FontSize="12"
					           Foreground="{StaticResource TextMuted}"
					           VerticalAlignment="Center" Margin="0,0,8,0"/>
					<TextBox x:Name="emaxw" Grid.Column="1" Height="30" Padding="6,4" Text="1920"
					         BorderBrush="{StaticResource BorderSoft}" VerticalContentAlignment="Center"/>
					<TextBlock Grid.Column="3" Text="最大高" FontSize="12"
					           Foreground="{StaticResource TextMuted}"
					           VerticalAlignment="Center" Margin="0,0,8,0"/>
					<TextBox x:Name="emaxh" Grid.Column="4" Height="30" Padding="6,4" Text="1080"
					         BorderBrush="{StaticResource BorderSoft}" VerticalContentAlignment="Center"/>
				</Grid>
				<TextBlock FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
				           Margin="0,0,0,4"
				           Text="例如 1920×1080：更大选区会缩小进该范围，不放大。"/>
			</StackPanel>
		</ScrollViewer>

		<StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
			<Button x:Name="bcancel" Content="取消" Style="{StaticResource ToolBtn}" Width="88" Margin="0,0,8,0"
			        IsCancel="True"/>
			<Button x:Name="bok" Content="确定" Style="{StaticResource PrimaryBtn}" Width="88" Margin="0"
			        IsDefault="True"/>
		</StackPanel>
	</Grid>
</Window>
