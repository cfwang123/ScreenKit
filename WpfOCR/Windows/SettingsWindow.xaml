<Window x:Class="WpfOCR.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="参数设置"
        Height="640" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgApp}"
        FontFamily="Segoe UI, Microsoft YaHei UI">
	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
			<StackPanel>
				<TextBlock x:Name="lbsetlang" Text="界面语言" FontWeight="SemiBold" Margin="0,0,0,6"/>
				<ComboBox x:Name="euilang" Height="32" Margin="0,0,0,6">
					<ComboBoxItem Content="中文" Tag="zh"/>
					<ComboBoxItem Content="English" Tag="en"/>
				</ComboBox>
				<TextBlock x:Name="lbsetlanghint" FontSize="11" Foreground="{StaticResource TextMuted}"
				           TextWrapping="Wrap" Margin="0,0,0,14"
				           Text="切换后立即生效，并写入 config.toml"/>

				<TextBlock x:Name="lbsetpack" Text="模型包" FontWeight="SemiBold" Margin="0,0,0,6"/>
				<ComboBox x:Name="epack" Height="32" Margin="0,0,0,10"
				          DisplayMemberPath="DisplayName"/>

				<TextBlock x:Name="lbsetvariant" Text="语言 / 模型变体" FontWeight="SemiBold" Margin="0,0,0,6"/>
				<ComboBox x:Name="evariant" Height="32" Margin="0,0,0,6"
				          DisplayMemberPath="Title"/>
				<TextBlock x:Name="lbmodelhint" FontSize="11" Foreground="{StaticResource TextMuted}"
				           TextWrapping="Wrap" Margin="0,0,0,14"
				           Text=""/>

				<TextBlock Text="推理设备" FontWeight="SemiBold" Margin="0,0,0,6"/>
				<ComboBox x:Name="edevice" Height="32" Margin="0,0,0,6">
					<ComboBoxItem Content="GPU (NVIDIA CUDA)" Tag="Gpu"/>
					<ComboBoxItem Content="核显 (Intel DirectML)" Tag="IntelGpu"/>
					<ComboBoxItem Content="CPU" Tag="Cpu"/>
				</ComboBox>
				<TextBlock FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,14"
				           TextWrapping="Wrap"
				           Text="核显走 DirectML；与 NVIDIA CUDA 不能同进程切换，换设备若失败请重启程序"/>

				<TextBlock Text="检测边长上限" FontWeight="SemiBold" Margin="0,0,0,6"/>
				<TextBlock FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"
				           Text="也可在主窗口顶栏「边长」快速切换"/>
				<DockPanel Margin="0,0,0,14">
					<TextBlock x:Name="lbdetlen" DockPanel.Dock="Right" Width="48" Text="1024"
					           VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
					<Slider x:Name="edetlen" Minimum="320" Maximum="2560" TickFrequency="32"
					        IsSnapToTickEnabled="True" Value="1024"/>
				</DockPanel>

				<TextBlock Text="检测阈值" FontWeight="SemiBold" Margin="0,0,0,6"/>
				<DockPanel Margin="0,0,0,14">
					<TextBlock x:Name="lbdetth" DockPanel.Dock="Right" Width="48" Text="0.30"
					           VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
					<Slider x:Name="edetth" Minimum="0.1" Maximum="0.9" TickFrequency="0.05"
					        IsSnapToTickEnabled="True" Value="0.3"/>
				</DockPanel>

				<TextBlock Text="框置信阈值" FontWeight="SemiBold" Margin="0,0,0,6"/>
				<DockPanel Margin="0,0,0,14">
					<TextBlock x:Name="lbboxth" DockPanel.Dock="Right" Width="48" Text="0.50"
					           VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
					<Slider x:Name="eboxth" Minimum="0.1" Maximum="0.9" TickFrequency="0.05"
					        IsSnapToTickEnabled="True" Value="0.5"/>
				</DockPanel>

				<CheckBox x:Name="eusecls" Content="启用方向分类 (cls)" Margin="0,0,0,14" IsChecked="True"/>

				<TextBlock Text="全局热键" FontWeight="SemiBold" Margin="0,0,0,6"/>
				<TextBlock FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"
				           TextWrapping="Wrap"
				           Text="点「捕获」后按下组合键写入；「清空」禁用该热键。留空亦可手改。"/>

				<TextBlock FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"
				           TextWrapping="Wrap"
				           Text="主窗呼出/隐藏 · 默认 Ctrl+Alt+O；留空禁用。再按一次隐藏"/>
				<DockPanel Margin="0,0,0,10" LastChildFill="True">
					<Button x:Name="bhkclear" DockPanel.Dock="Right" Content="清空" Width="48" Height="30"
					        Style="{StaticResource ToolBtn}" Padding="4,0" Margin="4,0,0,0" ToolTip="清空（禁用）"/>
					<Button x:Name="bhkcap" DockPanel.Dock="Right" Content="捕获" Width="48" Height="30"
					        Style="{StaticResource ToolBtn}" Padding="4,0" ToolTip="点击后按下快捷键"/>
					<TextBox x:Name="ehotkey" Height="30" Padding="6,4"
					         BorderBrush="{StaticResource BorderSoft}" VerticalContentAlignment="Center"/>
				</DockPanel>

				<TextBlock FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"
				           TextWrapping="Wrap"
				           Text="截图标注 · 框选并标注，默认 Ctrl+Alt+Q；留空禁用"/>
				<DockPanel Margin="0,0,0,10" LastChildFill="True">
					<Button x:Name="bhksnapclear" DockPanel.Dock="Right" Content="清空" Width="48" Height="30"
					        Style="{StaticResource ToolBtn}" Padding="4,0" Margin="4,0,0,0" ToolTip="清空（禁用）"/>
					<Button x:Name="bhksnapcap" DockPanel.Dock="Right" Content="捕获" Width="48" Height="30"
					        Style="{StaticResource ToolBtn}" Padding="4,0" ToolTip="点击后按下快捷键"/>
					<TextBox x:Name="ehotkeysnap" Height="30" Padding="6,4"
					         BorderBrush="{StaticResource BorderSoft}" VerticalContentAlignment="Center"/>
				</DockPanel>

				<TextBlock FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"
				           Text="截图识别 · 框选后立即 OCR，默认 Ctrl+Alt+W；留空禁用"/>
				<DockPanel Margin="0,0,0,10" LastChildFill="True">
					<Button x:Name="bhkocrclear" DockPanel.Dock="Right" Content="清空" Width="48" Height="30"
					        Style="{StaticResource ToolBtn}" Padding="4,0" Margin="4,0,0,0" ToolTip="清空（禁用）"/>
					<Button x:Name="bhkocrcap" DockPanel.Dock="Right" Content="捕获" Width="48" Height="30"
					        Style="{StaticResource ToolBtn}" Padding="4,0" ToolTip="点击后按下快捷键"/>
					<TextBox x:Name="ehotkeysnapocr" Height="30" Padding="6,4"
					         BorderBrush="{StaticResource BorderSoft}" VerticalContentAlignment="Center"/>
				</DockPanel>

				<TextBlock FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"
				           TextWrapping="Wrap"
				           Text="屏幕画板 · 全屏冻结后标注；默认空=禁用"/>
				<DockPanel Margin="0,0,0,10" LastChildFill="True">
					<Button x:Name="bhkboardclear" DockPanel.Dock="Right" Content="清空" Width="48" Height="30"
					        Style="{StaticResource ToolBtn}" Padding="4,0" Margin="4,0,0,0" ToolTip="清空（禁用）"/>
					<Button x:Name="bhkboardcap" DockPanel.Dock="Right" Content="捕获" Width="48" Height="30"
					        Style="{StaticResource ToolBtn}" Padding="4,0" ToolTip="点击后按下快捷键"/>
					<TextBox x:Name="ehotkeyboard" Height="30" Padding="6,4"
					         BorderBrush="{StaticResource BorderSoft}" VerticalContentAlignment="Center"
					         AutomationProperties.AutomationId="set.hotkey.board"/>
				</DockPanel>

				<TextBlock FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"
				           TextWrapping="Wrap"
				           Text="语音输入 · 麦克风持续识别并输入到焦点窗口，默认 Ctrl+Alt+V；再按一次结束；留空禁用"/>
				<DockPanel Margin="0,0,0,10" LastChildFill="True">
					<Button x:Name="bhkvoiceclear" DockPanel.Dock="Right" Content="清空" Width="48" Height="30"
					        Style="{StaticResource ToolBtn}" Padding="4,0" Margin="4,0,0,0" ToolTip="清空（禁用）"/>
					<Button x:Name="bhkvoicecap" DockPanel.Dock="Right" Content="捕获" Width="48" Height="30"
					        Style="{StaticResource ToolBtn}" Padding="4,0" ToolTip="点击后按下快捷键"/>
					<TextBox x:Name="ehotkeyvoice" Height="30" Padding="6,4"
					         BorderBrush="{StaticResource BorderSoft}" VerticalContentAlignment="Center"/>
				</DockPanel>

				<TextBlock FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"
				           TextWrapping="Wrap"
				           Text="系统实时字幕 · 流式识别到桌面字幕窗，默认 Ctrl+Alt+B；再按一次结束；留空禁用"/>
				<DockPanel Margin="0,0,0,10" LastChildFill="True">
					<Button x:Name="bhkliveclear" DockPanel.Dock="Right" Content="清空" Width="48" Height="30"
					        Style="{StaticResource ToolBtn}" Padding="4,0" Margin="4,0,0,0" ToolTip="清空（禁用）"/>
					<Button x:Name="bhklivecap" DockPanel.Dock="Right" Content="捕获" Width="48" Height="30"
					        Style="{StaticResource ToolBtn}" Padding="4,0" ToolTip="点击后按下快捷键"/>
					<TextBox x:Name="ehotkeylive" Height="30" Padding="6,4"
					         BorderBrush="{StaticResource BorderSoft}" VerticalContentAlignment="Center"
					         AutomationProperties.AutomationId="set.hotkey.live"/>
				</DockPanel>
				<CheckBox x:Name="emintray" Content="最小化时隐藏到通知栏（关闭需确认退出）" Margin="0,0,0,14" IsChecked="True"/>

				<TextBlock Text="截图历史" FontWeight="SemiBold" Margin="0,0,0,6"/>
				<TextBlock FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"
				           TextWrapping="Wrap"
				           Text="screenshots/ 目录保留时间；超过后自动删除。默认 3 天，可选不限。"/>
				<ComboBox x:Name="esnapkeep" Height="32" Margin="0,0,0,10"
				          AutomationProperties.AutomationId="set.screenshot.keep">
					<ComboBoxItem Content="1 天" Tag="1"/>
					<ComboBoxItem Content="3 天" Tag="3" IsSelected="True"/>
					<ComboBoxItem Content="7 天" Tag="7"/>
					<ComboBoxItem Content="14 天" Tag="14"/>
					<ComboBoxItem Content="30 天" Tag="30"/>
					<ComboBoxItem Content="90 天" Tag="90"/>
					<ComboBoxItem Content="不限" Tag="0"/>
				</ComboBox>
				<TextBlock FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"
				           TextWrapping="Wrap"
				           Text="截图标注/识别完成时写入剪贴板的方式（二选一；主菜单/托盘也可切换）。"/>
				<RadioButton x:Name="esnapcopyimg" GroupName="SnapCopy"
				             Content="复制为图片（可贴到 Word / 聊天等）"
				             Margin="0,0,0,4" IsChecked="True"
				             AutomationProperties.AutomationId="set.snap.copy.image"/>
				<RadioButton x:Name="esnapcopyfile" GroupName="SnapCopy"
				             Content="复制为文件（资源管理器 Ctrl+V）"
				             Margin="0,0,0,14"
				             AutomationProperties.AutomationId="set.snap.copy.file"/>

				<TextBlock Text="HTTP 识图 API（Umi 兼容）" FontWeight="SemiBold" Margin="0,0,0,6"/>
				<TextBlock FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"
				           TextWrapping="Wrap"
				           Text="POST /api/ocr · 支持 JSON base64 与 multipart 上传；GET /api/ocr/get_options"/>
				<CheckBox x:Name="ehttpen" Content="启用 HTTP API" Margin="0,0,0,8" IsChecked="True"/>
				<Grid Margin="0,0,0,10">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="12"/>
						<ColumnDefinition Width="100"/>
					</Grid.ColumnDefinitions>
					<StackPanel Grid.Column="0">
						<TextBlock Text="监听地址" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
						<TextBox x:Name="ehttphost" Height="30" Padding="6,4"
						         BorderBrush="{StaticResource BorderSoft}" Text="127.0.0.1"/>
					</StackPanel>
					<StackPanel Grid.Column="2">
						<TextBlock Text="端口" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
						<TextBox x:Name="ehttpport" Height="30" Padding="6,4"
						         BorderBrush="{StaticResource BorderSoft}" Text="1224"/>
					</StackPanel>
				</Grid>
				<CheckBox x:Name="eservicemode" Content="服务模式（引擎常驻预热，不释放模型内存）"
				          Margin="0,0,0,4" IsChecked="False"/>
				<TextBlock FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,14"
				           TextWrapping="Wrap"
				           Text="启用后启动与改参会立即加载引擎并保持常驻；关闭则为懒加载（改参后丢弃，下次识别再加载）"/>

				<TextBlock Text="PDF 识别" FontWeight="SemiBold" Margin="0,0,0,6"/>
				<CheckBox x:Name="epdftext" Content="导出时叠加不可见文字层（可检索/可复制）"
				          Margin="0,0,0,6" IsChecked="True"/>
				<TextBlock FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,14"
				           TextWrapping="Wrap"
				           Text="页面尺寸按原 PDF 页面还原；光栅化 DPI 由程序固定（约 150），无需配置"/>

				<TextBlock Text="系统日志" FontWeight="SemiBold" Margin="0,0,0,6"/>
				<CheckBox x:Name="ecapturelog" Content="写入诊断日志（默认关闭）"
				          Margin="0,0,0,4" IsChecked="False"
				          AutomationProperties.AutomationId="set.capture.log"/>
				<TextBlock FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,14"
				           TextWrapping="Wrap"
				           Text="开启后写入 log/capture.log 与录屏 log/record_*.log，便于排查；日常使用请保持关闭"/>
			</StackPanel>
		</ScrollViewer>

		<StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
			<Button x:Name="bcancel" Content="取消" Style="{StaticResource ToolBtn}" Width="88" Margin="0,0,8,0"
			        IsCancel="True"/>
			<Button x:Name="bok" Content="确定" Style="{StaticResource PrimaryBtn}" Width="88" Margin="0"
			        IsDefault="True"/>
		</StackPanel>
	</Grid>
</Window>
