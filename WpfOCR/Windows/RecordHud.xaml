<Window x:Class="WpfOCR.RecordHud"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ShowActivated="False">
	<Window.Resources>
		<!-- 黄底条上的紧凑文字按钮 -->
		<Style x:Key="HudLinkBtn" TargetType="Button">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Foreground" Value="#111"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Padding" Value="8,0"/>
			<Setter Property="Height" Value="22"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="bd" Background="{TemplateBinding Background}"
						        CornerRadius="2" Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bd" Property="Background" Value="#33000000"/>
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter Property="Opacity" Value="0.35"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<!-- 图标按钮（开始/暂停/停止） -->
		<Style x:Key="HudIconBtn" TargetType="Button" BasedOn="{StaticResource HudLinkBtn}">
			<Setter Property="Padding" Value="4,0"/>
			<Setter Property="Width" Value="26"/>
			<Setter Property="MinWidth" Value="26"/>
		</Style>
		<!-- 选区边缘/角点：低透明以保证分层窗可点 -->
		<Style x:Key="HudGrip" TargetType="Border">
			<Setter Property="Background" Value="#02E53935"/>
			<Setter Property="IsHitTestVisible" Value="True"/>
			<Setter Property="SnapsToDevicePixels" Value="True"/>
		</Style>
		<!-- 图标几何 -->
		<Geometry x:Key="GeoPlay">M 3,2 L 12,8 L 3,14 Z</Geometry>
		<Geometry x:Key="GeoPause">M 2.5,2.5 H 5.5 V 13.5 H 2.5 Z M 9.5,2.5 H 12.5 V 13.5 H 9.5 Z</Geometry>
		<Geometry x:Key="GeoStop">M 3,3 H 13 V 13 H 3 Z</Geometry>
		<!-- 折线箭头：与实心播放三角区分 -->
		<Geometry x:Key="GeoChevronL">M 10,2.5 L 4,8 L 10,13.5</Geometry>
		<Geometry x:Key="GeoChevronR">M 4,2.5 L 10,8 L 4,13.5</Geometry>
	</Window.Resources>

	<!-- Background 全透明：分层窗仅不透明像素接收点击 -->
	<Canvas x:Name="proot" Background="Transparent" IsHitTestVisible="True"
	        ClipToBounds="False">
		<!-- 红色录制外框：几何在选区外 -->
		<Rectangle x:Name="rborder" Stroke="#E53935" StrokeThickness="3"
		           Fill="Transparent" IsHitTestVisible="False"
		           SnapsToDevicePixels="True" UseLayoutRounding="True"/>
		<Rectangle x:Name="rdot" Width="8" Height="8" Fill="#E53935" RadiusX="4" RadiusY="4"
		           IsHitTestVisible="False" UseLayoutRounding="True"/>

		<!-- 顶部拖动条（移动选区） -->
		<Border x:Name="bdrag" Height="10" Cursor="SizeAll" Style="{StaticResource HudGrip}"
		        ToolTip="拖动移动录屏区域"
		        AutomationProperties.AutomationId="hud.drag"/>

		<!-- 八向缩放手柄 -->
		<Border x:Name="g_nw" Width="12" Height="12" Cursor="SizeNWSE" Style="{StaticResource HudGrip}"
		        AutomationProperties.AutomationId="hud.grip.nw"/>
		<Border x:Name="g_n" Height="8" Cursor="SizeNS" Style="{StaticResource HudGrip}"
		        AutomationProperties.AutomationId="hud.grip.n"/>
		<Border x:Name="g_ne" Width="12" Height="12" Cursor="SizeNESW" Style="{StaticResource HudGrip}"
		        AutomationProperties.AutomationId="hud.grip.ne"/>
		<Border x:Name="g_e" Width="8" Cursor="SizeWE" Style="{StaticResource HudGrip}"
		        AutomationProperties.AutomationId="hud.grip.e"/>
		<Border x:Name="g_se" Width="12" Height="12" Cursor="SizeNWSE" Style="{StaticResource HudGrip}"
		        AutomationProperties.AutomationId="hud.grip.se"/>
		<Border x:Name="g_s" Height="8" Cursor="SizeNS" Style="{StaticResource HudGrip}"
		        AutomationProperties.AutomationId="hud.grip.s"/>
		<Border x:Name="g_sw" Width="12" Height="12" Cursor="SizeNESW" Style="{StaticResource HudGrip}"
		        AutomationProperties.AutomationId="hud.grip.sw"/>
		<Border x:Name="g_w" Width="8" Cursor="SizeWE" Style="{StaticResource HudGrip}"
		        AutomationProperties.AutomationId="hud.grip.w"/>

		<!-- 收起后：手柄 + 展开 + 状态圆点 + 开始|暂停 + 停止 -->
		<Border x:Name="bmini" Background="#F7E600" CornerRadius="4"
		        BorderBrush="#C4B800" BorderThickness="1"
		        Padding="2,3,4,3" Height="28" Visibility="Collapsed"
		        HorizontalAlignment="Left" VerticalAlignment="Top"
		        IsHitTestVisible="True" Cursor="SizeAll"
		        SnapsToDevicePixels="True" UseLayoutRounding="True"
		        ToolTip="拖动移动 · 展开/开始/暂停/停止">
			<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
				<Border x:Name="bhandleM" Width="14" Height="22" Cursor="SizeAll" Margin="0,0,2,0"
				        Background="Transparent" ToolTip="拖动控制条"
				        AutomationProperties.AutomationId="hud.handle.mini">
					<Canvas Width="10" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"
					        IsHitTestVisible="False">
						<Ellipse Canvas.Left="1" Canvas.Top="1" Width="2.5" Height="2.5" Fill="#66000000"/>
						<Ellipse Canvas.Left="6" Canvas.Top="1" Width="2.5" Height="2.5" Fill="#66000000"/>
						<Ellipse Canvas.Left="1" Canvas.Top="5.5" Width="2.5" Height="2.5" Fill="#66000000"/>
						<Ellipse Canvas.Left="6" Canvas.Top="5.5" Width="2.5" Height="2.5" Fill="#66000000"/>
						<Ellipse Canvas.Left="1" Canvas.Top="10" Width="2.5" Height="2.5" Fill="#66000000"/>
						<Ellipse Canvas.Left="6" Canvas.Top="10" Width="2.5" Height="2.5" Fill="#66000000"/>
					</Canvas>
				</Border>
				<Button x:Name="bexpand" Style="{StaticResource HudIconBtn}"
				        Width="22" Padding="0" Margin="0,0,2,0"
				        ToolTip="展开控制条"
				        AutomationProperties.AutomationId="hud.expand"
				        AutomationProperties.Name="展开控制条">
					<Path Data="{StaticResource GeoChevronR}" Stroke="#111" StrokeThickness="1.8"
					      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
					      Fill="Transparent" Stretch="Uniform" Width="10" Height="12"/>
				</Button>
				<Ellipse x:Name="edotM" Width="8" Height="8" Fill="#C62828" Margin="2,0,6,0"
				         VerticalAlignment="Center"
				         ToolTip="录制状态"/>
				<Button x:Name="boptM" Content="选项" Style="{StaticResource HudLinkBtn}"
				        Padding="4,0" Margin="0,0,2,0"
				        ToolTip="录屏选项"
				        AutomationProperties.AutomationId="hud.options.mini"
				        AutomationProperties.Name="录屏选项"/>
				<Button x:Name="bstartM" Style="{StaticResource HudIconBtn}"
				        ToolTip="开始录屏"
				        AutomationProperties.AutomationId="hud.start.mini"
				        AutomationProperties.Name="开始录屏">
					<Path Data="{StaticResource GeoPlay}" Fill="#111"
					      Stretch="Uniform" Width="11" Height="11"/>
				</Button>
				<Button x:Name="bpauseM" Style="{StaticResource HudIconBtn}" Visibility="Collapsed"
				        ToolTip="暂停"
				        AutomationProperties.AutomationId="hud.pause.mini"
				        AutomationProperties.Name="暂停录屏">
					<Grid Width="14" Height="14">
						<Path x:Name="icoPauseM" Data="{StaticResource GeoPause}" Fill="#111"
						      Stretch="Uniform" Width="12" Height="12"/>
						<Path x:Name="icoResumeM" Data="{StaticResource GeoPlay}" Fill="#111"
						      Stretch="Uniform" Width="11" Height="11" Visibility="Collapsed"/>
					</Grid>
				</Button>
				<Button x:Name="bstopM" Style="{StaticResource HudIconBtn}"
				        ToolTip="未开始：取消 · 录制中：结束"
				        AutomationProperties.AutomationId="hud.stop.mini"
				        AutomationProperties.Name="停止录屏">
					<Path Data="{StaticResource GeoStop}" Fill="#111"
					      Stretch="Uniform" Width="11" Height="11"/>
				</Button>
			</StackPanel>
		</Border>

		<!-- 单行紧凑黄底浮动条 -->
		<Border x:Name="bbar" Background="#F7E600" CornerRadius="0"
		        BorderBrush="#C4B800" BorderThickness="1"
		        Padding="2,3,6,3" Height="28"
		        HorizontalAlignment="Left" VerticalAlignment="Top"
		        IsHitTestVisible="True" Cursor="SizeAll"
		        SnapsToDevicePixels="True" UseLayoutRounding="True"
		        ToolTip="拖动可移动控制条">
			<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
				<!-- 左侧拖动手柄 -->
				<Border x:Name="bhandle" Width="16" Height="22" Cursor="SizeAll" Margin="0,0,4,0"
				        Background="Transparent" ToolTip="拖动控制条"
				        AutomationProperties.AutomationId="hud.handle">
					<Canvas Width="10" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"
					        IsHitTestVisible="False">
						<Ellipse Canvas.Left="1" Canvas.Top="1" Width="2.5" Height="2.5" Fill="#66000000"/>
						<Ellipse Canvas.Left="6" Canvas.Top="1" Width="2.5" Height="2.5" Fill="#66000000"/>
						<Ellipse Canvas.Left="1" Canvas.Top="5.5" Width="2.5" Height="2.5" Fill="#66000000"/>
						<Ellipse Canvas.Left="6" Canvas.Top="5.5" Width="2.5" Height="2.5" Fill="#66000000"/>
						<Ellipse Canvas.Left="1" Canvas.Top="10" Width="2.5" Height="2.5" Fill="#66000000"/>
						<Ellipse Canvas.Left="6" Canvas.Top="10" Width="2.5" Height="2.5" Fill="#66000000"/>
					</Canvas>
				</Border>
				<Button x:Name="bcollapse" Style="{StaticResource HudIconBtn}"
				        Width="22" Padding="0" Margin="0,0,4,0"
				        ToolTip="收起控制条"
				        AutomationProperties.AutomationId="hud.collapse"
				        AutomationProperties.Name="收起控制条">
					<Path Data="{StaticResource GeoChevronL}" Stroke="#111" StrokeThickness="1.8"
					      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
					      Fill="Transparent" Stretch="Uniform" Width="10" Height="12"/>
				</Button>
				<Ellipse x:Name="edot" Width="8" Height="8" Fill="#C62828" Margin="0,0,8,0"
				         VerticalAlignment="Center"/>
				<TextBlock x:Name="lbstate" Text="就绪" FontSize="12" FontWeight="Bold"
				           Foreground="#111" VerticalAlignment="Center" Margin="0,0,10,0"/>
				<TextBlock x:Name="lbtime" Text="00:00:00" FontSize="12" FontFamily="Consolas, Cascadia Mono"
				           FontWeight="SemiBold" Foreground="#111" VerticalAlignment="Center"
				           Margin="0,0,10,0" MinWidth="58"/>
				<TextBlock x:Name="lbsize" Text="0 KB" FontSize="12" FontFamily="Consolas, Cascadia Mono"
				           Foreground="#111" VerticalAlignment="Center" Margin="0,0,12,0" MinWidth="64"/>
				<TextBlock x:Name="lbregion" Text="0×0" FontSize="12" FontWeight="SemiBold"
				           Foreground="#111" VerticalAlignment="Center" Margin="0,0,6,0"/>
				<TextBlock x:Name="lbsummary" Text="" FontSize="11"
				           Foreground="#333" VerticalAlignment="Center" Margin="0,0,10,0"
				           MaxWidth="280" TextTrimming="CharacterEllipsis"/>
				<Rectangle Width="1" Height="14" Fill="#99000000" Margin="0,0,4,0"
				           VerticalAlignment="Center"/>
				<Button x:Name="bopt" Content="选项" Style="{StaticResource HudLinkBtn}"
				        Padding="4,0" Margin="0,0,2,0"
				        ToolTip="录屏选项"
				        AutomationProperties.AutomationId="hud.options"
				        AutomationProperties.Name="录屏选项"/>
				<Button x:Name="bstart" Style="{StaticResource HudIconBtn}"
				        ToolTip="开始录屏"
				        AutomationProperties.AutomationId="hud.start"
				        AutomationProperties.Name="开始录屏">
					<Path Data="{StaticResource GeoPlay}" Fill="#111"
					      Stretch="Uniform" Width="11" Height="11"/>
				</Button>
				<Button x:Name="bpause" Style="{StaticResource HudIconBtn}" Visibility="Collapsed"
				        ToolTip="暂停"
				        AutomationProperties.AutomationId="hud.pause"
				        AutomationProperties.Name="暂停录屏">
					<Grid Width="14" Height="14">
						<Path x:Name="icoPause" Data="{StaticResource GeoPause}" Fill="#111"
						      Stretch="Uniform" Width="12" Height="12"/>
						<Path x:Name="icoResume" Data="{StaticResource GeoPlay}" Fill="#111"
						      Stretch="Uniform" Width="11" Height="11" Visibility="Collapsed"/>
					</Grid>
				</Button>
				<Button x:Name="bstop" Style="{StaticResource HudIconBtn}"
				        ToolTip="未开始：取消录屏 · 录制中：结束并保存/丢弃"
				        AutomationProperties.AutomationId="hud.stop"
				        AutomationProperties.Name="停止录屏">
					<Path Data="{StaticResource GeoStop}" Fill="#111"
					      Stretch="Uniform" Width="11" Height="11"/>
				</Button>
			</StackPanel>
		</Border>
	</Canvas>
</Window>
