<Window x:Class="WpfOCR.RecordHud"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ShowActivated="False">
	<Window.Resources>
		<!-- 黄底条上的紧凑文字按钮 -->
		<Style x:Key="HudLinkBtn" TargetType="Button">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Foreground" Value="#111"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Padding" Value="8,0"/>
			<Setter Property="Height" Value="22"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="bd" Background="{TemplateBinding Background}"
						        CornerRadius="2" Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bd" Property="Background" Value="#33000000"/>
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter Property="Opacity" Value="0.35"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<Style x:Key="HudStopBtn" TargetType="Button" BasedOn="{StaticResource HudLinkBtn}">
			<Setter Property="Padding" Value="6,0"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="ToolTip" Value="未开始：取消 · 录制中：结束"/>
		</Style>
	</Window.Resources>

	<!-- Background 全透明：分层窗仅不透明像素接收点击，黄条可点、其余穿透 -->
	<Canvas x:Name="proot" Background="Transparent" IsHitTestVisible="True"
	        ClipToBounds="False">
		<!-- 红色录制外框：几何在选区外 -->
		<Rectangle x:Name="rborder" Stroke="#E53935" StrokeThickness="3"
		           Fill="Transparent" IsHitTestVisible="False"
		           SnapsToDevicePixels="True" UseLayoutRounding="True"/>
		<Rectangle x:Name="rdot" Width="8" Height="8" Fill="#E53935" RadiusX="4" RadiusY="4"
		           IsHitTestVisible="False" UseLayoutRounding="True"/>

		<!-- 单行紧凑黄底浮动条 -->
		<Border x:Name="bbar" Background="#F7E600" CornerRadius="0"
		        BorderBrush="#C4B800" BorderThickness="1"
		        Padding="10,3" Height="28"
		        HorizontalAlignment="Left" VerticalAlignment="Top"
		        IsHitTestVisible="True"
		        SnapsToDevicePixels="True" UseLayoutRounding="True">
			<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
				<Ellipse x:Name="edot" Width="8" Height="8" Fill="#C62828" Margin="0,0,8,0"
				         VerticalAlignment="Center"/>
				<TextBlock x:Name="lbstate" Text="就绪" FontSize="12" FontWeight="Bold"
				           Foreground="#111" VerticalAlignment="Center" Margin="0,0,10,0"/>
				<TextBlock x:Name="lbtime" Text="00:00:00" FontSize="12" FontFamily="Consolas, Cascadia Mono"
				           FontWeight="SemiBold" Foreground="#111" VerticalAlignment="Center"
				           Margin="0,0,10,0" MinWidth="58"/>
				<TextBlock x:Name="lbsize" Text="0 KB" FontSize="12" FontFamily="Consolas, Cascadia Mono"
				           Foreground="#111" VerticalAlignment="Center" Margin="0,0,12,0" MinWidth="64"/>
				<TextBlock x:Name="lbregion" Text="0×0" FontSize="12" FontWeight="SemiBold"
				           Foreground="#111" VerticalAlignment="Center" Margin="0,0,6,0"/>
				<TextBlock x:Name="lbsummary" Text="" FontSize="11"
				           Foreground="#333" VerticalAlignment="Center" Margin="0,0,10,0"
				           MaxWidth="280" TextTrimming="CharacterEllipsis"/>
				<Rectangle Width="1" Height="14" Fill="#99000000" Margin="0,0,6,0"
				           VerticalAlignment="Center"/>
				<Button x:Name="bstart" Content="开始" Style="{StaticResource HudLinkBtn}"
				        AutomationProperties.AutomationId="hud.start"
				        AutomationProperties.Name="开始录屏"/>
				<Button x:Name="bpause" Content="暂停" Style="{StaticResource HudLinkBtn}" IsEnabled="False"
				        AutomationProperties.AutomationId="hud.pause"
				        AutomationProperties.Name="暂停录屏"/>
				<Button x:Name="bstop" Content="■" Style="{StaticResource HudStopBtn}"
				        AutomationProperties.AutomationId="hud.stop"
				        AutomationProperties.Name="停止录屏"
				        ToolTip="未开始：取消录屏 · 录制中：结束并保存/丢弃"/>
			</StackPanel>
		</Border>
	</Canvas>
</Window>
