<Window x:Class="WpfOCR.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="诊断 / 日志"
        Height="640" Width="780"
        MinHeight="400" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgApp}"
        FontFamily="Consolas, Microsoft YaHei UI">
	<Grid Margin="14">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
		<TextBlock Grid.Row="0" Text="CUDA / DirectML / 路径 / 显示器 DPI"
		           FontSize="15" FontWeight="SemiBold" FontFamily="Segoe UI, Microsoft YaHei UI"
		           Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10"/>
		<TextBox x:Name="elog" Grid.Row="1"
		         IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
		         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
		         FontSize="12" Padding="10"
		         BorderBrush="{StaticResource BorderSoft}"
		         Background="{StaticResource BgPanel}"/>
		<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
			<Button x:Name="brefresh" Content="刷新" Style="{StaticResource ToolBtn}" Width="88" Margin="0,0,8,0"/>
			<Button x:Name="bcopy" Content="复制全部" Style="{StaticResource ToolBtn}" Width="96" Margin="0,0,8,0"/>
			<Button x:Name="bopenlog" Content="打开日志目录" Style="{StaticResource ToolBtn}" Width="110" Margin="0,0,8,0"/>
			<Button x:Name="bclose" Content="关闭" Style="{StaticResource PrimaryBtn}" Width="88" Margin="0"
			        IsCancel="True" IsDefault="True"/>
		</StackPanel>
	</Grid>
</Window>
