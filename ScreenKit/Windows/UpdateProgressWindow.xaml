<Window x:Class="ScreenKit.UpdateProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="检查更新"
        Width="440" Height="220"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BgApp}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        Closing="onclosing">
	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<TextBlock x:Name="lbphase" Grid.Row="0" FontSize="15" FontWeight="SemiBold"
		           Foreground="{StaticResource TextPrimary}"
		           Text="正在检查更新…" TextWrapping="Wrap" Margin="0,0,0,10"/>

		<ProgressBar x:Name="pbar" Grid.Row="1" Height="10" Minimum="0" Maximum="100"
		             Value="0" Margin="0,0,0,6" IsIndeterminate="True"/>

		<DockPanel Grid.Row="2" Margin="0,0,0,10">
			<TextBlock x:Name="lbpct" DockPanel.Dock="Right" FontSize="12"
			           Foreground="{StaticResource TextMuted}" Text=""/>
			<TextBlock x:Name="lbbytes" FontSize="12" Foreground="{StaticResource TextMuted}"
			           Text=""/>
		</DockPanel>

		<TextBlock x:Name="lbdetail" Grid.Row="3" FontSize="12" LineHeight="20"
		           Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
		           VerticalAlignment="Top"/>

		<Button x:Name="bcancel" Grid.Row="4" Content="取消" Width="100" Height="32"
		        HorizontalAlignment="Right" Style="{StaticResource ToolBtn}"
		        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"
		        Click="oncancel" IsCancel="True"/>
	</Grid>
</Window>
