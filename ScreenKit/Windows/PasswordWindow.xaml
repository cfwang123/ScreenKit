<Window x:Class="ScreenKit.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="密码生成器"
        Width="560" Height="520"
        MinWidth="440" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BgApp}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        AutomationProperties.AutomationId="pwgen.window">
	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
		<Grid Grid.Row="0" Margin="0,0,0,10">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="72"/>
				<ColumnDefinition Width="16"/>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="72"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>
			<TextBlock x:Name="lblen" Text="长度" VerticalAlignment="Center" Margin="0,0,8,0"/>
			<TextBox x:Name="elen" Grid.Column="1" Height="30" Padding="6,4" Text="16"
			         BorderBrush="{StaticResource BorderSoft}" VerticalContentAlignment="Center"
			         AutomationProperties.AutomationId="pwgen.len"/>
			<TextBlock x:Name="lbcount" Grid.Column="3" Text="条数" VerticalAlignment="Center" Margin="0,0,8,0"/>
			<TextBox x:Name="ecount" Grid.Column="4" Height="30" Padding="6,4" Text="5"
			         BorderBrush="{StaticResource BorderSoft}" VerticalContentAlignment="Center"
			         AutomationProperties.AutomationId="pwgen.count"/>
		</Grid>
		<WrapPanel Grid.Row="1" Margin="0,0,0,10">
			<CheckBox x:Name="clower" Content="小写 a-z" IsChecked="True" Margin="0,0,16,6"
			          AutomationProperties.AutomationId="pwgen.lower"/>
			<CheckBox x:Name="cupper" Content="大写 A-Z" IsChecked="True" Margin="0,0,16,6"
			          AutomationProperties.AutomationId="pwgen.upper"/>
			<CheckBox x:Name="cdigit" Content="数字 0-9" IsChecked="True" Margin="0,0,16,6"
			          AutomationProperties.AutomationId="pwgen.digit"/>
			<CheckBox x:Name="csymbol" Content="符号" IsChecked="True" Margin="0,0,16,6"
			          AutomationProperties.AutomationId="pwgen.symbol"/>
			<CheckBox x:Name="cnoamb" Content="排除易混 0OIl1" Margin="0,0,16,6"
			          AutomationProperties.AutomationId="pwgen.noamb"/>
			<CheckBox x:Name="ceach" Content="每类至少一个" IsChecked="True" Margin="0,0,16,6"
			          AutomationProperties.AutomationId="pwgen.each"/>
		</WrapPanel>
		<TextBlock x:Name="lbout" Grid.Row="2" Text="结果" FontWeight="SemiBold" Margin="0,0,0,6"/>
		<TextBox x:Name="eout" Grid.Row="3" AcceptsReturn="True" TextWrapping="NoWrap"
		         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
		         FontFamily="Consolas, Cascadia Mono, Microsoft YaHei UI" FontSize="15"
		         Padding="8" BorderBrush="{StaticResource BorderSoft}"
		         AutomationProperties.AutomationId="pwgen.out"/>
		<TextBlock x:Name="lbstat" Grid.Row="4" Margin="0,8,0,8" Foreground="{StaticResource TextMuted}"/>
		<DockPanel Grid.Row="5">
			<Button x:Name="bgen" Style="{StaticResource ToolBtn}"
			        AutomationProperties.AutomationId="pwgen.gen"/>
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
				<Button x:Name="bcopy" Style="{StaticResource ToolBtn}"
				        AutomationProperties.AutomationId="pwgen.copy"/>
				<Button x:Name="bclose" Style="{StaticResource ToolBtn}"
				        AutomationProperties.AutomationId="pwgen.close"/>
			</StackPanel>
		</DockPanel>
	</Grid>
</Window>
