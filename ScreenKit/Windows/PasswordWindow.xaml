<Window x:Class="ScreenKit.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="密码生成器"
        Width="680" Height="580"
        MinWidth="520" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BgApp}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        AutomationProperties.AutomationId="pwgen.window">
	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
		<TabControl x:Name="tabpw" Grid.Row="0" Margin="0,0,0,8"
		            BorderBrush="{StaticResource BorderSoft}"
		            AutomationProperties.AutomationId="pwgen.tabs">
			<TabItem x:Name="tabrand" Header="随机密码"
			         AutomationProperties.AutomationId="pwgen.tab.rand">
				<Grid Margin="12">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>
					<Grid Grid.Row="0" Margin="0,0,0,10">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="72"/>
							<ColumnDefinition Width="16"/>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="72"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>
						<TextBlock x:Name="lblen" Text="长度" VerticalAlignment="Center" Margin="0,0,8,0"/>
						<TextBox x:Name="elen" Grid.Column="1" Height="30" Padding="6,4" Text="16"
						         BorderBrush="{StaticResource BorderSoft}" VerticalContentAlignment="Center"
						         AutomationProperties.AutomationId="pwgen.len"/>
						<TextBlock x:Name="lbcount" Grid.Column="3" Text="条数" VerticalAlignment="Center" Margin="0,0,8,0"/>
						<TextBox x:Name="ecount" Grid.Column="4" Height="30" Padding="6,4" Text="5"
						         BorderBrush="{StaticResource BorderSoft}" VerticalContentAlignment="Center"
						         AutomationProperties.AutomationId="pwgen.count"/>
					</Grid>
					<WrapPanel Grid.Row="1" Margin="0,0,0,10">
						<CheckBox x:Name="clower" Content="小写 a-z" IsChecked="True" Margin="0,0,16,6"
						          AutomationProperties.AutomationId="pwgen.lower"/>
						<CheckBox x:Name="cupper" Content="大写 A-Z" IsChecked="True" Margin="0,0,16,6"
						          AutomationProperties.AutomationId="pwgen.upper"/>
						<CheckBox x:Name="cdigit" Content="数字 0-9" IsChecked="True" Margin="0,0,16,6"
						          AutomationProperties.AutomationId="pwgen.digit"/>
						<CheckBox x:Name="csymbol" Content="符号" IsChecked="True" Margin="0,0,16,6"
						          AutomationProperties.AutomationId="pwgen.symbol"/>
						<CheckBox x:Name="cnoamb" Content="排除易混 0OIl1" Margin="0,0,16,6"
						          AutomationProperties.AutomationId="pwgen.noamb"/>
						<CheckBox x:Name="ceach" Content="每类至少一个" IsChecked="True" Margin="0,0,16,6"
						          AutomationProperties.AutomationId="pwgen.each"/>
					</WrapPanel>
					<TextBlock x:Name="lbout" Grid.Row="2" Text="结果" FontWeight="SemiBold" Margin="0,0,0,6"/>
					<TextBox x:Name="eout" Grid.Row="3" AcceptsReturn="True" TextWrapping="NoWrap"
					         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
					         FontFamily="Consolas, Cascadia Mono, Microsoft YaHei UI" FontSize="15"
					         Padding="8" BorderBrush="{StaticResource BorderSoft}"
					         AutomationProperties.AutomationId="pwgen.out"/>
					<TextBlock x:Name="lbstat" Grid.Row="4" Margin="0,8,0,8" Foreground="{StaticResource TextMuted}"/>
					<DockPanel Grid.Row="5">
						<Button x:Name="bgen" Style="{StaticResource ToolBtn}"
						        AutomationProperties.AutomationId="pwgen.gen"/>
						<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
							<Button x:Name="bcopy" Style="{StaticResource ToolBtn}"
							        AutomationProperties.AutomationId="pwgen.copy"/>
						</StackPanel>
					</DockPanel>
				</Grid>
			</TabItem>
			<TabItem x:Name="tablex" Header="单词译音"
			         AutomationProperties.AutomationId="pwgen.tab.lex">
				<Grid Margin="12">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>
					<TextBlock x:Name="lblexhint" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8"
					           Foreground="{StaticResource TextMuted}" FontSize="12"
					           Text="输入一个词，用 LLM 译成中日韩英等，并给出拼音 / romaji / 罗马字。"/>
					<Grid Grid.Row="1" Margin="0,0,0,8">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="8"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>
						<TextBlock x:Name="lbword" Text="单词" VerticalAlignment="Center" Margin="0,0,8,0"/>
						<TextBox x:Name="eword" Grid.Column="1" Height="32" Padding="8,4"
						         BorderBrush="{StaticResource BorderSoft}"
						         VerticalContentAlignment="Center"
						         AutomationProperties.AutomationId="pwgen.lex.word"/>
						<Button x:Name="blex" Grid.Column="3" Style="{StaticResource ToolBtn}"
						        AutomationProperties.AutomationId="pwgen.lex.go"/>
					</Grid>
					<ListView x:Name="lvlex" Grid.Row="2" BorderBrush="{StaticResource BorderSoft}"
					          SelectionMode="Extended"
					          AutomationProperties.AutomationId="pwgen.lex.list">
						<ListView.View>
							<GridView>
								<GridViewColumn x:Name="collexlang" Header="语言" Width="100"
								                DisplayMemberBinding="{Binding Lang}"/>
								<GridViewColumn x:Name="collexnat" Header="原文" Width="200"
								                DisplayMemberBinding="{Binding Native}"/>
								<GridViewColumn x:Name="collexlat" Header="拼音 / 罗马字" Width="220"
								                DisplayMemberBinding="{Binding Latin}"/>
							</GridView>
						</ListView.View>
					</ListView>
					<TextBlock x:Name="lblexstat" Grid.Row="3" Margin="0,8,0,8"
					           Foreground="{StaticResource TextMuted}"/>
					<DockPanel Grid.Row="4">
						<Button x:Name="blexcopy" Style="{StaticResource ToolBtn}"
						        AutomationProperties.AutomationId="pwgen.lex.copy"/>
						<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
							<Button x:Name="blexlat" Style="{StaticResource ToolBtn}"
							        AutomationProperties.AutomationId="pwgen.lex.latin"/>
						</StackPanel>
					</DockPanel>
				</Grid>
			</TabItem>
		</TabControl>
		<DockPanel Grid.Row="1">
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
				<Button x:Name="bclose" Style="{StaticResource ToolBtn}"
				        AutomationProperties.AutomationId="pwgen.close"/>
			</StackPanel>
		</DockPanel>
	</Grid>
</Window>
