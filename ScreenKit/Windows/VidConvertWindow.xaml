<Window x:Class="ScreenKit.VidConvertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="视频批量转换"
        Width="920" Height="640"
        MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BgApp}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        AllowDrop="True"
        AutomationProperties.AutomationId="vidconv.window">
	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<Grid Grid.Row="0" Margin="0,0,0,10">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" MinWidth="72"/>
				<ColumnDefinition Width="180"/>
				<ColumnDefinition Width="16"/>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="72"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>
			<TextBlock x:Name="lbfmt" Grid.Column="0" Text="目标格式" FontWeight="SemiBold"
			           VerticalAlignment="Center" Margin="0,0,8,0"/>
			<ComboBox x:Name="efmt" Grid.Column="1" Height="32"
			          VerticalContentAlignment="Center"
			          AutomationProperties.AutomationId="vidconv.fmt">
				<ComboBoxItem Content="MP4" Tag="mp4" IsSelected="True"/>
				<ComboBoxItem Content="MKV" Tag="mkv"/>
				<ComboBoxItem Content="WebM" Tag="webm"/>
			</ComboBox>
			<TextBlock x:Name="lbcrf" Grid.Column="3" Text="CRF"
			           FontSize="12" Foreground="{StaticResource TextMuted}"
			           VerticalAlignment="Center" Margin="0,0,8,0"/>
			<TextBox x:Name="ecrf" Grid.Column="4" Height="30" Padding="6,4" Text="23"
			         BorderBrush="{StaticResource BorderSoft}"
			         VerticalContentAlignment="Center"
			         ToolTip="越小越清晰、体积越大。H.264 为 0–51，WebM 为 0–63"
			         AutomationProperties.AutomationId="vidconv.crf"/>
		</Grid>

		<StackPanel Grid.Row="1" Margin="0,0,0,10">
			<CheckBox x:Name="eshorten" Content="限制较短边（超过则等比缩小，不放大）"
			          Margin="0,0,0,8" IsChecked="False"
			          AutomationProperties.AutomationId="vidconv.short"/>
			<StackPanel Orientation="Horizontal"
			            IsEnabled="{Binding ElementName=eshorten, Path=IsChecked}">
				<TextBlock x:Name="lbshort" Text="较短边" FontSize="12"
				           Foreground="{StaticResource TextMuted}"
				           VerticalAlignment="Center" Margin="0,0,8,0"/>
				<TextBox x:Name="eshort" Width="88" Height="30" Padding="6,4" Text="1080"
				         BorderBrush="{StaticResource BorderSoft}" VerticalContentAlignment="Center"
				         AutomationProperties.AutomationId="vidconv.shortpx"/>
			</StackPanel>
			<CheckBox x:Name="eaudio" Content="保留声音" Margin="0,8,0,0" IsChecked="True"
			          AutomationProperties.AutomationId="vidconv.audio"/>
		</StackPanel>

		<StackPanel Grid.Row="2" Margin="0,0,0,10">
			<TextBlock x:Name="lbout" Text="输出目录" FontWeight="SemiBold" Margin="0,0,0,8"/>
			<WrapPanel>
				<RadioButton x:Name="routsrc" GroupName="VidConvOut" Content="每个源文件旁的 output/"
				             Margin="0,0,16,6" IsChecked="True"
				             AutomationProperties.AutomationId="vidconv.outsrc"/>
				<RadioButton x:Name="routother" GroupName="VidConvOut" Content="其它目录"
				             Margin="0,0,16,6"
				             AutomationProperties.AutomationId="vidconv.outother"/>
				<RadioButton x:Name="routrep" GroupName="VidConvOut" Content="替换源文件（永久删除）"
				             Margin="0,0,16,6"
				             AutomationProperties.AutomationId="vidconv.outreplace"/>
				<RadioButton x:Name="routrecycle" GroupName="VidConvOut" Content="替换源文件（回收站）"
				             Margin="0,0,16,6"
				             AutomationProperties.AutomationId="vidconv.outrecycle"/>
			</WrapPanel>
			<DockPanel Margin="0,4,0,0">
				<Button x:Name="bbrowse" DockPanel.Dock="Right" Height="30" Margin="8,0,0,0" Padding="10,0"
				        AutomationProperties.AutomationId="vidconv.browse"/>
				<TextBox x:Name="eoutdir" Height="30" Padding="6,4"
				         BorderBrush="{StaticResource BorderSoft}" VerticalContentAlignment="Center"
				         AutomationProperties.AutomationId="vidconv.outdir"/>
			</DockPanel>
		</StackPanel>

		<DockPanel Grid.Row="3" Margin="0,0,0,8" LastChildFill="False">
			<Button x:Name="badd" Height="30" Margin="0,0,8,0" Padding="10,0"
			        AutomationProperties.AutomationId="vidconv.add"/>
			<Button x:Name="bremove" Height="30" Margin="0,0,8,0" Padding="10,0"
			        AutomationProperties.AutomationId="vidconv.remove"/>
			<Button x:Name="bclear" Height="30" Padding="10,0"
			        AutomationProperties.AutomationId="vidconv.clear"/>
			<TextBlock x:Name="lbcount" Text="0 个文件" VerticalAlignment="Center" Margin="12,0,0,0"
			           Foreground="{StaticResource TextMuted}"/>
		</DockPanel>

		<Border Grid.Row="4" Background="{StaticResource BgPanel}"
		        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="8">
			<Grid>
				<ListView x:Name="lv" BorderThickness="0" Background="Transparent"
				          AllowDrop="True"
				          AutomationProperties.AutomationId="vidconv.list">
					<ListView.View>
						<GridView>
							<GridViewColumn x:Name="colname" Header="文件" Width="520"
							                DisplayMemberBinding="{Binding FileName}"/>
							<GridViewColumn x:Name="colst" Header="状态" Width="280"
							                DisplayMemberBinding="{Binding Status}"/>
						</GridView>
					</ListView.View>
				</ListView>
				<TextBlock x:Name="lbdrop" Text="拖入视频或文件夹"
				           FontSize="15" FontWeight="SemiBold"
				           Foreground="{StaticResource TextMuted}"
				           HorizontalAlignment="Center" VerticalAlignment="Center"
				           IsHitTestVisible="False"/>
			</Grid>
		</Border>

		<DockPanel Grid.Row="5" Margin="0,12,0,0" LastChildFill="False">
			<Button x:Name="bgo" Height="32" Padding="14,0" Margin="0,0,8,0" IsDefault="True"
			        AutomationProperties.AutomationId="vidconv.go"/>
			<Button x:Name="bcancel" Height="32" Padding="14,0" Margin="0,0,8,0" Visibility="Collapsed"
			        AutomationProperties.AutomationId="vidconv.cancel"/>
			<Button x:Name="bclose" Height="32" Padding="14,0"
			        AutomationProperties.AutomationId="vidconv.close"/>
			<TextBlock x:Name="lbmsg" VerticalAlignment="Center" Margin="12,0,0,0"
			           Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis"/>
		</DockPanel>
	</Grid>
</Window>
