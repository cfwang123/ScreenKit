<Window x:Class="ScreenKit.UdpDebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TCP/UDP/串口 调试"
        Width="860" Height="640"
        MinWidth="700" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BgApp}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        AutomationProperties.AutomationId="udpdbg.window">
	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="140"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
		<DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
			<RadioButton x:Name="rudp" Content="UDP" GroupName="sockproto" IsChecked="True"
			             VerticalAlignment="Center" Margin="0,0,10,0"
			             AutomationProperties.AutomationId="udpdbg.proto.udp"/>
			<RadioButton x:Name="rtcp" Content="TCP" GroupName="sockproto"
			             VerticalAlignment="Center" Margin="0,0,10,0"
			             AutomationProperties.AutomationId="udpdbg.proto.tcp"/>
			<RadioButton x:Name="rcom" Content="串口" GroupName="sockproto"
			             VerticalAlignment="Center" Margin="0,0,14,0"
			             AutomationProperties.AutomationId="udpdbg.proto.com"/>
			<CheckBox x:Name="chexshow" Content="hex 显示" VerticalAlignment="Center" Margin="0,0,12,0"
			          AutomationProperties.AutomationId="udpdbg.hexshow"/>
			<TextBlock x:Name="lbenc" Text="编码" VerticalAlignment="Center" Margin="0,0,6,0"/>
			<ComboBox x:Name="eenc" Width="110" Height="28" Margin="0,0,12,0"
			          VerticalContentAlignment="Center"
			          AutomationProperties.AutomationId="udpdbg.enc"/>
			<CheckBox x:Name="cscroll" Content="自动滚动" VerticalAlignment="Center" Margin="0,0,12,0"
			          IsChecked="True"
			          AutomationProperties.AutomationId="udpdbg.scroll"/>
			<Button x:Name="bclear" Style="{StaticResource ToolBtnSm}"
			        AutomationProperties.AutomationId="udpdbg.clear"/>
		</DockPanel>
		<TextBox x:Name="elog" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
		         FontFamily="Consolas, Microsoft YaHei UI" FontSize="13"
		         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
		         BorderBrush="{StaticResource BorderSoft}" Padding="8"
		         AutomationProperties.AutomationId="udpdbg.log"/>
		<Grid x:Name="netrow" Grid.Row="2" Margin="0,10,0,0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="150"/>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="90"/>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="90"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>
			<TextBlock x:Name="lbpeer" Text="对方 ip" VerticalAlignment="Center" Margin="0,0,6,0"/>
			<TextBox x:Name="epeer" Grid.Column="1" Height="30" Padding="6,2" Margin="0,0,10,0"
			         BorderBrush="{StaticResource BorderSoft}" VerticalContentAlignment="Center"
			         AutomationProperties.AutomationId="udpdbg.peer"/>
			<TextBlock x:Name="lbpeerport" Grid.Column="2" Text="端口" VerticalAlignment="Center" Margin="0,0,6,0"/>
			<TextBox x:Name="epeerport" Grid.Column="3" Height="30" Padding="6,2" Margin="0,0,10,0"
			         BorderBrush="{StaticResource BorderSoft}" VerticalContentAlignment="Center"
			         AutomationProperties.AutomationId="udpdbg.peerport"/>
			<TextBlock x:Name="lblocal" Grid.Column="4" Text="本机端口" VerticalAlignment="Center" Margin="0,0,6,0"/>
			<TextBox x:Name="elocal" Grid.Column="5" Height="30" Padding="6,2" Margin="0,0,10,0"
			         BorderBrush="{StaticResource BorderSoft}" VerticalContentAlignment="Center"
			         AutomationProperties.AutomationId="udpdbg.local"/>
			<Button x:Name="blisten" Grid.Column="7" Style="{StaticResource ToolBtn}"
			        AutomationProperties.AutomationId="udpdbg.listen"/>
		</Grid>
		<DockPanel x:Name="comrow" Grid.Row="3" Margin="0,10,0,0" LastChildFill="False" Visibility="Collapsed">
			<TextBlock x:Name="lbport" Text="端口" VerticalAlignment="Center" Margin="0,0,6,0"/>
			<ComboBox x:Name="eport" Width="110" Height="30" Margin="0,0,8,0"
			          VerticalContentAlignment="Center" IsEditable="True"
			          AutomationProperties.AutomationId="udpdbg.com.port"/>
			<Button x:Name="brefresh" Style="{StaticResource ToolBtnSm}" Margin="0,0,12,0"
			        AutomationProperties.AutomationId="udpdbg.com.refresh"/>
			<TextBlock x:Name="lbbaud" Text="波特率" VerticalAlignment="Center" Margin="0,0,6,0"/>
			<ComboBox x:Name="ebaud" Width="100" Height="30" Margin="0,0,10,0"
			          VerticalContentAlignment="Center" IsEditable="True"
			          AutomationProperties.AutomationId="udpdbg.com.baud"/>
			<TextBlock x:Name="lbdata" Text="数据位" VerticalAlignment="Center" Margin="0,0,6,0"/>
			<ComboBox x:Name="edata" Width="64" Height="30" Margin="0,0,10,0"
			          VerticalContentAlignment="Center"
			          AutomationProperties.AutomationId="udpdbg.com.data"/>
			<TextBlock x:Name="lbparity" Text="校验" VerticalAlignment="Center" Margin="0,0,6,0"/>
			<ComboBox x:Name="eparity" Width="80" Height="30" Margin="0,0,10,0"
			          VerticalContentAlignment="Center"
			          AutomationProperties.AutomationId="udpdbg.com.parity"/>
			<TextBlock x:Name="lbstop" Text="停止位" VerticalAlignment="Center" Margin="0,0,6,0"/>
			<ComboBox x:Name="estop" Width="64" Height="30"
			          VerticalContentAlignment="Center"
			          AutomationProperties.AutomationId="udpdbg.com.stop"/>
		</DockPanel>
		<DockPanel Grid.Row="4" Margin="0,8,0,0" LastChildFill="False">
			<CheckBox x:Name="chexsend" Content="hex 发送" VerticalAlignment="Center" Margin="0,0,14,0"
			          AutomationProperties.AutomationId="udpdbg.hexsend"/>
			<CheckBox x:Name="ctimer" Content="定时" VerticalAlignment="Center" Margin="0,0,6,0"
			          AutomationProperties.AutomationId="udpdbg.timer"/>
			<TextBox x:Name="einterval" Width="70" Height="28" Padding="6,2" Margin="0,0,4,0"
			         Text="1000" BorderBrush="{StaticResource BorderSoft}"
			         VerticalContentAlignment="Center"
			         AutomationProperties.AutomationId="udpdbg.interval"/>
			<TextBlock x:Name="lbms" Text="ms" VerticalAlignment="Center" Margin="0,0,14,0"/>
			<CheckBox x:Name="creply" Content="自动回复" VerticalAlignment="Center" Margin="0,0,14,0"
			          AutomationProperties.AutomationId="udpdbg.reply"/>
			<Button x:Name="bsend" Style="{StaticResource ToolBtn}" Margin="0,0,8,0"
			        AutomationProperties.AutomationId="udpdbg.send"/>
			<Button x:Name="bconnect" Style="{StaticResource ToolBtn}"
			        AutomationProperties.AutomationId="udpdbg.connect"/>
			<Button x:Name="bopen" Style="{StaticResource ToolBtn}" Visibility="Collapsed"
			        AutomationProperties.AutomationId="udpdbg.com.open"/>
		</DockPanel>
		<TextBox x:Name="epayload" Grid.Row="5" Margin="0,8,0,0" AcceptsReturn="True"
		         FontFamily="Consolas, Microsoft YaHei UI" FontSize="13"
		         VerticalScrollBarVisibility="Auto"
		         BorderBrush="{StaticResource BorderSoft}" Padding="8"
		         AutomationProperties.AutomationId="udpdbg.payload"/>
		<TextBlock x:Name="lbstat" Grid.Row="6" Margin="0,8,0,0" FontSize="12"
		           Foreground="{StaticResource TextMuted}"
		           AutomationProperties.AutomationId="udpdbg.stat"/>
	</Grid>
</Window>
