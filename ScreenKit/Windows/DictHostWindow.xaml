<Window x:Class="ScreenKit.DictHostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScreenKit"
        Title="词典"
        Height="680" Width="960"
        MinHeight="420" MinWidth="640"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        ResizeMode="CanResize"
        Background="{StaticResource BgApp}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        AutomationProperties.AutomationId="dict.host">
	<local:DictWindow x:Name="host"/>
</Window>
