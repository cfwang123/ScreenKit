<Window x:Class="ScreenKit.ImeSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入法设置"
        Height="560" Width="580"
        MinHeight="420" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource BgApp}"
        FontFamily="Segoe UI, Microsoft YaHei UI">
	<Grid Margin="16,16,16,12">
		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="12,10,8,10">
			<StackPanel>
				<TextBlock x:Name="lbneeddb" FontSize="11" Foreground="{StaticResource Danger}"
				           TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"/>

				<TextBlock x:Name="lbimelangs" FontSize="11" Foreground="{StaticResource TextMuted}"
				           Margin="0,0,0,6" TextWrapping="Wrap"
				           Text="启用的输入法。取消勾选的语言不进切换循环，快捷键也不切过去"/>
				<StackPanel Orientation="Horizontal" Margin="0,0,0,12">
					<CheckBox x:Name="cbimewubi" Margin="0,0,18,0" Content="五笔"
					          AutomationProperties.AutomationId="set.ime.lang.wubi"/>
					<CheckBox x:Name="cbimeja" Margin="0,0,18,0" Content="日语"
					          AutomationProperties.AutomationId="set.ime.lang.ja"/>
					<CheckBox x:Name="cbimeko" Content="韩语"
					          AutomationProperties.AutomationId="set.ime.lang.ko"/>
				</StackPanel>

				<TextBlock x:Name="lbhkhintImeCycle" FontSize="11" Foreground="{StaticResource TextMuted}"
				           Margin="0,0,0,4" TextWrapping="Wrap"
				           Text="切换语言 · 五笔、日语、韩语，然后再到关闭。默认 Ctrl+`"/>
				<DockPanel Margin="0,0,0,10" LastChildFill="True">
					<Button x:Name="bimecycleclear" DockPanel.Dock="Right" Content="清空" Width="48" Height="30"
					        Style="{StaticResource ToolBtn}" Padding="4,0" Margin="4,0,0,0" ToolTip="清空（禁用）"/>
					<Button x:Name="bimecyclecap" DockPanel.Dock="Right" Content="捕获" Width="48" Height="30"
					        Style="{StaticResource ToolBtn}" Padding="4,0" ToolTip="点击后按下快捷键"/>
					<TextBox x:Name="ehotkeyimecycle" Height="30" Padding="6,4"
					         BorderBrush="{StaticResource BorderSoft}" VerticalContentAlignment="Center"
					         AutomationProperties.AutomationId="set.ime.hotkey.cycle"/>
				</DockPanel>

				<TextBlock x:Name="lbhkhintImeWubi" FontSize="11" Foreground="{StaticResource TextMuted}"
				           Margin="0,0,0,4" TextWrapping="Wrap"
				           Text="切到五笔。默认 Ctrl+Alt+1"/>
				<DockPanel Margin="0,0,0,10" LastChildFill="True">
					<Button x:Name="bimewubiclear" DockPanel.Dock="Right" Content="清空" Width="48" Height="30"
					        Style="{StaticResource ToolBtn}" Padding="4,0" Margin="4,0,0,0" ToolTip="清空（禁用）"/>
					<Button x:Name="bimewubicap" DockPanel.Dock="Right" Content="捕获" Width="48" Height="30"
					        Style="{StaticResource ToolBtn}" Padding="4,0" ToolTip="点击后按下快捷键"/>
					<TextBox x:Name="ehotkeyimewubi" Height="30" Padding="6,4"
					         BorderBrush="{StaticResource BorderSoft}" VerticalContentAlignment="Center"
					         AutomationProperties.AutomationId="set.ime.hotkey.wubi"/>
				</DockPanel>

				<TextBlock x:Name="lbhkhintImeJa" FontSize="11" Foreground="{StaticResource TextMuted}"
				           Margin="0,0,0,4" TextWrapping="Wrap"
				           Text="切到日语。默认 Ctrl+Alt+2"/>
				<DockPanel Margin="0,0,0,10" LastChildFill="True">
					<Button x:Name="bimejaclear" DockPanel.Dock="Right" Content="清空" Width="48" Height="30"
					        Style="{StaticResource ToolBtn}" Padding="4,0" Margin="4,0,0,0" ToolTip="清空（禁用）"/>
					<Button x:Name="bimejacap" DockPanel.Dock="Right" Content="捕获" Width="48" Height="30"
					        Style="{StaticResource ToolBtn}" Padding="4,0" ToolTip="点击后按下快捷键"/>
					<TextBox x:Name="ehotkeyimeja" Height="30" Padding="6,4"
					         BorderBrush="{StaticResource BorderSoft}" VerticalContentAlignment="Center"
					         AutomationProperties.AutomationId="set.ime.hotkey.ja"/>
				</DockPanel>

				<TextBlock x:Name="lbhkhintImeKo" FontSize="11" Foreground="{StaticResource TextMuted}"
				           Margin="0,0,0,4" TextWrapping="Wrap"
				           Text="切到韩语。默认 Ctrl+Alt+3"/>
				<DockPanel Margin="0,0,0,10" LastChildFill="True">
					<Button x:Name="bimekoclear" DockPanel.Dock="Right" Content="清空" Width="48" Height="30"
					        Style="{StaticResource ToolBtn}" Padding="4,0" Margin="4,0,0,0" ToolTip="清空（禁用）"/>
					<Button x:Name="bimekocap" DockPanel.Dock="Right" Content="捕获" Width="48" Height="30"
					        Style="{StaticResource ToolBtn}" Padding="4,0" ToolTip="点击后按下快捷键"/>
					<TextBox x:Name="ehotkeyimeko" Height="30" Padding="6,4"
					         BorderBrush="{StaticResource BorderSoft}" VerticalContentAlignment="Center"
					         AutomationProperties.AutomationId="set.ime.hotkey.ko"/>
				</DockPanel>

				<TextBlock x:Name="lbhkhintImeOff" FontSize="11" Foreground="{StaticResource TextMuted}"
				           Margin="0,0,0,4" TextWrapping="Wrap"
				           Text="关闭输入，按键交给当前窗口。默认 Ctrl+Alt+4"/>
				<DockPanel Margin="0,0,0,10" LastChildFill="True">
					<Button x:Name="bimeoffclear" DockPanel.Dock="Right" Content="清空" Width="48" Height="30"
					        Style="{StaticResource ToolBtn}" Padding="4,0" Margin="4,0,0,0" ToolTip="清空（禁用）"/>
					<Button x:Name="bimeoffcap" DockPanel.Dock="Right" Content="捕获" Width="48" Height="30"
					        Style="{StaticResource ToolBtn}" Padding="4,0" ToolTip="点击后按下快捷键"/>
					<TextBox x:Name="ehotkeyimeoff" Height="30" Padding="6,4"
					         BorderBrush="{StaticResource BorderSoft}" VerticalContentAlignment="Center"
					         AutomationProperties.AutomationId="set.ime.hotkey.off"/>
				</DockPanel>

				<CheckBox x:Name="cbimegvim" Margin="0,4,0,4"
				          AutomationProperties.AutomationId="set.ime.gvim"/>
				<TextBlock x:Name="lbimegvimhint" FontSize="11" Foreground="{StaticResource TextMuted}"
				           Margin="0,0,0,10" TextWrapping="Wrap"/>

				<CheckBox x:Name="cbimerare" Margin="0,4,0,4"
				          AutomationProperties.AutomationId="set.ime.rare"/>
				<TextBlock x:Name="lbimerarehint" FontSize="11" Foreground="{StaticResource TextMuted}"
				           Margin="0,0,0,10" TextWrapping="Wrap"/>
			</StackPanel>
		</ScrollViewer>

		<DockPanel Grid.Row="1" Margin="0,12,0,0" LastChildFill="False">
			<Button x:Name="bdict" DockPanel.Dock="Left" Style="{StaticResource ToolBtn}"
			        Padding="12,6" Content="词库…"
			        AutomationProperties.AutomationId="set.ime.dict"/>
			<Button x:Name="bcancel" Content="取消" Style="{StaticResource ToolBtn}"
			        DockPanel.Dock="Right" Width="96" Padding="12,6" Margin="8,0,0,0"
			        IsCancel="True" AutomationProperties.AutomationId="set.ime.cancel"/>
			<Button x:Name="bok" Content="确定" Style="{StaticResource PrimaryBtn}"
			        DockPanel.Dock="Right" Width="96" Padding="12,6"
			        IsDefault="True" AutomationProperties.AutomationId="set.ime.ok"/>
		</DockPanel>
	</Grid>
</Window>
