<Window x:Class="ScreenKit.UsbDevWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="USB 设备"
        Width="980" Height="640"
        MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BgApp}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        AutomationProperties.AutomationId="usb.window">
	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
		<TextBlock x:Name="lbhint" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10"
		           Foreground="{StaticResource TextMuted}" FontSize="12"/>
		<Grid Grid.Row="1" Margin="0,0,0,8">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>
			<TextBlock x:Name="lbfilter" Text="筛选" VerticalAlignment="Center" Margin="0,0,8,0"/>
			<TextBox x:Name="efilter" Grid.Column="1" Height="32" Padding="8,4" Margin="0,0,8,0"
			         BorderBrush="{StaticResource BorderSoft}"
			         VerticalContentAlignment="Center"
			         AutomationProperties.AutomationId="usb.filter"/>
			<Button x:Name="brefresh" Grid.Column="2" Style="{StaticResource ToolBtn}" Margin="0,0,6,0"
			        AutomationProperties.AutomationId="usb.refresh"/>
			<Button x:Name="bcopy" Grid.Column="3" Style="{StaticResource ToolBtn}"
			        AutomationProperties.AutomationId="usb.copy"/>
		</Grid>
		<Grid Grid.Row="2">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="1.15*" MinWidth="280"/>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="*" MinWidth="260"/>
			</Grid.ColumnDefinitions>
			<ListView x:Name="lv" BorderBrush="{StaticResource BorderSoft}"
			          SelectionMode="Single"
			          AutomationProperties.AutomationId="usb.list">
				<ListView.View>
					<GridView>
						<GridViewColumn x:Name="colname" Width="220"
						                DisplayMemberBinding="{Binding Name}"/>
						<GridViewColumn x:Name="colvid" Width="90"
						                DisplayMemberBinding="{Binding VidPid}"/>
						<GridViewColumn x:Name="colcls" Width="90"
						                DisplayMemberBinding="{Binding ClassName}"/>
						<GridViewColumn x:Name="colstatus" Width="110"
						                DisplayMemberBinding="{Binding Status}"/>
					</GridView>
				</ListView.View>
			</ListView>
			<GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
			<ListView x:Name="lvprop" Grid.Column="2" BorderBrush="{StaticResource BorderSoft}"
			          SelectionMode="Single"
			          FontFamily="Consolas, Microsoft YaHei UI"
			          AutomationProperties.AutomationId="usb.detail">
				<ListView.View>
					<GridView>
						<GridViewColumn x:Name="colprop" Width="120"
						                DisplayMemberBinding="{Binding Name}"/>
						<GridViewColumn x:Name="colval" Width="360"
						                DisplayMemberBinding="{Binding Value}"/>
					</GridView>
				</ListView.View>
			</ListView>
		</Grid>
		<DockPanel Grid.Row="3" Margin="0,10,0,0">
			<Button x:Name="bclose" Style="{StaticResource ToolBtn}" DockPanel.Dock="Right"
			        AutomationProperties.AutomationId="usb.close"/>
			<TextBlock x:Name="lbstat" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
		</DockPanel>
	</Grid>
</Window>
