<Window x:Class="ScreenKit.AsrCaptionStyleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="桌面字幕样式"
        Height="560" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgApp}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        Topmost="True"
        ShowInTaskbar="True">
	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<ScrollViewer VerticalScrollBarVisibility="Auto">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="88"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>

				<TextBlock Text="字体" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
				<ComboBox x:Name="efont" Grid.Column="1" Height="28" Margin="0,0,0,10"/>

				<TextBlock Grid.Row="1" Text="字号" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
				<StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
					<Slider x:Name="esize" Minimum="12" Maximum="72" Width="200" VerticalAlignment="Center"/>
					<TextBlock x:Name="lbsize" Width="36" Margin="8,0,0,0" VerticalAlignment="Center"/>
				</StackPanel>

				<TextBlock Grid.Row="2" Text="前景色" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
				<StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
					<Border x:Name="swfg" Width="28" Height="28" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"
					        CornerRadius="3" Cursor="Hand" ToolTip="点击选色"/>
					<TextBox x:Name="efg" Width="120" Height="28" Margin="8,0,0,0" ToolTip="#AARRGGBB"/>
					<Button x:Name="bfg" Content="HSV" Width="48" Height="28" Margin="8,0,0,0" Style="{StaticResource ToolBtnSm}"
					        ToolTip="HSV 选色（含透明度）"/>
				</StackPanel>

				<TextBlock Grid.Row="3" Text="描边色" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
				<StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
					<Border x:Name="swoutline" Width="28" Height="28" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"
					        CornerRadius="3" Cursor="Hand" ToolTip="点击选色"/>
					<TextBox x:Name="eoutline" Width="120" Height="28" Margin="8,0,0,0" ToolTip="#AARRGGBB"/>
					<Button x:Name="boutline" Content="HSV" Width="48" Height="28" Margin="8,0,0,0" Style="{StaticResource ToolBtnSm}"
					        ToolTip="HSV 选色（含透明度）"/>
				</StackPanel>

				<TextBlock Grid.Row="4" Text="背景色" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
				<StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
					<Border x:Name="swbg" Width="28" Height="28" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"
					        CornerRadius="3" Cursor="Hand" ToolTip="点击选色"/>
					<TextBox x:Name="ebg" Width="120" Height="28" Margin="8,0,0,0" ToolTip="#AARRGGBB"/>
					<Button x:Name="bbg" Content="HSV" Width="48" Height="28" Margin="8,0,0,0" Style="{StaticResource ToolBtnSm}"
					        ToolTip="HSV 选色（含透明度）"/>
				</StackPanel>

				<TextBlock Grid.Row="5" Text="边框色" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
				<StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
					<Border x:Name="swbd" Width="28" Height="28" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"
					        CornerRadius="3" Cursor="Hand" ToolTip="点击选色"/>
					<TextBox x:Name="eborder" Width="120" Height="28" Margin="8,0,0,0" ToolTip="#AARRGGBB"/>
					<Button x:Name="bborder" Content="HSV" Width="48" Height="28" Margin="8,0,0,0" Style="{StaticResource ToolBtnSm}"
					        ToolTip="HSV 选色（含透明度）"/>
				</StackPanel>

				<TextBlock Grid.Row="6" Text="边框粗细" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
				<StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
					<Slider x:Name="eborderth" Minimum="0" Maximum="8" TickFrequency="1" IsSnapToTickEnabled="True"
					        Width="200" VerticalAlignment="Center"/>
					<TextBlock x:Name="lbborderth" Width="36" Margin="8,0,0,0" VerticalAlignment="Center"/>
				</StackPanel>

				<TextBlock Grid.Row="7" Text="对齐" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
				<StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
					<RadioButton x:Name="ralignL" Content="左" GroupName="capAlign" Margin="0,0,16,0" VerticalAlignment="Center"/>
					<RadioButton x:Name="ralignC" Content="中" GroupName="capAlign" Margin="0,0,16,0" VerticalAlignment="Center"/>
					<RadioButton x:Name="ralignR" Content="右" GroupName="capAlign" VerticalAlignment="Center"/>
				</StackPanel>

				<TextBlock Grid.Row="8" Text="宽度" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
				<StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
					<TextBox x:Name="ewidth" Width="100" Height="28" VerticalAlignment="Center"/>
					<CheckBox x:Name="cautow" Content="自适应" Margin="12,0,0,0" VerticalAlignment="Center"/>
				</StackPanel>

				<TextBlock Grid.Row="9" Text="高度" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
				<StackPanel Grid.Row="9" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
					<TextBox x:Name="eheight" Width="100" Height="28" VerticalAlignment="Center"/>
					<CheckBox x:Name="cautoh" Content="自适应" Margin="12,0,0,0" VerticalAlignment="Center"/>
				</StackPanel>

				<TextBlock Grid.Row="10" Text="最大宽度" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"
				           ToolTip="自适应宽度时文本最大宽"/>
				<TextBox x:Name="emaxw" Grid.Row="10" Grid.Column="1" Height="28" Margin="0,0,0,10"/>

				<TextBlock Grid.Row="11" Grid.ColumnSpan="2" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"
				           Foreground="{StaticResource TextMuted}"
				           Text="非模态：可同时拖动桌面字幕改位置，或拖边缘/角点改大小。悬停字幕时显示边框与缩放点。"/>
			</Grid>
		</ScrollViewer>

		<StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
			<Button x:Name="bapply" Content="应用" Width="80" Height="30" Margin="0,0,8,0" Style="{StaticResource ToolBtn}"/>
			<Button x:Name="bok" Content="确定" Width="80" Height="30" Margin="0,0,8,0" IsDefault="True" Style="{StaticResource PrimaryBtn}"/>
			<Button x:Name="bcancel" Content="取消" Width="80" Height="30" IsCancel="True" Style="{StaticResource ToolBtn}"/>
		</StackPanel>
	</Grid>
</Window>
