<Window x:Class="ScreenKit.CastUsbWaitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="连接安卓USB配件"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AutomationProperties.AutomationId="cast.usbwait">
	<StackPanel Margin="24,20" MinWidth="280">
		<TextBlock x:Name="lb" Text="等待安卓USB配件中" FontSize="16" TextWrapping="Wrap"/>
		<TextBlock x:Name="lbst" Margin="0,8,0,0" FontSize="13" Opacity="0.7"/>
		<Button x:Name="bclose" Content="取消" HorizontalAlignment="Right" Margin="0,16,0,0"
		        MinWidth="72" Padding="12,4" Click="bclose_Click"
		        AutomationProperties.AutomationId="cast.usbwait.close"/>
	</StackPanel>
</Window>
