<Window x:Class="ScreenKit.PortUseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="网络端口占用"
        Width="980" Height="620"
        MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BgApp}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        AutomationProperties.AutomationId="port.window">
	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
		<TextBlock x:Name="lbhint" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10"
		           Foreground="{StaticResource TextMuted}" FontSize="12"/>
		<Grid Grid.Row="1" Margin="0,0,0,8">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>
			<TextBlock x:Name="lbfilter" Text="筛选" VerticalAlignment="Center" Margin="0,0,8,0"/>
			<TextBox x:Name="efilter" Grid.Column="1" Height="32" Padding="8,4" Margin="0,0,8,0"
			         BorderBrush="{StaticResource BorderSoft}"
			         VerticalContentAlignment="Center"
			         AutomationProperties.AutomationId="port.filter"/>
			<Button x:Name="brefresh" Grid.Column="2" Style="{StaticResource ToolBtn}"
			        AutomationProperties.AutomationId="port.refresh"/>
		</Grid>
		<ListView x:Name="lv" Grid.Row="2" BorderBrush="{StaticResource BorderSoft}"
		          SelectionMode="Single"
		          AutomationProperties.AutomationId="port.list">
			<ListView.View>
				<GridView>
					<GridViewColumn x:Name="colproto" Width="64"
					                DisplayMemberBinding="{Binding Proto}"/>
					<GridViewColumn x:Name="collocal" Width="150"
					                DisplayMemberBinding="{Binding Local}"/>
					<GridViewColumn x:Name="collport" Width="70"
					                DisplayMemberBinding="{Binding LocalPort}"/>
					<GridViewColumn x:Name="colremote" Width="150"
					                DisplayMemberBinding="{Binding Remote}"/>
					<GridViewColumn x:Name="colrport" Width="80"
					                DisplayMemberBinding="{Binding RemotePortText}"/>
					<GridViewColumn x:Name="colstate" Width="110"
					                DisplayMemberBinding="{Binding State}"/>
					<GridViewColumn x:Name="colpid" Width="70"
					                DisplayMemberBinding="{Binding Pid}"/>
					<GridViewColumn x:Name="colproc" Width="140"
					                DisplayMemberBinding="{Binding Proc}"/>
				</GridView>
			</ListView.View>
		</ListView>
		<TextBlock x:Name="lbdetail" Grid.Row="3" Margin="0,10,0,0" TextWrapping="Wrap"
		           FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"/>
		<DockPanel Grid.Row="4" Margin="0,10,0,0">
			<Button x:Name="bopen" Style="{StaticResource ToolBtn}" DockPanel.Dock="Right"
			        AutomationProperties.AutomationId="port.open"/>
			<TextBlock x:Name="lbstat" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
		</DockPanel>
	</Grid>
</Window>
