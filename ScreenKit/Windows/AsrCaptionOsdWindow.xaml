<Window x:Class="ScreenKit.AsrCaptionOsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="实时字幕"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        WindowStartupLocation="Manual"
        ShowActivated="False">
	<!-- 可拖区域；编辑/悬停时显示虚线框与缩放角点 -->
	<Grid x:Name="prootouter" MouseEnter="onrootenter" MouseLeave="onrootleave">
		<Border x:Name="proot" Background="#01000000" Cursor="SizeAll" Padding="10,8"
		        BorderBrush="Transparent" BorderThickness="0" CornerRadius="6"
		        ClipToBounds="True">
			<Grid>
				<ScrollViewer x:Name="pscroll" VerticalScrollBarVisibility="Hidden"
				              HorizontalScrollBarVisibility="Disabled"
				              CanContentScroll="False"
				              Focusable="False"
				              IsHitTestVisible="False">
					<StackPanel x:Name="plines" Orientation="Vertical"/>
				</ScrollViewer>
				<!-- 悬停/编辑时设置 -->
				<Button x:Name="bsettings" Width="28" Height="28"
				        HorizontalAlignment="Right" VerticalAlignment="Top"
				        Margin="0,-2,-2,0"
				        Visibility="Collapsed"
				        Cursor="Hand"
				        ToolTip="字幕样式设置"
				        Background="#66000000" BorderBrush="#88FFFFFF" BorderThickness="1"
				        Click="onsettings"
				        AutomationProperties.AutomationId="asr.cap.settings">
					<Button.Template>
						<ControlTemplate TargetType="Button">
							<Border x:Name="bd" Background="{TemplateBinding Background}"
							        BorderBrush="{TemplateBinding BorderBrush}"
							        BorderThickness="{TemplateBinding BorderThickness}"
							        CornerRadius="4">
								<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
							<ControlTemplate.Triggers>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter TargetName="bd" Property="Background" Value="#99000000"/>
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Button.Template>
					<TextBlock Text="⚙" FontSize="14" Foreground="White" HorizontalAlignment="Center"
					           VerticalAlignment="Center" Margin="0,-1,0,0"/>
				</Button>
			</Grid>
		</Border>

		<Rectangle x:Name="peditframe" Stroke="#FF3B82F6" StrokeThickness="2" StrokeDashArray="4 3"
		           RadiusX="4" RadiusY="4" IsHitTestVisible="False" Visibility="Collapsed"/>

		<Ellipse x:Name="gripNW" Width="10" Height="10" Fill="#FF3B82F6" Stroke="White" StrokeThickness="1"
		         HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-4,-4,0,0"
		         Cursor="SizeNWSE" Visibility="Collapsed"/>
		<Ellipse x:Name="gripNE" Width="10" Height="10" Fill="#FF3B82F6" Stroke="White" StrokeThickness="1"
		         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0"
		         Cursor="SizeNESW" Visibility="Collapsed"/>
		<Ellipse x:Name="gripSW" Width="10" Height="10" Fill="#FF3B82F6" Stroke="White" StrokeThickness="1"
		         HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-4,0,0,-4"
		         Cursor="SizeNESW" Visibility="Collapsed"/>
		<Ellipse x:Name="gripSE" Width="10" Height="10" Fill="#FF3B82F6" Stroke="White" StrokeThickness="1"
		         HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-4"
		         Cursor="SizeNWSE" Visibility="Collapsed"/>
		<Ellipse x:Name="gripN" Width="10" Height="10" Fill="#FF3B82F6" Stroke="White" StrokeThickness="1"
		         HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-4,0,0"
		         Cursor="SizeNS" Visibility="Collapsed"/>
		<Ellipse x:Name="gripS" Width="10" Height="10" Fill="#FF3B82F6" Stroke="White" StrokeThickness="1"
		         HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-4"
		         Cursor="SizeNS" Visibility="Collapsed"/>
		<Ellipse x:Name="gripW" Width="10" Height="10" Fill="#FF3B82F6" Stroke="White" StrokeThickness="1"
		         HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-4,0,0,0"
		         Cursor="SizeWE" Visibility="Collapsed"/>
		<Ellipse x:Name="gripE" Width="10" Height="10" Fill="#FF3B82F6" Stroke="White" StrokeThickness="1"
		         HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-4,0"
		         Cursor="SizeWE" Visibility="Collapsed"/>
	</Grid>
</Window>
