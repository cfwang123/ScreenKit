<Window x:Class="ScreenKit.SqlExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导出"
        Width="540"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgApp}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="13"
        AutomationProperties.AutomationId="sqlexport.window">
	<StackPanel Margin="18">
		<TextBlock x:Name="lbhint" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}"
		           FontSize="12" Margin="0,0,0,14"/>

		<TextBlock x:Name="lbscope" FontWeight="SemiBold" Margin="0,0,0,6"/>
		<ComboBox x:Name="escope" Height="30" VerticalContentAlignment="Center" Margin="0,0,0,14"
		          AutomationProperties.AutomationId="sqlexport.scope"/>

		<TextBlock x:Name="lbformat" FontWeight="SemiBold" Margin="0,0,0,6"/>
		<WrapPanel Margin="0,0,0,6">
			<RadioButton x:Name="rfmt" GroupName="fmt" Content="SQL" Margin="0,0,18,0"
			             VerticalContentAlignment="Center"
			             AutomationProperties.AutomationId="sqlexport.fmt.sql"/>
			<RadioButton x:Name="rxlsx" GroupName="fmt" Content="Excel (xlsx)" Margin="0,0,18,0"
			             VerticalContentAlignment="Center"
			             AutomationProperties.AutomationId="sqlexport.fmt.xlsx"/>
			<RadioButton x:Name="rcsv" GroupName="fmt" Content="CSV" Margin="0,0,18,0"
			             VerticalContentAlignment="Center"
			             AutomationProperties.AutomationId="sqlexport.fmt.csv"/>
			<RadioButton x:Name="rhtml" GroupName="fmt" Content="HTML"
			             VerticalContentAlignment="Center"
			             AutomationProperties.AutomationId="sqlexport.fmt.html"/>
		</WrapPanel>

		<StackPanel x:Name="psql" Margin="0,8,0,0">
			<DockPanel Margin="0,0,0,10">
				<TextBlock x:Name="lbdialect" Width="88" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
				<ComboBox x:Name="edialect" Height="30" VerticalContentAlignment="Center"
				          AutomationProperties.AutomationId="sqlexport.dialect"/>
			</DockPanel>
			<DockPanel x:Name="pver">
				<TextBlock x:Name="lbver" Width="88" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
				<ComboBox x:Name="ever" Height="30" VerticalContentAlignment="Center"
				          AutomationProperties.AutomationId="sqlexport.version"/>
			</DockPanel>
			<TextBlock x:Name="lbtip" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"
			           Foreground="{StaticResource TextMuted}"/>
			<WrapPanel Margin="0,10,0,0">
				<CheckBox x:Name="eschema" Content="建表语句" IsChecked="True" Margin="0,0,20,0"
				          AutomationProperties.AutomationId="sqlexport.schema"/>
				<CheckBox x:Name="edata" Content="数据" IsChecked="True"
				          AutomationProperties.AutomationId="sqlexport.data"/>
			</WrapPanel>
		</StackPanel>

		<TextBlock x:Name="lbtarget" FontWeight="SemiBold" Margin="0,14,0,6"/>
		<DockPanel>
			<Button x:Name="bbrowse" Style="{StaticResource ToolBtn}" DockPanel.Dock="Right" Margin="8,0,0,0"
			        AutomationProperties.AutomationId="sqlexport.browse"/>
			<TextBox x:Name="epath" Height="30" Padding="8,4" VerticalContentAlignment="Center"
			         BorderBrush="{StaticResource BorderSoft}"
			         ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
			         AutomationProperties.AutomationId="sqlexport.path"/>
		</DockPanel>

		<TextBlock x:Name="lbstat" TextWrapping="Wrap" FontSize="12" Margin="0,12,0,0"
		           Foreground="{StaticResource TextMuted}"
		           AutomationProperties.AutomationId="sqlexport.stat"/>

		<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
			<Button x:Name="bcancel" Content="取消" Style="{StaticResource ToolBtn}" Width="88" Margin="0,0,8,0"
			        IsCancel="True"/>
			<Button x:Name="bok" Content="导出" Style="{StaticResource PrimaryBtn}" Width="88" IsDefault="True"
			        AutomationProperties.AutomationId="sqlexport.ok"/>
		</StackPanel>
	</StackPanel>
</Window>
