<Window x:Class="ScreenKit.TextSyncWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文本同步"
        Height="420" Width="480"
        MinHeight="320" MinWidth="360"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgApp}"
        FontFamily="Segoe UI, Microsoft YaHei UI">
	<Grid Margin="14">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
		<TextBlock x:Name="lbhint" Text="手机发来的文本（点复制取全文）"
		           Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,0,0,8"
		           TextWrapping="Wrap"/>
		<Border Grid.Row="1" Background="{StaticResource BgPanel}" CornerRadius="8"
		        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1">
			<ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
				<ItemsControl x:Name="lstmsgs">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<DockPanel Margin="0,0,0,8" LastChildFill="True">
								<Button DockPanel.Dock="Right" Content="复制" Style="{StaticResource ToolBtn}"
								        Padding="10,4" Margin="8,0,0,0" Tag="{Binding}" Click="oncopy"
								        AutomationProperties.AutomationId="sendfile.text.copy"/>
								<TextBlock Text="{Binding Line}" TextTrimming="CharacterEllipsis"
								           VerticalAlignment="Center" FontSize="14"
								           Foreground="{StaticResource TextPrimary}"
								           ToolTip="{Binding Full}"/>
							</DockPanel>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</ScrollViewer>
		</Border>
		<DockPanel Grid.Row="2" Margin="0,10,0,0">
			<Button x:Name="bsend" DockPanel.Dock="Right" Content="发送" Style="{StaticResource PrimaryBtn}"
			        Width="88" Margin="8,0,0,0" IsDefault="True"
			        AutomationProperties.AutomationId="sendfile.text.send"/>
			<TextBox x:Name="esend" Height="64" AcceptsReturn="True" TextWrapping="Wrap"
			         VerticalScrollBarVisibility="Auto" Padding="8,6"
			         BorderBrush="{StaticResource BorderSoft}"
			         AutomationProperties.AutomationId="sendfile.text.input"/>
		</DockPanel>
	</Grid>
</Window>
