<Window x:Class="ScreenKit.PdfOcrWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PDF 识别工作台"
        Height="780" Width="1280"
        MinHeight="560" MinWidth="960"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgApp}"
        FontFamily="Segoe UI, Microsoft YaHei UI">
	<Grid Margin="12">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- 工具栏 -->
		<Border Grid.Row="0" Background="{StaticResource BgPanel}" CornerRadius="10"
		        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" Padding="10,8" Margin="0,0,0,10">
			<DockPanel>
				<StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
					<Button x:Name="bopenpdf" Content="打开 PDF" Style="{StaticResource PrimaryBtn}" Margin="0,0,6,0"/>
					<Button x:Name="bopendraft" Content="打开草稿" Style="{StaticResource ToolBtn}"/>
					<Button x:Name="bsavedraft" Content="存草稿" Style="{StaticResource ToolBtn}"/>
					<Button x:Name="bsavedraftas" Content="草稿另存" Style="{StaticResource ToolBtn}"/>
					<Border Width="1" Background="{StaticResource BorderSoft}" Margin="6,4"/>
					<Button x:Name="brecogall" Content="全部识别" Style="{StaticResource PrimaryBtn}" Margin="0,0,6,0"/>
					<Button x:Name="brecogpage" Content="识别本页" Style="{StaticResource ToolBtn}"/>
					<TextBlock Text="页" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"
					           Margin="8,0,4,0" FontSize="12"/>
					<TextBox x:Name="epagefrom" Width="40" Height="28" Padding="4,2" Text="1"
					         VerticalContentAlignment="Center" TextAlignment="Center"
					         BorderBrush="{StaticResource BorderSoft}" ToolTip="起始页（含）"/>
					<TextBlock Text="–" VerticalAlignment="Center" Margin="4,0" Foreground="{StaticResource TextMuted}"/>
					<TextBox x:Name="epageto" Width="40" Height="28" Padding="4,2" Text="1"
					         VerticalContentAlignment="Center" TextAlignment="Center"
					         BorderBrush="{StaticResource BorderSoft}" ToolTip="结束页（含）"/>
					<Button x:Name="brecogrange" Content="范围识别" Style="{StaticResource ToolBtn}" Margin="4,0,0,0"
					        ToolTip="对指定页码范围批量识别"/>
					<Button x:Name="bcancelocr" Content="取消" Style="{StaticResource ToolBtn}" Margin="4,0,0,0"
					        Visibility="Collapsed" ToolTip="取消批量/本页识别（页间生效）"/>
					<Border Width="1" Background="{StaticResource BorderSoft}" Margin="6,4"/>
					<Button x:Name="bexport" Content="导出 PDF" Style="{StaticResource PrimaryBtn}" Margin="0,0,6,0"/>
					<Button x:Name="bcopyall" Content="复制全文" Style="{StaticResource ToolBtn}"/>
				</StackPanel>
				<StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
					<CheckBox x:Name="einvisible" Content="不可见文字层" IsChecked="True"
					          VerticalAlignment="Center" Margin="0,0,0,0"
					          ToolTip="导出时在图像下叠加可检索文字；页面尺寸按原 PDF 还原"/>
				</StackPanel>
			</DockPanel>
		</Border>

		<!-- 工程信息 -->
		<DockPanel Grid.Row="1" Margin="0,0,0,8">
			<TextBlock x:Name="lbtitle" Text="未打开工程" FontSize="15" FontWeight="SemiBold"
			           Foreground="{StaticResource TextPrimary}" DockPanel.Dock="Left"/>
			<TextBlock x:Name="lbdirty" Text="" Foreground="{StaticResource Danger}"
			           Margin="10,0,0,0" VerticalAlignment="Center"/>
		</DockPanel>

		<!-- 三栏：页列表 | 预览 | 编辑 -->
		<Grid Grid.Row="2">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="180" MinWidth="140"/>
				<ColumnDefinition Width="8"/>
				<ColumnDefinition Width="*" MinWidth="320"/>
				<ColumnDefinition Width="8"/>
				<ColumnDefinition Width="360" MinWidth="280"/>
			</Grid.ColumnDefinitions>

			<!-- 页列表 -->
			<Border Grid.Column="0" Background="{StaticResource BgPanel}" CornerRadius="10"
			        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1">
				<DockPanel>
					<TextBlock DockPanel.Dock="Top" Text="页面" FontWeight="SemiBold" Margin="12,10,12,6"
					           Foreground="{StaticResource TextPrimary}"/>
					<ListBox x:Name="lstpages" BorderThickness="0" Margin="4,0,4,8"
					         Background="Transparent"
					         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
						<ListBox.ItemTemplate>
							<DataTemplate>
								<StackPanel Margin="4,6">
									<TextBlock Text="{Binding DisplayName}" FontSize="13"
									           TextWrapping="Wrap"/>
								</StackPanel>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
				</DockPanel>
			</Border>

			<GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent"/>

			<!-- 预览：单页 + 缩放 + 翻页 -->
			<Border Grid.Column="2" Background="{StaticResource BgPanel}" CornerRadius="10"
			        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>

					<!-- 缩放工具 -->
					<DockPanel Grid.Row="0" Margin="10,8,10,6">
						<TextBlock Text="页面预览" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
						           VerticalAlignment="Center"/>
						<StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
							<TextBlock x:Name="lbpagesize" Foreground="{StaticResource TextMuted}" FontSize="12"
							           VerticalAlignment="Center" Margin="0,0,10,0" Text=""/>
							<Button x:Name="bzoomout" Content="－" Style="{StaticResource ToolBtn}" Width="32" Padding="0"
							        ToolTip="缩小" Margin="0,0,2,0"/>
							<TextBlock x:Name="lbzoom" Text="100%" Width="48" TextAlignment="Center"
							           VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" FontSize="12"/>
							<Button x:Name="bzoomin" Content="＋" Style="{StaticResource ToolBtn}" Width="32" Padding="0"
							        ToolTip="放大" Margin="0,0,4,0"/>
							<Button x:Name="bfitw" Content="适应宽度" Style="{StaticResource ToolBtn}" Padding="8,4"
							        ToolTip="按预览区宽度缩放"/>
							<Button x:Name="bzoom100" Content="100%" Style="{StaticResource ToolBtn}" Padding="8,4" Margin="0"/>
						</StackPanel>
					</DockPanel>

					<!-- 画布：图像 + 高亮框（像素坐标） -->
					<Border Grid.Row="1" Background="{StaticResource BgImage}" Margin="8,0,8,4" CornerRadius="8"
					        ClipToBounds="True" x:Name="pviewport">
						<ScrollViewer x:Name="scpreview"
						              HorizontalScrollBarVisibility="Auto"
						              VerticalScrollBarVisibility="Auto"
						              Padding="0"
						              Background="Transparent">
							<Grid x:Name="pstage" HorizontalAlignment="Left" VerticalAlignment="Top">
								<Grid.LayoutTransform>
									<ScaleTransform x:Name="tfzoom" ScaleX="1" ScaleY="1"/>
								</Grid.LayoutTransform>
								<!-- Stretch=Fill + 固定像素宽高，与 OCR 框坐标对齐 -->
								<Image x:Name="imgpage" Stretch="Fill" SnapsToDevicePixels="True"
								       RenderOptions.BitmapScalingMode="HighQuality"/>
								<Canvas x:Name="poverlay" IsHitTestVisible="False"/>
							</Grid>
						</ScrollViewer>
					</Border>

					<!-- 翻页 / 跳页 -->
					<DockPanel Grid.Row="2" Margin="10,4,10,10">
						<StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
							<Button x:Name="bprev" Content="上一页" Style="{StaticResource ToolBtn}" Margin="0,0,4,0"/>
							<Button x:Name="bnext" Content="下一页" Style="{StaticResource ToolBtn}" Margin="0,0,10,0"/>
							<TextBlock Text="第" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" Margin="0,0,4,0"/>
							<TextBox x:Name="ejumppage" Width="48" Height="28" Padding="4,2"
							         VerticalContentAlignment="Center" TextAlignment="Center"
							         BorderBrush="{StaticResource BorderSoft}" Text="1"/>
							<TextBlock x:Name="lbpagecount" Text="/ 0 页" VerticalAlignment="Center"
							           Foreground="{StaticResource TextMuted}" Margin="4,0,8,0"/>
							<Button x:Name="bjump" Content="跳转" Style="{StaticResource ToolBtn}" Padding="10,4" Margin="0"/>
						</StackPanel>
						<TextBlock x:Name="lbhlhint" DockPanel.Dock="Right" FontSize="11"
						           Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"
						           Text="点击表格行可高亮定位"/>
					</DockPanel>
				</Grid>
			</Border>

			<GridSplitter Grid.Column="3" Width="8" HorizontalAlignment="Stretch" Background="Transparent"/>

			<!-- 编辑区 -->
			<Border Grid.Column="4" Background="{StaticResource BgPanel}" CornerRadius="10"
			        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1">
				<Grid Margin="12">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="1.2*"/>
					</Grid.RowDefinitions>

					<TextBlock Grid.Row="0" Text="识别文字（可编辑）" FontWeight="SemiBold"
					           Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6"/>
					<TextBlock Grid.Row="1" FontSize="11" Foreground="{StaticResource TextMuted}"
					           TextWrapping="Wrap" Margin="0,0,0,8"
					           Text="点击一行可在左侧预览高亮。表格保持识别顺序，不可排序。"/>

					<!-- 行列表：禁止排序，保持识别顺序 -->
					<DataGrid x:Name="gridlines" Grid.Row="2"
					          AutoGenerateColumns="False"
					          CanUserAddRows="True" CanUserDeleteRows="True"
					          CanUserSortColumns="False"
					          CanUserReorderColumns="False"
					          SelectionMode="Single"
					          SelectionUnit="FullRow"
					          HeadersVisibility="Column"
					          GridLinesVisibility="Horizontal"
					          BorderBrush="{StaticResource BorderSoft}"
					          RowHeaderWidth="28"
					          FontSize="13">
						<DataGrid.Columns>
							<DataGridTextColumn Header="#" Binding="{Binding LineNo}" Width="36" IsReadOnly="True"
							                    CanUserSort="False"/>
							<DataGridTextColumn Header="文字" Binding="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
							                    Width="*" CanUserSort="False"/>
							<DataGridTextColumn Header="置信" Binding="{Binding Score, StringFormat=F2}" Width="52"
							                    IsReadOnly="True" CanUserSort="False"/>
						</DataGrid.Columns>
					</DataGrid>

					<DockPanel Grid.Row="3" Margin="0,10,0,6">
						<TextBlock Text="整页文本" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
						<Button x:Name="bapplytext" DockPanel.Dock="Right" Content="应用整页文本"
						        Style="{StaticResource GhostBtn}" Padding="8,2" Margin="0"/>
					</DockPanel>
					<TextBox x:Name="epageText" Grid.Row="4"
					         AcceptsReturn="True" TextWrapping="Wrap"
					         VerticalScrollBarVisibility="Auto"
					         FontSize="13" Padding="8"
					         BorderBrush="{StaticResource BorderSoft}"
					         FontFamily="Consolas, Microsoft YaHei UI"/>
				</Grid>
			</Border>
		</Grid>

		<!-- 状态栏 -->
		<Border Grid.Row="3" Margin="0,10,0,0" Padding="4,2">
			<DockPanel>
				<TextBlock x:Name="lbstatus" Text="打开 PDF 或草稿开始" FontSize="12"
				           Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis"/>
				<ProgressBar x:Name="prog" DockPanel.Dock="Right" Width="180" Height="8"
				             VerticalAlignment="Center" Margin="12,0,0,0"
				             Minimum="0" Maximum="100" Value="0" Visibility="Collapsed"/>
			</DockPanel>
		</Border>
	</Grid>
</Window>
