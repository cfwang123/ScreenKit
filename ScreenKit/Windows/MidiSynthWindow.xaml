<Window x:Class="ScreenKit.MidiSynthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MIDI 合成器"
        Width="980" Height="760"
        MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BgApp}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        AutomationProperties.AutomationId="midi.window">
	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
		<TextBlock x:Name="lbhint" TextWrapping="Wrap" Margin="0,0,0,8"
		           Foreground="{StaticResource TextMuted}" FontSize="12"/>
		<WrapPanel Grid.Row="1" Margin="0,0,0,8">
			<TextBlock x:Name="lbout" Text="输出" VerticalAlignment="Center" Margin="0,0,6,6"/>
			<ComboBox x:Name="eout" Width="220" Height="32" Margin="0,0,12,6"
			          VerticalContentAlignment="Center"
			          AutomationProperties.AutomationId="midi.out"/>
			<TextBlock x:Name="lbin" Text="输入" VerticalAlignment="Center" Margin="0,0,6,6"/>
			<ComboBox x:Name="ein" Width="180" Height="32" Margin="0,0,12,6"
			          VerticalContentAlignment="Center"
			          AutomationProperties.AutomationId="midi.in"/>
			<TextBlock x:Name="lbprog" Text="乐器" VerticalAlignment="Center" Margin="0,0,6,6"/>
			<ComboBox x:Name="eprog" Width="180" Height="32" Margin="0,0,12,6"
			          VerticalContentAlignment="Center"
			          AutomationProperties.AutomationId="midi.prog"/>
			<TextBlock x:Name="lbch" Text="通道" VerticalAlignment="Center" Margin="0,0,6,6"/>
			<ComboBox x:Name="ech" Width="64" Height="32" Margin="0,0,12,6"
			          VerticalContentAlignment="Center"
			          AutomationProperties.AutomationId="midi.ch"/>
			<TextBlock x:Name="lbvol" Text="音量" VerticalAlignment="Center" Margin="0,0,6,6"/>
			<Slider x:Name="evol" Width="100" Minimum="0" Maximum="127" Value="100"
			        VerticalAlignment="Center" Margin="0,0,6,6" TickFrequency="1" IsSnapToTickEnabled="True"/>
			<TextBlock x:Name="lbvolv" Text="100" Width="28" VerticalAlignment="Center" Margin="0,0,8,6"/>
			<Button x:Name="bstop" Style="{StaticResource ToolBtn}" Margin="0,0,0,6"
			        AutomationProperties.AutomationId="midi.stop"/>
		</WrapPanel>
		<DockPanel Grid.Row="2" Margin="0,0,0,8">
			<StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
				<TextBlock x:Name="lboct" Text="八度" VerticalAlignment="Center" Margin="0,0,6,0"/>
				<Button x:Name="boctdn" Style="{StaticResource ToolBtn}" Margin="0,0,4,0"/>
				<TextBlock x:Name="lboctv" Text="C4" Width="36" VerticalAlignment="Center" FontWeight="SemiBold"/>
				<Button x:Name="boctup" Style="{StaticResource ToolBtn}"/>
			</StackPanel>
			<ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
				<Canvas x:Name="ppiano" Height="150"/>
			</ScrollViewer>
		</DockPanel>
		<WrapPanel Grid.Row="3" Margin="0,0,0,8">
			<Button x:Name="bopen" Style="{StaticResource ToolBtn}" Margin="0,0,6,0"
			        AutomationProperties.AutomationId="midi.open"/>
			<Button x:Name="bsave" Style="{StaticResource ToolBtn}" Margin="0,0,6,0"
			        AutomationProperties.AutomationId="midi.save"/>
			<Button x:Name="bsaveas" Style="{StaticResource ToolBtn}" Margin="0,0,12,0"
			        AutomationProperties.AutomationId="midi.saveas"/>
			<Button x:Name="bplay" Style="{StaticResource ToolBtn}" Margin="0,0,6,0"
			        AutomationProperties.AutomationId="midi.play"/>
			<Button x:Name="bstopfile" Style="{StaticResource ToolBtn}" Margin="0,0,12,0"
			        AutomationProperties.AutomationId="midi.stopfile"/>
			<TextBlock x:Name="lbtempo" Text="速度" VerticalAlignment="Center" Margin="0,0,6,0"/>
			<TextBox x:Name="etempo" Width="64" Height="32" Padding="6,4" VerticalContentAlignment="Center"
			         BorderBrush="{StaticResource BorderSoft}"
			         AutomationProperties.AutomationId="midi.tempo"/>
		</WrapPanel>
		<WrapPanel Grid.Row="4" Margin="0,0,0,8">
			<TextBlock x:Name="lbtrack" Text="音轨" VerticalAlignment="Center" Margin="0,0,6,0"/>
			<ComboBox x:Name="etrack" Width="180" Height="32" Margin="0,0,8,0"
			          VerticalContentAlignment="Center"
			          AutomationProperties.AutomationId="midi.track"/>
			<Button x:Name="baddtr" Style="{StaticResource ToolBtn}" Margin="0,0,6,0"/>
			<Button x:Name="bdeltr" Style="{StaticResource ToolBtn}" Margin="0,0,12,0"/>
			<Button x:Name="baddn" Style="{StaticResource ToolBtn}" Margin="0,0,6,0"/>
			<Button x:Name="bdeln" Style="{StaticResource ToolBtn}"/>
		</WrapPanel>
		<ListView x:Name="lv" Grid.Row="5" BorderBrush="{StaticResource BorderSoft}"
		          SelectionMode="Single"
		          AutomationProperties.AutomationId="midi.notes">
			<ListView.View>
				<GridView>
					<GridViewColumn x:Name="colstart" Width="90" DisplayMemberBinding="{Binding Start}"/>
					<GridViewColumn x:Name="collen" Width="90" DisplayMemberBinding="{Binding Length}"/>
					<GridViewColumn x:Name="colnote" Width="70" DisplayMemberBinding="{Binding Note}"/>
					<GridViewColumn x:Name="colname" Width="80" DisplayMemberBinding="{Binding Name}"/>
					<GridViewColumn x:Name="colvel" Width="80" DisplayMemberBinding="{Binding Velocity}"/>
					<GridViewColumn x:Name="colch" Width="70" DisplayMemberBinding="{Binding Channel}"/>
				</GridView>
			</ListView.View>
		</ListView>
		<WrapPanel Grid.Row="6" Margin="0,8,0,0">
			<TextBlock x:Name="lbedstart" Text="起点" VerticalAlignment="Center" Margin="0,0,6,0"/>
			<TextBox x:Name="estart" Width="72" Height="32" Padding="6,4" Margin="0,0,8,0"
			         VerticalContentAlignment="Center" BorderBrush="{StaticResource BorderSoft}"/>
			<TextBlock x:Name="lbedlen" Text="长度" VerticalAlignment="Center" Margin="0,0,6,0"/>
			<TextBox x:Name="elen" Width="72" Height="32" Padding="6,4" Margin="0,0,8,0"
			         VerticalContentAlignment="Center" BorderBrush="{StaticResource BorderSoft}"/>
			<TextBlock x:Name="lbednote" Text="音高" VerticalAlignment="Center" Margin="0,0,6,0"/>
			<TextBox x:Name="enote" Width="56" Height="32" Padding="6,4" Margin="0,0,8,0"
			         VerticalContentAlignment="Center" BorderBrush="{StaticResource BorderSoft}"/>
			<TextBlock x:Name="lbedvel" Text="力度" VerticalAlignment="Center" Margin="0,0,6,0"/>
			<TextBox x:Name="evel" Width="56" Height="32" Padding="6,4" Margin="0,0,8,0"
			         VerticalContentAlignment="Center" BorderBrush="{StaticResource BorderSoft}"/>
			<TextBlock x:Name="lbedch" Text="通道" VerticalAlignment="Center" Margin="0,0,6,0"/>
			<TextBox x:Name="echnote" Width="48" Height="32" Padding="6,4" Margin="0,0,8,0"
			         VerticalContentAlignment="Center" BorderBrush="{StaticResource BorderSoft}"/>
			<Button x:Name="bapply" Style="{StaticResource ToolBtn}"
			        AutomationProperties.AutomationId="midi.apply"/>
		</WrapPanel>
		<TextBlock x:Name="lbstat" Grid.Row="7" Margin="0,8,0,0" TextWrapping="Wrap"
		           Foreground="{StaticResource TextMuted}" FontSize="12"/>
	</Grid>
</Window>
