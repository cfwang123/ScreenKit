<Window x:Class="ScreenKit.AnnotateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="截图标注"
        Height="720" Width="1100"
        MinHeight="480" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgApp}"
        FontFamily="Segoe UI, Microsoft YaHei UI">
	<Grid Margin="12">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- 工具栏 -->
		<Border Grid.Row="0" Background="{StaticResource BgPanel}" CornerRadius="10"
		        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" Padding="10,8" Margin="0,0,0,10">
			<DockPanel>
				<StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
					<TextBlock x:Name="lbanntools" Text="工具" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"
					           Margin="0,0,8,0" FontSize="12"/>
					<ToggleButton x:Name="trect" Content="框" Style="{StaticResource ToolToggle}"
					              ToolTip="矩形" Margin="0,0,4,0" Padding="12,6"/>
					<ToggleButton x:Name="tline" Content="线" Style="{StaticResource ToolToggle}"
					              ToolTip="直线" Margin="0,0,4,0" Padding="12,6"/>
					<ToggleButton x:Name="tarrow" Content="箭头" Style="{StaticResource ToolToggle}"
					              ToolTip="箭头" Margin="0,0,4,0" Padding="12,6"/>
					<ToggleButton x:Name="ttext" Content="文字" Style="{StaticResource ToolToggle}"
					              ToolTip="文字标注" Margin="0,0,10,0" Padding="12,6"/>
					<Border Width="1" Background="{StaticResource BorderSoft}" Margin="4,4,10,4"/>
					<TextBlock x:Name="lbanncolor" Text="颜色" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"
					           Margin="0,0,6,0" FontSize="12"/>
					<ComboBox x:Name="ecolor" Width="100" Height="30" VerticalContentAlignment="Center" Margin="0,0,10,0">
						<ComboBoxItem x:Name="itannred" Content="红" Tag="#EF4444" IsSelected="True"/>
						<ComboBoxItem x:Name="itannorange" Content="橙" Tag="#F97316"/>
						<ComboBoxItem x:Name="itannyellow" Content="黄" Tag="#EAB308"/>
						<ComboBoxItem x:Name="itanngreen" Content="绿" Tag="#22C55E"/>
						<ComboBoxItem x:Name="itannblue" Content="蓝" Tag="#3B82F6"/>
						<ComboBoxItem x:Name="itannpurple" Content="紫" Tag="#A855F7"/>
						<ComboBoxItem x:Name="itannwhite" Content="白" Tag="#FFFFFF"/>
						<ComboBoxItem x:Name="itannblack" Content="黑" Tag="#111827"/>
					</ComboBox>
					<TextBlock x:Name="lbannfontsize" Text="字号" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"
					           Margin="0,0,6,0" FontSize="12"/>
					<ComboBox x:Name="efont" Width="64" Height="30" VerticalContentAlignment="Center" Margin="0,0,10,0">
						<ComboBoxItem Content="14" Tag="14"/>
						<ComboBoxItem Content="18" Tag="18" IsSelected="True"/>
						<ComboBoxItem Content="24" Tag="24"/>
						<ComboBoxItem Content="32" Tag="32"/>
						<ComboBoxItem Content="48" Tag="48"/>
					</ComboBox>
					<TextBlock x:Name="lbannthick" Text="线宽" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"
					           Margin="0,0,6,0" FontSize="12"/>
					<ComboBox x:Name="ethick" Width="56" Height="30" VerticalContentAlignment="Center">
						<ComboBoxItem Content="2" Tag="2"/>
						<ComboBoxItem Content="3" Tag="3" IsSelected="True"/>
						<ComboBoxItem Content="5" Tag="5"/>
						<ComboBoxItem Content="8" Tag="8"/>
					</ComboBox>
					<Border Width="1" Background="{StaticResource BorderSoft}" Margin="10,4"/>
					<Button x:Name="bundo" Content="撤销" Style="{StaticResource ToolBtn}" Margin="0,0,4,0"/>
					<Button x:Name="bclear" Content="清空标注" Style="{StaticResource ToolBtn}" Margin="0"/>
				</StackPanel>
			</DockPanel>
		</Border>

		<!-- 画布 -->
		<Border Grid.Row="1" Background="{StaticResource BgImage}" CornerRadius="10"
		        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" ClipToBounds="True">
			<ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
			              Padding="12">
				<Grid x:Name="pstage" HorizontalAlignment="Left" VerticalAlignment="Top">
					<Image x:Name="imgview" Stretch="Fill" SnapsToDevicePixels="True"
					       RenderOptions.BitmapScalingMode="HighQuality"/>
					<Canvas x:Name="pdraw" Background="Transparent"/>
				</Grid>
			</ScrollViewer>
		</Border>

		<!-- 底栏 -->
		<DockPanel Grid.Row="2" Margin="0,12,0,0">
			<TextBlock x:Name="lbhint" DockPanel.Dock="Left" VerticalAlignment="Center"
			           Foreground="{StaticResource TextMuted}" FontSize="12"
			           Text="选择工具后在图上拖拽；文字工具点击后输入"/>
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
				<Button x:Name="bsave" Content="保存文件" Style="{StaticResource ToolBtn}" Width="100" Margin="0,0,8,0"/>
				<Button x:Name="bcopy" Content="复制到剪贴板" Style="{StaticResource PrimaryBtn}" Width="120" Margin="0,0,8,0"/>
				<Button x:Name="bclose" Content="关闭" Style="{StaticResource ToolBtn}" Width="88" Margin="0"/>
			</StackPanel>
		</DockPanel>
	</Grid>
</Window>
