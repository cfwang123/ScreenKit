<Window x:Class="ScreenKit.MemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="内存占用"
        Height="640" Width="860"
        MinHeight="400" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgApp}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        AutomationProperties.AutomationId="mem.window">
	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
		<TextBlock x:Name="lbhead" Grid.Row="0" Text="进程与已加载模型" FontSize="16" FontWeight="SemiBold"
		           Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
		<TextBlock x:Name="lbproc" Grid.Row="1" FontSize="14" Margin="0,0,0,6"
		           AutomationProperties.AutomationId="mem.proc"/>
		<TextBlock x:Name="lbhint" Grid.Row="2" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}"
		           Margin="0,0,0,8" AutomationProperties.AutomationId="mem.hint"/>
		<ListView x:Name="lv" Grid.Row="3" BorderBrush="{StaticResource BorderSoft}"
		          AutomationProperties.AutomationId="mem.list">
			<ListView.View>
				<GridView>
					<GridViewColumn x:Name="coleng" Header="引擎" Width="140" DisplayMemberBinding="{Binding EngineText}"/>
					<GridViewColumn x:Name="colname" Header="模型" Width="320" DisplayMemberBinding="{Binding Name}"/>
					<GridViewColumn x:Name="coldev" Header="设备" Width="100" DisplayMemberBinding="{Binding Device}"/>
					<GridViewColumn x:Name="colbytes" Header="模型文件" Width="110" DisplayMemberBinding="{Binding BytesText}"/>
				</GridView>
			</ListView.View>
		</ListView>
		<TextBlock x:Name="lbsum" Grid.Row="4" Margin="0,8,0,4" Foreground="{StaticResource TextMuted}"
		           AutomationProperties.AutomationId="mem.sum"/>
		<WrapPanel Grid.Row="5" Margin="0,4,0,8">
			<TextBlock x:Name="lbort" Text="ONNX 运行库" VerticalAlignment="Center" Margin="0,0,8,8"
			           Foreground="{StaticResource TextPrimary}"/>
			<Button x:Name="bortcpu" Content="卸载 CPU" Style="{StaticResource ToolBtn}"
			        Margin="0,0,8,8" Padding="10,4" AutomationProperties.AutomationId="mem.ort.cpu"/>
			<Button x:Name="bortcuda" Content="卸载 CUDA" Style="{StaticResource ToolBtn}"
			        Margin="0,0,8,8" Padding="10,4" AutomationProperties.AutomationId="mem.ort.cuda"/>
			<Button x:Name="bortdml" Content="卸载 DirectML" Style="{StaticResource ToolBtn}"
			        Margin="0,0,8,8" Padding="10,4" AutomationProperties.AutomationId="mem.ort.dml"/>
		</WrapPanel>
		<DockPanel Grid.Row="6">
			<Button x:Name="bclose" DockPanel.Dock="Right" Content="关闭" Style="{StaticResource PrimaryBtn}"
			        Width="88" IsCancel="True"/>
			<Button x:Name="bunload" DockPanel.Dock="Right" Content="卸载" Style="{StaticResource ToolBtn}"
			        Width="88" Margin="0,0,8,0" AutomationProperties.AutomationId="mem.unload"/>
			<Button x:Name="brefresh" DockPanel.Dock="Right" Content="刷新" Style="{StaticResource ToolBtn}"
			        Width="88" Margin="0,0,8,0" AutomationProperties.AutomationId="mem.refresh"/>
		</DockPanel>
	</Grid>
</Window>
