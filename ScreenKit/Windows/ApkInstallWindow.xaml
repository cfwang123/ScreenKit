<Window x:Class="ScreenKit.ApkInstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="安装到手机"
        Width="440"
        MinWidth="400" MinHeight="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BgApp}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        AutomationProperties.AutomationId="apk.window">
	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<TextBlock x:Name="lbtitle" Grid.Row="0" FontSize="16" FontWeight="SemiBold"
		           Foreground="{StaticResource TextPrimary}"
		           Text="安装到手机" Margin="0,0,0,8"
		           AutomationProperties.AutomationId="apk.title"/>

		<TextBlock x:Name="lbstatus" Grid.Row="1" FontSize="13"
		           Foreground="{StaticResource TextMuted}"
		           TextWrapping="Wrap" Text="正在获取最新版本…" Margin="0,0,0,12"
		           AutomationProperties.AutomationId="apk.status"/>

		<Border Grid.Row="2" Width="248" Height="248" HorizontalAlignment="Center"
		        Background="White" CornerRadius="8"
		        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"
		        Margin="0,0,0,12">
			<Image x:Name="iqr" Stretch="Uniform" Margin="8"
			       RenderOptions.BitmapScalingMode="NearestNeighbor"
			       AutomationProperties.AutomationId="apk.qr"/>
		</Border>

		<TextBox x:Name="eurl" Grid.Row="3" IsReadOnly="True" TextWrapping="Wrap"
		         AcceptsReturn="True" BorderBrush="{StaticResource BorderSoft}"
		         Padding="8,6" FontSize="12" MinHeight="52" MaxHeight="88"
		         VerticalScrollBarVisibility="Auto"
		         IsReadOnlyCaretVisible="True"
		         IsInactiveSelectionHighlightEnabled="True"
		         AutomationProperties.AutomationId="apk.url"/>

		<TextBlock x:Name="lbhint" Grid.Row="4" FontSize="12" Margin="0,8,0,12"
		           Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
		           Text="用手机浏览器扫描二维码下载 APK，允许未知来源后安装。"/>

		<DockPanel Grid.Row="5" LastChildFill="False">
			<Button x:Name="bclose" DockPanel.Dock="Right" Content="关闭"
			        Style="{StaticResource PrimaryBtn}" Width="88" Height="32"
			        IsCancel="True" IsDefault="True"
			        AutomationProperties.AutomationId="apk.close"/>
			<Button x:Name="bopen" DockPanel.Dock="Left" Content="打开下载"
			        Style="{StaticResource ToolBtn}" Height="32" Padding="12,2"
			        Margin="0,0,8,0" IsEnabled="False"
			        AutomationProperties.AutomationId="apk.open"/>
			<Button x:Name="bcopy" DockPanel.Dock="Left" Content="复制链接"
			        Style="{StaticResource ToolBtn}" Height="32" Padding="12,2"
			        IsEnabled="False"
			        AutomationProperties.AutomationId="apk.copy"/>
		</DockPanel>
	</Grid>
</Window>
