<Window x:Class="ScreenKit.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="媒体播放器"
        Width="1280" Height="720"
        MinWidth="420" MinHeight="240"
        WindowStyle="None"
        Background="#FF0B0E11"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        AllowDrop="True"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        UseLayoutRounding="True"
        AutomationProperties.AutomationId="player.window">
	<Window.Resources>
		<Style x:Key="tbBtn" TargetType="Button">
			<Setter Property="Background" Value="#22FFFFFF"/>
			<Setter Property="Foreground" Value="#FFE8EDF0"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding" Value="10,4"/>
			<Setter Property="Margin" Value="2,0"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4"
						        Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bd" Property="Background" Value="#44FFFFFF"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="bd" Property="Background" Value="#66FFFFFF"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<Style x:Key="flatSlider" TargetType="Slider">
			<Setter Property="Height" Value="18"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
	</Window.Resources>
	<Grid x:Name="proot" Background="#FF0B0E11">
		<Grid.RowDefinitions>
			<RowDefinition x:Name="rowHead" Height="28"/>
			<RowDefinition Height="*"/>
			<RowDefinition x:Name="rowBar" Height="72"/>
			<RowDefinition x:Name="rowList" Height="0"/>
		</Grid.RowDefinitions>

		<!-- 标题栏 -->
		<Border x:Name="phead" Grid.Row="0" Background="#FF15191D" MouseLeftButtonDown="headdown">
			<Grid>
				<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
					<TextBlock x:Name="lbhead" Text="媒体播放器" Foreground="#FFB9C6CE" FontSize="12"
					           VerticalAlignment="Center"/>
				</StackPanel>
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
				            Margin="0,0,6,0">
					<Button x:Name="bfile" Style="{StaticResource tbBtn}" Content="打开" ToolTip="打开文件"/>
					<Button x:Name="bmode" Style="{StaticResource tbBtn}" Content="大窗口" ToolTip="切换窗口形态"/>
					<Button x:Name="btop" Style="{StaticResource tbBtn}" Content="置顶" ToolTip="窗口固定在前"/>
					<Button x:Name="bmin" Style="{StaticResource tbBtn}" Content="—" ToolTip="最小化"/>
					<Button x:Name="bclose" Style="{StaticResource tbBtn}" Content="✕" ToolTip="关闭"/>
				</StackPanel>
			</Grid>
		</Border>

		<!-- 画面与字幕 -->
		<Grid Grid.Row="1" x:Name="pstage" Background="#FF000000"
		      MouseLeftButtonDown="stagedown" MouseLeftButtonUp="stageup"
		      MouseMove="stagemove" MouseWheel="stagewheel">
			<Image x:Name="imgvideo" Stretch="Uniform" SnapsToDevicePixels="True"
			       RenderOptions.BitmapScalingMode="HighQuality"/>
			<Grid x:Name="ptext" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
			      IsHitTestVisible="False"/>
			<TextBlock x:Name="lbempty" Text="把文件或文件夹拖到这里" Foreground="#FF56636B"
			           FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
			           IsHitTestVisible="False"/>
			<Border x:Name="phud" Background="#99000000" CornerRadius="6" Padding="10,5"
			        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,12,0,0"
			        Visibility="Collapsed" IsHitTestVisible="False">
				<TextBlock x:Name="lbhud" Foreground="White" FontSize="12"/>
			</Border>
		</Grid>

		<!-- 底部控制条 -->
		<Border Grid.Row="2" x:Name="pbar" Background="#FF15191D">
			<Grid Margin="10,4">
				<Grid.RowDefinitions>
					<RowDefinition Height="18"/>
					<RowDefinition Height="*"/>
				</Grid.RowDefinitions>
				<Grid Grid.Row="0">
					<Slider x:Name="sseek" Style="{StaticResource flatSlider}" Minimum="0" Maximum="1"
					        IsMoveToPointEnabled="True" Thumb.DragStarted="seekstart"
					        Thumb.DragCompleted="seekdone" ValueChanged="seekchanged"/>
				</Grid>
				<Grid Grid.Row="1">
					<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
						<Button x:Name="bplay" Style="{StaticResource tbBtn}" Content="▶" ToolTip="播放/暂停 (空格)"/>
						<Button x:Name="bprev" Style="{StaticResource tbBtn}" Content="⏮" ToolTip="上一首"/>
						<Button x:Name="bnext" Style="{StaticResource tbBtn}" Content="⏭" ToolTip="下一首"/>
						<TextBlock x:Name="lbtime" Text="00:00 / 00:00" Foreground="#FFB9C6CE" FontSize="12"
						           VerticalAlignment="Center" Margin="10,0,0,0"/>
						<Button x:Name="bloop" Style="{StaticResource tbBtn}" Content="顺序" ToolTip="播放模式"
						        Margin="10,0,0,0"/>
						<Button x:Name="bsub" Style="{StaticResource tbBtn}" Content="字幕" ToolTip="字幕开关 (S)"/>
						<Button x:Name="bsubopen" Style="{StaticResource tbBtn}" Content="…" ToolTip="打开字幕/歌词文件"/>
					</StackPanel>
					<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
						<Button x:Name="bmute" Style="{StaticResource tbBtn}" Content="🔊" ToolTip="静音 (M)"/>
						<Slider x:Name="svol" Style="{StaticResource flatSlider}" Width="90" Minimum="0"
						        Maximum="1" Value="0.8" Margin="4,0"/>
					</StackPanel>
				</Grid>
			</Grid>
		</Border>

		<!-- 播放列表与查词面板 -->
		<Grid Grid.Row="3" x:Name="ppanel" Background="#FF11151A">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="320"/>
			</Grid.ColumnDefinitions>
			<DockPanel Grid.Column="0">
				<StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,6">
					<Button x:Name="baddfile" Style="{StaticResource tbBtn}" Content="添加文件"/>
					<Button x:Name="badddir" Style="{StaticResource tbBtn}" Content="添加目录"/>
					<Button x:Name="bclearlist" Style="{StaticResource tbBtn}" Content="清空"/>
					<Button x:Name="bdropmiss" Style="{StaticResource tbBtn}" Content="清理失效"/>
					<TextBlock x:Name="lblistcount" Text="0 项" Foreground="#FF7E9098" FontSize="12"
					           VerticalAlignment="Center" Margin="10,0,0,0"/>
				</StackPanel>
				<ListBox x:Name="lblist" Background="Transparent" Foreground="#FFE8EDF0"
				         BorderThickness="0" Margin="4,0,4,4"
				         VirtualizingStackPanel.IsVirtualizing="True"
				         VirtualizingStackPanel.VirtualizationMode="Recycling"
				         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
				         MouseDoubleClick="listdouble">
					<ListBox.ItemContainerStyle>
						<Style TargetType="ListBoxItem">
							<Setter Property="Padding" Value="6,3"/>
							<Setter Property="Foreground" Value="#FFE8EDF0"/>
						</Style>
					</ListBox.ItemContainerStyle>
					<ListBox.ItemTemplate>
						<DataTemplate>
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="Auto"/>
								</Grid.ColumnDefinitions>
								<TextBlock Grid.Column="0" Text="{Binding Display}" TextTrimming="CharacterEllipsis"/>
								<TextBlock Grid.Column="1" Text="{Binding DurText}" Foreground="#FF7E9098"
								           FontSize="11" Margin="8,0,0,0"/>
							</Grid>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</DockPanel>
			<Border Grid.Column="1" BorderBrush="#FF1F262C" BorderThickness="1,0,0,0">
				<DockPanel>
					<StackPanel DockPanel.Dock="Top" Margin="8,6">
						<TextBox x:Name="edictq" FontSize="16" Padding="6,3" Background="#FF1B2229"
						         Foreground="#FFE8EDF0" BorderThickness="0"
						         TextChanged="dictqchanged"/>
						<TextBlock x:Name="lbouthint" Text="点字幕或歌词里的字，这里显示释义"
						           Foreground="#FF7E9098" FontSize="11" Margin="0,4,0,0"
						           TextWrapping="Wrap"/>
					</StackPanel>
					<ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8,0,8,8">
						<TextBlock x:Name="lbout" Foreground="#FFDCE4E9" FontSize="13"
						           TextWrapping="Wrap" LineHeight="20"/>
					</ScrollViewer>
				</DockPanel>
			</Border>
		</Grid>
	</Grid>
</Window>
