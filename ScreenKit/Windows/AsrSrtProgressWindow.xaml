<Window x:Class="ScreenKit.AsrSrtProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="正在生成字幕"
        Width="480" Height="280"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BgApp}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        Closing="onclosing">
	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<TextBlock x:Name="lbphase" Grid.Row="0" FontSize="15" FontWeight="SemiBold"
		           Foreground="{StaticResource TextPrimary}"
		           Text="正在准备识别引擎…" TextWrapping="Wrap" Margin="0,0,0,10"/>

		<ProgressBar x:Name="pbar" Grid.Row="1" Height="10" Minimum="0" Maximum="100"
		             Value="0" Margin="0,0,0,6"/>

		<DockPanel Grid.Row="2" Margin="0,0,0,10">
			<TextBlock x:Name="lbpct" DockPanel.Dock="Right" FontSize="12"
			           Foreground="{StaticResource TextMuted}" Text="0%"/>
			<TextBlock x:Name="lbpos" FontSize="12" Foreground="{StaticResource TextMuted}"
			           Text="进度 00:00:00,000 / 00:00:00,000"/>
		</DockPanel>

		<StackPanel Grid.Row="3" VerticalAlignment="Top">
			<TextBlock x:Name="lbdetail" FontSize="12" LineHeight="20"
			           Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>
			<TextBlock x:Name="lblatest" FontSize="13" Margin="0,10,0,0" LineHeight="20"
			           Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap"
			           Text="最新：—"/>
		</StackPanel>

		<Button x:Name="bcancel" Grid.Row="4" Content="取消" Width="100" Height="32"
		        HorizontalAlignment="Right" Style="{StaticResource ToolBtn}"
		        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"
		        Click="oncancel" Margin="0,12,0,0" IsCancel="True"/>
	</Grid>
</Window>
