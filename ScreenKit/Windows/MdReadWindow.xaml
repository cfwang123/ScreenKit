<Window x:Class="ScreenKit.MdReadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="文档阅读器"
        Width="1040" Height="760"
        MinWidth="680" MinHeight="440"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgApp}"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowDrop="True"
        AutomationProperties.AutomationId="mdread.window">
	<!-- CaptionHeight 与标题栏同高：空白处交给系统拖动/双击；交互控件要标 IsHitTestVisibleInChrome -->
	<shell:WindowChrome.WindowChrome>
		<shell:WindowChrome CaptionHeight="32"
		                    ResizeBorderThickness="8,6,8,6"
		                    GlassFrameThickness="0"
		                    CornerRadius="0"
		                    UseAeroCaptionButtons="False"/>
	</shell:WindowChrome.WindowChrome>

	<Window.Resources>
		<!-- 标题栏窗口按钮，高度与标题栏 32 对齐 -->
		<Style x:Key="CapBtn" TargetType="Button">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Width" Value="42"/>
			<Setter Property="Height" Value="32"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="bd" Background="{TemplateBinding Background}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bd" Property="Background" Value="#E2E6EC"/>
								<Setter Property="Foreground" Value="#1F2328"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<Style x:Key="CapBtnClose" TargetType="Button" BasedOn="{StaticResource CapBtn}">
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="bd" Background="{TemplateBinding Background}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bd" Property="Background" Value="#E81123"/>
								<Setter Property="Foreground" Value="White"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- 标题栏 tab 芯片：当前页白底凸出，其余透明；右边一条细线分隔 -->
		<Style x:Key="TitleTab" TargetType="Border">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0,0,1,0"/>
			<Setter Property="Padding" Value="10,0,6,0"/>
			<Setter Property="Margin" Value="0,4,0,0"/>
			<Setter Property="MinWidth" Value="60"/>
			<Setter Property="MaxWidth" Value="220"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="SnapsToDevicePixels" Value="True"/>
		</Style>
		<Style x:Key="TitleTabActive" TargetType="Border" BasedOn="{StaticResource TitleTab}">
			<Setter Property="Background" Value="#FFFFFF"/>
			<Setter Property="BorderBrush" Value="#D6DBE2"/>
		</Style>

		<!-- 芯片右上角的关闭叉 -->
		<Style x:Key="CloseTabBtn" TargetType="Button">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Width" Value="18"/>
			<Setter Property="Height" Value="18"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="3">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bd" Property="Background" Value="#FECACA"/>
								<Setter Property="Foreground" Value="#B42318"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- 工具栏图标按钮：统一 28×26 的方形，线框图标铺满图标区 -->
		<Style x:Key="BarBtn" TargetType="Button">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Width" Value="28"/>
			<Setter Property="Height" Value="26"/>
			<Setter Property="Padding" Value="5"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="ToolTipService.Placement" Value="Bottom"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="bd" Background="{TemplateBinding Background}"
						        BorderBrush="{TemplateBinding BorderBrush}"
						        BorderThickness="1" CornerRadius="3"
						        Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bd" Property="Background" Value="#E6EAF0"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="bd" Property="Background" Value="#D6DDE6"/>
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter Property="Opacity" Value="0.35"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- 图标笔触：与 docview 一致，muted 色细线，不填充 -->
		<Style x:Key="BarIcon" TargetType="Path">
			<Setter Property="Stroke" Value="#6B7280"/>
			<Setter Property="StrokeThickness" Value="1.4"/>
			<Setter Property="StrokeStartLineCap" Value="Round"/>
			<Setter Property="StrokeEndLineCap" Value="Round"/>
			<Setter Property="StrokeLineJoin" Value="Round"/>
			<Setter Property="Fill" Value="Transparent"/>
			<Setter Property="Stretch" Value="Uniform"/>
			<Setter Property="Width" Value="16"/>
			<Setter Property="Height" Value="16"/>
		</Style>

		<!-- 工具栏上的小号文字（页码「/ 2」这类） -->
		<Style x:Key="BarLabel" TargetType="TextBlock">
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
			<Setter Property="FontSize" Value="12"/>
		</Style>

		<!-- 工具栏里的输入框：页码、查找 -->
		<Style x:Key="BarBox" TargetType="TextBox">
			<Setter Property="Height" Value="22"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="Padding" Value="4,0"/>
			<Setter Property="BorderBrush" Value="#D2D8E0"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Background" Value="White"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="TextBox">
						<Border Background="{TemplateBinding Background}"
						        BorderBrush="{TemplateBinding BorderBrush}"
						        BorderThickness="{TemplateBinding BorderThickness}"
						        CornerRadius="3">
							<ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
							              VerticalAlignment="Center"/>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<Border x:Name="proot" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"
	        Background="{StaticResource BgApp}">
		<DockPanel>
			<!-- 第 1 行：自绘标题栏 = 汉堡菜单 + tab 芯片 + 窗口按钮 -->
			<Border x:Name="ptitle" DockPanel.Dock="Top" Height="32"
			        Background="#F0F2F5" BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,0,1"
			        MouseLeftButtonDown="ontitledrag">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>

					<Menu x:Name="mnmain" Grid.Column="0" Background="Transparent" VerticalAlignment="Stretch"
					      Padding="0" Margin="0"
					      shell:WindowChrome.IsHitTestVisibleInChrome="True">
						<MenuItem x:Name="mnhamburger" Padding="10,0" VerticalAlignment="Stretch" ToolTip="菜单">
							<MenuItem.Header>
								<TextBlock Text="☰" FontSize="14" VerticalAlignment="Center"
								           Foreground="#333A44"/>
							</MenuItem.Header>
							<MenuItem x:Name="mnopen" Header="打开…"/>
							<MenuItem x:Name="mnhistory" Header="历史文件">
								<MenuItem x:Name="mnhistempty" Header="（暂无）" IsEnabled="False"/>
							</MenuItem>
							<MenuItem x:Name="mnclose" Header="关闭当前标签"/>
							<MenuItem x:Name="mncloseall" Header="关闭全部标签"/>
							<Separator/>
							<MenuItem x:Name="mnword" Header="导出 Word…"/>
							<MenuItem x:Name="mnpdf" Header="导出 PDF…"/>
							<Separator/>
							<MenuItem x:Name="mnreload" Header="重新加载当前标签"/>
							<Separator/>
							<MenuItem x:Name="mnpath" Header="复制文件路径"/>
							<MenuItem x:Name="mnsysopen" Header="用系统应用打开"/>
							<MenuItem x:Name="mnexplorer" Header="在 Explorer 中显示"/>
						</MenuItem>
					</Menu>

					<!-- tab 芯片条；ScrollViewer 本身不进 chrome，芯片单独标可命中 -->
					<ScrollViewer x:Name="svtabs" Grid.Column="1"
					              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
					              VerticalAlignment="Stretch" Background="Transparent">
						<StackPanel x:Name="tabhost" Orientation="Horizontal" VerticalAlignment="Stretch"
						            Background="Transparent"/>
					</ScrollViewer>

					<StackPanel Grid.Column="2" Orientation="Horizontal"
					            shell:WindowChrome.IsHitTestVisibleInChrome="True">
						<Button x:Name="bmin" Style="{StaticResource CapBtn}" Content="─" ToolTip="最小化"
						        AutomationProperties.AutomationId="mdread.min"/>
						<Button x:Name="bmax" Style="{StaticResource CapBtn}" Content="□" ToolTip="最大化"
						        AutomationProperties.AutomationId="mdread.max"/>
						<Button x:Name="bclosewin" Style="{StaticResource CapBtnClose}" Content="✕" ToolTip="关闭"
						        AutomationProperties.AutomationId="mdread.closewin"/>
					</StackPanel>
				</Grid>
			</Border>

			<!-- 第 2 行：工具栏。参照 docview：一行图标按钮，页码和查找是行内输入框 -->
			<Border x:Name="ptoolbar" DockPanel.Dock="Top" Background="#F7F8FA"
			        BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,0,1" Padding="6,2">
				<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
						<!-- 打开 -->
						<Button x:Name="bopen" Style="{StaticResource BarBtn}" ToolTip="打开文件"
						        AutomationProperties.AutomationId="mdread.open">
							<Path Style="{StaticResource BarIcon}"
							      Data="M5,4 h4 l3,3 h7 a2,2 0 0 1 2,2 v8 a2,2 0 0 1 -2,2 h-14 a2,2 0 0 1 -2,-2 v-11 a2,2 0 0 1 2,-2"/>
						</Button>
						<Border Width="1" Height="18" Background="#D8DEE6" Margin="6,0"/>

						<!-- 页码范围：页码 / 总页数 -->
						<TextBlock Text="页码:" Style="{StaticResource BarLabel}" Margin="0,0,4,0"/>
						<TextBox x:Name="epage" Style="{StaticResource BarBox}" Width="44"
						         HorizontalContentAlignment="Right" ToolTip="跳到指定页（回车）"
						         AutomationProperties.AutomationId="mdread.pagebox"/>
						<TextBlock x:Name="lbpage" Text="/ 0" Style="{StaticResource BarLabel}"
						           MinWidth="38" Margin="2,0,6,0"/>

						<!-- 上一页 / 下一页 -->
						<Button x:Name="bprev" Style="{StaticResource BarBtn}" ToolTip="上一页 (PgUp)"
						        AutomationProperties.AutomationId="mdread.prev">
							<Path Style="{StaticResource BarIcon}" Data="M5,12 L19,12 M5,12 L11,18 M5,12 L11,6"/>
						</Button>
						<Button x:Name="bnext" Style="{StaticResource BarBtn}" ToolTip="下一页 (PgDn)"
						        AutomationProperties.AutomationId="mdread.next">
							<Path Style="{StaticResource BarIcon}" Data="M5,12 L19,12 M13,18 L19,12 M13,6 L19,12"/>
						</Button>
						<Border Width="1" Height="18" Background="#D8DEE6" Margin="6,0"/>

						<!-- 缩小 / 放大 / 适应宽度 -->
						<Button x:Name="bzoomout" Style="{StaticResource BarBtn}" ToolTip="缩小 (Ctrl+-)"
						        AutomationProperties.AutomationId="mdread.zoomout">
							<Path Style="{StaticResource BarIcon}"
							      Data="M10,10 m-7,0 a7,7 0 1,0 14,0 a7,7 0 1,0 -14,0 M7,10 L13,10 M21,21 L15,15"/>
						</Button>
						<Button x:Name="bzoomin" Style="{StaticResource BarBtn}" ToolTip="放大 (Ctrl++)"
						        AutomationProperties.AutomationId="mdread.zoomin">
							<Path Style="{StaticResource BarIcon}"
							      Data="M10,10 m-7,0 a7,7 0 1,0 14,0 a7,7 0 1,0 -14,0 M7,10 L13,10 M10,7 L10,13 M21,21 L15,15"/>
						</Button>
						<Button x:Name="bzoomfit" Style="{StaticResource BarBtn}" ToolTip="适应宽度"
						        AutomationProperties.AutomationId="mdread.zoomfit">
							<Path Style="{StaticResource BarIcon}"
							      Data="M3,3 h18 a2,2 0 0 1 2,2 v14 a2,2 0 0 1 -2,2 h-18 a2,2 0 0 1 -2,-2 v-14 a2,2 0 0 1 2,-2 M3,12 L21,12"/>
						</Button>
						<Border Width="1" Height="18" Background="#D8DEE6" Margin="6,0"/>

						<!-- 查找：开关按钮 + 输入框 + 上/下一个（后两个未查找时隐藏） -->
						<Button x:Name="bfind" Style="{StaticResource BarBtn}" ToolTip="查找 (Ctrl+F)"
						        AutomationProperties.AutomationId="mdread.find">
							<Path Style="{StaticResource BarIcon}"
							      Data="M10,10 m-7,0 a7,7 0 1,0 14,0 a7,7 0 1,0 -14,0 M21,21 L15,15"/>
						</Button>
						<TextBox x:Name="efind" Style="{StaticResource BarBox}" Width="150" Margin="2,0,2,0"
						         Visibility="Collapsed" ToolTip="输入后回车向下，Shift+回车向上"
						         AutomationProperties.AutomationId="mdread.findbox"/>
						<Button x:Name="bfindprev" Style="{StaticResource BarBtn}" ToolTip="上一个"
						        Visibility="Collapsed" AutomationProperties.AutomationId="mdread.findprev">
							<Path Style="{StaticResource BarIcon}" Data="M15,6 L9,12 L15,18"/>
						</Button>
						<Button x:Name="bfindnext" Style="{StaticResource BarBtn}" ToolTip="下一个"
						        Visibility="Collapsed" AutomationProperties.AutomationId="mdread.findnext">
							<Path Style="{StaticResource BarIcon}" Data="M9,6 L15,12 L9,18"/>
						</Button>
				</StackPanel>
			</Border>

			<!-- 状态栏：只显示当前页和缩放 -->
			<Border DockPanel.Dock="Bottom" Background="#F7F8FA"
			        BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,1,0,0" Padding="8,0"
			        Height="24">
				<TextBlock x:Name="lbstat" VerticalAlignment="Center"
				           TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextMuted}"
				           FontSize="12" AutomationProperties.AutomationId="mdread.stat"/>
			</Border>

			<!-- 文档区，阅读器自己的 FrameworkElement 挂在这里 -->
			<Border x:Name="phostbox" BorderBrush="{StaticResource BorderSoft}" BorderThickness="0"
			        Background="White">
				<ContentControl x:Name="phost" Focusable="False"
				                AutomationProperties.AutomationId="mdread.view"/>
			</Border>
		</DockPanel>
	</Border>
</Window>
