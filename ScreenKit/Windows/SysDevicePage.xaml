<UserControl x:Class="ScreenKit.SysDevicePage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Grid Margin="12">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
		<TextBlock x:Name="lbhint" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10"
		           Foreground="{StaticResource TextMuted}" FontSize="12"/>
		<Grid Grid.Row="1" Margin="0,0,0,8">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>
			<TextBlock x:Name="lbfilter" Text="筛选" VerticalAlignment="Center" Margin="0,0,8,0"/>
			<TextBox x:Name="efilter" Grid.Column="1" Height="32" Padding="8,4" Margin="0,0,8,0"
			         BorderBrush="{StaticResource BorderSoft}" VerticalContentAlignment="Center"/>
			<Button x:Name="brefresh" Grid.Column="2" Style="{StaticResource ToolBtn}" Margin="0,0,6,0"/>
			<Button x:Name="bcopy" Grid.Column="3" Style="{StaticResource ToolBtn}"/>
		</Grid>
		<Grid Grid.Row="2">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="1.2*" MinWidth="300"/>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="*" MinWidth="260"/>
			</Grid.ColumnDefinitions>
			<ListView x:Name="lvdev" BorderBrush="{StaticResource BorderSoft}" SelectionMode="Single">
				<ListView.View>
					<GridView>
						<GridViewColumn x:Name="colname" Width="230" DisplayMemberBinding="{Binding Name}"/>
						<GridViewColumn x:Name="colkind" Width="110" DisplayMemberBinding="{Binding ClassName}"/>
						<GridViewColumn x:Name="colinfo" Width="120" DisplayMemberBinding="{Binding Com}"/>
						<GridViewColumn x:Name="colstatus" Width="110" DisplayMemberBinding="{Binding Status}"/>
					</GridView>
				</ListView.View>
			</ListView>
			<GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
			<ListView x:Name="lvprop" Grid.Column="2" BorderBrush="{StaticResource BorderSoft}"
			          SelectionMode="Single" FontFamily="Consolas, Microsoft YaHei UI">
				<ListView.View>
					<GridView>
						<GridViewColumn x:Name="colprop" Width="120" DisplayMemberBinding="{Binding Name}"/>
						<GridViewColumn x:Name="colvalue" Width="360" DisplayMemberBinding="{Binding Value}"/>
					</GridView>
				</ListView.View>
			</ListView>
		</Grid>
		<TextBlock x:Name="lbstat" Grid.Row="3" Margin="0,8,0,0"
		           VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
	</Grid>
</UserControl>
