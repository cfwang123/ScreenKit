<Window x:Class="ScreenKit.NetRulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="规则与标记"
        Height="460" Width="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BgApp}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        AutomationProperties.AutomationId="netrules.window">
	<Grid Margin="14">
		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
		<ScrollViewer VerticalScrollBarVisibility="Auto">
			<StackPanel>
				<CheckBox x:Name="cklisten" Content="忽略本机 LISTEN 连接（减少噪音）" Margin="0,0,0,10"/>
				<CheckBox x:Name="ckcolor" Content="启用黑白名单着色" Margin="0,0,0,12"/>
				<TextBlock Text="进程黑名单（子串，逗号分隔）→ 红底" Margin="0,0,0,4" Foreground="#374151"/>
				<TextBox x:Name="eprocblack" Height="48" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,10" Padding="6"/>
				<TextBlock Text="进程白名单（子串，逗号分隔）→ 绿底" Margin="0,0,0,4" Foreground="#374151"/>
				<TextBox x:Name="eprocwhite" Height="48" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,10" Padding="6"/>
				<TextBlock Text="IP 黑名单（子串，逗号分隔）" Margin="0,0,0,4" Foreground="#374151"/>
				<TextBox x:Name="eipblack" Height="36" Margin="0,0,0,10" Padding="6"/>
				<TextBlock Text="IP 白名单（子串，逗号分隔）" Margin="0,0,0,4" Foreground="#374151"/>
				<TextBox x:Name="eipwhite" Height="36" Margin="0,0,0,10" Padding="6"/>
				<TextBlock x:Name="lbpath" FontSize="11" Foreground="#718096" TextWrapping="Wrap"/>
			</StackPanel>
		</ScrollViewer>
		<StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
			<Button x:Name="bsave" Content="保存" Width="88" Style="{StaticResource PrimaryBtn}"/>
			<Button x:Name="bcancel" Content="取消" Width="88" Style="{StaticResource ToolBtn}"/>
		</StackPanel>
	</Grid>
</Window>
