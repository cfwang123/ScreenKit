<Window x:Class="ScreenKit.InstallFeaturesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="安装功能"
        Height="720" Width="860"
        MinHeight="560" MinWidth="680"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgApp}"
        FontFamily="Segoe UI, Microsoft YaHei UI">
	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="110"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<StackPanel Grid.Row="0" Margin="0,0,0,8">
			<TextBlock x:Name="lbtitle" Text="安装功能"
			           FontSize="16" FontWeight="SemiBold"
			           Foreground="{StaticResource TextPrimary}"/>
			<TextBlock x:Name="lbmirror" TextWrapping="Wrap" Margin="0,4,0,0"
			           FontSize="12" Foreground="{StaticResource Accent}"
			           Text=""/>
		</StackPanel>

		<TabControl x:Name="tabmain" Grid.Row="1" Margin="0,0,0,8"
		            BorderBrush="{StaticResource BorderSoft}"
		            AutomationProperties.AutomationId="inst.tabs">
			<!-- Tab1：功能选择 -->
			<TabItem x:Name="tabpick" Header="功能选择"
			         AutomationProperties.AutomationId="inst.tab.pick">
				<Grid Margin="8">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>
					<TextBlock x:Name="lbpickhint" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8"
					           FontSize="12" Foreground="{StaticResource TextMuted}"
					           Text="已装功能默认勾选。绿色将安装、红色将卸载。点确认开始安装或删除。ONNX 语音模型、Windows 语音合成和 Windows 语音识别请到对应页。"/>
					<Border Grid.Row="1" Background="{StaticResource BgPanel}"
					        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"
					        CornerRadius="8" Padding="4">
						<TreeView x:Name="etree" BorderThickness="0" Background="Transparent"
						          VirtualizingStackPanel.IsVirtualizing="False"
						          AutomationProperties.AutomationId="inst.pick.tree">
							<TreeView.ItemContainerStyle>
								<Style TargetType="TreeViewItem">
									<Setter Property="IsExpanded" Value="True"/>
									<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
									<Setter Property="Padding" Value="0,2"/>
								</Style>
							</TreeView.ItemContainerStyle>
							<TreeView.ItemTemplate>
								<HierarchicalDataTemplate ItemsSource="{Binding Children}">
									<Border CornerRadius="4" Padding="6,3" Margin="0,1,8,1">
										<Border.Style>
											<Style TargetType="Border">
												<Setter Property="Background" Value="Transparent"/>
												<Style.Triggers>
													<DataTrigger Binding="{Binding Diff}" Value="add">
														<Setter Property="Background" Value="#DCFCE7"/>
													</DataTrigger>
													<DataTrigger Binding="{Binding Diff}" Value="del">
														<Setter Property="Background" Value="#FEE2E2"/>
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</Border.Style>
										<DockPanel LastChildFill="True">
											<TextBlock DockPanel.Dock="Right"
											           Text="{Binding SizeLabel}"
											           Width="88" TextAlignment="Right"
											           VerticalAlignment="Center" FontSize="11"
											           Foreground="{StaticResource TextMuted}"/>
											<CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
											          IsThreeState="{Binding IsGroup}"
											          VerticalAlignment="Center" Margin="0,0,8,0">
												<StackPanel>
													<TextBlock Text="{Binding Title}" FontSize="13"
													           Foreground="{StaticResource TextPrimary}"/>
													<TextBlock Text="{Binding Detail}" FontSize="11"
													           TextWrapping="Wrap"
													           Foreground="{StaticResource TextMuted}"/>
												</StackPanel>
											</CheckBox>
										</DockPanel>
									</Border>
								</HierarchicalDataTemplate>
							</TreeView.ItemTemplate>
						</TreeView>
					</Border>
					<DockPanel Grid.Row="2" Margin="0,8,0,0">
						<Button x:Name="bconfirm" DockPanel.Dock="Right" Content="确认"
						        Style="{StaticResource PrimaryBtn}" Width="120" Height="32"
						        AutomationProperties.AutomationId="inst.pick.confirm"/>
						<Button x:Name="breset" DockPanel.Dock="Right" Content="复位"
						        Style="{StaticResource ToolBtn}" Width="80" Height="32"
						        Margin="0,0,8,0"
						        AutomationProperties.AutomationId="inst.pick.reset"/>
						<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
							<Border x:Name="badd" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
								<TextBlock x:Name="lbadd" FontSize="12" FontWeight="SemiBold" Text=""
								           AutomationProperties.AutomationId="inst.pick.add"/>
							</Border>
							<Border x:Name="bdel" CornerRadius="4" Padding="8,4">
								<TextBlock x:Name="lbdel" FontSize="12" FontWeight="SemiBold" Text=""
								           AutomationProperties.AutomationId="inst.pick.del"/>
							</Border>
						</StackPanel>
					</DockPanel>
				</Grid>
			</TabItem>

			<!-- Tab：ONNX 语音模型 -->
			<TabItem x:Name="tabtts" Header="onnx语音模型"
			         AutomationProperties.AutomationId="inst.tab.tts">
				<Grid Margin="8">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
					</Grid.RowDefinitions>

					<TextBlock x:Name="lbttshint" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8"
					           FontSize="12" Foreground="{StaticResource TextMuted}"
					           Text="Sherpa-ONNX TTS 模型（GitHub tts-models）。按语言筛选后勾选安装到 ttsmodels。"/>

					<DockPanel Grid.Row="1" Margin="0,0,0,8" LastChildFill="False">
						<TextBlock x:Name="lbttslang" Text="语言" VerticalAlignment="Center" Margin="0,0,6,0"
						           Foreground="{StaticResource TextMuted}"/>
						<ComboBox x:Name="ettslang" Width="160" Height="28" Margin="0,0,12,0"
						          VerticalContentAlignment="Center"/>
						<CheckBox x:Name="cttsmissing" Content="仅未安装" VerticalAlignment="Center"
						          Margin="0,0,12,0" IsChecked="False"/>
						<CheckBox x:Name="cttssupported" Content="仅当前引擎支持"
						          VerticalAlignment="Center" Margin="0,0,12,0" IsChecked="True"
						          ToolTip="VITS / Matcha / Piper（本应用可扫描使用）"/>
						<Button x:Name="bttsrefresh" Content="刷新列表" Style="{StaticResource ToolBtn}"
						        Width="88" Margin="0,0,8,0"/>
						<TextBlock x:Name="lbttssource" VerticalAlignment="Center"
						           FontSize="11" Foreground="{StaticResource TextMuted}"
						           Text=""/>
					</DockPanel>

					<Border Grid.Row="2" Background="{StaticResource BgPanel}"
					        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"
					        CornerRadius="8">
						<ListView x:Name="lvtss" BorderThickness="0"
						          Background="Transparent"
						          VirtualizingPanel.IsVirtualizing="True"
						          VirtualizingPanel.VirtualizationMode="Recycling"
						          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
						          SelectionMode="Extended">
							<ListView.View>
								<GridView>
									<GridViewColumn Width="36">
										<GridViewColumn.Header>
											<CheckBox x:Name="cttsheader" ToolTip="全选当前列表"/>
										</GridViewColumn.Header>
										<GridViewColumn.CellTemplate>
											<DataTemplate>
												<CheckBox IsChecked="{Binding Selected, Mode=TwoWay}"
												          VerticalAlignment="Center"/>
											</DataTemplate>
										</GridViewColumn.CellTemplate>
									</GridViewColumn>
									<GridViewColumn Header="模型" Width="320"
									                DisplayMemberBinding="{Binding Title}"/>
									<GridViewColumn Header="语言" Width="100"
									                DisplayMemberBinding="{Binding LangLabel}"/>
									<GridViewColumn Header="引擎" Width="72"
									                DisplayMemberBinding="{Binding Engine}"/>
									<GridViewColumn Header="大小" Width="90"
									                DisplayMemberBinding="{Binding SizeText}"/>
									<GridViewColumn Header="状态" Width="88">
										<GridViewColumn.CellTemplate>
											<DataTemplate>
												<Border CornerRadius="4" Padding="8,2"
												        HorizontalAlignment="Left"
												        Background="{Binding StateBg}">
													<TextBlock Text="{Binding StateText}"
													           FontSize="11" FontWeight="SemiBold"
													           Foreground="{Binding StateFg}"/>
												</Border>
											</DataTemplate>
										</GridViewColumn.CellTemplate>
									</GridViewColumn>
								</GridView>
							</ListView.View>
						</ListView>
					</Border>
				</Grid>
			</TabItem>

			<!-- Tab：Windows 语音功能包 -->
			<TabItem x:Name="tabwin" Header="Windows语音合成"
			         AutomationProperties.AutomationId="inst.tab.win">
				<Grid Margin="8">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>
					<TextBlock x:Name="lbwinhint" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8"
					           FontSize="12" Foreground="{StaticResource TextMuted}"
					           Text="系统语音包 Language.TextToSpeech。进入本页时才读取已安装的语音包和发音人。本进程是管理员时直接读取、安装或卸载；否则用 start 弹出管理员窗口。装好后需重启本程序，语音合成页才会看到新发音人。"/>
					<DockPanel Grid.Row="1" Margin="0,0,0,8" LastChildFill="True">
						<CheckBox x:Name="cwinonly" DockPanel.Dock="Left" Content="仅已安装"
						          VerticalAlignment="Center" Margin="0,0,12,0" IsChecked="False"
						          AutomationProperties.AutomationId="inst.win.only"/>
						<Button x:Name="bwinrefresh" DockPanel.Dock="Left" Content="刷新"
						        Style="{StaticResource ToolBtn}" Width="72" Margin="0,0,8,0"
						        AutomationProperties.AutomationId="inst.win.refresh"/>
						<Button x:Name="bwincopy" DockPanel.Dock="Left" Content="复制命令"
						        Style="{StaticResource ToolBtn}" Width="88" Margin="0,0,12,0"
						        AutomationProperties.AutomationId="inst.win.copy"/>
						<TextBlock x:Name="lbwinadmin" VerticalAlignment="Center" TextWrapping="Wrap"
						           FontSize="12" Foreground="{StaticResource TextMuted}" Text=""/>
					</DockPanel>
					<Border Grid.Row="2" Background="{StaticResource BgPanel}"
					        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"
					        CornerRadius="8">
						<ListView x:Name="lvwin" BorderThickness="0"
						          Background="Transparent"
						          VirtualizingPanel.IsVirtualizing="False"
						          ScrollViewer.HorizontalScrollBarVisibility="Auto"
						          AutomationProperties.AutomationId="inst.win.list">
							<ListView.View>
								<GridView>
									<GridViewColumn Width="36">
										<GridViewColumn.Header>
											<CheckBox x:Name="cwinheader" ToolTip="全选当前列表"/>
										</GridViewColumn.Header>
										<GridViewColumn.CellTemplate>
											<DataTemplate>
												<CheckBox IsChecked="{Binding Selected, Mode=TwoWay}"
												          VerticalAlignment="Center"/>
											</DataTemplate>
										</GridViewColumn.CellTemplate>
									</GridViewColumn>
									<GridViewColumn Header="语言" Width="200"
									                DisplayMemberBinding="{Binding Title}"/>
									<GridViewColumn Header="发音人" Width="220"
									                DisplayMemberBinding="{Binding Voices}"/>
									<GridViewColumn Header="状态" Width="88">
										<GridViewColumn.CellTemplate>
											<DataTemplate>
												<Border CornerRadius="4" Padding="8,2"
												        HorizontalAlignment="Left"
												        Background="{Binding StateBg}">
													<TextBlock Text="{Binding StateText}"
													           FontSize="11" FontWeight="SemiBold"
													           Foreground="{Binding StateFg}"/>
												</Border>
											</DataTemplate>
										</GridViewColumn.CellTemplate>
									</GridViewColumn>
									<GridViewColumn Header="功能包" Width="280"
									                DisplayMemberBinding="{Binding Capability}"/>
								</GridView>
							</ListView.View>
						</ListView>
					</Border>
					<TextBox x:Name="ewincmd" Grid.Row="3" Margin="0,8,0,0"
					         Height="72" IsReadOnly="True" TextWrapping="Wrap"
					         VerticalScrollBarVisibility="Auto"
					         FontSize="11" FontFamily="Consolas, Microsoft YaHei UI" Padding="8"
					         BorderBrush="{StaticResource BorderSoft}"
					         Background="{StaticResource BgPanel}"
					         AutomationProperties.AutomationId="inst.win.cmd"/>
				</Grid>
			</TabItem>

			<!-- Tab：Windows 语音识别功能包 -->
			<TabItem x:Name="tabwinasr" Header="Windows语音识别"
			         AutomationProperties.AutomationId="inst.tab.winasr">
				<Grid Margin="8">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>
					<TextBlock x:Name="lbwinasrhint" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8"
					           FontSize="12" Foreground="{StaticResource TextMuted}"
					           Text="系统语音识别包 Language.Speech。进入本页时读取功能包和 System.Speech 识别器。安装时 Windows 会自动补齐同语言的 Basic 与 TextToSpeech 依赖。装好后需重启本程序。"/>
					<DockPanel Grid.Row="1" Margin="0,0,0,8" LastChildFill="True">
						<CheckBox x:Name="cwinasronly" DockPanel.Dock="Left" Content="仅已安装"
						          VerticalAlignment="Center" Margin="0,0,12,0" IsChecked="False"
						          AutomationProperties.AutomationId="inst.winasr.only"/>
						<Button x:Name="bwinasrrefresh" DockPanel.Dock="Left" Content="刷新"
						        Style="{StaticResource ToolBtn}" Width="72" Margin="0,0,8,0"
						        AutomationProperties.AutomationId="inst.winasr.refresh"/>
						<Button x:Name="bwinasrcopy" DockPanel.Dock="Left" Content="复制命令"
						        Style="{StaticResource ToolBtn}" Width="88" Margin="0,0,12,0"
						        AutomationProperties.AutomationId="inst.winasr.copy"/>
						<TextBlock x:Name="lbwinasradmin" VerticalAlignment="Center" TextWrapping="Wrap"
						           FontSize="12" Foreground="{StaticResource TextMuted}" Text=""/>
					</DockPanel>
					<Border Grid.Row="2" Background="{StaticResource BgPanel}"
					        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"
					        CornerRadius="8">
						<ListView x:Name="lvwinasr" BorderThickness="0"
						          Background="Transparent"
						          VirtualizingPanel.IsVirtualizing="False"
						          ScrollViewer.HorizontalScrollBarVisibility="Auto"
						          AutomationProperties.AutomationId="inst.winasr.list">
							<ListView.View>
								<GridView>
									<GridViewColumn Width="36">
										<GridViewColumn.Header>
											<CheckBox x:Name="cwinasrheader" ToolTip="全选当前列表"/>
										</GridViewColumn.Header>
										<GridViewColumn.CellTemplate>
											<DataTemplate>
												<CheckBox IsChecked="{Binding Selected, Mode=TwoWay}"
												          VerticalAlignment="Center"/>
											</DataTemplate>
										</GridViewColumn.CellTemplate>
									</GridViewColumn>
									<GridViewColumn Header="语言" Width="200"
									                DisplayMemberBinding="{Binding Title}"/>
									<GridViewColumn Header="识别器" Width="220"
									                DisplayMemberBinding="{Binding Recognizers}"/>
									<GridViewColumn Header="状态" Width="88">
										<GridViewColumn.CellTemplate>
											<DataTemplate>
												<Border CornerRadius="4" Padding="8,2"
												        HorizontalAlignment="Left"
												        Background="{Binding StateBg}">
													<TextBlock Text="{Binding StateText}"
													           FontSize="11" FontWeight="SemiBold"
													           Foreground="{Binding StateFg}"/>
												</Border>
											</DataTemplate>
										</GridViewColumn.CellTemplate>
									</GridViewColumn>
									<GridViewColumn Header="功能包" Width="280"
									                DisplayMemberBinding="{Binding Capability}"/>
								</GridView>
							</ListView.View>
						</ListView>
					</Border>
					<TextBox x:Name="ewinasrcmd" Grid.Row="3" Margin="0,8,0,0"
					         Height="72" IsReadOnly="True" TextWrapping="Wrap"
					         VerticalScrollBarVisibility="Auto"
					         FontSize="11" FontFamily="Consolas, Microsoft YaHei UI" Padding="8"
					         BorderBrush="{StaticResource BorderSoft}"
					         Background="{StaticResource BgPanel}"
					         AutomationProperties.AutomationId="inst.winasr.cmd"/>
				</Grid>
			</TabItem>
		</TabControl>

		<DockPanel Grid.Row="2" Margin="0,0,0,6">
			<TextBlock x:Name="lbprog" DockPanel.Dock="Right" MinWidth="48"
			           HorizontalAlignment="Right" VerticalAlignment="Center"
			           Foreground="{StaticResource TextMuted}" Text="0%"/>
			<ProgressBar x:Name="pbar" Height="12" Minimum="0" Maximum="1"
			             Value="0" Margin="0,0,10,0"/>
		</DockPanel>

		<StackPanel Grid.Row="3" Margin="0,0,0,6">
			<TextBlock x:Name="lbstatus" FontSize="12"
			           Foreground="{StaticResource TextMuted}" Text="就绪"/>
			<TextBlock x:Name="lbbytes" FontSize="12" Margin="0,2,0,0"
			           Foreground="{StaticResource Accent}" Text=""/>
		</StackPanel>

		<TextBox x:Name="elog" Grid.Row="4"
		         IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
		         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
		         FontSize="11" FontFamily="Consolas, Microsoft YaHei UI" Padding="8"
		         BorderBrush="{StaticResource BorderSoft}"
		         Background="{StaticResource BgPanel}"/>

		<DockPanel Grid.Row="5" Margin="0,12,0,0" LastChildFill="False">
			<StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
				<Button x:Name="bmissing" Content="勾选未装" Style="{StaticResource GhostBtn}"
				        Width="96" Margin="0,0,8,0"
				        ToolTip="当前页：仅勾选未安装/部分安装的项"
				        BorderBrush="{StaticResource Danger}" Foreground="{StaticResource Danger}"/>
				<Button x:Name="bnone" Content="全不选" Style="{StaticResource ToolBtn}"
				        Width="80" Margin="0,0,8,0"/>
				<Button x:Name="ball" Content="全选" Style="{StaticResource ToolBtn}"
				        Width="72"/>
			</StackPanel>
			<StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
				<Button x:Name="bcancel" Content="取消" Style="{StaticResource ToolBtn}"
				        Width="80" Margin="0,0,8,0" IsEnabled="False"/>
				<Button x:Name="bdelete" Content="删除选中" Style="{StaticResource ToolBtn}"
				        Width="96" Margin="0,0,8,0"
				        ToolTip="删除已勾选且已安装的组件/发音人（不可恢复）"/>
				<Button x:Name="binstall" Content="安装选中" Style="{StaticResource PrimaryBtn}"
				        Width="110" Margin="0,0,8,0" IsDefault="True"/>
				<Button x:Name="bclose" Content="关闭" Style="{StaticResource ToolBtn}"
				        Width="80" IsCancel="True"/>
			</StackPanel>
		</DockPanel>
	</Grid>
</Window>
