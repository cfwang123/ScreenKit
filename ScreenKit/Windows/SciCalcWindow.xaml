<Window x:Class="ScreenKit.SciCalcWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="科学计算器"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        UseLayoutRounding="True"
        AutomationProperties.AutomationId="scicalc.window">
	<Border x:Name="chrome" Background="#CC000000" CornerRadius="12" Padding="8,6,8,8"
	        BorderBrush="#33FFFFFF" BorderThickness="1">
		<StackPanel>
			<Grid Margin="2,0,0,2">
				<TextBlock x:Name="lbmem" Text="" Foreground="#F59E0B" FontSize="11"
				           VerticalAlignment="Center" AutomationProperties.AutomationId="scicalc.mem"/>
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
					<Button x:Name="bdeg" Content="DEG" Width="36" Height="18" Padding="0" Margin="0,0,4,0"
					        FontSize="10" Background="#262626" Foreground="#E5E5E5" BorderThickness="0"
					        Cursor="Hand" AutomationProperties.AutomationId="scicalc.deg"/>
					<Button x:Name="bclose" Content="×" Width="22" Height="18" Padding="0" FontSize="14"
					        Background="Transparent" Foreground="#D4D4D4" BorderThickness="0"
					        Cursor="Hand" AutomationProperties.AutomationId="scicalc.close"/>
				</StackPanel>
			</Grid>
			<TextBlock x:Name="lbexpr" FontSize="11" Foreground="#A3A3A3" TextAlignment="Right"
			           TextWrapping="NoWrap" MinHeight="15" Margin="4,0,4,0"
			           AutomationProperties.AutomationId="scicalc.expr"/>
			<TextBlock x:Name="lbval" FontSize="26" Foreground="White" TextAlignment="Right"
			           FontFamily="Consolas, Segoe UI" Margin="4,0,4,6" Text="0"
			           AutomationProperties.AutomationId="scicalc.val"/>
			<UniformGrid x:Name="keys" Columns="6"/>
		</StackPanel>
	</Border>
</Window>
