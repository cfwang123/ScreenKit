<Window x:Class="ScreenKit.CaptureOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Cursor="Cross"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
	<!-- 微信式：先截整屏作底图 → 框选裁剪 → 标注工具条 -->
	<Window.Resources>
		<!-- 微信式圆角图标按钮 -->
		<Style x:Key="WxIconBtn" TargetType="Button">
			<Setter Property="Width" Value="36"/>
			<Setter Property="Height" Value="36"/>
			<Setter Property="Margin" Value="1,0"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="FontSize" Value="16"/>
			<Setter Property="Foreground" Value="#1A1A1A"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="bd" Background="{TemplateBinding Background}"
						        CornerRadius="8" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bd" Property="Background" Value="#F0F0F0"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="bd" Property="Background" Value="#E5E5E5"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<Style x:Key="WxIconToggle" TargetType="ToggleButton">
			<Setter Property="Width" Value="36"/>
			<Setter Property="Height" Value="36"/>
			<Setter Property="Margin" Value="1,0"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="FontSize" Value="15"/>
			<Setter Property="Foreground" Value="#1A1A1A"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ToggleButton">
						<Border x:Name="bd" Background="{TemplateBinding Background}"
						        CornerRadius="8" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bd" Property="Background" Value="#F0F0F0"/>
							</Trigger>
							<Trigger Property="IsChecked" Value="True">
								<Setter TargetName="bd" Property="Background" Value="#E8E8E8"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<!-- 颜色圆点 -->
		<Style x:Key="WxColorDot" TargetType="RadioButton">
			<Setter Property="Width" Value="22"/>
			<Setter Property="Height" Value="22"/>
			<Setter Property="Margin" Value="3,0"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="RadioButton">
						<Grid>
							<Ellipse x:Name="ring" Stroke="Transparent" StrokeThickness="2"
							         Fill="Transparent" Margin="-2"/>
							<Ellipse x:Name="dot" Fill="{TemplateBinding Background}" Margin="2"
							         Stroke="#D0D0D0" StrokeThickness="1"/>
						</Grid>
						<ControlTemplate.Triggers>
							<Trigger Property="IsChecked" Value="True">
								<Setter TargetName="ring" Property="Stroke" Value="#333333"/>
							</Trigger>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="ring" Property="Stroke" Value="#999999"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>
	<Canvas x:Name="proot" Background="Transparent"
	        UseLayoutRounding="True" SnapsToDevicePixels="True">
		<!-- 打开前截取的整屏冻结画面（1:1 像素对齐，禁止模糊缩放） -->
		<Image x:Name="imgDesktop" Stretch="Fill" IsHitTestVisible="False"
		       SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="NearestNeighbor"
		       RenderOptions.EdgeMode="Aliased"/>
		<!-- 外侧遮罩（EvenOdd 挖空选区 / 窗口高亮） -->
		<Path x:Name="mask" Fill="#99000000" SnapsToDevicePixels="True"/>
		<!-- 窗口识别：仅绿色边框，不挖空遮罩 -->
		<Rectangle x:Name="rwin" Stroke="#07C160" StrokeThickness="2"
		           Fill="Transparent" Visibility="Collapsed" IsHitTestVisible="False"
		           SnapsToDevicePixels="True"/>
		<!-- 选区描边（拖拽框选） -->
		<Rectangle x:Name="rsel" Stroke="#07C160" StrokeThickness="2"
		           Fill="Transparent" Visibility="Collapsed" SnapsToDevicePixels="True"/>
		<!-- 标注：绿框+画布。视口模式隐藏 imgshot，挖空直接露底层冻结图（避免双图层亚像素抖） -->
		<Border x:Name="bpane" Visibility="Collapsed" BorderBrush="#07C160" BorderThickness="2"
		        Background="Transparent" ClipToBounds="True"
		        SnapsToDevicePixels="True" UseLayoutRounding="False">
			<Grid x:Name="pstage" ClipToBounds="True" SnapsToDevicePixels="True">
				<Image x:Name="imgshot" Stretch="Fill" IsHitTestVisible="False"
				       HorizontalAlignment="Left" VerticalAlignment="Top"
				       SnapsToDevicePixels="True"
				       RenderOptions.BitmapScalingMode="NearestNeighbor"
				       RenderOptions.EdgeMode="Aliased"/>
				<Canvas x:Name="pdraw" Background="Transparent" SnapsToDevicePixels="True"/>
			</Grid>
		</Border>
		<!-- 微信式：选区确认后 8 点缩放手柄（移动靠拖选区边缘） -->
		<Canvas x:Name="phandles" Visibility="Collapsed" IsHitTestVisible="True"
		        SnapsToDevicePixels="True"/>
		<!-- 微信式放大镜 + 坐标/色值 -->
		<Border x:Name="bmag" Visibility="Collapsed" Background="#F7FFFFFF" CornerRadius="10"
		        BorderBrush="#E0E0E0" BorderThickness="1" Padding="8" IsHitTestVisible="False"
		        SnapsToDevicePixels="True">
			<Border.Effect>
				<DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.16" Color="#000000"/>
			</Border.Effect>
			<StackPanel>
				<!-- 2× 尺寸：224×224，像素块最近邻放大 -->
				<Border x:Name="bmagview" Width="224" Height="224" BorderBrush="#07C160" BorderThickness="1"
				        CornerRadius="2" ClipToBounds="True" Background="#111">
					<Grid>
						<Image x:Name="imgmag" Stretch="None" SnapsToDevicePixels="True"
						       HorizontalAlignment="Left" VerticalAlignment="Top"
						       RenderOptions.BitmapScalingMode="NearestNeighbor"
						       RenderOptions.EdgeMode="Aliased"/>
						<!-- 十字线（中心） -->
						<Line X1="112" Y1="0" X2="112" Y2="224" Stroke="#07C160" StrokeThickness="1" Opacity="0.9"/>
						<Line X1="0" Y1="112" X2="224" Y2="112" Stroke="#07C160" StrokeThickness="1" Opacity="0.9"/>
					</Grid>
				</Border>
				<Grid Margin="0,8,0,0">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>
					<TextBlock Grid.Row="0" Grid.Column="0" Text="坐标" FontSize="11"
					           Foreground="#666" Margin="0,0,10,3"/>
					<TextBlock x:Name="lbmagxy" Grid.Row="0" Grid.Column="1" FontSize="11"
					           Foreground="#222" Text="0, 0"/>
					<TextBlock Grid.Row="1" Grid.Column="0" Text="色值" FontSize="11"
					           Foreground="#666" Margin="0,0,10,3"/>
					<StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
						<Border x:Name="bmagswatch" Width="12" Height="12" CornerRadius="2"
						        BorderBrush="#CCC" BorderThickness="1" Margin="0,0,6,0" VerticalAlignment="Center"/>
						<TextBlock x:Name="lbmagcolor" FontSize="11" Foreground="#222" Text="#000000"
						           VerticalAlignment="Center"/>
					</StackPanel>
					<TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
					           Text="Ctrl+C 复制色值" FontSize="10" Foreground="#999" Margin="0,4,0,0"/>
				</Grid>
			</StackPanel>
		</Border>
		<!-- 微信式标注工具条：左工具 · 颜色 · 右操作（撤销/保存/取消/完成） -->
		<Border x:Name="bbar" Visibility="Collapsed" Background="#FFFFFFF2" CornerRadius="22"
		        BorderBrush="#E8E8E8" BorderThickness="1" Padding="10,6"
		        SnapsToDevicePixels="True">
			<Border.Effect>
				<DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270" Opacity="0.18" Color="#000000"/>
			</Border.Effect>
			<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
				<!-- 绘制工具：Path 图标（矩形/圆加大描边） -->
				<ToggleButton x:Name="trect" Style="{StaticResource WxIconToggle}" ToolTip="矩形">
					<Path Stroke="#1A1A1A" StrokeThickness="2.2" Fill="Transparent"
					      Stretch="Uniform" Width="18" Height="18"
					      Data="M3,3 H15 V15 H3 Z"/>
				</ToggleButton>
				<ToggleButton x:Name="tellipse" Style="{StaticResource WxIconToggle}" ToolTip="椭圆">
					<Path Stroke="#1A1A1A" StrokeThickness="2.2" Fill="Transparent"
					      Stretch="Uniform" Width="18" Height="18"
					      Data="M9,2.5 A6.5,6.5 0 1 1 8.99,2.5 Z"/>
				</ToggleButton>
				<ToggleButton x:Name="tarrow" Style="{StaticResource WxIconToggle}" ToolTip="箭头">
					<!-- FontAwesome 风格箭头 -->
					<Path Stroke="#1A1A1A" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
					      StrokeLineJoin="Round" Fill="Transparent" Stretch="Uniform" Width="18" Height="18"
					      Data="M3,15 L15,3 M8,3 H15 V10"/>
				</ToggleButton>
				<ToggleButton x:Name="tline" Style="{StaticResource WxIconToggle}" ToolTip="画笔（自由绘制）">
					<!-- 画笔笔尖 -->
					<Path Stroke="#1A1A1A" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
					      StrokeLineJoin="Round" Fill="Transparent" Stretch="Uniform" Width="18" Height="18"
					      Data="M3,14 L6,11 L13,4 L15,6 L8,13 L5,16 Z M11.5,5.5 L13.5,7.5"/>
				</ToggleButton>
				<ToggleButton x:Name="ttext" Style="{StaticResource WxIconToggle}" ToolTip="文字">
					<TextBlock Text="T" FontSize="17" FontWeight="Bold" FontFamily="Segoe UI"/>
				</ToggleButton>

				<Border Width="1" Height="22" Background="#E0E0E0" Margin="8,0" VerticalAlignment="Center"/>

				<!-- 颜色 -->
				<RadioButton x:Name="crred" Style="{StaticResource WxColorDot}" Background="#FA5151"
				             IsChecked="True" GroupName="annColor" ToolTip="红" Tag="#FA5151"/>
				<RadioButton x:Name="cryellow" Style="{StaticResource WxColorDot}" Background="#FFC300"
				             GroupName="annColor" ToolTip="黄" Tag="#FFC300"/>
				<RadioButton x:Name="crgreen" Style="{StaticResource WxColorDot}" Background="#07C160"
				             GroupName="annColor" ToolTip="绿" Tag="#07C160"/>
				<RadioButton x:Name="crblue" Style="{StaticResource WxColorDot}" Background="#10AEFF"
				             GroupName="annColor" ToolTip="蓝" Tag="#10AEFF"/>
				<RadioButton x:Name="crwhite" Style="{StaticResource WxColorDot}" Background="#FFFFFF"
				             GroupName="annColor" ToolTip="白" Tag="#FFFFFF"
				             BorderBrush="#CCCCCC"/>
				<!-- 线粗 -->
				<ComboBox x:Name="ethick" Width="52" Height="28" Margin="8,0,0,0"
				          VerticalContentAlignment="Center" FontSize="12"
				          BorderThickness="0" Background="Transparent" ToolTip="线粗">
					<ComboBoxItem Content="1" Tag="1"/>
					<ComboBoxItem Content="2" Tag="2"/>
					<ComboBoxItem Content="3" Tag="3" IsSelected="True"/>
					<ComboBoxItem Content="4" Tag="4"/>
					<ComboBoxItem Content="6" Tag="6"/>
					<ComboBoxItem Content="8" Tag="8"/>
				</ComboBox>
				<!-- 字号 -->
				<ComboBox x:Name="efont" Width="48" Height="28" Margin="4,0,0,0"
				          VerticalContentAlignment="Center" FontSize="12"
				          BorderThickness="0" Background="Transparent" ToolTip="字号">
					<ComboBoxItem Content="14" Tag="14"/>
					<ComboBoxItem Content="18" Tag="18" IsSelected="True"/>
					<ComboBoxItem Content="24" Tag="24"/>
					<ComboBoxItem Content="32" Tag="32"/>
				</ComboBox>

				<Border Width="1" Height="22" Background="#E0E0E0" Margin="8,0" VerticalAlignment="Center"/>

				<!-- 操作：撤销 · 保存 · OCR 识图 · 取消 · 完成 -->
				<Button x:Name="bundo" Style="{StaticResource WxIconBtn}" ToolTip="撤销 (Ctrl+Z)">
					<Path Stroke="#1A1A1A" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
					      StrokeLineJoin="Round" Fill="Transparent" Stretch="Uniform" Width="16" Height="16"
					      Data="M3,7 H11 A4,4 0 1 1 11,15 H6 M3,7 L6,4 M3,7 L6,10"/>
				</Button>
				<Button x:Name="bsave" Style="{StaticResource WxIconBtn}" ToolTip="保存到文件">
					<!-- FontAwesome download：托盘 + 向下箭头 -->
					<Path Fill="#1A1A1A" Stretch="Uniform" Width="16" Height="16"
					      Data="M8,1 V9.2 L5.2,6.4 4,7.6 8.5,12.1 13,7.6 11.8,6.4 9,9.2 V1 Z M2,13 V15 H15 V13 H2 Z"/>
				</Button>
				<!-- OCR 识图：完成标注并识别 -->
				<Button x:Name="bocr" Style="{StaticResource WxIconBtn}" ToolTip="截图并识别 (OCR)"
				        Width="40" Height="36" Margin="2,0,1,0"
				        AutomationProperties.AutomationId="overlay.ocr"
				        AutomationProperties.Name="OCR识图">
					<Border Background="#3B82F6" CornerRadius="5" Padding="4,3" MinWidth="30">
						<TextBlock Text="OCR" FontSize="10" FontWeight="Bold" Foreground="White"
						           FontFamily="Segoe UI, Microsoft YaHei UI"
						           HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Border>
				</Button>
				<Button x:Name="bcancel" Style="{StaticResource WxIconBtn}" ToolTip="取消 (Esc)" Margin="4,0,1,0">
					<Path Stroke="#FA5151" StrokeThickness="2.2" StrokeStartLineCap="Round"
					      Fill="Transparent" Stretch="Uniform" Width="14" Height="14"
					      Data="M2,2 L12,12 M12,2 L2,12"/>
				</Button>
				<!-- 完成：对勾 + 下拉（复制为图片/文件/路径） -->
				<Button x:Name="bok" Style="{StaticResource WxIconBtn}" ToolTip="完成并复制 (Enter)"
				        Width="36" Height="36" Margin="1,0,0,0"
				        AutomationProperties.AutomationId="overlay.ok"
				        AutomationProperties.Name="完成并复制">
					<Path Stroke="#07C160" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
					      StrokeLineJoin="Round" Fill="Transparent" Stretch="Uniform" Width="16" Height="16"
					      Data="M2,8.5 L6.5,13 L14,3.5"/>
				</Button>
				<Button x:Name="bcopydrop" Style="{StaticResource WxIconBtn}" ToolTip="复制方式"
				        Width="22" Height="36" Margin="0,0,1,0" Padding="0"
				        AutomationProperties.AutomationId="overlay.copydrop"
				        AutomationProperties.Name="复制方式下拉">
					<!-- 下拉三角；菜单在 Resources，由代码 PlacementTarget 打开 -->
					<Path Fill="#07C160" Stretch="Uniform" Width="10" Height="6"
					      Data="M0,0 L10,0 L5,6 Z"/>
				</Button>
			</StackPanel>
		</Border>
		<!-- 隐藏兼容：旧代码可能引用 ecolor -->
		<ComboBox x:Name="ecolor" Visibility="Collapsed">
			<ComboBoxItem Content="红" Tag="#FA5151" IsSelected="True"/>
		</ComboBox>
		<!-- 复制方式下拉面板（同窗内，避免 Topmost 下 ContextMenu 立刻被关掉） -->
		<Border x:Name="pcopyas" Visibility="Collapsed" Background="#FFFFFFF2" CornerRadius="10"
		        BorderBrush="#E8E8E8" BorderThickness="1" Padding="4"
		        SnapsToDevicePixels="True">
			<Border.Effect>
				<DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.16" Color="#000000"/>
			</Border.Effect>
			<StackPanel>
				<Button x:Name="mncopyimg" Style="{StaticResource WxIconBtn}" Height="32" Width="Auto"
				        MinWidth="132" HorizontalContentAlignment="Left" Padding="10,0"
				        Margin="0,0,0,2" FontSize="13"
				        AutomationProperties.AutomationId="overlay.copy.img"
				        Content="复制为图片"/>
				<Button x:Name="mncopyfile" Style="{StaticResource WxIconBtn}" Height="32" Width="Auto"
				        MinWidth="132" HorizontalContentAlignment="Left" Padding="10,0"
				        Margin="0,0,0,2" FontSize="13"
				        AutomationProperties.AutomationId="overlay.copy.file"
				        Content="复制为文件"/>
				<Button x:Name="mncopypath" Style="{StaticResource WxIconBtn}" Height="32" Width="Auto"
				        MinWidth="132" HorizontalContentAlignment="Left" Padding="10,0"
				        FontSize="13"
				        AutomationProperties.AutomationId="overlay.copy.path"
				        Content="复制为路径"/>
			</StackPanel>
		</Border>
		<!-- 提示 -->
		<Border x:Name="bhint" Background="#CC111827" CornerRadius="8" Padding="12,8"
		        Canvas.Left="24" Canvas.Top="24">
			<TextBlock x:Name="lbcap" Text="单击标注 · 双击完成 · 拖拽框选(可跨屏) · Ctrl+C 复制色值 · Esc 取消"
			           Foreground="White" FontSize="14"/>
		</Border>
	</Canvas>
</Window>
