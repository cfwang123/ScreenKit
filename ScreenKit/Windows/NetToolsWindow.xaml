<Window x:Class="ScreenKit.NetToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="网络工具"
        Width="720" Height="600"
        MinWidth="520" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BgApp}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        AutomationProperties.AutomationId="nettool.window">
	<Grid Margin="16">
		<TabControl x:Name="tabs" BorderBrush="{StaticResource BorderSoft}"
		            AutomationProperties.AutomationId="nettool.tabs">
			<TabItem x:Name="tabdiag" Header="诊断"
			         AutomationProperties.AutomationId="nettool.tab.diag">
				<Grid Margin="12">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>
					<Grid Grid.Row="0" Margin="0,0,0,10">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="12"/>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="56"/>
						</Grid.ColumnDefinitions>
						<TextBlock x:Name="lbhost" Text="主机" VerticalAlignment="Center" Margin="0,0,8,0"/>
						<TextBox x:Name="ehost" Grid.Column="1" Height="32" Padding="8,4"
						         BorderBrush="{StaticResource BorderSoft}"
						         VerticalContentAlignment="Center"
						         AutomationProperties.AutomationId="nettool.host"/>
						<TextBlock x:Name="lbcount" Grid.Column="3" Text="Ping 次数" VerticalAlignment="Center" Margin="0,0,8,0"/>
						<TextBox x:Name="ecount" Grid.Column="4" Height="32" Padding="6,4" Text="4"
						         BorderBrush="{StaticResource BorderSoft}"
						         VerticalContentAlignment="Center"
						         AutomationProperties.AutomationId="nettool.count"/>
					</Grid>
					<WrapPanel Grid.Row="1" Margin="0,0,0,10">
						<Button x:Name="bping" Style="{StaticResource ToolBtn}" Margin="0,0,6,6"
						        AutomationProperties.AutomationId="nettool.ping"/>
						<Button x:Name="bdns" Style="{StaticResource ToolBtn}" Margin="0,0,6,6"
						        AutomationProperties.AutomationId="nettool.dns"/>
						<Button x:Name="bdnsrec" Style="{StaticResource ToolBtn}" Margin="0,0,6,6"
						        AutomationProperties.AutomationId="nettool.dnsrec"/>
						<Button x:Name="bport" Style="{StaticResource ToolBtn}" Margin="0,0,6,6"
						        AutomationProperties.AutomationId="nettool.port"/>
						<Button x:Name="blocal" Style="{StaticResource ToolBtn}" Margin="0,0,6,6"
						        AutomationProperties.AutomationId="nettool.local"/>
						<Button x:Name="bwake" Style="{StaticResource ToolBtn}" Margin="0,0,6,6"
						        AutomationProperties.AutomationId="nettool.wake"/>
						<Button x:Name="barp" Style="{StaticResource ToolBtn}" Margin="0,0,6,6"
						        AutomationProperties.AutomationId="nettool.arp"/>
						<Button x:Name="barprev" Style="{StaticResource ToolBtn}" Margin="0,0,6,6"
						        AutomationProperties.AutomationId="nettool.arprev"/>
						<Button x:Name="bwhois" Style="{StaticResource ToolBtn}" Margin="0,0,6,6"
						        AutomationProperties.AutomationId="nettool.whois"/>
						<Button x:Name="btrace" Style="{StaticResource ToolBtn}" Margin="0,0,6,6"
						        AutomationProperties.AutomationId="nettool.trace"/>
						<Button x:Name="blocate" Style="{StaticResource ToolBtn}" Margin="0,0,6,6"
						        AutomationProperties.AutomationId="nettool.locate"/>
						<Button x:Name="bproxy" Style="{StaticResource ToolBtn}" Margin="0,0,6,6"
						        AutomationProperties.AutomationId="nettool.proxy"/>
						<Button x:Name="bipcity" Style="{StaticResource ToolBtn}" Margin="0,0,6,6"
						        AutomationProperties.AutomationId="nettool.ipcity"/>
						<Button x:Name="bmac" Style="{StaticResource ToolBtn}" Margin="0,0,6,6"
						        AutomationProperties.AutomationId="nettool.mac"/>
						<Button x:Name="busb" Style="{StaticResource ToolBtn}" Margin="0,0,6,6"
						        AutomationProperties.AutomationId="nettool.usb"/>
						<Button x:Name="bhttp" Style="{StaticResource ToolBtn}" Margin="0,0,6,6"
						        AutomationProperties.AutomationId="nettool.http"/>
						<Button x:Name="bgeo" Style="{StaticResource ToolBtn}" Margin="0,0,6,6"
						        AutomationProperties.AutomationId="nettool.geo"/>
						<Button x:Name="bscan" Style="{StaticResource ToolBtn}" Margin="0,0,6,6"
						        AutomationProperties.AutomationId="nettool.scan"/>
						<Button x:Name="bdiscover" Style="{StaticResource ToolBtn}" Margin="0,0,6,6"
						        AutomationProperties.AutomationId="nettool.discover"/>
						<Button x:Name="bmap" Style="{StaticResource ToolBtn}" Margin="0,0,6,6" IsEnabled="False"
						        AutomationProperties.AutomationId="nettool.map"/>
						<Button x:Name="bstop" Style="{StaticResource ToolBtn}" Margin="0,0,6,6"
						        AutomationProperties.AutomationId="nettool.stop"/>
					</WrapPanel>
					<RichTextBox x:Name="eout" Grid.Row="2" IsReadOnly="True" IsDocumentEnabled="True"
					             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
					             FontFamily="Consolas, Cascadia Mono, Microsoft YaHei UI" FontSize="13"
					             Padding="8" BorderBrush="{StaticResource BorderSoft}"
					             AutomationProperties.AutomationId="nettool.out">
						<FlowDocument PagePadding="0" FontFamily="Consolas, Cascadia Mono, Microsoft YaHei UI" FontSize="13"/>
					</RichTextBox>
					<TextBlock x:Name="lbstat" Grid.Row="3" Margin="0,8,0,8" Foreground="{StaticResource TextMuted}"/>
					<DockPanel Grid.Row="4">
						<Button x:Name="bclear" Style="{StaticResource ToolBtn}"/>
						<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
							<Button x:Name="bcopy" Style="{StaticResource ToolBtn}"/>
							<Button x:Name="bclose" Style="{StaticResource ToolBtn}"/>
						</StackPanel>
					</DockPanel>
				</Grid>
			</TabItem>
			<TabItem x:Name="tabpscan" Header="端口扫描"
			         AutomationProperties.AutomationId="nettool.tab.pscan">
				<Grid Margin="12">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>
					<Grid Grid.Row="0" Margin="0,0,0,10">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="12"/>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="2*"/>
						</Grid.ColumnDefinitions>
						<TextBlock x:Name="lbpsip" Text="IP" VerticalAlignment="Center" Margin="0,0,8,0"/>
						<TextBox x:Name="epsip" Grid.Column="1" Height="32" Padding="8,4"
						         BorderBrush="{StaticResource BorderSoft}"
						         VerticalContentAlignment="Center"
						         AutomationProperties.AutomationId="nettool.pscan.ip"/>
						<TextBlock x:Name="lbpsports" Grid.Column="3" Text="端口范围" VerticalAlignment="Center" Margin="0,0,8,0"/>
						<TextBox x:Name="epsports" Grid.Column="4" Height="32" Padding="8,4" Text="1-1024"
						         BorderBrush="{StaticResource BorderSoft}"
						         VerticalContentAlignment="Center"
						         AutomationProperties.AutomationId="nettool.pscan.ports"/>
					</Grid>
					<WrapPanel Grid.Row="1" Margin="0,0,0,10">
						<Button x:Name="bpstart" Style="{StaticResource ToolBtn}" Margin="0,0,6,6"
						        AutomationProperties.AutomationId="nettool.pscan.start"/>
						<Button x:Name="bpstop" Style="{StaticResource ToolBtn}" Margin="0,0,6,6"
						        AutomationProperties.AutomationId="nettool.pscan.stop"/>
					</WrapPanel>
					<TextBox x:Name="epsout" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
					         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
					         FontFamily="Consolas, Cascadia Mono, Microsoft YaHei UI" FontSize="13"
					         Padding="8" BorderBrush="{StaticResource BorderSoft}"
					         AutomationProperties.AutomationId="nettool.pscan.out"/>
					<TextBlock x:Name="lbpsstat" Grid.Row="3" Margin="0,8,0,8" Foreground="{StaticResource TextMuted}"/>
					<DockPanel Grid.Row="4">
						<Button x:Name="bpsclear" Style="{StaticResource ToolBtn}"/>
						<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
							<Button x:Name="bpscopy" Style="{StaticResource ToolBtn}"/>
							<Button x:Name="bpsclose" Style="{StaticResource ToolBtn}"/>
						</StackPanel>
					</DockPanel>
				</Grid>
			</TabItem>
		</TabControl>
	</Grid>
</Window>
