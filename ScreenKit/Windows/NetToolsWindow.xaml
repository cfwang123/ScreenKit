<Window x:Class="ScreenKit.NetToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="网络工具"
        Width="880" Height="640"
        MinWidth="700" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BgApp}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        AutomationProperties.AutomationId="nettool.window">
	<Window.Resources>
		<Style x:Key="NetCard" TargetType="Border">
			<Setter Property="Background" Value="{StaticResource BgPanel}"/>
			<Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="10"/>
		</Style>

		<Style x:Key="NetGrp" TargetType="TextBlock">
			<Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Margin" Value="0,0,12,4"/>
		</Style>

		<Style x:Key="NetInput" TargetType="TextBox">
			<Setter Property="Height" Value="32"/>
			<Setter Property="Padding" Value="9,0"/>
			<Setter Property="Background" Value="{StaticResource BgPanel}"/>
			<Setter Property="BorderBrush" Value="#DCE3EC"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="TextBox">
						<Border x:Name="bd" Background="{TemplateBinding Background}"
						        BorderBrush="{TemplateBinding BorderBrush}"
						        BorderThickness="{TemplateBinding BorderThickness}"
						        CornerRadius="8">
							<ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
							              VerticalAlignment="Center" Focusable="False"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsKeyboardFocusWithin" Value="True">
								<Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter Property="Opacity" Value="0.5"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="NetColHead" TargetType="GridViewColumnHeader">
			<Setter Property="HorizontalContentAlignment" Value="Left"/>
			<Setter Property="Padding" Value="10,7"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="FontWeight" Value="Normal"/>
			<Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
			<Setter Property="Background" Value="#F7F9FC"/>
			<Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
			<Setter Property="BorderThickness" Value="0,0,0,1"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="GridViewColumnHeader">
						<Border x:Name="bd" Background="{TemplateBinding Background}"
						        BorderBrush="{TemplateBinding BorderBrush}"
						        BorderThickness="{TemplateBinding BorderThickness}"
						        Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bd" Property="Background" Value="#EFF3F9"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- 文字链接式按钮：透明底，悬停加下划线 -->
		<Style x:Key="NetLink" TargetType="Button">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Foreground" Value="#2563EB"/>
			<Setter Property="Padding" Value="8,6"/>
			<Setter Property="Margin" Value="0,0,6,4"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="MinHeight" Value="30"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="HorizontalContentAlignment" Value="Left"/>
			<Setter Property="SnapsToDevicePixels" Value="True"/>
			<Setter Property="ContentTemplate">
				<Setter.Value>
					<DataTemplate>
						<TextBlock Text="{Binding}" TextWrapping="Wrap">
							<TextBlock.Style>
								<Style TargetType="TextBlock">
									<Style.Triggers>
										<DataTrigger Value="True"
										             Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Button}}}">
											<Setter Property="TextDecorations" Value="Underline"/>
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</TextBlock.Style>
						</TextBlock>
					</DataTemplate>
				</Setter.Value>
			</Setter>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="bd" Background="{TemplateBinding Background}"
						        CornerRadius="6" Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
							                  VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bd" Property="Background" Value="#F1F6FD"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="bd" Property="Background" Value="#E4EEFB"/>
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter Property="Opacity" Value="0.42"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="NetBar" TargetType="ProgressBar">
			<Setter Property="Height" Value="6"/>
			<Setter Property="Background" Value="#E9EEF5"/>
			<Setter Property="Foreground" Value="{StaticResource Accent}"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ProgressBar">
						<Border Background="{TemplateBinding Background}" CornerRadius="3">
							<Grid x:Name="PART_Track">
								<Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
								        CornerRadius="3" HorizontalAlignment="Left"/>
							</Grid>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="NetTabItem" TargetType="TabItem">
			<Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="TabItem">
						<Grid>
							<Border x:Name="bd" Background="Transparent" CornerRadius="8,8,0,0" Padding="15,8" Margin="0,0,2,0">
								<ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
							<Border x:Name="ul" Height="2" VerticalAlignment="Bottom" Background="Transparent"
							        CornerRadius="1" Margin="12,0,12,0"/>
						</Grid>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bd" Property="Background" Value="#EAEFF6"/>
								<Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
							</Trigger>
							<Trigger Property="IsSelected" Value="True">
								<Setter TargetName="ul" Property="Background" Value="{StaticResource Accent}"/>
								<Setter Property="Foreground" Value="{StaticResource Accent}"/>
								<Setter Property="FontWeight" Value="SemiBold"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="NetTab" TargetType="TabControl">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="TabControl">
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="*"/>
							</Grid.RowDefinitions>
							<TabPanel Grid.Row="0" IsItemsHost="True" Margin="0,0,0,8"/>
							<Border Grid.Row="1" Style="{StaticResource NetCard}">
								<ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
							</Border>
						</Grid>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<Grid Margin="16">
		<TabControl x:Name="tabs" Style="{StaticResource NetTab}"
		            AutomationProperties.AutomationId="nettool.tabs">
			<TabItem x:Name="tabdiag" Header="诊断" Style="{StaticResource NetTabItem}"
			         AutomationProperties.AutomationId="nettool.tab.diag">
				<Grid Margin="16">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>
					<Grid Grid.Row="0" Margin="0,0,0,10">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" MinWidth="56"/>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>
						<TextBlock x:Name="lbhost" Text="主机" Style="{StaticResource NetGrp}"/>
						<TextBox x:Name="ehost" Grid.Column="1" Style="{StaticResource NetInput}" Margin="0,0,12,4"
						         AutomationProperties.AutomationId="nettool.host"/>
						<TextBlock x:Name="lbcount" Grid.Column="2" Text="Ping 次数" Style="{StaticResource NetGrp}"
						           Margin="0,0,8,4"/>
						<TextBox x:Name="ecount" Grid.Column="3" Width="56" Text="4" Style="{StaticResource NetInput}"
						         Margin="0,0,14,4"
						         AutomationProperties.AutomationId="nettool.count"/>
						<Button x:Name="bstop" Grid.Column="4" Style="{StaticResource ToolBtn}" VerticalAlignment="Center"
						        Margin="0,0,0,4"
						        AutomationProperties.AutomationId="nettool.stop"/>
					</Grid>

					<Grid Grid.Row="1">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" MinWidth="56"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
						</Grid.RowDefinitions>

						<TextBlock x:Name="lbgrpdiag" Text="诊断" Style="{StaticResource NetGrp}"/>
						<WrapPanel Grid.Column="1">
							<Button x:Name="bping" Style="{StaticResource NetLink}" Margin="0,0,4,4"
							        AutomationProperties.AutomationId="nettool.ping"/>
							<Button x:Name="bdns" Style="{StaticResource NetLink}" Margin="0,0,4,4"
							        AutomationProperties.AutomationId="nettool.dns"/>
							<Button x:Name="bdnsrec" Style="{StaticResource NetLink}" Margin="0,0,4,4"
							        AutomationProperties.AutomationId="nettool.dnsrec"/>
							<Button x:Name="bport" Style="{StaticResource NetLink}" Margin="0,0,4,4"
							        AutomationProperties.AutomationId="nettool.port"/>
							<Button x:Name="btrace" Style="{StaticResource NetLink}" Margin="0,0,4,4"
							        AutomationProperties.AutomationId="nettool.trace"/>
						</WrapPanel>

						<TextBlock x:Name="lbgrplocal" Text="局域网" Grid.Row="1" Style="{StaticResource NetGrp}"/>
						<WrapPanel Grid.Row="1" Grid.Column="1">
							<Button x:Name="blocal" Style="{StaticResource NetLink}" Margin="0,0,4,4"
							        AutomationProperties.AutomationId="nettool.local"/>
							<Button x:Name="barp" Style="{StaticResource NetLink}" Margin="0,0,4,4"
							        AutomationProperties.AutomationId="nettool.arp"/>
							<Button x:Name="barprev" Style="{StaticResource NetLink}" Margin="0,0,4,4"
							        AutomationProperties.AutomationId="nettool.arprev"/>
							<Button x:Name="bwake" Style="{StaticResource NetLink}" Margin="0,0,4,4"
							        AutomationProperties.AutomationId="nettool.wake"/>
							<Button x:Name="bscan" Style="{StaticResource NetLink}" Margin="0,0,4,4"
							        AutomationProperties.AutomationId="nettool.scan"/>
						</WrapPanel>

						<TextBlock x:Name="lbgrpquery" Text="查询" Grid.Row="2" Style="{StaticResource NetGrp}"/>
						<WrapPanel Grid.Row="2" Grid.Column="1">
							<Button x:Name="bwhois" Style="{StaticResource NetLink}" Margin="0,0,4,4"
							        AutomationProperties.AutomationId="nettool.whois"/>
							<Button x:Name="bipcity" Style="{StaticResource NetLink}" Margin="0,0,4,4"
							        AutomationProperties.AutomationId="nettool.ipcity"/>
							<Button x:Name="bmac" Style="{StaticResource NetLink}" Margin="0,0,4,4"
							        AutomationProperties.AutomationId="nettool.mac"/>
							<Button x:Name="busb" Style="{StaticResource NetLink}" Margin="0,0,4,4"
							        AutomationProperties.AutomationId="nettool.usb"/>
							<Button x:Name="bdiscover" Style="{StaticResource NetLink}" Margin="0,0,4,4"
							        AutomationProperties.AutomationId="nettool.discover"/>
						</WrapPanel>

						<TextBlock x:Name="lbgrplocate" Text="定位" Grid.Row="3" Style="{StaticResource NetGrp}"/>
						<WrapPanel Grid.Row="3" Grid.Column="1">
							<Button x:Name="blocate" Style="{StaticResource NetLink}" Margin="0,0,4,4"
							        AutomationProperties.AutomationId="nettool.locate"/>
							<Button x:Name="bproxy" Style="{StaticResource NetLink}" Margin="0,0,4,4"
							        AutomationProperties.AutomationId="nettool.proxy"/>
							<Button x:Name="bhttp" Style="{StaticResource NetLink}" Margin="0,0,4,4"
							        AutomationProperties.AutomationId="nettool.http"/>
							<Button x:Name="bgeo" Style="{StaticResource NetLink}" Margin="0,0,4,4"
							        AutomationProperties.AutomationId="nettool.geo"/>
							<Button x:Name="bmap" Style="{StaticResource NetLink}" Margin="0,0,4,4" IsEnabled="False"
							        AutomationProperties.AutomationId="nettool.map"/>
						</WrapPanel>
					</Grid>

					<Border Grid.Row="2" Style="{StaticResource NetCard}" Background="#FCFDFE">
						<RichTextBox x:Name="eout" IsReadOnly="True" IsDocumentEnabled="True"
						             Background="Transparent" BorderThickness="0"
						             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
						             FontFamily="Consolas, Cascadia Mono, Microsoft YaHei UI" FontSize="13"
						             Padding="10" Margin="1"
						             AutomationProperties.AutomationId="nettool.out">
							<FlowDocument PagePadding="0" FontFamily="Consolas, Cascadia Mono, Microsoft YaHei UI" FontSize="13"/>
						</RichTextBox>
					</Border>
					<TextBlock x:Name="lbstat" Grid.Row="3" Margin="2,8,0,0" MinHeight="16" FontSize="12"
					           Foreground="{StaticResource TextMuted}"/>
					<DockPanel Grid.Row="4" Margin="0,10,0,0">
						<Button x:Name="bclear" Style="{StaticResource ToolBtn}"/>
						<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
							<Button x:Name="bcopy" Style="{StaticResource ToolBtn}"/>
							<Button x:Name="bclose" Style="{StaticResource ToolBtn}" Margin="0"/>
						</StackPanel>
					</DockPanel>
				</Grid>
			</TabItem>

			<TabItem x:Name="tabip" Header="IP扫描" Style="{StaticResource NetTabItem}"
			         AutomationProperties.AutomationId="nettool.tab.ip">
				<Grid Margin="16">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>
					<Grid Grid.Row="0" Margin="0,0,0,10">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>
						<StackPanel Orientation="Horizontal">
							<Button x:Name="bistart" Style="{StaticResource ToolBtn}" Margin="0,0,6,0"
							        AutomationProperties.AutomationId="nettool.ip.start"/>
							<Button x:Name="bistop" Style="{StaticResource ToolBtn}" Margin="0"
							        AutomationProperties.AutomationId="nettool.ip.stop"/>
						</StackPanel>
						<Button x:Name="biport" Grid.Column="2" Style="{StaticResource ToolBtn}"
						        VerticalAlignment="Center"
						        AutomationProperties.AutomationId="nettool.ip.toport"/>
					</Grid>
					<ProgressBar x:Name="isbar" Grid.Row="1" Style="{StaticResource NetBar}" Minimum="0" Maximum="1" Value="0"
					             Margin="0,0,0,12"
					             AutomationProperties.AutomationId="nettool.ip.bar"/>
					<Border Grid.Row="2" Style="{StaticResource NetCard}">
						<ListView x:Name="lvip" BorderThickness="0" Background="Transparent" Margin="1"
						          SelectionMode="Single"
						          FontFamily="Consolas, Cascadia Mono, Microsoft YaHei UI"
						          AutomationProperties.AutomationId="nettool.ip.list">
							<ListView.ContextMenu>
								<ContextMenu>
									<MenuItem x:Name="mnipname" Header="复制主机名(_N)"
									          AutomationProperties.AutomationId="nettool.ip.copy.name"/>
									<MenuItem x:Name="mnipaddr" Header="复制 IP(_I)"
									          AutomationProperties.AutomationId="nettool.ip.copy.ip"/>
									<MenuItem x:Name="mnipmac" Header="复制 MAC(_M)"
									          AutomationProperties.AutomationId="nettool.ip.copy.mac"/>
								</ContextMenu>
							</ListView.ContextMenu>
							<ListView.View>
								<GridView>
									<GridViewColumn x:Name="colipname" Header="主机名" Width="220"
									                HeaderContainerStyle="{StaticResource NetColHead}"
									                DisplayMemberBinding="{Binding Name}"/>
									<GridViewColumn x:Name="colipaddr" Header="IP" Width="140"
									                HeaderContainerStyle="{StaticResource NetColHead}"
									                DisplayMemberBinding="{Binding Ip}"/>
									<GridViewColumn x:Name="colipmac" Header="MAC" Width="180"
									                HeaderContainerStyle="{StaticResource NetColHead}"
									                DisplayMemberBinding="{Binding Mac}"/>
								</GridView>
							</ListView.View>
						</ListView>
					</Border>
					<TextBlock x:Name="lbistat" Grid.Row="3" Margin="2,8,0,0" MinHeight="16" FontSize="12"
					           Foreground="{StaticResource TextMuted}"/>
					<DockPanel Grid.Row="4" Margin="0,10,0,0">
						<Button x:Name="biclear" Style="{StaticResource ToolBtn}"/>
						<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
							<Button x:Name="bicopy" Style="{StaticResource ToolBtn}"/>
							<Button x:Name="biclose" Style="{StaticResource ToolBtn}" Margin="0"/>
						</StackPanel>
					</DockPanel>
				</Grid>
			</TabItem>

			<TabItem x:Name="tabpscan" Header="端口扫描" Style="{StaticResource NetTabItem}"
			         AutomationProperties.AutomationId="nettool.tab.pscan">
				<Grid Margin="16">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>
					<Grid Grid.Row="0" Margin="0,0,0,10">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="2*"/>
						</Grid.ColumnDefinitions>
						<TextBlock x:Name="lbpsip" Text="IP" Style="{StaticResource NetGrp}"/>
						<TextBox x:Name="epsip" Grid.Column="1" Style="{StaticResource NetInput}" Margin="0,0,6,4"
						         AutomationProperties.AutomationId="nettool.pscan.ip"/>
						<TextBlock x:Name="lbpsports" Grid.Column="2" Text="端口范围" Style="{StaticResource NetGrp}"
						           Margin="10,0,8,4"/>
						<TextBox x:Name="epsports" Grid.Column="3" Text="1-1024" Style="{StaticResource NetInput}"
						         Margin="0,0,6,4"
						         AutomationProperties.AutomationId="nettool.pscan.ports"/>
					</Grid>
					<Grid Grid.Row="1" Margin="0,0,0,10">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>
						<StackPanel Orientation="Horizontal">
							<Button x:Name="bpstart" Style="{StaticResource ToolBtn}" Margin="0,0,6,0"
							        AutomationProperties.AutomationId="nettool.pscan.start"/>
							<Button x:Name="bpstop" Style="{StaticResource ToolBtn}" Margin="0"
							        AutomationProperties.AutomationId="nettool.pscan.stop"/>
						</StackPanel>
						<StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
							<Button x:Name="bpcommon" Style="{StaticResource ToolBtn}" Margin="0,0,12,0"
							        AutomationProperties.AutomationId="nettool.pscan.common"/>
							<TextBlock x:Name="lbptimeout" Text="超时" Style="{StaticResource NetGrp}" Margin="0,0,8,0"/>
							<TextBox x:Name="eptimeout" Width="72" Text="400" Style="{StaticResource NetInput}"
							         AutomationProperties.AutomationId="nettool.pscan.timeout"/>
						</StackPanel>
					</Grid>
					<ProgressBar x:Name="psbar" Grid.Row="2" Style="{StaticResource NetBar}" Minimum="0" Maximum="1" Value="0"
					             Margin="0,0,0,12"
					             AutomationProperties.AutomationId="nettool.pscan.bar"/>
					<Border Grid.Row="3" Style="{StaticResource NetCard}">
						<ListView x:Name="lvps" BorderThickness="0" Background="Transparent" Margin="1"
						          SelectionMode="Single"
						          FontFamily="Consolas, Cascadia Mono, Microsoft YaHei UI"
						          AutomationProperties.AutomationId="nettool.pscan.list">
							<ListView.View>
								<GridView>
									<GridViewColumn x:Name="colpsport" Header="端口" Width="120"
									                HeaderContainerStyle="{StaticResource NetColHead}"
									                DisplayMemberBinding="{Binding Port}"/>
									<GridViewColumn x:Name="colpskind" Header="类型" Width="120"
									                HeaderContainerStyle="{StaticResource NetColHead}"
									                DisplayMemberBinding="{Binding Kind}"/>
									<GridViewColumn x:Name="colpsbanner" Header="标识" Width="280"
									                HeaderContainerStyle="{StaticResource NetColHead}"
									                DisplayMemberBinding="{Binding Banner}"/>
								</GridView>
							</ListView.View>
						</ListView>
					</Border>
					<TextBlock x:Name="lbpsstat" Grid.Row="4" Margin="2,8,0,0" MinHeight="16" FontSize="12"
					           Foreground="{StaticResource TextMuted}"/>
					<DockPanel Grid.Row="5" Margin="0,10,0,0">
						<Button x:Name="bpsclear" Style="{StaticResource ToolBtn}"/>
						<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
							<Button x:Name="bpscopy" Style="{StaticResource ToolBtn}"/>
							<Button x:Name="bpsclose" Style="{StaticResource ToolBtn}" Margin="0"/>
						</StackPanel>
					</DockPanel>
				</Grid>
			</TabItem>
		</TabControl>
	</Grid>
</Window>
