<Window x:Class="ScreenKit.WinTopWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="窗口管理"
        Width="1180" Height="780"
        MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BgApp}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="13"
        AutomationProperties.AutomationId="wintop.window">
	<Window.Resources>
		<Style x:Key="propLabel" TargetType="TextBlock">
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
			<Setter Property="Margin" Value="0,3,8,3"/>
		</Style>
		<Style x:Key="propBox" TargetType="TextBox">
			<Setter Property="Height" Value="26"/>
			<Setter Property="Padding" Value="6,0"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
			<Setter Property="FontFamily" Value="Consolas, Microsoft YaHei UI"/>
			<Setter Property="FontSize" Value="12"/>
		</Style>
		<Style x:Key="propRead" TargetType="TextBox" BasedOn="{StaticResource propBox}">
			<Setter Property="IsReadOnly" Value="True"/>
			<Setter Property="Background" Value="{StaticResource BgToolbar}"/>
		</Style>
		<Style x:Key="actBtn" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
			<Setter Property="Padding" Value="9,4"/>
			<Setter Property="Margin" Value="0,0,4,4"/>
			<Setter Property="FontSize" Value="12"/>
		</Style>
	</Window.Resources>
	<Grid Margin="12">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- 顶栏 -->
		<Border Grid.Row="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderSoft}"
		        BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
			<DockPanel>
				<TextBlock x:Name="lbstat" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,2,0"
				           Foreground="{StaticResource TextMuted}" FontSize="12"/>
				<StackPanel>
					<TextBlock x:Name="lbhint" TextWrapping="Wrap" Margin="0,0,0,6"
					           Foreground="{StaticResource TextMuted}" FontSize="12"/>
					<WrapPanel VerticalAlignment="Center">
						<Button x:Name="bpick" Style="{StaticResource ToolBtn}" Margin="0,0,6,0"
						        AutomationProperties.AutomationId="wintop.pick"/>
						<Button x:Name="brefresh" Style="{StaticResource ToolBtn}"
						        AutomationProperties.AutomationId="wintop.refresh"/>
						<CheckBox x:Name="chidden" VerticalAlignment="Center" Margin="0,0,12,0"
						          AutomationProperties.AutomationId="wintop.hidden"/>
						<TextBlock x:Name="lbfilter" VerticalAlignment="Center" Margin="0,0,6,0"
						           Foreground="{StaticResource TextMuted}"/>
						<TextBox x:Name="efilter" Width="200" Height="30" Padding="8,4" Margin="0,0,8,0"
						         BorderBrush="{StaticResource BorderSoft}" VerticalContentAlignment="Center"
						         AutomationProperties.AutomationId="wintop.filter"/>
						<Button x:Name="bflash" Style="{StaticResource ToolBtn}"
						        AutomationProperties.AutomationId="wintop.flash"/>
						<Button x:Name="bcopyhwnd" Style="{StaticResource ToolBtn}"
						        AutomationProperties.AutomationId="wintop.copyhwnd"/>
						<Button x:Name="bcopyall" Style="{StaticResource ToolBtn}" Margin="0"
						        AutomationProperties.AutomationId="wintop.copyprops"/>
					</WrapPanel>
				</StackPanel>
			</DockPanel>
		</Border>

		<!-- 主体 -->
		<Grid Grid.Row="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="420" MinWidth="260"/>
				<ColumnDefinition Width="6"/>
				<ColumnDefinition Width="*" MinWidth="360"/>
			</Grid.ColumnDefinitions>

			<!-- 左：列表 / 树 -->
			<Border Grid.Column="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderSoft}"
			        BorderThickness="1" CornerRadius="8" Padding="4">
				<TabControl x:Name="tabmain" BorderThickness="0" Background="Transparent">
					<TabItem x:Name="tablist">
						<ListBox x:Name="lstwin" BorderThickness="0" Background="Transparent"
						         DisplayMemberPath="ListText"
						         FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"
						         ScrollViewer.HorizontalScrollBarVisibility="Auto"
						         VirtualizingPanel.IsVirtualizing="True"
						         VirtualizingPanel.VirtualizationMode="Recycling"
						         AutomationProperties.AutomationId="wintop.list"/>
					</TabItem>
					<TabItem x:Name="tabtree">
						<DockPanel>
							<StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,4">
								<Button x:Name="bloadtree" Style="{StaticResource ToolBtnSm}"
								        AutomationProperties.AutomationId="wintop.tree.load"/>
								<TextBlock x:Name="lbtree" VerticalAlignment="Center" Margin="6,0,0,0"
								           Foreground="{StaticResource TextMuted}" FontSize="12"/>
							</StackPanel>
							<TreeView x:Name="treewin" BorderThickness="0" Background="Transparent"
							          FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"
							          ScrollViewer.HorizontalScrollBarVisibility="Auto"
							          AutomationProperties.AutomationId="wintop.tree"/>
						</DockPanel>
					</TabItem>
				</TabControl>
			</Border>

			<GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

			<!-- 右：属性 / 操作 / 样式位 / 消息 -->
			<ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
				<StackPanel>
					<Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderSoft}"
					        BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
						<StackPanel>
							<TextBlock x:Name="lbprops" FontWeight="SemiBold" Margin="0,0,0,6"/>
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="64"/>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="64"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
								</Grid.RowDefinitions>

								<TextBlock Grid.Row="0" Grid.Column="0" x:Name="lbhwnd" Style="{StaticResource propLabel}"/>
								<TextBox Grid.Row="0" Grid.Column="1" x:Name="ehhwnd" Style="{StaticResource propRead}"
								         Margin="0,2,4,2" AutomationProperties.AutomationId="wintop.hwnd"/>
								<TextBlock Grid.Row="0" Grid.Column="2" x:Name="lbdec" Style="{StaticResource propLabel}"
								           Margin="4,3,8,3"/>
								<TextBox Grid.Row="0" Grid.Column="3" x:Name="ehdec" Style="{StaticResource propRead}" Margin="0,2"/>

								<TextBlock Grid.Row="1" Grid.Column="0" x:Name="lbtitle" Style="{StaticResource propLabel}"/>
								<TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" x:Name="ehtitle"
								         Style="{StaticResource propBox}" Margin="0,2"
								         AutomationProperties.AutomationId="wintop.title"/>

								<TextBlock Grid.Row="2" Grid.Column="0" x:Name="lbclass" Style="{StaticResource propLabel}"/>
								<TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" x:Name="ehclass"
								         Style="{StaticResource propRead}" Margin="0,2"/>

								<TextBlock Grid.Row="3" Grid.Column="0" x:Name="lbproc" Style="{StaticResource propLabel}"/>
								<TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" x:Name="ehproc"
								         Style="{StaticResource propRead}" Margin="0,2"/>

								<TextBlock Grid.Row="4" Grid.Column="0" x:Name="lbpath" Style="{StaticResource propLabel}"/>
								<TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" x:Name="ehpath"
								         Style="{StaticResource propRead}" Margin="0,2" TextWrapping="Wrap"
								         MinHeight="26" Height="Auto"/>

								<TextBlock Grid.Row="5" Grid.Column="0" x:Name="lbrect" Style="{StaticResource propLabel}"/>
								<WrapPanel Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,2" VerticalAlignment="Center">
									<TextBlock Text="X" VerticalAlignment="Center" Margin="0,0,4,0"/>
									<TextBox x:Name="erx" Style="{StaticResource propBox}" Width="62"/>
									<TextBlock Text="Y" VerticalAlignment="Center" Margin="6,0,4,0"/>
									<TextBox x:Name="ery" Style="{StaticResource propBox}" Width="62"/>
									<TextBlock Text="W" VerticalAlignment="Center" Margin="6,0,4,0"/>
									<TextBox x:Name="erw" Style="{StaticResource propBox}" Width="62"/>
									<TextBlock Text="H" VerticalAlignment="Center" Margin="6,0,4,0"/>
									<TextBox x:Name="erh" Style="{StaticResource propBox}" Width="62"/>
									<TextBlock x:Name="lbclient" VerticalAlignment="Center" Margin="10,0,0,0"
									           Foreground="{StaticResource TextMuted}" FontSize="12"/>
								</WrapPanel>

								<TextBlock Grid.Row="6" Grid.Column="0" x:Name="lbstate" Style="{StaticResource propLabel}"/>
								<TextBlock Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3" x:Name="lbstatev"
								           VerticalAlignment="Center" Margin="0,4" FontFamily="Consolas, Microsoft YaHei UI"
								           FontSize="12" TextWrapping="Wrap"/>

								<TextBlock Grid.Row="7" Grid.Column="0" x:Name="lbstyle" Style="{StaticResource propLabel}"/>
								<TextBox Grid.Row="7" Grid.Column="1" x:Name="ehstyle" Style="{StaticResource propRead}"
								         Margin="0,2,4,2"/>
								<TextBlock Grid.Row="7" Grid.Column="2" x:Name="lbexstyle" Style="{StaticResource propLabel}"
								           Margin="4,3,8,3"/>
								<TextBox Grid.Row="7" Grid.Column="3" x:Name="ehexstyle" Style="{StaticResource propRead}" Margin="0,2"/>

								<TextBlock Grid.Row="8" Grid.Column="0" x:Name="lbparent" Style="{StaticResource propLabel}"/>
								<TextBox Grid.Row="8" Grid.Column="1" x:Name="ehparent" Style="{StaticResource propRead}"
								         Margin="0,2,4,2"/>
								<TextBlock Grid.Row="8" Grid.Column="2" x:Name="lbowner" Style="{StaticResource propLabel}"
								           Margin="4,3,8,3"/>
								<TextBox Grid.Row="8" Grid.Column="3" x:Name="ehowner" Style="{StaticResource propRead}" Margin="0,2"/>
							</Grid>
						</StackPanel>
					</Border>

					<Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderSoft}"
					        BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
						<StackPanel>
							<TextBlock x:Name="lbact" FontWeight="SemiBold" Margin="0,0,0,6"/>
							<WrapPanel>
								<Button x:Name="bactivate" Style="{StaticResource actBtn}"/>
								<Button x:Name="btopmost" Style="{StaticResource actBtn}"/>
								<Button x:Name="buntopmost" Style="{StaticResource actBtn}"/>
								<Button x:Name="bshow" Style="{StaticResource actBtn}"/>
								<Button x:Name="bhide" Style="{StaticResource actBtn}"/>
								<Button x:Name="benable" Style="{StaticResource actBtn}"/>
								<Button x:Name="bdisable" Style="{StaticResource actBtn}"/>
								<Button x:Name="bmin" Style="{StaticResource actBtn}"/>
								<Button x:Name="bmax" Style="{StaticResource actBtn}"/>
								<Button x:Name="brestore" Style="{StaticResource actBtn}"/>
								<Button x:Name="bmovescreen" Style="{StaticResource actBtn}"/>
								<Button x:Name="bapplypos" Style="{StaticResource actBtn}"/>
								<Button x:Name="bsettitle" Style="{StaticResource actBtn}"/>
								<Button x:Name="bclose" Style="{StaticResource actBtn}"/>
								<Button x:Name="bbmclick" Style="{StaticResource actBtn}"/>
							</WrapPanel>
						</StackPanel>
					</Border>

					<Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderSoft}"
					        BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
						<StackPanel>
							<TextBlock x:Name="lbstylebits" FontWeight="SemiBold" Margin="0,0,0,6"/>
							<WrapPanel>
								<CheckBox x:Name="cws_caption" Content="CAPTION" Tag="WS_CAPTION" Margin="0,0,10,4"/>
								<CheckBox x:Name="cws_border" Content="BORDER" Tag="WS_BORDER" Margin="0,0,10,4"/>
								<CheckBox x:Name="cws_thickframe" Content="THICKFRAME" Tag="WS_THICKFRAME" Margin="0,0,10,4"/>
								<CheckBox x:Name="cws_sysmenu" Content="SYSMENU" Tag="WS_SYSMENU" Margin="0,0,10,4"/>
								<CheckBox x:Name="cws_minimizebox" Content="MINIMIZEBOX" Tag="WS_MINIMIZEBOX" Margin="0,0,10,4"/>
								<CheckBox x:Name="cws_maximizebox" Content="MAXIMIZEBOX" Tag="WS_MAXIMIZEBOX" Margin="0,0,10,4"/>
								<CheckBox x:Name="cws_visible" Content="VISIBLE" Tag="WS_VISIBLE" Margin="0,0,10,4"/>
								<CheckBox x:Name="cws_disabled" Content="DISABLED" Tag="WS_DISABLED" Margin="0,0,10,4"/>
								<CheckBox x:Name="cex_topmost" Content="EX_TOPMOST" Tag="WS_EX_TOPMOST" Margin="0,0,10,4"/>
								<CheckBox x:Name="cex_toolwindow" Content="EX_TOOLWINDOW" Tag="WS_EX_TOOLWINDOW" Margin="0,0,10,4"/>
								<CheckBox x:Name="cex_appwindow" Content="EX_APPWINDOW" Tag="WS_EX_APPWINDOW" Margin="0,0,10,4"/>
								<CheckBox x:Name="cex_layered" Content="EX_LAYERED" Tag="WS_EX_LAYERED" Margin="0,0,10,4"/>
								<CheckBox x:Name="cex_transparent" Content="EX_TRANSPARENT" Tag="WS_EX_TRANSPARENT" Margin="0,0,10,4"/>
								<CheckBox x:Name="cex_clientedge" Content="EX_CLIENTEDGE" Tag="WS_EX_CLIENTEDGE" Margin="0,0,10,4"/>
							</WrapPanel>
						</StackPanel>
					</Border>

					<Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderSoft}"
					        BorderThickness="1" CornerRadius="8" Padding="10">
						<StackPanel>
							<TextBlock x:Name="lbmsg" FontWeight="SemiBold" Margin="0,0,0,6"/>
							<WrapPanel>
								<TextBlock x:Name="lbmsgkey" VerticalAlignment="Center" Margin="0,0,4,0"
								           Foreground="{StaticResource TextMuted}"/>
								<TextBox x:Name="emsg" Style="{StaticResource propBox}" Width="92" Text="0x10" Margin="0,0,10,0"/>
								<TextBlock x:Name="lbwp" VerticalAlignment="Center" Margin="0,0,4,0"
								           Foreground="{StaticResource TextMuted}"/>
								<TextBox x:Name="ewp" Style="{StaticResource propBox}" Width="92" Text="0" Margin="0,0,10,0"/>
								<TextBlock x:Name="lblp" VerticalAlignment="Center" Margin="0,0,4,0"
								           Foreground="{StaticResource TextMuted}"/>
								<TextBox x:Name="elp" Style="{StaticResource propBox}" Width="92" Text="0" Margin="0,0,10,0"/>
								<ComboBox x:Name="esendmode" Width="120" Height="26" Margin="0,0,8,0" FontSize="12"/>
								<Button x:Name="bsendmsg" Style="{StaticResource actBtn}" Margin="0"/>
							</WrapPanel>
							<TextBlock x:Name="lbtip" Margin="0,6,0,0" Foreground="{StaticResource TextMuted}" FontSize="11"/>
						</StackPanel>
					</Border>
				</StackPanel>
			</ScrollViewer>
		</Grid>

		<!-- 底栏：连续鼠标 -->
		<Border Grid.Row="2" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderSoft}"
		        BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,8,0,0">
			<DockPanel>
				<TextBlock x:Name="lbmouse" DockPanel.Dock="Left" FontWeight="SemiBold" VerticalAlignment="Center"
				           Margin="0,0,12,0"/>
				<TextBlock x:Name="lbmouseprog" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,2,0"
				           Foreground="{StaticResource TextMuted}" FontSize="12"/>
				<WrapPanel VerticalAlignment="Center">
					<TextBlock x:Name="lbmethod" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{StaticResource TextMuted}"/>
					<ComboBox x:Name="emethod" Width="120" Height="26" Margin="0,0,8,0" FontSize="12"/>
					<TextBlock x:Name="lbbutton" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{StaticResource TextMuted}"/>
					<ComboBox x:Name="ebutton" Width="76" Height="26" Margin="0,0,8,0" FontSize="12"/>
					<TextBlock x:Name="lbaction" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{StaticResource TextMuted}"/>
					<ComboBox x:Name="emode" Width="76" Height="26" Margin="0,0,8,0" FontSize="12"/>
					<TextBlock x:Name="lbcx" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{StaticResource TextMuted}"/>
					<TextBox x:Name="emx" Style="{StaticResource propBox}" Width="54" Text="0" Margin="0,0,6,0"/>
					<TextBlock Text="Y" VerticalAlignment="Center" Margin="0,0,4,0"/>
					<TextBox x:Name="emy" Style="{StaticResource propBox}" Width="54" Text="0" Margin="0,0,6,0"/>
					<Button x:Name="bcenter" Style="{StaticResource actBtn}"/>
					<TextBlock x:Name="lbinterval" VerticalAlignment="Center" Margin="4,0,4,0" Foreground="{StaticResource TextMuted}"/>
					<TextBox x:Name="einterval" Style="{StaticResource propBox}" Width="54" Text="100" Margin="0,0,6,0"/>
					<TextBlock x:Name="lbcount" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{StaticResource TextMuted}"/>
					<TextBox x:Name="ecount" Style="{StaticResource propBox}" Width="54" Text="0" Margin="0,0,6,0"/>
					<Button x:Name="bsendonce" Style="{StaticResource actBtn}"/>
					<Button x:Name="bstartmouse" Style="{StaticResource actBtn}"/>
					<Button x:Name="bstopmouse" Style="{StaticResource actBtn}" Margin="0"/>
				</WrapPanel>
			</DockPanel>
		</Border>
	</Grid>
</Window>
