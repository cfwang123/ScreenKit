<Window x:Class="ScreenKit.WinTopWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="窗口管理"
        Width="760" Height="560"
        MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BgApp}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        AutomationProperties.AutomationId="wintop.window">
	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
		<TextBlock x:Name="lbhint" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10"
		           Foreground="{StaticResource TextMuted}" FontSize="12"/>
		<Grid Grid.Row="1" Margin="0,0,0,8">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>
			<TextBlock x:Name="lbfilter" Text="筛选" VerticalAlignment="Center" Margin="0,0,8,0"/>
			<TextBox x:Name="efilter" Grid.Column="1" Height="32" Padding="8,4" Margin="0,0,8,0"
			         BorderBrush="{StaticResource BorderSoft}"
			         VerticalContentAlignment="Center"
			         AutomationProperties.AutomationId="wintop.filter"/>
			<Button x:Name="brefresh" Grid.Column="2" Style="{StaticResource ToolBtn}" Margin="0,0,6,0"
			        AutomationProperties.AutomationId="wintop.refresh"/>
			<Button x:Name="bpick" Grid.Column="3" Style="{StaticResource ToolBtn}"
			        AutomationProperties.AutomationId="wintop.pick"/>
		</Grid>
		<ListView x:Name="lv" Grid.Row="2" BorderBrush="{StaticResource BorderSoft}"
		          SelectionMode="Single"
		          AutomationProperties.AutomationId="wintop.list">
			<ListView.View>
				<GridView>
					<GridViewColumn x:Name="coltop" Width="64"
					                DisplayMemberBinding="{Binding TopText}"/>
					<GridViewColumn x:Name="colhwnd" Width="110"
					                DisplayMemberBinding="{Binding HwndHex}"/>
					<GridViewColumn x:Name="coltitle" Width="320"
					                DisplayMemberBinding="{Binding Title}"/>
					<GridViewColumn x:Name="colproc" Width="140"
					                DisplayMemberBinding="{Binding Proc}"/>
				</GridView>
			</ListView.View>
		</ListView>
		<Grid Grid.Row="3" Margin="0,10,0,0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="180"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>
			<TextBlock x:Name="lbhwnd" Text="HWND" VerticalAlignment="Center" Margin="0,0,8,0"/>
			<TextBox x:Name="ehwnd" Grid.Column="1" Height="32" Padding="8,4"
			         BorderBrush="{StaticResource BorderSoft}"
			         FontFamily="Consolas, Microsoft YaHei UI"
			         VerticalContentAlignment="Center"
			         AutomationProperties.AutomationId="wintop.hwnd"/>
			<StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
				<Button x:Name="bpin" Style="{StaticResource ToolBtn}" Margin="8,0,6,0"
				        AutomationProperties.AutomationId="wintop.pin"/>
				<Button x:Name="bunpin" Style="{StaticResource ToolBtn}"
				        AutomationProperties.AutomationId="wintop.unpin"/>
			</StackPanel>
		</Grid>
		<DockPanel Grid.Row="4" Margin="0,10,0,0">
			<TextBlock x:Name="lbstat" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
			<Button x:Name="bclose" Style="{StaticResource ToolBtn}" HorizontalAlignment="Right"
			        AutomationProperties.AutomationId="wintop.close"/>
		</DockPanel>
	</Grid>
</Window>
