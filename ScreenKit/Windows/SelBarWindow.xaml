<Window x:Class="ScreenKit.SelBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Focusable="False"
        FontFamily="Segoe UI, Microsoft YaHei UI, Microsoft YaHei"
        FontSize="13"
        Foreground="#1F2329"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AutomationProperties.AutomationId="selbar">
	<Window.Resources>
		<Style x:Key="barbtn" TargetType="Button">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding" Value="8,5"/>
			<Setter Property="Focusable" Value="False"/>
			<Setter Property="FocusVisualStyle" Value="{x:Null}"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Foreground" Value="#1F2329"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="bd" Background="{TemplateBinding Background}"
						        CornerRadius="8" Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bd" Property="Background" Value="#F2F3F5"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="bd" Property="Background" Value="#E8E9ED"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>
	<Border Margin="12" Background="White" CornerRadius="20" Padding="4,3"
	        BorderBrush="#14000000" BorderThickness="1">
		<Border.Effect>
			<DropShadowEffect BlurRadius="14" ShadowDepth="1" Opacity="0.16" Color="#000000"/>
		</Border.Effect>
		<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
			<Button x:Name="bpause" Style="{StaticResource barbtn}" Padding="8,5"
			        AutomationProperties.AutomationId="selbar.pause">
				<TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE769;" FontSize="14"/>
			</Button>
			<Button x:Name="bavatar" Style="{StaticResource barbtn}" Padding="4,2"
			        AutomationProperties.AutomationId="selbar.avatar">
				<Grid Width="22" Height="22">
					<Ellipse>
						<Ellipse.Fill>
							<LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
								<GradientStop Color="#8B7CFF" Offset="0"/>
								<GradientStop Color="#5B8DEF" Offset="1"/>
							</LinearGradientBrush>
						</Ellipse.Fill>
					</Ellipse>
					<TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" Foreground="White"
					           FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
				</Grid>
			</Button>
			<Button x:Name="bsearch" Style="{StaticResource barbtn}"
			        AutomationProperties.AutomationId="selbar.search">
				<StackPanel Orientation="Horizontal">
					<TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;" FontSize="14"
					           Margin="0,1,6,0" VerticalAlignment="Center"/>
					<TextBlock x:Name="lbsearch" Text="AI 搜索" VerticalAlignment="Center"/>
				</StackPanel>
			</Button>
			<Button x:Name="btr" Style="{StaticResource barbtn}"
			        AutomationProperties.AutomationId="selbar.translate">
				<StackPanel Orientation="Horizontal">
					<TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8C1;" FontSize="14"
					           Margin="0,1,6,0" VerticalAlignment="Center"/>
					<TextBlock x:Name="lbtr" Text="翻译" VerticalAlignment="Center"/>
				</StackPanel>
			</Button>
			<Button x:Name="bexplain" Style="{StaticResource barbtn}"
			        AutomationProperties.AutomationId="selbar.explain">
				<StackPanel Orientation="Horizontal">
					<TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE82D;" FontSize="14"
					           Margin="0,1,6,0" VerticalAlignment="Center"/>
					<TextBlock x:Name="lbexplain" Text="解释" VerticalAlignment="Center"/>
				</StackPanel>
			</Button>
			<Button x:Name="bcopy" Style="{StaticResource barbtn}"
			        AutomationProperties.AutomationId="selbar.copy">
				<StackPanel Orientation="Horizontal">
					<TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8C8;" FontSize="14"
					           Margin="0,1,6,0" VerticalAlignment="Center"/>
					<TextBlock x:Name="lbcopy" Text="复制" VerticalAlignment="Center"/>
				</StackPanel>
			</Button>
			<Button x:Name="bread" Style="{StaticResource barbtn}"
			        AutomationProperties.AutomationId="selbar.read">
				<StackPanel Orientation="Horizontal">
					<TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE767;" FontSize="14"
					           Margin="0,1,6,0" VerticalAlignment="Center"/>
					<TextBlock x:Name="lbread" Text="朗读" VerticalAlignment="Center"/>
				</StackPanel>
			</Button>
			<Border Width="1" Height="16" Background="#E6E7EB" Margin="4,0" VerticalAlignment="Center"/>
			<Button x:Name="bmore" Style="{StaticResource barbtn}" Padding="8,5"
			        AutomationProperties.AutomationId="selbar.more">
				<TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70D;" FontSize="12"/>
			</Button>
		</StackPanel>
	</Border>
</Window>
