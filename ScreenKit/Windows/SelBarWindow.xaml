<Window x:Class="ScreenKit.SelBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Focusable="False"
        FontFamily="Segoe UI, Microsoft YaHei UI, Microsoft YaHei"
        FontSize="13"
        Foreground="#1F2329"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AutomationProperties.AutomationId="dict.sel.outside">
	<Border Margin="8" Background="#FCFCFC" BorderBrush="#A0A0A0" BorderThickness="1"
	        CornerRadius="4" Padding="8,6" MinWidth="280" MaxWidth="360">
		<Border.Effect>
			<DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.22" Direction="270"/>
		</Border.Effect>
		<StackPanel>
			<TextBlock x:Name="lbselwait" Text="搜索中…" FontSize="13" Foreground="#6E6E6E"
			           Margin="2,0,0,4"/>
			<ListBox x:Name="lsel" MaxHeight="200" FontSize="13" BorderThickness="0"
			         Background="Transparent" Focusable="False"
			         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
			         AutomationProperties.AutomationId="dict.sel.hits">
				<ListBox.ItemContainerStyle>
					<Style TargetType="ListBoxItem">
						<Setter Property="Padding" Value="4,2"/>
						<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
						<Setter Property="Background" Value="Transparent"/>
						<Setter Property="Focusable" Value="False"/>
						<Setter Property="Template">
							<Setter.Value>
								<ControlTemplate TargetType="ListBoxItem">
									<Border x:Name="bd" Background="{TemplateBinding Background}"
									        Padding="{TemplateBinding Padding}" CornerRadius="3">
										<ContentPresenter/>
									</Border>
									<ControlTemplate.Triggers>
										<Trigger Property="IsMouseOver" Value="True">
											<Setter TargetName="bd" Property="Background" Value="#DBEAFE"/>
										</Trigger>
									</ControlTemplate.Triggers>
								</ControlTemplate>
							</Setter.Value>
						</Setter>
					</Style>
				</ListBox.ItemContainerStyle>
				<ListBox.ItemTemplate>
					<DataTemplate>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="1.1*"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis"
							           Margin="0,0,8,0"/>
							<TextBlock Grid.Column="1" Text="{Binding Gloss}" FontSize="13" Opacity="0.72"
							           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
						</Grid>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
			<Separator x:Name="spsel" Margin="0,4,0,6"/>
			<WrapPanel>
				<Button x:Name="bselspeak" Content="发音" Height="26" MinWidth="52" Margin="0,0,6,0"
				        Padding="8,0" FontSize="12" Focusable="False" Style="{StaticResource GhostBtn}"
				        AutomationProperties.AutomationId="dict.sel.speak"/>
				<Button x:Name="bselsearch" Content="搜索" Height="26" MinWidth="52" Margin="0,0,6,0"
				        Padding="8,0" FontSize="12" Focusable="False" Style="{StaticResource GhostBtn}"
				        AutomationProperties.AutomationId="dict.sel.search"/>
				<Button x:Name="bseltr" Content="翻译" Height="26" MinWidth="52" Margin="0,0,6,0"
				        Padding="8,0" FontSize="12" Focusable="False" Style="{StaticResource GhostBtn}"
				        AutomationProperties.AutomationId="dict.sel.translate"/>
				<Button x:Name="bselcopy" Content="复制" Height="26" MinWidth="52"
				        Padding="8,0" FontSize="12" Focusable="False" Style="{StaticResource GhostBtn}"
				        AutomationProperties.AutomationId="dict.sel.copy"/>
			</WrapPanel>
		</StackPanel>
	</Border>
</Window>
