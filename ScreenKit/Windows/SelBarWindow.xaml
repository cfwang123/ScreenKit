<Window x:Class="ScreenKit.SelBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScreenKit"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="376"
        MinWidth="296"
        Focusable="True"
        FontFamily="Segoe UI, Microsoft YaHei UI, Microsoft YaHei"
        FontSize="13"
        Foreground="#1F2329"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AutomationProperties.AutomationId="dict.sel.outside">
	<Window.Resources>
		<local:SelHalfWidth x:Key="selhalf"/>
		<Style x:Key="SelAct" TargetType="Button">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Margin" Value="0,0,12,0"/>
			<Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Foreground" Value="#5C6570"/>
			<Setter Property="Focusable" Value="False"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<TextBlock x:Name="tx" Text="{TemplateBinding Content}"
						           FontFamily="{TemplateBinding FontFamily}"
						           Foreground="{TemplateBinding Foreground}"
						           FontSize="{TemplateBinding FontSize}"
						           VerticalAlignment="Center"/>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="tx" Property="Foreground" Value="#1F2329"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="tx" Property="Foreground" Value="{StaticResource Accent}"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<Style x:Key="SelBtn" TargetType="Button">
			<Setter Property="Background" Value="#FFFFFF"/>
			<Setter Property="BorderBrush" Value="#C5CAD1"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Padding" Value="10,2"/>
			<Setter Property="Margin" Value="0,0,8,0"/>
			<Setter Property="MinHeight" Value="22"/>
			<Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Foreground" Value="#1F2329"/>
			<Setter Property="Focusable" Value="False"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="bd" Background="{TemplateBinding Background}"
						        BorderBrush="{TemplateBinding BorderBrush}"
						        BorderThickness="{TemplateBinding BorderThickness}"
						        CornerRadius="3" Padding="{TemplateBinding Padding}">
							<TextBlock x:Name="tx" Text="{TemplateBinding Content}"
							           FontFamily="{TemplateBinding FontFamily}"
							           Foreground="{TemplateBinding Foreground}"
							           FontSize="{TemplateBinding FontSize}"
							           VerticalAlignment="Center" HorizontalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bd" Property="Background" Value="#F3F6FA"/>
								<Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="bd" Property="Background" Value="#E7EEF8"/>
								<Setter TargetName="tx" Property="Foreground" Value="{StaticResource Accent}"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<Style x:Key="SelCheck" TargetType="CheckBox">
			<Setter Property="Foreground" Value="#5C6570"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Focusable" Value="False"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="CheckBox">
						<StackPanel Orientation="Horizontal">
							<Border x:Name="box" Width="12" Height="12" Margin="0,0,4,0"
							        BorderBrush="#B0B0B0" BorderThickness="1" CornerRadius="2"
							        Background="Transparent" VerticalAlignment="Center">
								<TextBlock x:Name="mark" Text="✓" FontSize="10" FontWeight="Bold"
								           Foreground="{StaticResource Accent}" HorizontalAlignment="Center"
								           VerticalAlignment="Center" Margin="0,-2,0,0" Visibility="Collapsed"/>
							</Border>
							<TextBlock x:Name="tx" Text="{TemplateBinding Content}"
							           Foreground="{TemplateBinding Foreground}"
							           FontSize="{TemplateBinding FontSize}" VerticalAlignment="Center"/>
						</StackPanel>
						<ControlTemplate.Triggers>
							<Trigger Property="IsChecked" Value="True">
								<Setter TargetName="mark" Property="Visibility" Value="Visible"/>
								<Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Accent}"/>
								<Setter TargetName="tx" Property="Foreground" Value="#1F2329"/>
							</Trigger>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="tx" Property="Foreground" Value="#1F2329"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<Style x:Key="SelLang" TargetType="ToggleButton">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Margin" Value="0,0,10,0"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Foreground" Value="#5C6570"/>
			<Setter Property="Focusable" Value="False"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ToggleButton">
						<TextBlock x:Name="tx" Text="{TemplateBinding Content}"
						           Foreground="{TemplateBinding Foreground}"
						           FontSize="{TemplateBinding FontSize}"
						           VerticalAlignment="Center"/>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="tx" Property="Foreground" Value="#1F2329"/>
							</Trigger>
							<Trigger Property="IsChecked" Value="True">
								<Setter TargetName="tx" Property="FontWeight" Value="SemiBold"/>
								<Setter TargetName="tx" Property="Foreground" Value="{StaticResource Accent}"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>
	<Border x:Name="bdpop" Margin="8" Background="#FCFCFC" BorderBrush="#A0A0A0" BorderThickness="1"
	        CornerRadius="4" Padding="8,6,8,16" MinWidth="280" MaxWidth="360" Cursor="SizeAll">
		<Border.Effect>
			<DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.22" Direction="270"/>
		</Border.Effect>
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition x:Name="rowhits" Height="280"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>
			<DockPanel Grid.Row="0" Margin="0,0,0,4" LastChildFill="True">
				<Button x:Name="bselclose" DockPanel.Dock="Right" Content="×" Width="22" Height="22"
				        Margin="4,0,0,0" Padding="0" FontSize="16" Focusable="False"
				        Style="{StaticResource GhostBtn}" VerticalAlignment="Center"
				        AutomationProperties.AutomationId="dict.sel.close"/>
				<Button x:Name="bselspeak" DockPanel.Dock="Right" Content="&#xE767;"
				        FontFamily="Segoe MDL2 Assets" FontSize="14" Style="{StaticResource SelAct}"
				        Margin="0,0,2,0" ToolTip="发音"
				        AutomationProperties.AutomationId="dict.sel.speak"/>
				<ToggleButton x:Name="bselread" DockPanel.Dock="Right" Content="朗读" Style="{StaticResource SelLang}"
				              Margin="10,0,6,0" AutomationProperties.AutomationId="dict.sel.filter.read"/>
				<ToggleButton x:Name="bselftr" DockPanel.Dock="Right" Content="翻译" Style="{StaticResource SelLang}"
				              Margin="10,0,6,0" AutomationProperties.AutomationId="dict.sel.filter.tr"/>
				<WrapPanel VerticalAlignment="Center">
				<ToggleButton x:Name="bselfall" Content="全部" Style="{StaticResource SelLang}" IsChecked="True"
				              AutomationProperties.AutomationId="dict.sel.filter.all"/>
				<ToggleButton x:Name="bselfzh" Content="中" Style="{StaticResource SelLang}"
				              AutomationProperties.AutomationId="dict.sel.filter.zh"/>
				<ToggleButton x:Name="bselfja" Content="日" Style="{StaticResource SelLang}"
				              AutomationProperties.AutomationId="dict.sel.filter.ja"/>
				<ToggleButton x:Name="bselfko" Content="韩" Style="{StaticResource SelLang}"
				              AutomationProperties.AutomationId="dict.sel.filter.ko"/>
				<ToggleButton x:Name="bselfen" Content="英" Style="{StaticResource SelLang}" Margin="0"
				              AutomationProperties.AutomationId="dict.sel.filter.en"/>
				</WrapPanel>
			</DockPanel>
			<Grid Grid.Row="1">
			<Grid x:Name="gdict">
			<TextBlock x:Name="lbselwait" Text="搜索中…" FontSize="13" Foreground="#6E6E6E"
			           Margin="2,0,0,4" VerticalAlignment="Top"/>
			<TextBlock x:Name="lbselempty" Text="没有查到词条" FontSize="13" Foreground="#8A9199"
			           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
			           AutomationProperties.AutomationId="dict.sel.empty"/>
			<ListBox x:Name="lsel" FontSize="13" BorderThickness="0" Cursor="Arrow"
			         Background="Transparent" Focusable="False"
			         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
			         ScrollViewer.VerticalScrollBarVisibility="Auto"
			         ScrollViewer.CanContentScroll="False"
			         AutomationProperties.AutomationId="dict.sel.hits">
				<ListBox.ItemContainerStyle>
					<Style TargetType="ListBoxItem">
						<Setter Property="Padding" Value="4,2"/>
						<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
						<Setter Property="Background" Value="Transparent"/>
						<Setter Property="Focusable" Value="False"/>
						<Setter Property="Template">
							<Setter.Value>
								<ControlTemplate TargetType="ListBoxItem">
									<Border x:Name="bd" Background="{TemplateBinding Background}"
									        Padding="{TemplateBinding Padding}" CornerRadius="3">
										<ContentPresenter/>
									</Border>
									<ControlTemplate.Triggers>
										<Trigger Property="IsMouseOver" Value="True">
											<Setter TargetName="bd" Property="Background" Value="#DBEAFE"/>
										</Trigger>
									</ControlTemplate.Triggers>
								</ControlTemplate>
							</Setter.Value>
						</Setter>
					</Style>
				</ListBox.ItemContainerStyle>
				<ListBox.ItemTemplate>
					<DataTemplate>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Text="{Binding Title}" FontSize="13" TextWrapping="NoWrap"
							           TextTrimming="CharacterEllipsis" Margin="0,0,8,0"
							           MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource selhalf}}"/>
							<TextBlock Grid.Column="1" Text="{Binding Gloss}" FontSize="13" Opacity="0.72"
							           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
						</Grid>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
			</Grid>
			<Grid x:Name="gtr" Visibility="Collapsed">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
				</Grid.RowDefinitions>
				<DockPanel Grid.Row="0" Margin="0,0,0,2" LastChildFill="False">
					<Button x:Name="btrspeaksrc" DockPanel.Dock="Right" Content="&#xE767;"
					        FontFamily="Segoe MDL2 Assets" FontSize="14" Style="{StaticResource SelAct}"
					        Margin="6,0,0,0" AutomationProperties.AutomationId="dict.sel.tr.speak.src"/>
					<ComboBox x:Name="etrsrc" DockPanel.Dock="Right" Width="108" Height="22" FontSize="12"
					          HorizontalAlignment="Left" VerticalContentAlignment="Center"
					          MaxDropDownHeight="280" AutomationProperties.AutomationId="dict.sel.tr.src"/>
					<TextBlock x:Name="lbsrc" Text="原文" FontSize="12" Foreground="#5C6570" VerticalAlignment="Center"/>
					<TextBlock x:Name="lbsrclang" FontSize="12" Foreground="{StaticResource Accent}"
					           VerticalAlignment="Center" Margin="8,0,0,0"/>
				</DockPanel>
				<TextBox x:Name="etrsrctext" Grid.Row="1" TextWrapping="Wrap" AcceptsReturn="True"
				         VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="#F4F5F7"
				         Padding="4,2" FontSize="13" AutomationProperties.AutomationId="dict.sel.tr.text"/>
				<DockPanel Grid.Row="2" Margin="0,4,0,2" LastChildFill="False">
					<Button x:Name="btrgo" DockPanel.Dock="Right" Content="翻译" Style="{StaticResource SelBtn}"
					        Margin="6,0,0,0" AutomationProperties.AutomationId="dict.sel.tr.go"/>
					<Button x:Name="btrspeakdst" DockPanel.Dock="Right" Content="&#xE767;"
					        FontFamily="Segoe MDL2 Assets" FontSize="14" Style="{StaticResource SelAct}"
					        Margin="6,0,0,0" AutomationProperties.AutomationId="dict.sel.tr.speak.dst"/>
					<ComboBox x:Name="etrdst" DockPanel.Dock="Right" Width="108" Height="22" FontSize="12"
					          HorizontalAlignment="Left" VerticalContentAlignment="Center"
					          MaxDropDownHeight="280" AutomationProperties.AutomationId="dict.sel.tr.dst"/>
					<TextBlock x:Name="lbdst" Text="译文" FontSize="12" Foreground="#5C6570" VerticalAlignment="Center"/>
					<TextBlock x:Name="lbdstlang" FontSize="12" Foreground="{StaticResource Accent}"
					           VerticalAlignment="Center" Margin="8,0,0,0"/>
				</DockPanel>
				<TextBox x:Name="etrdsttext" Grid.Row="3" IsReadOnly="True" IsReadOnlyCaretVisible="True"
				         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
				         BorderThickness="0" Background="#F4F5F7" Padding="4,2" FontSize="13"
				         AutomationProperties.AutomationId="dict.sel.tr.out"/>
			</Grid>
			<Grid x:Name="gread" Visibility="Collapsed">
				<Grid.RowDefinitions>
					<RowDefinition Height="*"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>
				<TextBox x:Name="ereadtext" TextWrapping="Wrap" AcceptsReturn="True"
				         VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="#F4F5F7"
				         Padding="4,2" FontSize="13" AutomationProperties.AutomationId="dict.sel.read.text"/>
				<DockPanel Grid.Row="1" Margin="0,4,0,0" LastChildFill="False">
					<ComboBox x:Name="ereadeng" Width="108" Height="22" FontSize="12" Margin="0,0,6,0"
					          VerticalContentAlignment="Center" MaxDropDownHeight="240"
					          AutomationProperties.AutomationId="dict.sel.read.eng"/>
					<ComboBox x:Name="ereadlang" Width="72" Height="22" FontSize="12" Margin="0,0,6,0"
					          VerticalContentAlignment="Center" MaxDropDownHeight="200"
					          AutomationProperties.AutomationId="dict.sel.read.lang"/>
					<ComboBox x:Name="ereadvoice" Width="128" Height="22" FontSize="12"
					          VerticalContentAlignment="Center" MaxDropDownHeight="280"
					          AutomationProperties.AutomationId="dict.sel.read.voice"/>
				</DockPanel>
				<DockPanel Grid.Row="2" Margin="0,4,0,0" LastChildFill="False">
					<Button x:Name="breadrate" Content="1x" Style="{StaticResource SelBtn}"
					        AutomationProperties.AutomationId="dict.sel.read.rate"/>
					<Popup x:Name="poprate" PlacementTarget="{Binding ElementName=breadrate}"
					       Placement="Top" StaysOpen="False" AllowsTransparency="True"
					       VerticalOffset="-4">
						<Border Background="#FCFCFC" BorderBrush="#A0A0A0" BorderThickness="1"
						        CornerRadius="4" Padding="10,8">
							<Slider x:Name="ereadrate" Width="148" Minimum="0.5" Maximum="2"
							        TickFrequency="0.1" IsSnapToTickEnabled="True"
							        IsMoveToPointEnabled="True" Value="1"
							        VerticalAlignment="Center"
							        AutomationProperties.AutomationId="dict.sel.read.rate.slider"/>
						</Border>
					</Popup>
					<Button x:Name="breadgo" Content="朗读" Style="{StaticResource SelBtn}"
					        AutomationProperties.AutomationId="dict.sel.read.go"/>
					<Button x:Name="breadstop" Content="停止" Style="{StaticResource SelBtn}" Margin="0"
					        AutomationProperties.AutomationId="dict.sel.read.stop"/>
				</DockPanel>
			</Grid>
			</Grid>
			<DockPanel Grid.Row="2" Margin="0,6,14,0" LastChildFill="True">
				<CheckBox x:Name="cbselon" DockPanel.Dock="Right" Content="划词浮窗" Style="{StaticResource SelCheck}"
				          AutomationProperties.AutomationId="dict.sel.turnoff"/>
				<WrapPanel VerticalAlignment="Center">
					<Button x:Name="bselsearch" Content="搜索" Style="{StaticResource SelBtn}"
					        AutomationProperties.AutomationId="dict.sel.search"/>
					<Button x:Name="bselcopy" Content="复制" Style="{StaticResource SelBtn}" Margin="0"
					        AutomationProperties.AutomationId="dict.sel.copy"/>
				</WrapPanel>
			</DockPanel>
			<Thumb x:Name="bgrip" Grid.RowSpan="3" Width="16" Height="16"
			       HorizontalAlignment="Right" VerticalAlignment="Bottom"
			       Margin="0,0,-2,-10" Cursor="SizeNWSE" Focusable="False"
			       ToolTip="拖动调整大小" AutomationProperties.AutomationId="dict.sel.resize">
				<Thumb.Template>
					<ControlTemplate TargetType="Thumb">
						<Grid Background="Transparent">
							<Path Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"
							      Stroke="#888888" StrokeThickness="1"
							      Data="M0,12 L12,0 M4,12 L12,4 M8,12 L12,8"/>
						</Grid>
					</ControlTemplate>
				</Thumb.Template>
			</Thumb>
		</Grid>
	</Border>
</Window>
