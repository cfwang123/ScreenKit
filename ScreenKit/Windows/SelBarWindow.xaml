<Window x:Class="ScreenKit.SelBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MinWidth="296"
        Focusable="False"
        FontFamily="Segoe UI, Microsoft YaHei UI, Microsoft YaHei"
        FontSize="13"
        Foreground="#1F2329"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AutomationProperties.AutomationId="dict.sel.outside">
	<Border x:Name="bdpop" Margin="8" Background="#FCFCFC" BorderBrush="#A0A0A0" BorderThickness="1"
	        CornerRadius="4" Padding="8,6,8,16" MinWidth="280" MaxWidth="360">
		<Border.Effect>
			<DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.22" Direction="270"/>
		</Border.Effect>
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition x:Name="rowhits" Height="Auto"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>
			<DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="True">
				<Button x:Name="bselclose" DockPanel.Dock="Right" Content="×" Width="28" Height="26"
				        Margin="4,0,0,0" Padding="0" FontSize="16" Focusable="False"
				        Style="{StaticResource GhostBtn}" VerticalAlignment="Top"
				        AutomationProperties.AutomationId="dict.sel.close"/>
				<WrapPanel>
				<ToggleButton x:Name="bselfall" Content="全部" Height="26" Padding="8,0" FontSize="12"
				              Style="{StaticResource ToolToggleSm}" IsChecked="True" Focusable="False"
				              AutomationProperties.AutomationId="dict.sel.filter.all"/>
				<ToggleButton x:Name="bselfzh" Content="汉语" Height="26" Padding="8,0" FontSize="12"
				              Style="{StaticResource ToolToggleSm}" Focusable="False"
				              AutomationProperties.AutomationId="dict.sel.filter.zh"/>
				<ToggleButton x:Name="bselfja" Content="日语" Height="26" Padding="8,0" FontSize="12"
				              Style="{StaticResource ToolToggleSm}" Focusable="False"
				              AutomationProperties.AutomationId="dict.sel.filter.ja"/>
				<ToggleButton x:Name="bselfko" Content="韩语" Height="26" Padding="8,0" FontSize="12"
				              Style="{StaticResource ToolToggleSm}" Focusable="False"
				              AutomationProperties.AutomationId="dict.sel.filter.ko"/>
				<ToggleButton x:Name="bselfen" Content="英语" Height="26" Padding="8,0" FontSize="12"
				              Style="{StaticResource ToolToggleSm}" Focusable="False"
				              AutomationProperties.AutomationId="dict.sel.filter.en"/>
				</WrapPanel>
			</DockPanel>
			<TextBlock x:Name="lbselwait" Grid.Row="1" Text="搜索中…" FontSize="13" Foreground="#6E6E6E"
			           Margin="2,0,0,4"/>
			<ListBox x:Name="lsel" Grid.Row="2" MaxHeight="280" FontSize="13" BorderThickness="0"
			         Background="Transparent" Focusable="False"
			         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
			         ScrollViewer.VerticalScrollBarVisibility="Auto"
			         ScrollViewer.CanContentScroll="False"
			         AutomationProperties.AutomationId="dict.sel.hits">
				<ListBox.ItemContainerStyle>
					<Style TargetType="ListBoxItem">
						<Setter Property="Padding" Value="4,2"/>
						<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
						<Setter Property="Background" Value="Transparent"/>
						<Setter Property="Focusable" Value="False"/>
						<Setter Property="Template">
							<Setter.Value>
								<ControlTemplate TargetType="ListBoxItem">
									<Border x:Name="bd" Background="{TemplateBinding Background}"
									        Padding="{TemplateBinding Padding}" CornerRadius="3">
										<ContentPresenter/>
									</Border>
									<ControlTemplate.Triggers>
										<Trigger Property="IsMouseOver" Value="True">
											<Setter TargetName="bd" Property="Background" Value="#DBEAFE"/>
										</Trigger>
									</ControlTemplate.Triggers>
								</ControlTemplate>
							</Setter.Value>
						</Setter>
					</Style>
				</ListBox.ItemContainerStyle>
				<ListBox.ItemTemplate>
					<DataTemplate>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="1.1*"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis"
							           Margin="0,0,8,0"/>
							<TextBlock Grid.Column="1" Text="{Binding Gloss}" FontSize="13" Opacity="0.72"
							           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
						</Grid>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
			<StackPanel Grid.Row="3">
			<Separator x:Name="spsel" Margin="0,4,0,6"/>
			<WrapPanel>
				<Button x:Name="bselspeak" Content="发音" Height="26" MinWidth="52" Margin="0,0,6,0"
				        Padding="8,0" FontSize="12" Focusable="False" Style="{StaticResource GhostBtn}"
				        AutomationProperties.AutomationId="dict.sel.speak"/>
				<Button x:Name="bselsearch" Content="搜索" Height="26" MinWidth="52" Margin="0,0,6,0"
				        Padding="8,0" FontSize="12" Focusable="False" Style="{StaticResource GhostBtn}"
				        AutomationProperties.AutomationId="dict.sel.search"/>
				<Button x:Name="bseltr" Content="翻译" Height="26" MinWidth="52" Margin="0,0,6,0"
				        Padding="8,0" FontSize="12" Focusable="False" Style="{StaticResource GhostBtn}"
				        AutomationProperties.AutomationId="dict.sel.translate"/>
				<Button x:Name="bselcopy" Content="复制" Height="26" MinWidth="52" Margin="0,0,6,0"
				        Padding="8,0" FontSize="12" Focusable="False" Style="{StaticResource GhostBtn}"
				        AutomationProperties.AutomationId="dict.sel.copy"/>
				<Button x:Name="bselturnoff" Content="关闭划词浮窗" Height="26" MinWidth="52"
				        Padding="8,0" FontSize="12" Focusable="False" Style="{StaticResource GhostBtn}"
				        AutomationProperties.AutomationId="dict.sel.turnoff"/>
			</WrapPanel>
			</StackPanel>
			<Thumb x:Name="bgrip" Grid.RowSpan="4" Width="16" Height="16"
			       HorizontalAlignment="Right" VerticalAlignment="Bottom"
			       Margin="0,0,-2,-10" Cursor="SizeNWSE" Focusable="False"
			       ToolTip="拖动调整大小" AutomationProperties.AutomationId="dict.sel.resize">
				<Thumb.Template>
					<ControlTemplate TargetType="Thumb">
						<Grid Background="Transparent">
							<Path Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"
							      Stroke="#888888" StrokeThickness="1"
							      Data="M0,12 L12,0 M4,12 L12,4 M8,12 L12,8"/>
						</Grid>
					</ControlTemplate>
				</Thumb.Template>
			</Thumb>
		</Grid>
	</Border>
</Window>
