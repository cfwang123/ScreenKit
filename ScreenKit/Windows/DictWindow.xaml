<UserControl x:Class="ScreenKit.DictWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{StaticResource BgApp}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="13"
        AutomationProperties.AutomationId="dict.window">
	<Grid Margin="10">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
		<DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="True">
			<Button x:Name="bspeak" DockPanel.Dock="Right" Content="发音" Height="28" MinWidth="52"
			        Margin="6,0,0,0" Padding="8,0" FontSize="12" Style="{StaticResource GhostBtn}"
			        AutomationProperties.AutomationId="dict.speak"/>
			<Button x:Name="bexport" DockPanel.Dock="Right" Content="导出" Height="28" MinWidth="52"
			        Margin="6,0,0,0" Padding="8,0" FontSize="12" Style="{StaticResource GhostBtn}"
			        AutomationProperties.AutomationId="dict.export"/>
			<StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="6,0,0,0"
			            AutomationProperties.AutomationId="dict.filter">
				<ToggleButton x:Name="bfiltall" Content="全部" Height="28" Padding="8,0" FontSize="12"
				              Style="{StaticResource ToolToggle}"
				              AutomationProperties.AutomationId="dict.filter.all"/>
				<ToggleButton x:Name="bfiltzh" Content="汉语" Height="28" Padding="8,0" FontSize="12"
				              Style="{StaticResource ToolToggle}"
				              AutomationProperties.AutomationId="dict.filter.zh"/>
				<ToggleButton x:Name="bfiltja" Content="日语" Height="28" Padding="8,0" FontSize="12"
				              Style="{StaticResource ToolToggle}"
				              AutomationProperties.AutomationId="dict.filter.ja"/>
				<ToggleButton x:Name="bfiltko" Content="韩语" Height="28" Padding="8,0" FontSize="12"
				              Style="{StaticResource ToolToggle}"
				              AutomationProperties.AutomationId="dict.filter.ko"/>
				<ToggleButton x:Name="bfilten" Content="英语" Height="28" Padding="8,0" FontSize="12"
				              Style="{StaticResource ToolToggle}"
				              AutomationProperties.AutomationId="dict.filter.en"/>
			</StackPanel>
			<TextBox x:Name="esearch" Height="28" FontSize="13" Padding="8,2"
			         VerticalContentAlignment="Center"
			         AutomationProperties.AutomationId="dict.search"/>
		</DockPanel>
		<Grid Grid.Row="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="340" MinWidth="200"/>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>
			<ListBox x:Name="lhits" Grid.Column="0"
			         BorderBrush="{StaticResource BorderSoft}"
			         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
			         AutomationProperties.AutomationId="dict.hits">
				<ListBox.ItemContainerStyle>
					<Style TargetType="ListBoxItem">
						<Setter Property="Padding" Value="6,1"/>
						<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
						<Setter Property="FontSize" Value="13"/>
					</Style>
				</ListBox.ItemContainerStyle>
				<ListBox.ItemTemplate>
					<DataTemplate>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>
							<Grid Margin="0,1" VerticalAlignment="Center">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
								</Grid.RowDefinitions>
								<TextBlock Text="{Binding Title}" FontSize="13"
								           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
								<TextBlock Grid.Row="1" Text="{Binding Preview}" FontSize="13" Opacity="0.62"
								           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
							</Grid>
							<Button Grid.Column="1" Content="🔊" FontSize="13" Width="28" Height="28"
							        Margin="4,0,0,0" Padding="0" VerticalAlignment="Center"
							        Background="Transparent" BorderThickness="0" Foreground="#2878BE"
							        Cursor="Hand" Focusable="False"
							        AutomationProperties.AutomationId="dict.row.speak"/>
						</Grid>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
			<GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center"
			              Background="{StaticResource BorderSoft}"/>
			<RichTextBox x:Name="edetail" Grid.Column="2" Margin="8,0,0,0"
			             IsReadOnly="True" IsReadOnlyCaretVisible="True" IsDocumentEnabled="True"
			             VerticalScrollBarVisibility="Auto" FontSize="13"
			             Padding="8,6" BorderBrush="{StaticResource BorderSoft}"
			             ContextMenu="{x:Null}"
			             AutomationProperties.AutomationId="dict.detail">
				<FlowDocument PagePadding="2" FontSize="13"/>
			</RichTextBox>
		</Grid>
		<TextBlock x:Name="lbstatus" Grid.Row="2" Margin="2,6,0,0" FontSize="12"
		           Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>
		<Popup x:Name="psel" Placement="Relative"
		       PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
		       StaysOpen="True" AllowsTransparency="True">
			<Border Background="#FCFCFC" BorderBrush="#A0A0A0" BorderThickness="1"
			        CornerRadius="4" Padding="8,6" MinWidth="280" MaxWidth="360">
				<Border.Effect>
					<DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.22" Direction="270"/>
				</Border.Effect>
				<StackPanel>
					<TextBlock x:Name="lbselwait" Text="搜索中…" FontSize="13" Foreground="#6E6E6E"
					           Margin="2,0,0,4"/>
					<ListBox x:Name="lsel" MaxHeight="200" FontSize="13" BorderThickness="0"
					         Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
					         AutomationProperties.AutomationId="dict.sel.hits">
						<ListBox.ItemContainerStyle>
							<Style TargetType="ListBoxItem">
								<Setter Property="Padding" Value="4,2"/>
								<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
								<Setter Property="Background" Value="Transparent"/>
								<Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
								<Setter Property="Template">
									<Setter.Value>
										<ControlTemplate TargetType="ListBoxItem">
											<Border x:Name="bd" Background="{TemplateBinding Background}"
											        Padding="{TemplateBinding Padding}" CornerRadius="3">
												<ContentPresenter/>
											</Border>
											<ControlTemplate.Triggers>
												<Trigger Property="IsMouseOver" Value="True">
													<Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSoft}"/>
												</Trigger>
												<Trigger Property="IsSelected" Value="True">
													<Setter TargetName="bd" Property="Background" Value="#BFDBFE"/>
												</Trigger>
											</ControlTemplate.Triggers>
										</ControlTemplate>
									</Setter.Value>
								</Setter>
							</Style>
						</ListBox.ItemContainerStyle>
						<ListBox.ItemTemplate>
							<DataTemplate>
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="1.1*"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>
									<TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis"
									           Margin="0,0,8,0"/>
									<TextBlock Grid.Column="1" Text="{Binding Gloss}" FontSize="13" Opacity="0.72"
									           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
								</Grid>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
					<Separator x:Name="spsel" Margin="0,4,0,6"/>
					<WrapPanel>
						<Button x:Name="bselspeak" Content="发音" Height="26" MinWidth="52" Margin="0,0,6,0"
						        Padding="8,0" FontSize="12" Style="{StaticResource GhostBtn}"
						        AutomationProperties.AutomationId="dict.sel.speak"/>
						<Button x:Name="bselsearch" Content="搜索" Height="26" MinWidth="52" Margin="0,0,6,0"
						        Padding="8,0" FontSize="12" Style="{StaticResource GhostBtn}"
						        AutomationProperties.AutomationId="dict.sel.search"/>
						<Button x:Name="bseltr" Content="翻译" Height="26" MinWidth="52" Margin="0,0,6,0"
						        Padding="8,0" FontSize="12" Style="{StaticResource GhostBtn}"
						        AutomationProperties.AutomationId="dict.sel.translate"/>
						<Button x:Name="bselcopy" Content="复制" Height="26" MinWidth="52"
						        Padding="8,0" FontSize="12" Style="{StaticResource GhostBtn}"
						        AutomationProperties.AutomationId="dict.sel.copy"/>
					</WrapPanel>
				</StackPanel>
			</Border>
		</Popup>
	</Grid>
</UserControl>
