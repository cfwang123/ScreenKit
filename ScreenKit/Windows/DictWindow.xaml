<Window x:Class="ScreenKit.DictWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="词典"
        Height="680" Width="980"
        MinHeight="420" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="{StaticResource BgApp}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        AutomationProperties.AutomationId="dict.window">
	<Grid Margin="12">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
		<DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
			<Button x:Name="bspeakzh" DockPanel.Dock="Right" Content="读中文" Height="32" MinWidth="72"
			        Margin="6,0,0,0" Padding="10,0" Style="{StaticResource GhostBtn}"
			        AutomationProperties.AutomationId="dict.speakzh"/>
			<Button x:Name="bspeak" DockPanel.Dock="Right" Content="发音" Height="32" MinWidth="64"
			        Margin="6,0,0,0" Padding="10,0" Style="{StaticResource GhostBtn}"
			        AutomationProperties.AutomationId="dict.speak"/>
			<ComboBox x:Name="elang" DockPanel.Dock="Right" Width="110" Height="32"
			          VerticalContentAlignment="Center"
			          AutomationProperties.AutomationId="dict.filter">
				<ComboBoxItem Tag="" Content="全部"/>
				<ComboBoxItem Tag="zh" Content="汉语"/>
				<ComboBoxItem Tag="en" Content="英语"/>
				<ComboBoxItem Tag="ja" Content="日语"/>
				<ComboBoxItem Tag="ko" Content="韩语"/>
			</ComboBox>
			<TextBox x:Name="esearch" Height="32" FontSize="16" Padding="8,4"
			         VerticalContentAlignment="Center"
			         AutomationProperties.AutomationId="dict.search"/>
		</DockPanel>
		<Grid Grid.Row="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="360" MinWidth="220"/>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>
			<ListBox x:Name="lhits" Grid.Column="0"
			         BorderBrush="{StaticResource BorderSoft}"
			         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
			         AutomationProperties.AutomationId="dict.hits">
				<ListBox.ItemTemplate>
					<DataTemplate>
						<StackPanel Margin="2,3">
							<TextBlock Text="{Binding Head}" FontSize="15" TextTrimming="CharacterEllipsis"/>
							<TextBlock Text="{Binding Meta}" Opacity="0.62" FontSize="12" TextTrimming="CharacterEllipsis"/>
							<TextBlock Text="{Binding Preview}" Opacity="0.82" FontSize="12" TextTrimming="CharacterEllipsis"/>
						</StackPanel>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
			<GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center"
			              Background="{StaticResource BorderSoft}"/>
			<TextBox x:Name="edetail" Grid.Column="2" Margin="8,0,0,0"
			         IsReadOnly="True" IsReadOnlyCaretVisible="True"
			         TextWrapping="Wrap" AcceptsReturn="True"
			         VerticalScrollBarVisibility="Auto" FontSize="15"
			         Padding="12" BorderBrush="{StaticResource BorderSoft}"
			         AutomationProperties.AutomationId="dict.detail"/>
		</Grid>
		<TextBlock x:Name="lbstatus" Grid.Row="2" Margin="2,8,0,0" FontSize="12"
		           Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>
	</Grid>
</Window>
