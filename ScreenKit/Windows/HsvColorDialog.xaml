<Window x:Class="ScreenKit.HsvColorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择颜色"
        Height="430" Width="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgApp}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        ShowInTaskbar="False">
	<Grid Margin="14">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- SV 方块 + 色相条；Background=Transparent 才能命中点击 -->
		<Grid Height="200">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="28"/>
			</Grid.ColumnDefinitions>
			<Border BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="2">
				<Grid x:Name="psv" Cursor="Cross" ClipToBounds="True" Background="Transparent">
					<Image x:Name="imsv" Stretch="Fill" IsHitTestVisible="False"/>
					<Ellipse x:Name="cursv" Width="12" Height="12" Stroke="White" StrokeThickness="2"
					         IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"
					         RenderTransformOrigin="0.5,0.5">
						<Ellipse.RenderTransform>
							<TranslateTransform x:Name="cursvTf"/>
						</Ellipse.RenderTransform>
						<Ellipse.Effect>
							<DropShadowEffect BlurRadius="2" ShadowDepth="0" Opacity="0.8" Color="Black"/>
						</Ellipse.Effect>
					</Ellipse>
				</Grid>
			</Border>
			<Border Grid.Column="1" Margin="8,0,0,0" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="2">
				<Grid x:Name="phue" Cursor="Hand" ClipToBounds="True" Background="Transparent">
					<Image x:Name="imhue" Stretch="Fill" IsHitTestVisible="False"/>
					<Border x:Name="curhue" Height="4" BorderBrush="White" BorderThickness="1"
					        Background="#80000000" VerticalAlignment="Top" IsHitTestVisible="False"
					        HorizontalAlignment="Stretch"/>
				</Grid>
			</Border>
		</Grid>

		<!-- 透明度 -->
		<Grid Grid.Row="1" Margin="0,12,0,0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="56"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="48"/>
			</Grid.ColumnDefinitions>
			<TextBlock Text="透明度" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
			<Border Grid.Column="1" Height="20" Margin="8,0" CornerRadius="2" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1">
				<Grid>
					<Border>
						<Border.Background>
							<DrawingBrush TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute">
								<DrawingBrush.Drawing>
									<DrawingGroup>
										<GeometryDrawing Brush="#CCCCCC" Geometry="M0,0 h8 v8 h-8 z"/>
										<GeometryDrawing Brush="#FFFFFF" Geometry="M0,0 h4 v4 h-4 z M4,4 h4 v4 h-4 z"/>
									</DrawingGroup>
								</DrawingBrush.Drawing>
							</DrawingBrush>
						</Border.Background>
					</Border>
					<!-- 必须 Transparent 背景才能接收鼠标 -->
					<Border x:Name="palpha" Background="Transparent" Cursor="Hand">
						<Border.OpacityMask>
							<LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
								<GradientStop Color="#00000000" Offset="0"/>
								<GradientStop Color="#FF000000" Offset="1"/>
							</LinearGradientBrush>
						</Border.OpacityMask>
						<Border x:Name="palphafill" Background="Black"/>
					</Border>
				</Grid>
			</Border>
			<TextBlock x:Name="lbalpha" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
			           Foreground="{StaticResource TextMuted}"/>
		</Grid>

		<!-- HSV 数值：H 0~360，S/V 0~100% -->
		<Grid Grid.Row="2" Margin="0,12,0,0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>
			<StackPanel Orientation="Horizontal">
				<TextBlock Text="H" Width="16" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
				<TextBox x:Name="eh" Width="56" Height="26"/>
			</StackPanel>
			<StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
				<TextBlock Text="S" Width="16" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
				<TextBox x:Name="es" Width="56" Height="26"/>
			</StackPanel>
			<StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
				<TextBlock Text="V" Width="16" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
				<TextBox x:Name="ev" Width="56" Height="26"/>
			</StackPanel>
		</Grid>

		<!-- 预览 + 十六进制 -->
		<Grid Grid.Row="3" Margin="0,12,0,0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>
			<Border Width="48" Height="32" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="3">
				<Border.Background>
					<DrawingBrush TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute">
						<DrawingBrush.Drawing>
							<DrawingGroup>
								<GeometryDrawing Brush="#CCCCCC" Geometry="M0,0 h8 v8 h-8 z"/>
								<GeometryDrawing Brush="#FFFFFF" Geometry="M0,0 h4 v4 h-4 z M4,4 h4 v4 h-4 z"/>
							</DrawingGroup>
						</DrawingBrush.Drawing>
					</DrawingBrush>
				</Border.Background>
				<Border x:Name="ppreview" CornerRadius="2"/>
			</Border>
			<StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
				<TextBlock Text="Hex" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextMuted}"/>
				<TextBox x:Name="ehex" Width="130" Height="28" ToolTip="#AARRGGBB"/>
			</StackPanel>
		</Grid>

		<StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
			<Button x:Name="bok" Content="确定" Width="80" Height="28" Margin="0,0,8,0" IsDefault="True"
			        Style="{StaticResource PrimaryBtn}"/>
			<Button x:Name="bcancel" Content="取消" Width="80" Height="28" IsCancel="True"
			        Style="{StaticResource ToolBtn}"/>
		</StackPanel>
	</Grid>
</Window>
