<Window x:Class="ScreenKit.SqlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="数据库查询"
        Width="1120" Height="760"
        MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BgApp}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="13"
        AllowDrop="True"
        AutomationProperties.AutomationId="sql.window">
	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<TextBlock x:Name="lbhint" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8"
		           Foreground="{StaticResource TextMuted}" FontSize="12"/>

		<!-- 连接栏 -->
		<Border Grid.Row="1" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderSoft}"
		        BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
			<WrapPanel VerticalAlignment="Center">
				<TextBlock x:Name="lbtype" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextMuted}"/>
				<ComboBox x:Name="ecxkind" Width="130" Height="30" Margin="0,0,10,0" VerticalContentAlignment="Center"
				          AutomationProperties.AutomationId="sql.kind">
					<ComboBoxItem Content="SQLite" IsSelected="True"/>
					<ComboBoxItem Content="SQL Server"/>
				</ComboBox>

				<StackPanel x:Name="psqlite" Orientation="Horizontal" VerticalAlignment="Center">
					<TextBlock x:Name="lbfile" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextMuted}"/>
					<TextBox x:Name="efile" Width="330" Height="30" Padding="8,4" Margin="0,0,6,0"
					         BorderBrush="{StaticResource BorderSoft}" VerticalContentAlignment="Center"
					         ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
					         AutomationProperties.AutomationId="sql.file"/>
					<Button x:Name="bfile" Style="{StaticResource ToolBtn}" Margin="0,0,10,0"
					        AutomationProperties.AutomationId="sql.browse"/>
				</StackPanel>

				<StackPanel x:Name="pmssql" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
					<TextBlock x:Name="lbhost" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextMuted}"/>
					<TextBox x:Name="ehost" Width="150" Height="30" Padding="8,4" Margin="0,0,8,0"
					         BorderBrush="{StaticResource BorderSoft}" VerticalContentAlignment="Center"
					         AutomationProperties.AutomationId="sql.host"/>
					<TextBlock x:Name="lbdb" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextMuted}"/>
					<TextBox x:Name="edb" Width="130" Height="30" Padding="8,4" Margin="0,0,8,0"
					         BorderBrush="{StaticResource BorderSoft}" VerticalContentAlignment="Center"
					         AutomationProperties.AutomationId="sql.db"/>
					<TextBlock x:Name="lbuser" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextMuted}"/>
					<TextBox x:Name="euser" Width="90" Height="30" Padding="8,4" Margin="0,0,8,0"
					         BorderBrush="{StaticResource BorderSoft}" VerticalContentAlignment="Center"
					         AutomationProperties.AutomationId="sql.user"/>
					<TextBlock x:Name="lbpw" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextMuted}"/>
					<PasswordBox x:Name="epw" Width="90" Height="30" Padding="8,4" Margin="0,0,10,0"
					             BorderBrush="{StaticResource BorderSoft}" VerticalContentAlignment="Center"/>
				</StackPanel>

				<Button x:Name="bconnect" Style="{StaticResource ToolBtn}" Margin="0"
				        AutomationProperties.AutomationId="sql.connect"/>
			</WrapPanel>
		</Border>

		<!-- 主体 -->
		<Grid Grid.Row="2">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="280" MinWidth="180"/>
				<ColumnDefinition Width="8"/>
				<ColumnDefinition Width="*" MinWidth="420"/>
			</Grid.ColumnDefinitions>

			<Border Grid.Column="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderSoft}"
			        BorderThickness="1" CornerRadius="8" Padding="8">
				<DockPanel>
					<TextBlock x:Name="lbtables" DockPanel.Dock="Top" FontWeight="SemiBold" Margin="2,0,0,6"/>
					<StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
						<Button x:Name="brefresh" Style="{StaticResource ToolBtnSm}"
						        AutomationProperties.AutomationId="sql.refresh"/>
						<Button x:Name="bdata" Style="{StaticResource ToolBtnSm}"
						        AutomationProperties.AutomationId="sql.query"/>
						<Button x:Name="bschema" Style="{StaticResource ToolBtnSm}" Margin="0"
						        AutomationProperties.AutomationId="sql.schema"/>
					</StackPanel>
					<ListBox x:Name="lstables" BorderThickness="0" Background="Transparent"
					         FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"
					         ScrollViewer.HorizontalScrollBarVisibility="Auto"
					         VirtualizingPanel.IsVirtualizing="True"
					         AutomationProperties.AutomationId="sql.tables"/>
				</DockPanel>
			</Border>

			<GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent"/>

			<Grid Grid.Column="2">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
				</Grid.RowDefinitions>

				<Grid Grid.Row="0" Margin="0,0,0,8">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>
					<TextBox x:Name="esql" Height="96" Padding="8,6" AcceptsReturn="True" AcceptsTab="True"
					         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
					         BorderBrush="{StaticResource BorderSoft}" FontFamily="Consolas, Microsoft YaHei UI"
					         FontSize="12" TextWrapping="NoWrap"
					         AutomationProperties.AutomationId="sql.sql"/>
					<StackPanel Grid.Column="1" Margin="8,0,0,0">
						<Button x:Name="brun" Style="{StaticResource ToolBtn}" Margin="0,0,0,6" Width="96"
						        AutomationProperties.AutomationId="sql.run"/>
						<StackPanel Orientation="Horizontal">
							<TextBlock x:Name="lbtop" VerticalAlignment="Center" Margin="0,0,6,0"
							           Foreground="{StaticResource TextMuted}" FontSize="12"/>
							<ComboBox x:Name="etop" Width="92" Height="26" FontSize="12" VerticalContentAlignment="Center"/>
						</StackPanel>
					</StackPanel>
				</Grid>

				<TabControl x:Name="tabs" Grid.Row="1" BorderBrush="{StaticResource BorderSoft}"
				            AutomationProperties.AutomationId="sql.tabs">
					<TabItem x:Name="tabdata" AutomationProperties.AutomationId="sql.tab.data">
						<DataGrid x:Name="dg" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False"
						          HeadersVisibility="Column" GridLinesVisibility="All" BorderThickness="0"
						          Background="{StaticResource BgPanel}" RowBackground="White"
						          AlternatingRowBackground="#F7FAFC"
						          FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"
						          EnableRowVirtualization="True" EnableColumnVirtualization="True"
						          ClipboardCopyMode="IncludeHeader" SelectionUnit="Cell"
						          AutomationProperties.AutomationId="sql.grid"/>
					</TabItem>
					<TabItem x:Name="tabschema" AutomationProperties.AutomationId="sql.tab.schema">
						<DockPanel>
							<StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
								<TextBlock x:Name="lbcreate" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,0,0,4"/>
								<TextBox x:Name="ecreate" Height="86" Padding="6,4" IsReadOnly="True"
								         AcceptsReturn="True" TextWrapping="NoWrap"
								         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
								         BorderBrush="{StaticResource BorderSoft}"
								         FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"/>
							</StackPanel>
							<DataGrid x:Name="dgs" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False"
							          HeadersVisibility="Column" GridLinesVisibility="All" BorderThickness="0"
							          Background="{StaticResource BgPanel}" RowBackground="White"
							          AlternatingRowBackground="#F7FAFC"
							          FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"
							          ClipboardCopyMode="IncludeHeader" SelectionUnit="Cell"
							          AutomationProperties.AutomationId="sql.schema.grid"/>
						</DockPanel>
					</TabItem>
				</TabControl>
			</Grid>
		</Grid>

		<TextBlock x:Name="lbstat" Grid.Row="3" Margin="2,8,0,0" TextWrapping="Wrap"
		           Foreground="{StaticResource TextMuted}" FontSize="12"/>
	</Grid>
</Window>
