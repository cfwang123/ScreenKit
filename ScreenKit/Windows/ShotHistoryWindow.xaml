<Window x:Class="ScreenKit.ShotHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="截图历史"
        Width="1200" Height="740"
        MinWidth="860" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgApp}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        AutomationProperties.AutomationId="hist.window">
	<Window.Resources>
		<Style x:Key="WxIconBtn" TargetType="Button">
			<Setter Property="Width" Value="36"/>
			<Setter Property="Height" Value="36"/>
			<Setter Property="Margin" Value="1,0"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="FontSize" Value="16"/>
			<Setter Property="Foreground" Value="#1A1A1A"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="bd" Background="{TemplateBinding Background}"
						        CornerRadius="8" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bd" Property="Background" Value="#F0F0F0"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="bd" Property="Background" Value="#E5E5E5"/>
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter Property="Opacity" Value="0.4"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<Style x:Key="WxIconToggle" TargetType="ToggleButton">
			<Setter Property="Width" Value="36"/>
			<Setter Property="Height" Value="36"/>
			<Setter Property="Margin" Value="1,0"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="FontSize" Value="15"/>
			<Setter Property="Foreground" Value="#1A1A1A"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ToggleButton">
						<Border x:Name="bd" Background="{TemplateBinding Background}"
						        CornerRadius="8" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bd" Property="Background" Value="#F0F0F0"/>
							</Trigger>
							<Trigger Property="IsChecked" Value="True">
								<Setter TargetName="bd" Property="Background" Value="#E8E8E8"/>
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter Property="Opacity" Value="0.4"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<Style x:Key="WxColorDot" TargetType="RadioButton">
			<Setter Property="Width" Value="22"/>
			<Setter Property="Height" Value="22"/>
			<Setter Property="Margin" Value="3,0"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="RadioButton">
						<Grid>
							<Ellipse x:Name="ring" Stroke="Transparent" StrokeThickness="2"
							         Fill="Transparent" Margin="-2"/>
							<Ellipse x:Name="dot" Fill="{TemplateBinding Background}" Margin="2"
							         Stroke="#D0D0D0" StrokeThickness="1"/>
						</Grid>
						<ControlTemplate.Triggers>
							<Trigger Property="IsChecked" Value="True">
								<Setter TargetName="ring" Property="Stroke" Value="#333333"/>
							</Trigger>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="ring" Property="Stroke" Value="#999999"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>
	<Grid Margin="12">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="248"/>
			<ColumnDefinition Width="12"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<Grid Grid.Column="0">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>
			<TextBlock x:Name="lbtitle" Text="截图历史" FontSize="16" FontWeight="SemiBold"
			           Foreground="{StaticResource TextPrimary}" Margin="2,0,0,8"/>
			<Grid Grid.Row="1">
				<ListBox x:Name="lv" BorderBrush="{StaticResource BorderSoft}"
				         Background="{StaticResource BgPanel}"
				         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
				         VirtualizingPanel.IsVirtualizing="True"
				         VirtualizingPanel.VirtualizationMode="Recycling"
				         AutomationProperties.AutomationId="hist.list">
					<ListBox.ItemContainerStyle>
						<Style TargetType="ListBoxItem">
							<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
							<Setter Property="Padding" Value="0"/>
							<Setter Property="Margin" Value="4,2"/>
							<Setter Property="FocusVisualStyle" Value="{x:Null}"/>
							<Setter Property="Template">
								<Setter.Value>
									<ControlTemplate TargetType="ListBoxItem">
										<Border x:Name="bd" Background="Transparent"
										        BorderBrush="#E2E8F0" BorderThickness="1"
										        CornerRadius="8" Padding="6">
											<ContentPresenter/>
										</Border>
										<ControlTemplate.Triggers>
											<Trigger Property="IsMouseOver" Value="True">
												<Setter TargetName="bd" Property="Background" Value="#F8FAFC"/>
											</Trigger>
											<Trigger Property="IsSelected" Value="True">
												<Setter TargetName="bd" Property="BorderBrush" Value="#3B82F6"/>
												<Setter TargetName="bd" Property="Background" Value="#EFF6FF"/>
											</Trigger>
										</ControlTemplate.Triggers>
									</ControlTemplate>
								</Setter.Value>
							</Setter>
						</Style>
					</ListBox.ItemContainerStyle>
					<ListBox.ItemTemplate>
						<DataTemplate>
							<StackPanel>
								<Border Height="112" Background="#1E2430" CornerRadius="4" ClipToBounds="True">
									<Image Source="{Binding Thumb}" Stretch="Uniform"/>
								</Border>
								<TextBlock Text="{Binding Name}" FontSize="11" Margin="0,4,0,0"
								           TextTrimming="CharacterEllipsis"
								           Foreground="{StaticResource TextPrimary}"/>
								<TextBlock Text="{Binding When}" FontSize="10" Margin="0,1,0,0"
								           Foreground="{StaticResource TextMuted}"/>
							</StackPanel>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
				<TextBlock x:Name="lbempty" Text="没有截图" HorizontalAlignment="Center"
				           VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"
				           FontSize="13" IsHitTestVisible="False"/>
			</Grid>
			<Button x:Name="bfolder" Grid.Row="2" Content="打开文件夹" Margin="0,8,0,0"
			        Style="{StaticResource ToolBtn}" HorizontalAlignment="Stretch"
			        AutomationProperties.AutomationId="hist.folder"/>
		</Grid>

		<Grid Grid.Column="2">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>
			<TextBlock x:Name="lbmeta" FontSize="12" Foreground="{StaticResource TextMuted}"
			           Margin="2,2,2,6" TextTrimming="CharacterEllipsis"/>
			<Border Grid.Row="1" Background="{StaticResource BgImage}" CornerRadius="8"
			        ClipToBounds="True" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1">
				<Grid x:Name="pviewport" Background="Transparent" ClipToBounds="True"
				      AutomationProperties.AutomationId="hist.preview">
					<Canvas x:Name="pstage" HorizontalAlignment="Left" VerticalAlignment="Top">
						<Canvas.RenderTransform>
							<TransformGroup>
								<ScaleTransform x:Name="tfscale" ScaleX="1" ScaleY="1"/>
								<TranslateTransform x:Name="tfpan" X="0" Y="0"/>
							</TransformGroup>
						</Canvas.RenderTransform>
						<Image x:Name="imgview" Stretch="Fill" IsHitTestVisible="False"
						       SnapsToDevicePixels="True"
						       RenderOptions.BitmapScalingMode="HighQuality"/>
						<Canvas x:Name="pdraw" Background="Transparent" IsHitTestVisible="False"/>
					</Canvas>
				</Grid>
			</Border>

			<Border Grid.Row="2" Margin="0,8,0,0" Background="#FFFFFFF2" CornerRadius="16"
			        BorderBrush="#E8E8E8" BorderThickness="1" Padding="6,4" HorizontalAlignment="Stretch">
				<ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
				              VerticalAlignment="Center">
					<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
						<ToggleButton x:Name="trect" Style="{StaticResource WxIconToggle}" ToolTip="矩形"
						              AutomationProperties.AutomationId="hist.rect">
							<Path Stroke="#1A1A1A" StrokeThickness="2.2" Fill="Transparent"
							      Stretch="Uniform" Width="18" Height="18" Data="M3,3 H15 V15 H3 Z"/>
						</ToggleButton>
						<ToggleButton x:Name="tellipse" Style="{StaticResource WxIconToggle}" ToolTip="椭圆"
						              AutomationProperties.AutomationId="hist.ellipse">
							<Path Stroke="#1A1A1A" StrokeThickness="2.2" Fill="Transparent"
							      Stretch="Uniform" Width="18" Height="18"
							      Data="M9,2.5 A6.5,6.5 0 1 1 8.99,2.5 Z"/>
						</ToggleButton>
						<ToggleButton x:Name="tarrow" Style="{StaticResource WxIconToggle}" ToolTip="箭头"
						              AutomationProperties.AutomationId="hist.arrow">
							<Path Stroke="#1A1A1A" StrokeThickness="2" StrokeStartLineCap="Round"
							      StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"
							      Stretch="Uniform" Width="18" Height="18"
							      Data="M3,15 L15,3 M8,3 H15 V10"/>
						</ToggleButton>
						<ToggleButton x:Name="tpen" Style="{StaticResource WxIconToggle}" ToolTip="画笔"
						              AutomationProperties.AutomationId="hist.pen">
							<Path Stroke="#1A1A1A" StrokeThickness="1.8" StrokeStartLineCap="Round"
							      StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"
							      Stretch="Uniform" Width="18" Height="18"
							      Data="M3,14 L6,11 L13,4 L15,6 L8,13 L5,16 Z M11.5,5.5 L13.5,7.5"/>
						</ToggleButton>
						<ToggleButton x:Name="ttext" Style="{StaticResource WxIconToggle}" ToolTip="文字"
						              AutomationProperties.AutomationId="hist.text">
							<TextBlock Text="T" FontSize="17" FontWeight="Bold" FontFamily="Segoe UI"/>
						</ToggleButton>
						<Border Width="1" Height="22" Background="#E0E0E0" Margin="8,0" VerticalAlignment="Center"/>
						<RadioButton x:Name="crred" Style="{StaticResource WxColorDot}" Background="#FA5151"
						             IsChecked="True" GroupName="histColor" ToolTip="红" Tag="#FA5151"/>
						<RadioButton x:Name="cryellow" Style="{StaticResource WxColorDot}" Background="#FFC300"
						             GroupName="histColor" ToolTip="黄" Tag="#FFC300"/>
						<RadioButton x:Name="crgreen" Style="{StaticResource WxColorDot}" Background="#07C160"
						             GroupName="histColor" ToolTip="绿" Tag="#07C160"/>
						<RadioButton x:Name="crblue" Style="{StaticResource WxColorDot}" Background="#10AEFF"
						             GroupName="histColor" ToolTip="蓝" Tag="#10AEFF"/>
						<RadioButton x:Name="crwhite" Style="{StaticResource WxColorDot}" Background="#FFFFFF"
						             GroupName="histColor" ToolTip="白" Tag="#FFFFFF"/>
						<ComboBox x:Name="ethick" Width="52" Height="28" Margin="8,0,0,0"
						          VerticalContentAlignment="Center" FontSize="12" ToolTip="线粗">
							<ComboBoxItem Content="1" Tag="1"/>
							<ComboBoxItem Content="2" Tag="2"/>
							<ComboBoxItem Content="3" Tag="3" IsSelected="True"/>
							<ComboBoxItem Content="4" Tag="4"/>
							<ComboBoxItem Content="6" Tag="6"/>
							<ComboBoxItem Content="8" Tag="8"/>
						</ComboBox>
						<ComboBox x:Name="efont" Width="52" Height="28" Margin="4,0,0,0"
						          VerticalContentAlignment="Center" FontSize="12" ToolTip="字号">
							<ComboBoxItem Content="14" Tag="14"/>
							<ComboBoxItem Content="18" Tag="18" IsSelected="True"/>
							<ComboBoxItem Content="24" Tag="24"/>
							<ComboBoxItem Content="32" Tag="32"/>
						</ComboBox>
						<Border Width="1" Height="22" Background="#E0E0E0" Margin="8,0" VerticalAlignment="Center"/>
						<Button x:Name="bundo" Style="{StaticResource WxIconBtn}" ToolTip="撤销 (Ctrl+Z)"
						        AutomationProperties.AutomationId="hist.undo">
							<Path Stroke="#1A1A1A" StrokeThickness="1.8" StrokeStartLineCap="Round"
							      StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"
							      Stretch="Uniform" Width="16" Height="16"
							      Data="M3,7 H11 A4,4 0 1 1 11,15 H6 M3,7 L6,4 M3,7 L6,10"/>
						</Button>
						<Button x:Name="bopen" Style="{StaticResource WxIconBtn}" ToolTip="用系统软件打开"
						        AutomationProperties.AutomationId="hist.open">
							<Path Stroke="#1A1A1A" StrokeThickness="1.6" StrokeStartLineCap="Round"
							      StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"
							      Stretch="Uniform" Width="16" Height="16"
							      Data="M1.6,6.2 H8.2 V13.4 H1.6 Z M7.2,2.2 H13.6 V8.6 M8.4,7.4 L13.6,2.2 M10.4,2.2 H13.6 V5.4"/>
						</Button>
						<Button x:Name="bocr" Style="{StaticResource WxIconBtn}" ToolTip="保存并识别"
						        Width="40" Height="36" Margin="2,0,1,0"
						        AutomationProperties.AutomationId="hist.ocr">
							<Border Background="#3B82F6" CornerRadius="5" Padding="4,3" MinWidth="30">
								<TextBlock Text="OCR" FontSize="10" FontWeight="Bold" Foreground="White"
								           FontFamily="Segoe UI" HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
						</Button>
						<Button x:Name="bcancel" Style="{StaticResource WxIconBtn}" ToolTip="取消" Margin="4,0,1,0"
						        AutomationProperties.AutomationId="hist.cancel">
							<Path Stroke="#FA5151" StrokeThickness="2.2" StrokeStartLineCap="Round"
							      Fill="Transparent" Stretch="Uniform" Width="14" Height="14"
							      Data="M2,2 L12,12 M12,2 L2,12"/>
						</Button>
						<Button x:Name="bok" Style="{StaticResource WxIconBtn}" ToolTip="完成并复制"
						        Width="36" Height="36" Margin="1,0,0,0"
						        AutomationProperties.AutomationId="hist.ok">
							<Path Stroke="#07C160" StrokeThickness="2.4" StrokeStartLineCap="Round"
							      StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"
							      Stretch="Uniform" Width="16" Height="16"
							      Data="M2,8.5 L6.5,13 L14,3.5"/>
						</Button>
						<Button x:Name="bcopydrop" Style="{StaticResource WxIconBtn}" ToolTip="复制方式"
						        Width="Auto" Height="32" MinWidth="120" Margin="2,0,2,0"
						        AutomationProperties.AutomationId="hist.copydrop">
							<Border Padding="8,0" Background="Transparent">
								<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
									<TextBlock x:Name="lbcopymode" Text="复制为图片" FontSize="13"
									           Foreground="#1A1A1A" VerticalAlignment="Center"/>
									<TextBlock Text="p" FontSize="12" Foreground="#8A8A8A"
									           Margin="6,1,6,0" VerticalAlignment="Center"/>
									<Path Fill="#5C5C5C" Stretch="Uniform" Width="9" Height="5"
									      VerticalAlignment="Center" Data="M0,0 L9,0 L4.5,5 Z"/>
								</StackPanel>
							</Border>
						</Button>
					</StackPanel>
				</ScrollViewer>
			</Border>
			<TextBlock x:Name="lbstat" Grid.Row="3" Margin="2,6,2,0" FontSize="12"
			           Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis"/>
			<Popup x:Name="pcopyas" PlacementTarget="{Binding ElementName=bcopydrop}"
			       Placement="Top" StaysOpen="False" AllowsTransparency="True">
				<Border Background="#FFFFFFF2" CornerRadius="10" BorderBrush="#E8E8E8"
				        BorderThickness="1" Padding="4">
					<StackPanel>
						<Button x:Name="mncopyimg" Style="{StaticResource WxIconBtn}" Height="32" Width="160"
						        HorizontalContentAlignment="Left" FontSize="13" Margin="0,0,0,2"
						        AutomationProperties.AutomationId="hist.copy.img" Content="复制为图片"/>
						<Button x:Name="mncopyfile" Style="{StaticResource WxIconBtn}" Height="32" Width="160"
						        HorizontalContentAlignment="Left" FontSize="13" Margin="0,0,0,2"
						        AutomationProperties.AutomationId="hist.copy.file" Content="复制为文件"/>
						<Button x:Name="mncopypath" Style="{StaticResource WxIconBtn}" Height="32" Width="160"
						        HorizontalContentAlignment="Left" FontSize="13"
						        AutomationProperties.AutomationId="hist.copy.path" Content="复制为路径"/>
					</StackPanel>
				</Border>
			</Popup>
		</Grid>
	</Grid>
</Window>
