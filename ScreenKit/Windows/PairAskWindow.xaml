<Window x:Class="ScreenKit.PairAskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC 文件传输"
        Width="440" SizeToContent="Height"
        MinWidth="360" MinHeight="160"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True"
        ShowActivated="True"
        Background="{StaticResource BgApp}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        AutomationProperties.AutomationId="sendfile.pair.window">
	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
		<TextBlock x:Name="lbask" Grid.Row="0" FontSize="15" TextWrapping="Wrap"
		           Foreground="{StaticResource TextPrimary}"
		           Margin="0,0,0,20"
		           Text="允许该手机访问本机 sendfile 文件夹？"
		           AutomationProperties.AutomationId="sendfile.pair.ask"/>
		<StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
			<Button x:Name="bno" Content="拒绝" Style="{StaticResource ToolBtn}"
			        Width="88" Height="32" Margin="0,0,8,0" IsCancel="True"
			        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"
			        AutomationProperties.AutomationId="sendfile.pair.no"/>
			<Button x:Name="byes" Content="允许" Style="{StaticResource PrimaryBtn}"
			        Width="88" Height="32" Margin="0" IsDefault="True"
			        AutomationProperties.AutomationId="sendfile.pair.yes"/>
		</StackPanel>
	</Grid>
</Window>
