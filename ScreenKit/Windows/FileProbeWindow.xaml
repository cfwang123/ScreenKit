<Window x:Class="ScreenKit.FileProbeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文件分析"
        Width="860" Height="640"
        MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BgApp}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        AllowDrop="True"
        AutomationProperties.AutomationId="probe.window">
	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
		<TextBlock x:Name="lbhint" TextWrapping="Wrap" Margin="0,0,0,8"
		           Foreground="{StaticResource TextMuted}" FontSize="12"/>
		<DockPanel Grid.Row="1" Margin="0,0,0,8" LastChildFill="True">
			<Button x:Name="bcopy" Style="{StaticResource ToolBtn}" DockPanel.Dock="Right"/>
			<Button x:Name="bfile" Style="{StaticResource ToolBtn}" DockPanel.Dock="Right"/>
			<TextBox x:Name="epath" Height="32" Padding="8,4" Margin="0,0,8,0"
			         BorderBrush="{StaticResource BorderSoft}" VerticalContentAlignment="Center"/>
		</DockPanel>
		<TabControl x:Name="tabs" Grid.Row="2" BorderBrush="{StaticResource BorderSoft}"
		            AutomationProperties.AutomationId="probe.tabs">
			<TabItem x:Name="tabinfo" Header="概要" AutomationProperties.AutomationId="probe.tab.info">
				<ListView x:Name="lv" BorderThickness="0">
					<ListView.View>
						<GridView>
							<GridViewColumn x:Name="colname" Width="160" DisplayMemberBinding="{Binding Name}"/>
							<GridViewColumn x:Name="colvalue" Width="560" DisplayMemberBinding="{Binding Value}"/>
						</GridView>
					</ListView.View>
				</ListView>
			</TabItem>
			<TabItem x:Name="tabpe" Header="EXE/DLL" Visibility="Collapsed"
			         AutomationProperties.AutomationId="probe.tab.pe">
				<DockPanel>
					<DockPanel DockPanel.Dock="Top" Margin="0,8,0,8" LastChildFill="True">
						<TextBlock x:Name="lbpeq" VerticalAlignment="Center" Margin="0,0,6,0" DockPanel.Dock="Left"/>
						<TextBox x:Name="epeq" Height="32" Padding="8,4" VerticalContentAlignment="Center"/>
					</DockPanel>
					<TabControl x:Name="petabs" Padding="0" BorderThickness="0" Background="Transparent"
					            AutomationProperties.AutomationId="probe.pe.tabs">
						<TabItem x:Name="tabpehead" Header="头信息"
						         AutomationProperties.AutomationId="probe.pe.tab.head">
							<ListView x:Name="lvhead" BorderThickness="0">
								<ListView.View>
									<GridView>
										<GridViewColumn Width="160" DisplayMemberBinding="{Binding A}"/>
										<GridViewColumn Width="560" DisplayMemberBinding="{Binding B}"/>
										<GridViewColumn Width="0" DisplayMemberBinding="{Binding C}"/>
									</GridView>
								</ListView.View>
							</ListView>
						</TabItem>
						<TabItem x:Name="tabpesec" Header="节"
						         AutomationProperties.AutomationId="probe.pe.tab.sec">
							<ListView x:Name="lvsec" BorderThickness="0">
								<ListView.View>
									<GridView>
										<GridViewColumn Width="120" DisplayMemberBinding="{Binding A}"/>
										<GridViewColumn Width="420" DisplayMemberBinding="{Binding B}"/>
										<GridViewColumn Width="220" DisplayMemberBinding="{Binding C}"/>
									</GridView>
								</ListView.View>
							</ListView>
						</TabItem>
						<TabItem x:Name="tabpeimp" Header="导入"
						         AutomationProperties.AutomationId="probe.pe.tab.imp">
							<ListView x:Name="lvimp" BorderThickness="0">
								<ListView.View>
									<GridView>
										<GridViewColumn Width="180" DisplayMemberBinding="{Binding A}"/>
										<GridViewColumn Width="320" DisplayMemberBinding="{Binding B}"/>
										<GridViewColumn Width="200" DisplayMemberBinding="{Binding C}"/>
									</GridView>
								</ListView.View>
							</ListView>
						</TabItem>
						<TabItem x:Name="tabpeexp" Header="导出"
						         AutomationProperties.AutomationId="probe.pe.tab.exp">
							<ListView x:Name="lvexp" BorderThickness="0">
								<ListView.View>
									<GridView>
										<GridViewColumn Width="280" DisplayMemberBinding="{Binding A}"/>
										<GridViewColumn Width="80" DisplayMemberBinding="{Binding B}"/>
										<GridViewColumn Width="360" DisplayMemberBinding="{Binding C}"/>
									</GridView>
								</ListView.View>
							</ListView>
						</TabItem>
						<TabItem x:Name="tabpenet" Header="托管"
						         AutomationProperties.AutomationId="probe.pe.tab.net">
							<ListView x:Name="lvnet" BorderThickness="0">
								<ListView.View>
									<GridView>
										<GridViewColumn Width="100" DisplayMemberBinding="{Binding A}"/>
										<GridViewColumn Width="280" DisplayMemberBinding="{Binding B}"/>
										<GridViewColumn Width="380" DisplayMemberBinding="{Binding C}"/>
									</GridView>
								</ListView.View>
							</ListView>
						</TabItem>
						<TabItem x:Name="tabpeman" Header="清单"
						         AutomationProperties.AutomationId="probe.pe.tab.man">
							<TextBox x:Name="epetext" Visibility="Collapsed" IsReadOnly="True" AcceptsReturn="True"
							         TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
							         FontFamily="Consolas, Microsoft YaHei UI" BorderThickness="0"/>
						</TabItem>
					</TabControl>
				</DockPanel>
			</TabItem>
		</TabControl>
		<TextBlock x:Name="lbstat" Grid.Row="3" Margin="0,8,0,0" Foreground="{StaticResource TextMuted}"/>
	</Grid>
</Window>
