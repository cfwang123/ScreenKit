<Window x:Class="ScreenKit.FastCopyProgWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="快速复制"
        Width="560" Height="250"
        MinWidth="460" MinHeight="220"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Topmost="True"
        Background="{StaticResource BgApp}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        AutomationProperties.AutomationId="fastcopy.prog">
	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
		<TextBlock x:Name="lbfile" TextWrapping="Wrap" Margin="0,0,0,8"
		           AutomationProperties.AutomationId="fastcopy.prog.file"/>
		<ProgressBar x:Name="bar" Grid.Row="1" Height="14" Margin="0,0,0,8" Minimum="0" Maximum="100"/>
		<UniformGrid x:Name="pnums" Grid.Row="2" Columns="2" Margin="0,0,0,4">
			<TextBlock x:Name="lbtotal" Margin="0,0,12,4" TextWrapping="Wrap"
			           AutomationProperties.AutomationId="fastcopy.prog.total"/>
			<TextBlock x:Name="lbdone" Margin="0,0,0,4" TextWrapping="Wrap"
			           AutomationProperties.AutomationId="fastcopy.prog.done"/>
			<TextBlock x:Name="lbtotalsize" Margin="0,12,12,0" TextWrapping="Wrap"/>
			<TextBlock x:Name="lbdonesize" Margin="0,12,0,0" TextWrapping="Wrap"/>
		</UniformGrid>
		<Button x:Name="bcancel" Grid.Row="4" HorizontalAlignment="Right" MinWidth="88" Height="32"
		        Content="取消" AutomationProperties.AutomationId="fastcopy.prog.cancel"/>
	</Grid>
</Window>
