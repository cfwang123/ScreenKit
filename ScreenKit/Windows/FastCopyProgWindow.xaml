<Window x:Class="ScreenKit.FastCopyProgWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="快速复制"
        Width="520" Height="200"
        MinWidth="420" MinHeight="180"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Topmost="True"
        Background="{StaticResource BgApp}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        AutomationProperties.AutomationId="fastcopy.prog">
	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
		<TextBlock x:Name="lbfile" TextWrapping="Wrap" Margin="0,0,0,8"/>
		<ProgressBar x:Name="bar" Height="14" Margin="0,0,0,8" Minimum="0" Maximum="100"/>
		<TextBlock x:Name="lbstat" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" FontSize="12"/>
		<Button x:Name="bcancel" Grid.Row="4" HorizontalAlignment="Right" MinWidth="88" Height="32"
		        Content="取消" AutomationProperties.AutomationId="fastcopy.prog.cancel"/>
	</Grid>
</Window>
