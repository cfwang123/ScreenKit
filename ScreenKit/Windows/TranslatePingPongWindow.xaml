<Window x:Class="ScreenKit.TranslatePingPongWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="来回翻译 20 次"
        Height="640" Width="720"
        MinHeight="420" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgApp}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        ShowInTaskbar="True">
	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="True">
			<StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
				<Button x:Name="bcancel" Content="取消" Style="{StaticResource ToolBtn}"
				        Width="80" Height="32" Margin="0,0,8,0" ToolTip="停止后续往返"/>
				<Button x:Name="bcopy" Content="复制最终结果" Style="{StaticResource ToolBtn}"
				        Width="110" Height="32" IsEnabled="False" ToolTip="复制最后一轮译文"/>
			</StackPanel>
			<StackPanel VerticalAlignment="Center">
				<TextBlock x:Name="lbtitle" Text="来回翻译 20 次" FontSize="16" FontWeight="SemiBold"
				           Foreground="{StaticResource TextPrimary}"/>
				<TextBlock x:Name="lbstatus" Text="准备中…" FontSize="12" Margin="0,4,0,0"
				           Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>
			</StackPanel>
		</DockPanel>

		<Border Grid.Row="1" Background="{StaticResource BgPanel}" CornerRadius="10"
		        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" Padding="12">
			<TextBox x:Name="elog" AcceptsReturn="True" TextWrapping="Wrap"
			         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
			         IsReadOnly="True" BorderThickness="0" Background="Transparent"
			         FontSize="13" FontFamily="Consolas, Microsoft YaHei UI"
			         VerticalContentAlignment="Top"/>
		</Border>

		<DockPanel Grid.Row="2" Margin="0,12,0,0">
			<Button x:Name="bclose" DockPanel.Dock="Right" Content="关闭" Style="{StaticResource ToolBtn}"
			        Width="88" Height="32"/>
			<TextBlock x:Name="lbhint" VerticalAlignment="Center" FontSize="11"
			           Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
			           Text="每一「次」= 正向翻译 + 反向翻译；共 20 次往返，下方显示每一步中间结果。"/>
		</DockPanel>
	</Grid>
</Window>
