<Window x:Class="ScreenKit.BatchRenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="批量重命名"
        Width="1100" Height="720"
        MinWidth="800" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BgApp}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        AllowDrop="True"
        AutomationProperties.AutomationId="rename.window">
	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
		<TextBlock x:Name="lbhint" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10"
		           Foreground="{StaticResource TextMuted}" FontSize="12"/>
		<Grid Grid.Row="1" Margin="0,0,0,8">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="16"/>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>
			<TextBlock x:Name="lbold" Text="旧表达式" VerticalAlignment="Center" Margin="0,0,8,0"/>
			<TextBox x:Name="eold" Grid.Column="1" Height="30" Padding="6,4" Text="%1"
			         BorderBrush="{StaticResource BorderSoft}"
			         VerticalContentAlignment="Center"
			         AutomationProperties.AutomationId="rename.old"/>
			<TextBlock x:Name="lbnew" Grid.Column="3" Text="新表达式" VerticalAlignment="Center" Margin="0,0,8,0"/>
			<TextBox x:Name="enew" Grid.Column="4" Height="30" Padding="6,4" Text="%1"
			         BorderBrush="{StaticResource BorderSoft}"
			         VerticalContentAlignment="Center"
			         AutomationProperties.AutomationId="rename.new"/>
		</Grid>
		<StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
			<CheckBox x:Name="cmatch" Content="区分大小写" Margin="0,0,16,0"
			          AutomationProperties.AutomationId="rename.case"/>
			<CheckBox x:Name="cregex" Content="正则" Margin="0,0,16,0"
			          AutomationProperties.AutomationId="rename.regex"/>
			<CheckBox x:Name="cnoext" Content="忽略扩展名"
			          AutomationProperties.AutomationId="rename.noext"/>
		</StackPanel>
		<Grid Grid.Row="3">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="12"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>
			<DockPanel Grid.Column="0">
				<TextBlock x:Name="lbsrc" DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,6" Text="源文件"/>
				<ListView x:Name="lv" BorderBrush="{StaticResource BorderSoft}"
				          SelectionMode="Extended"
				          AutomationProperties.AutomationId="rename.list">
					<ListView.View>
						<GridView>
							<GridViewColumn Width="220">
								<GridViewColumn.Header>
									<GridViewColumnHeader x:Name="colname" Content="名称" Tag="name" Click="onsort"/>
								</GridViewColumn.Header>
								<GridViewColumn.DisplayMemberBinding>
									<Binding Path="From"/>
								</GridViewColumn.DisplayMemberBinding>
							</GridViewColumn>
							<GridViewColumn Width="140">
								<GridViewColumn.Header>
									<GridViewColumnHeader x:Name="colmtime" Content="修改日期" Tag="mtime" Click="onsort"/>
								</GridViewColumn.Header>
								<GridViewColumn.DisplayMemberBinding>
									<Binding Path="MTimeText"/>
								</GridViewColumn.DisplayMemberBinding>
							</GridViewColumn>
							<GridViewColumn Width="140">
								<GridViewColumn.Header>
									<GridViewColumnHeader x:Name="coladded" Content="添加日期" Tag="added" Click="onsort"/>
								</GridViewColumn.Header>
								<GridViewColumn.DisplayMemberBinding>
									<Binding Path="AddedText"/>
								</GridViewColumn.DisplayMemberBinding>
							</GridViewColumn>
						</GridView>
					</ListView.View>
				</ListView>
			</DockPanel>
			<DockPanel Grid.Column="2">
				<TextBlock x:Name="lbdst" DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,6" Text="目标文件名"/>
				<TextBox x:Name="eto" AcceptsReturn="True" TextWrapping="NoWrap"
				         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
				         FontFamily="Consolas, Microsoft YaHei UI" FontSize="13"
				         Padding="8" BorderBrush="{StaticResource BorderSoft}"
				         AutomationProperties.AutomationId="rename.dst"/>
			</DockPanel>
		</Grid>
		<TextBlock x:Name="lbstat" Grid.Row="4" Margin="0,8,0,8"
		           Foreground="{StaticResource TextMuted}"/>
		<DockPanel Grid.Row="5">
			<StackPanel Orientation="Horizontal">
				<Button x:Name="badd" Style="{StaticResource ToolBtn}"
				        AutomationProperties.AutomationId="rename.add"/>
				<Button x:Name="bfolder" Style="{StaticResource ToolBtn}"
				        AutomationProperties.AutomationId="rename.folder"/>
				<Button x:Name="bremove" Style="{StaticResource ToolBtn}"
				        AutomationProperties.AutomationId="rename.remove"/>
				<Button x:Name="bup" Style="{StaticResource ToolBtn}"
				        AutomationProperties.AutomationId="rename.up"/>
				<Button x:Name="bdown" Style="{StaticResource ToolBtn}"
				        AutomationProperties.AutomationId="rename.down"/>
				<Button x:Name="bclear" Style="{StaticResource ToolBtn}"
				        AutomationProperties.AutomationId="rename.clear"/>
			</StackPanel>
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
				<Button x:Name="bgo" Style="{StaticResource ToolBtn}"
				        AutomationProperties.AutomationId="rename.go"/>
				<Button x:Name="bclose" Style="{StaticResource ToolBtn}"
				        AutomationProperties.AutomationId="rename.close"/>
			</StackPanel>
		</DockPanel>
	</Grid>
</Window>
