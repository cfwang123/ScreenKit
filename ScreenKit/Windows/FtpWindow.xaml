<Window x:Class="ScreenKit.FtpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScreenKit"
        Title="FTP 文件管理"
        Width="980" Height="760"
        MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BgApp}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        AutomationProperties.AutomationId="ftp.window">
	<Grid Margin="12">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- ============ 连接栏 ============ -->
		<Grid Grid.Row="0" Margin="0,0,0,8">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="150"/>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="*" MinWidth="100"/>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="62"/>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="110"/>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="88"/>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="110"/>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>
			<TextBlock x:Name="lbsite" Text="站点" VerticalAlignment="Center" Margin="0,0,6,0"/>
			<ComboBox x:Name="cbSite" Grid.Column="1" Height="30" Margin="0,0,8,0"
			          VerticalContentAlignment="Center"
			          DisplayMemberPath="Name"
			          AutomationProperties.AutomationId="ftp.site"/>
			<TextBlock x:Name="lbhost" Grid.Column="2" Text="主机" VerticalAlignment="Center" Margin="0,0,6,0"/>
			<TextBox x:Name="ehost" Grid.Column="3" Height="30" Padding="6,3"
			         VerticalContentAlignment="Center" BorderBrush="{StaticResource BorderSoft}"
			         AutomationProperties.AutomationId="ftp.host"/>
			<TextBlock x:Name="lbport" Grid.Column="4" Text="端口" VerticalAlignment="Center" Margin="8,0,6,0"/>
			<TextBox x:Name="eport" Grid.Column="5" Height="30" Padding="6,3"
			         VerticalContentAlignment="Center" BorderBrush="{StaticResource BorderSoft}"
			         AutomationProperties.AutomationId="ftp.port"/>
			<TextBlock x:Name="lbuser" Grid.Column="6" Text="用户" VerticalAlignment="Center" Margin="8,0,6,0"/>
			<TextBox x:Name="euser" Grid.Column="7" Height="30" Padding="6,3"
			         VerticalContentAlignment="Center" BorderBrush="{StaticResource BorderSoft}"
			         AutomationProperties.AutomationId="ftp.user"/>
			<TextBlock x:Name="lbpass" Grid.Column="8" Text="密码" VerticalAlignment="Center" Margin="8,0,6,0"/>
			<PasswordBox x:Name="epass" Grid.Column="9" Height="30" Padding="6,3"
			             VerticalContentAlignment="Center" BorderBrush="{StaticResource BorderSoft}"
			             AutomationProperties.AutomationId="ftp.pass"/>
			<TextBlock x:Name="lbkind" Grid.Column="10" Text="协议" VerticalAlignment="Center" Margin="8,0,6,0"/>
			<ComboBox x:Name="cbKind" Grid.Column="11" Height="30"
			          VerticalContentAlignment="Center" Margin="0,0,8,0"
			          AutomationProperties.AutomationId="ftp.kind"/>
			<Button x:Name="bconn" Grid.Column="12" Style="{StaticResource ConnectBtn}" Height="30"
			        MinWidth="64" Margin="0,0,6,0" Padding="10,3"
			        AutomationProperties.AutomationId="ftp.connect"/>
			<Button x:Name="bsave" Grid.Column="13" Style="{StaticResource ToolBtn}" Height="30"
			        MinWidth="64" Padding="10,3"
			        AutomationProperties.AutomationId="ftp.savesite"/>
		</Grid>

		<!-- ============ 状态提示 ============ -->
		<TextBlock x:Name="lbhint" Grid.Row="1" TextWrapping="Wrap" Margin="0,0,0,8"
		           Foreground="{StaticResource TextMuted}" FontSize="12"/>

		<!-- ============ 服务器文件列表 ============ -->
		<Border x:Name="dropzone" Grid.Row="2" BorderBrush="{StaticResource BorderSoft}"
		        BorderThickness="1" Background="{StaticResource BgPanel}"
		        AllowDrop="True" CornerRadius="4" Padding="6">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
				</Grid.RowDefinitions>
				<StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
					<TextBlock x:Name="lbremote" Text="远程" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
					<Button x:Name="bremoteup" Style="{StaticResource ToolBtnSm}" Margin="0,0,4,0"
					        AutomationProperties.AutomationId="ftp.remote.up"/>
					<Button x:Name="bremoterefresh" Style="{StaticResource ToolBtnSm}" Margin="0,0,4,0"
					        AutomationProperties.AutomationId="ftp.remote.refresh"/>
					<Button x:Name="bremotemkdir" Style="{StaticResource ToolBtnSm}" Margin="0,0,4,0"
					        AutomationProperties.AutomationId="ftp.remote.mkdir"/>
					<Button x:Name="bremotedel" Style="{StaticResource ToolBtnSm}" Margin="0,0,12,0"
					        AutomationProperties.AutomationId="ftp.remote.del"/>
					<Button x:Name="bdownloadto" Style="{StaticResource ToolBtnSm}"
					        AutomationProperties.AutomationId="ftp.remote.downloadto"/>
				</StackPanel>
				<TextBox x:Name="eremotepath" Grid.Row="1" Height="28" Padding="6,3" Margin="0,0,0,6"
				         VerticalContentAlignment="Center" BorderBrush="{StaticResource BorderSoft}"
				         AutomationProperties.AutomationId="ftp.remote.path"/>
				<Border x:Name="tftptip" Grid.Row="2" Visibility="Collapsed"
				        Background="{StaticResource BgApp}" CornerRadius="4" Padding="18">
					<StackPanel VerticalAlignment="Center">
						<TextBlock x:Name="lbtftptiptitle" FontWeight="SemiBold" FontSize="13"
						           Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
						<TextBlock x:Name="lbtftptiptext" TextWrapping="Wrap" FontSize="12"
						           Foreground="{StaticResource TextMuted}"/>
						<TextBlock x:Name="lbtftptipget" FontWeight="SemiBold" Margin="0,14,0,6"
						           FontSize="12" Foreground="{StaticResource TextPrimary}"/>
						<DockPanel MaxWidth="520" HorizontalAlignment="Left">
							<Button x:Name="btftpget" DockPanel.Dock="Right" Height="30" MinWidth="96"
							        Margin="6,0,0,0" Padding="12,2"
							        Style="{StaticResource ToolBtn}"
							        AutomationProperties.AutomationId="ftp.tftp.get"/>
							<TextBox x:Name="etftpname" Height="30" Padding="6,3" MinWidth="220"
							         VerticalContentAlignment="Center"
							         BorderBrush="{StaticResource BorderSoft}"
							         AutomationProperties.AutomationId="ftp.tftp.name"/>
						</DockPanel>
					</StackPanel>
				</Border>
				<ListView x:Name="lvremote" Grid.Row="2" BorderThickness="0"
				          SelectionMode="Extended"
				          AllowDrop="True"
				          VirtualizingStackPanel.IsVirtualizing="True"
				          VirtualizingStackPanel.VirtualizationMode="Recycling"
				          AutomationProperties.AutomationId="ftp.remote.list">
					<ListView.View>
						<GridView>
							<GridViewColumn x:Name="colrname" Width="360">
								<GridViewColumn.CellTemplate>
									<DataTemplate>
										<StackPanel Orientation="Horizontal">
											<TextBlock Text="{Binding Icon}"
											           FontFamily="Segoe MDL2 Assets" FontSize="14"
											           Margin="0,0,7,0" VerticalAlignment="Center"
											           Foreground="{Binding IconBrush,
											               Converter={StaticResource hexbrush}}"/>
											<TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
										</StackPanel>
									</DataTemplate>
								</GridViewColumn.CellTemplate>
							</GridViewColumn>
							<GridViewColumn x:Name="colrsize" Width="100"
							                DisplayMemberBinding="{Binding SizeText}"/>
							<GridViewColumn x:Name="colrperm" Width="110"
							                DisplayMemberBinding="{Binding Perms}"/>
							<GridViewColumn x:Name="colrtime" Width="150"
							                DisplayMemberBinding="{Binding TimeText}"/>
						</GridView>
					</ListView.View>
				</ListView>
			</Grid>
		</Border>

		<!-- ============ 传输区 ============ -->
		<Border Grid.Row="3" Margin="0,10,0,0" BorderBrush="{StaticResource BorderSoft}"
		        BorderThickness="1" Background="{StaticResource BgPanel}" CornerRadius="4">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="150"/>
				</Grid.RowDefinitions>
				<StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,6,8,4">
					<TextBlock x:Name="lbxfer" Text="传输队列" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
					<TextBlock x:Name="lbxfercount" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,12,0"/>
					<TextBlock x:Name="lbparal" Text="并行" VerticalAlignment="Center" Margin="0,0,6,0"/>
					<ComboBox x:Name="cbParallel" Width="58" Height="24" VerticalContentAlignment="Center"
					          AutomationProperties.AutomationId="ftp.parallel"/>
					<Button x:Name="bclearfinished" Style="{StaticResource ToolBtnSm}" Margin="12,0,0,0"
					        AutomationProperties.AutomationId="ftp.clear"/>
				</StackPanel>
				<ListView x:Name="lvxfer" Grid.Row="1" BorderThickness="0"
				          SelectionMode="Extended"
				          VirtualizingStackPanel.IsVirtualizing="True"
				          VirtualizingStackPanel.VirtualizationMode="Recycling"
				          AutomationProperties.AutomationId="ftp.xfer.list">
					<ListView.View>
						<GridView>
							<GridViewColumn x:Name="colxdir" Width="60">
								<GridViewColumn.CellTemplate>
									<DataTemplate>
										<TextBlock Text="{Binding DirText}"/>
									</DataTemplate>
								</GridViewColumn.CellTemplate>
							</GridViewColumn>
							<GridViewColumn x:Name="colxname" Width="180">
								<GridViewColumn.CellTemplate>
									<DataTemplate>
										<TextBlock Text="{Binding DisplayName}" ToolTip="{Binding Remote}"/>
									</DataTemplate>
								</GridViewColumn.CellTemplate>
							</GridViewColumn>
							<GridViewColumn x:Name="colxprog" Width="150">
								<GridViewColumn.CellTemplate>
									<DataTemplate>
										<ProgressBar Height="14" Minimum="0" Maximum="100"
										             Value="{Binding Percent, Mode=OneWay}"
										             Foreground="{StaticResource Accent}"/>
									</DataTemplate>
								</GridViewColumn.CellTemplate>
							</GridViewColumn>
							<GridViewColumn x:Name="colxpct" Width="56"
							                DisplayMemberBinding="{Binding Percent, StringFormat={}{0:0}%}"/>
							<GridViewColumn x:Name="colxsize" Width="130"
							                DisplayMemberBinding="{Binding SizeText}"/>
							<GridViewColumn x:Name="colxspeed" Width="90"
							                DisplayMemberBinding="{Binding SpeedText}"/>
							<GridViewColumn x:Name="colxstate" Width="90"
							                DisplayMemberBinding="{Binding StateText}"/>
							<GridViewColumn x:Name="colxops" Width="130">
								<GridViewColumn.CellTemplate>
									<DataTemplate>
										<StackPanel Orientation="Horizontal">
											<Button Content="⏵" Width="26" Height="20" FontSize="11" Margin="0,0,2,0"
											        Style="{StaticResource ToolBtnSm}"
											        Tag="{Binding}"
											        Click="OnJobResume"/>
											<Button Content="⏸" Width="26" Height="20" FontSize="11" Margin="0,0,2,0"
											        Style="{StaticResource ToolBtnSm}"
											        Tag="{Binding}"
											        Click="OnJobPause"/>
											<Button Content="✕" Width="26" Height="20" FontSize="11"
											        Style="{StaticResource ToolBtnSm}"
											        Tag="{Binding}"
											        Click="OnJobCancel"/>
										</StackPanel>
									</DataTemplate>
								</GridViewColumn.CellTemplate>
							</GridViewColumn>
						</GridView>
					</ListView.View>
				</ListView>
			</Grid>
		</Border>

		<!-- ============ 底部状态 ============ -->
		<TextBlock x:Name="lbstat" Grid.Row="4" Margin="0,8,0,0" TextWrapping="Wrap"
		           Foreground="{StaticResource TextMuted}" FontSize="12"
		           AutomationProperties.AutomationId="ftp.status"/>
	</Grid>
</Window>
