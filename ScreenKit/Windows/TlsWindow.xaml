<Window x:Class="ScreenKit.TlsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TLS 证书检查"
        Width="940" Height="660"
        MinWidth="700" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BgApp}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        AutomationProperties.AutomationId="tls.window">
	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
		<TextBlock x:Name="lbhint" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10"
		           Foreground="{StaticResource TextMuted}" FontSize="12"/>
		<Grid Grid.Row="1" Margin="0,0,0,8">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>
			<TextBlock x:Name="lbtarget" Text="主机" VerticalAlignment="Center" Margin="0,0,8,0"/>
			<TextBox x:Name="etarget" Grid.Column="1" Height="32" Padding="8,4" Margin="0,0,8,0"
			         BorderBrush="{StaticResource BorderSoft}"
			         VerticalContentAlignment="Center"
			         AutomationProperties.AutomationId="tls.target"/>
			<Button x:Name="bcheck" Grid.Column="2" Style="{StaticResource ToolBtn}" Margin="0,0,6,0"
			        AutomationProperties.AutomationId="tls.check"/>
			<Button x:Name="bcopy" Grid.Column="3" Style="{StaticResource ToolBtn}"
			        AutomationProperties.AutomationId="tls.copy"/>
		</Grid>
		<Expander x:Name="expinfo" Grid.Row="2" IsExpanded="True" Margin="0,0,0,10"
		          AutomationProperties.AutomationId="tls.info">
			<Expander.Header>
				<TextBlock x:Name="lbinfo" FontSize="12"/>
			</Expander.Header>
			<ListView x:Name="lvinfo" MaxHeight="180" BorderBrush="{StaticResource BorderSoft}"
			          SelectionMode="Single"
			          FontFamily="Consolas, Microsoft YaHei UI"
			          AutomationProperties.AutomationId="tls.info.list">
				<ListView.View>
					<GridView>
						<GridViewColumn x:Name="colinfoname" Width="150"
						                DisplayMemberBinding="{Binding Name}"/>
						<GridViewColumn x:Name="colinfoval" Width="700"
						                DisplayMemberBinding="{Binding Value}"/>
					</GridView>
				</ListView.View>
			</ListView>
		</Expander>
		<Grid Grid.Row="3">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="1.2*" MinWidth="260"/>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="*" MinWidth="260"/>
			</Grid.ColumnDefinitions>
			<ListView x:Name="lvchain" BorderBrush="{StaticResource BorderSoft}"
			          SelectionMode="Single"
			          AutomationProperties.AutomationId="tls.chain">
				<ListView.View>
					<GridView>
						<GridViewColumn x:Name="colidx" Width="40"
						                DisplayMemberBinding="{Binding Index}"/>
						<GridViewColumn x:Name="colsubject" Width="300"
						                DisplayMemberBinding="{Binding Subject}"/>
						<GridViewColumn x:Name="colstate" Width="90"
						                DisplayMemberBinding="{Binding State}"/>
					</GridView>
				</ListView.View>
			</ListView>
			<GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
			<TextBox x:Name="edetail" Grid.Column="2" IsReadOnly="True" AcceptsReturn="True"
			         FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"
			         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
			         TextWrapping="NoWrap"
			         BorderBrush="{StaticResource BorderSoft}"
			         AutomationProperties.AutomationId="tls.detail"/>
		</Grid>
		<DockPanel Grid.Row="4" Margin="0,10,0,0">
			<TextBlock x:Name="lbstat" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"
			           TextWrapping="Wrap"/>
		</DockPanel>
	</Grid>
</Window>
