<Window x:Class="ScreenKit.SysInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScreenKit"
        Title="系统信息"
        Width="980" Height="680"
        MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BgApp}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        AutomationProperties.AutomationId="sys.window">
	<Grid Margin="16">
		<TabControl x:Name="tabsys" Margin="0"
		            BorderBrush="{StaticResource BorderSoft}"
		            AutomationProperties.AutomationId="sys.tabs">
			<TabItem x:Name="tabsystem" Header="系统"
			         AutomationProperties.AutomationId="sys.tab.sys">
				<Grid Margin="12">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>
					<TextBlock x:Name="lbsyshint" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10"
					           Foreground="{StaticResource TextMuted}" FontSize="12"/>
					<StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
						<Button x:Name="bsysrefresh" Style="{StaticResource ToolBtn}" Margin="0,0,6,0"
						        AutomationProperties.AutomationId="sys.refresh"/>
						<Button x:Name="bsyscopy" Style="{StaticResource ToolBtn}"
						        AutomationProperties.AutomationId="sys.copy"/>
					</StackPanel>
					<ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
					              HorizontalScrollBarVisibility="Disabled"
					              AutomationProperties.AutomationId="sys.list">
						<ItemsControl x:Name="icsys">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Border Margin="0,0,0,10" Padding="14,12" CornerRadius="8"
									        Background="{StaticResource BgPanel}"
									        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1">
										<StackPanel>
											<TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
											           Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
											<ItemsControl ItemsSource="{Binding Items}">
												<ItemsControl.ItemsPanel>
													<ItemsPanelTemplate>
														<WrapPanel/>
													</ItemsPanelTemplate>
												</ItemsControl.ItemsPanel>
												<ItemsControl.ItemTemplate>
													<DataTemplate>
														<Grid Width="300" Margin="0,0,16,8">
															<Grid.ColumnDefinitions>
																<ColumnDefinition Width="108"/>
																<ColumnDefinition Width="*"/>
															</Grid.ColumnDefinitions>
															<TextBlock Text="{Binding Name}" FontSize="12"
															           Foreground="{StaticResource TextMuted}"
															           VerticalAlignment="Top" TextWrapping="Wrap"/>
															<TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13"
															           Foreground="{StaticResource TextPrimary}"
															           VerticalAlignment="Top" TextWrapping="Wrap"/>
														</Grid>
													</DataTemplate>
												</ItemsControl.ItemTemplate>
											</ItemsControl>
										</StackPanel>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</ScrollViewer>
					<TextBlock x:Name="lbsysstat" Grid.Row="3" Margin="0,8,0,0"
					           VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
				</Grid>
			</TabItem>
			<TabItem x:Name="tabusb" Header="USB 设备"
			         AutomationProperties.AutomationId="sys.tab.usb">
				<Grid Margin="12">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>
					<TextBlock x:Name="lbusbhint" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10"
					           Foreground="{StaticResource TextMuted}" FontSize="12"/>
					<Grid Grid.Row="1" Margin="0,0,0,8">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>
						<TextBlock x:Name="lbusbfilter" Text="筛选" VerticalAlignment="Center" Margin="0,0,8,0"/>
						<TextBox x:Name="eusbfilter" Grid.Column="1" Height="32" Padding="8,4" Margin="0,0,8,0"
						         BorderBrush="{StaticResource BorderSoft}"
						         VerticalContentAlignment="Center"
						         AutomationProperties.AutomationId="usb.filter"/>
						<Button x:Name="busbrefresh" Grid.Column="2" Style="{StaticResource ToolBtn}" Margin="0,0,6,0"
						        AutomationProperties.AutomationId="usb.refresh"/>
						<Button x:Name="busbcopy" Grid.Column="3" Style="{StaticResource ToolBtn}"
						        AutomationProperties.AutomationId="usb.copy"/>
					</Grid>
					<Grid Grid.Row="2">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="1.15*" MinWidth="280"/>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="*" MinWidth="260"/>
						</Grid.ColumnDefinitions>
						<ListView x:Name="lvusb" BorderBrush="{StaticResource BorderSoft}"
						          SelectionMode="Single"
						          AutomationProperties.AutomationId="usb.list">
							<ListView.View>
								<GridView>
									<GridViewColumn x:Name="colusbname" Width="220"
									                DisplayMemberBinding="{Binding Name}"/>
									<GridViewColumn x:Name="colusbvid" Width="90"
									                DisplayMemberBinding="{Binding VidPid}"/>
									<GridViewColumn x:Name="colusbcls" Width="90"
									                DisplayMemberBinding="{Binding ClassName}"/>
									<GridViewColumn x:Name="colusbstatus" Width="110"
									                DisplayMemberBinding="{Binding Status}"/>
								</GridView>
							</ListView.View>
						</ListView>
						<GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
						<ListView x:Name="lvusbprop" Grid.Column="2" BorderBrush="{StaticResource BorderSoft}"
						          SelectionMode="Single"
						          FontFamily="Consolas, Microsoft YaHei UI"
						          AutomationProperties.AutomationId="usb.detail">
							<ListView.View>
								<GridView>
									<GridViewColumn x:Name="colusbprop" Width="120"
									                DisplayMemberBinding="{Binding Name}"/>
									<GridViewColumn x:Name="colusbval" Width="360"
									                DisplayMemberBinding="{Binding Value}"/>
								</GridView>
							</ListView.View>
						</ListView>
					</Grid>
					<TextBlock x:Name="lbusbstat" Grid.Row="3" Margin="0,8,0,0"
					           VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
				</Grid>
			</TabItem>
			<TabItem x:Name="tabcom" Header="串口"
			         AutomationProperties.AutomationId="sys.tab.com">
				<Grid Margin="12">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>
					<TextBlock x:Name="lbcomhint" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10"
					           Foreground="{StaticResource TextMuted}" FontSize="12"/>
					<Grid Grid.Row="1" Margin="0,0,0,8">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>
						<TextBlock x:Name="lbcomfilter" Text="筛选" VerticalAlignment="Center" Margin="0,0,8,0"/>
						<TextBox x:Name="ecomfilter" Grid.Column="1" Height="32" Padding="8,4" Margin="0,0,8,0"
						         BorderBrush="{StaticResource BorderSoft}"
						         VerticalContentAlignment="Center"
						         AutomationProperties.AutomationId="com.filter"/>
						<Button x:Name="bcomrefresh" Grid.Column="2" Style="{StaticResource ToolBtn}" Margin="0,0,6,0"
						        AutomationProperties.AutomationId="com.refresh"/>
						<Button x:Name="bcomcopy" Grid.Column="3" Style="{StaticResource ToolBtn}"
						        AutomationProperties.AutomationId="com.copy"/>
					</Grid>
					<Grid Grid.Row="2">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="1.15*" MinWidth="280"/>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="*" MinWidth="260"/>
						</Grid.ColumnDefinitions>
						<ListView x:Name="lvcom" BorderBrush="{StaticResource BorderSoft}"
						          SelectionMode="Single"
						          AutomationProperties.AutomationId="com.list">
							<ListView.View>
								<GridView>
									<GridViewColumn x:Name="colcomname" Width="220"
									                DisplayMemberBinding="{Binding Name}"/>
									<GridViewColumn x:Name="colcomport" Width="80"
									                DisplayMemberBinding="{Binding Com}"/>
									<GridViewColumn x:Name="colcomcls" Width="90"
									                DisplayMemberBinding="{Binding ClassName}"/>
									<GridViewColumn x:Name="colcomstatus" Width="110"
									                DisplayMemberBinding="{Binding Status}"/>
								</GridView>
							</ListView.View>
						</ListView>
						<GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
						<ListView x:Name="lvcomprop" Grid.Column="2" BorderBrush="{StaticResource BorderSoft}"
						          SelectionMode="Single"
						          FontFamily="Consolas, Microsoft YaHei UI"
						          AutomationProperties.AutomationId="com.detail">
							<ListView.View>
								<GridView>
									<GridViewColumn x:Name="colcomprop" Width="120"
									                DisplayMemberBinding="{Binding Name}"/>
									<GridViewColumn x:Name="colcomval" Width="360"
									                DisplayMemberBinding="{Binding Value}"/>
								</GridView>
							</ListView.View>
						</ListView>
					</Grid>
					<TextBlock x:Name="lbcomstat" Grid.Row="3" Margin="0,8,0,0"
					           VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
				</Grid>
			</TabItem>
			<TabItem x:Name="tabprn" Header="打印机"
			         AutomationProperties.AutomationId="sys.tab.prn">
				<Grid Margin="12">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>
					<TextBlock x:Name="lbprnhint" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10"
					           Foreground="{StaticResource TextMuted}" FontSize="12"/>
					<Grid Grid.Row="1" Margin="0,0,0,8">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>
						<TextBlock x:Name="lbprnfilter" Text="筛选" VerticalAlignment="Center" Margin="0,0,8,0"/>
						<TextBox x:Name="eprnfilter" Grid.Column="1" Height="32" Padding="8,4" Margin="0,0,8,0"
						         BorderBrush="{StaticResource BorderSoft}"
						         VerticalContentAlignment="Center"
						         AutomationProperties.AutomationId="prn.filter"/>
						<Button x:Name="bprnrefresh" Grid.Column="2" Style="{StaticResource ToolBtn}" Margin="0,0,6,0"
						        AutomationProperties.AutomationId="prn.refresh"/>
						<Button x:Name="bprncopy" Grid.Column="3" Style="{StaticResource ToolBtn}"
						        AutomationProperties.AutomationId="prn.copy"/>
					</Grid>
					<Grid Grid.Row="2">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="1.15*" MinWidth="220"/>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="*" MinWidth="260"/>
						</Grid.ColumnDefinitions>
						<ListView x:Name="lvprn" BorderBrush="{StaticResource BorderSoft}"
						          SelectionMode="Single"
						          AutomationProperties.AutomationId="prn.list">
							<ListView.View>
								<GridView>
									<GridViewColumn x:Name="colprnname" Width="200"
									                DisplayMemberBinding="{Binding Name}"/>
									<GridViewColumn x:Name="colprnport" Width="110"
									                DisplayMemberBinding="{Binding Com}"/>
									<GridViewColumn x:Name="colprndrv" Width="140"
									                DisplayMemberBinding="{Binding ClassName}"/>
									<GridViewColumn x:Name="colprnstatus" Width="90"
									                DisplayMemberBinding="{Binding Status}"/>
								</GridView>
							</ListView.View>
						</ListView>
						<GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
						<ListView x:Name="lvprnprop" Grid.Column="2" BorderBrush="{StaticResource BorderSoft}"
						          SelectionMode="Single"
						          FontFamily="Consolas, Microsoft YaHei UI"
						          AutomationProperties.AutomationId="prn.detail">
							<ListView.View>
								<GridView>
									<GridViewColumn x:Name="colprnprop" Width="120"
									                DisplayMemberBinding="{Binding Name}"/>
									<GridViewColumn x:Name="colprnval" Width="360"
									                DisplayMemberBinding="{Binding Value}"/>
								</GridView>
							</ListView.View>
						</ListView>
					</Grid>
					<TextBlock x:Name="lbprnstat" Grid.Row="3" Margin="0,8,0,0"
					           VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
				</Grid>
			</TabItem>
			<TabItem x:Name="tabaud" Header="声音/麦克风"
			         AutomationProperties.AutomationId="sys.tab.aud">
				<Grid Margin="12">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>
					<TextBlock x:Name="lbaudhint" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10"
					           Foreground="{StaticResource TextMuted}" FontSize="12"/>
					<Grid Grid.Row="1" Margin="0,0,0,8">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>
						<TextBlock x:Name="lbaudfilter" Text="筛选" VerticalAlignment="Center" Margin="0,0,8,0"/>
						<TextBox x:Name="eaudfilter" Grid.Column="1" Height="32" Padding="8,4" Margin="0,0,8,0"
						         BorderBrush="{StaticResource BorderSoft}"
						         VerticalContentAlignment="Center"
						         AutomationProperties.AutomationId="aud.filter"/>
						<CheckBox x:Name="eaudall" Grid.Column="2" Content="显示全部" IsChecked="False"
						          VerticalAlignment="Center" Margin="0,0,12,0"
						          AutomationProperties.AutomationId="aud.all"/>
						<Button x:Name="baudrefresh" Grid.Column="3" Style="{StaticResource ToolBtn}" Margin="0,0,6,0"
						        AutomationProperties.AutomationId="aud.refresh"/>
						<Button x:Name="baudcopy" Grid.Column="4" Style="{StaticResource ToolBtn}"
						        AutomationProperties.AutomationId="aud.copy"/>
					</Grid>
					<Grid Grid.Row="2">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="1.15*" MinWidth="220"/>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="*" MinWidth="260"/>
						</Grid.ColumnDefinitions>
						<ListView x:Name="lvaud" BorderBrush="{StaticResource BorderSoft}"
						          SelectionMode="Single"
						          AutomationProperties.AutomationId="aud.list">
							<ListView.View>
								<GridView>
									<GridViewColumn x:Name="colaudname" Width="240"
									                DisplayMemberBinding="{Binding Name}"/>
									<GridViewColumn x:Name="colaudkind" Width="70"
									                DisplayMemberBinding="{Binding ClassName}"/>
									<GridViewColumn x:Name="colauddef" Width="140"
									                DisplayMemberBinding="{Binding Com}"/>
									<GridViewColumn x:Name="colaudstatus" Width="80"
									                DisplayMemberBinding="{Binding Status}"/>
								</GridView>
							</ListView.View>
						</ListView>
						<GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
						<ListView x:Name="lvaudprop" Grid.Column="2" BorderBrush="{StaticResource BorderSoft}"
						          SelectionMode="Single"
						          FontFamily="Consolas, Microsoft YaHei UI"
						          AutomationProperties.AutomationId="aud.detail">
							<ListView.View>
								<GridView>
									<GridViewColumn x:Name="colaudprop" Width="120"
									                DisplayMemberBinding="{Binding Name}"/>
									<GridViewColumn x:Name="colaudval" Width="360"
									                DisplayMemberBinding="{Binding Value}"/>
								</GridView>
							</ListView.View>
						</ListView>
					</Grid>
					<TextBlock x:Name="lbaudstat" Grid.Row="3" Margin="0,8,0,0"
					           VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
				</Grid>
			</TabItem>
			<TabItem x:Name="tabdisplay" Header="显示器"
			         AutomationProperties.AutomationId="sys.tab.display">
				<local:SysDevicePage x:Name="pdisplay"/>
			</TabItem>
			<TabItem x:Name="tabcamera" Header="摄像头"
			         AutomationProperties.AutomationId="sys.tab.camera">
				<local:SysDevicePage x:Name="pcamera"/>
			</TabItem>
			<TabItem x:Name="tabbt" Header="蓝牙设备"
			         AutomationProperties.AutomationId="sys.tab.bt">
				<local:SysDevicePage x:Name="pbt"/>
			</TabItem>
			<TabItem x:Name="tabnet" Header="网络适配器"
			         AutomationProperties.AutomationId="sys.tab.net">
				<local:SysDevicePage x:Name="pnet"/>
			</TabItem>
			<TabItem x:Name="tabinput" Header="输入设备"
			         AutomationProperties.AutomationId="sys.tab.input">
				<local:SysDevicePage x:Name="pinput"/>
			</TabItem>
			<TabItem x:Name="tabdisk" Header="磁盘设备"
			         AutomationProperties.AutomationId="sys.tab.disk">
				<local:SysDevicePage x:Name="pdisk"/>
			</TabItem>
			<TabItem x:Name="tabbattery" Header="电池"
			         AutomationProperties.AutomationId="sys.tab.battery">
				<local:SysDevicePage x:Name="pbattery"/>
			</TabItem>
			<TabItem x:Name="tabpci" Header="PCI/系统设备"
			         AutomationProperties.AutomationId="sys.tab.pci">
				<local:SysDevicePage x:Name="ppci"/>
			</TabItem>
			<TabItem x:Name="tabproblem" Header="异常设备"
			         AutomationProperties.AutomationId="sys.tab.problem">
				<local:SysDevicePage x:Name="pproblem"/>
			</TabItem>
			<TabItem x:Name="tabfont" Header="字体列表"
			         AutomationProperties.AutomationId="sys.tab.font">
				<Grid Margin="12">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>
					<TextBlock x:Name="lbfonthint" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10"
					           Foreground="{StaticResource TextMuted}" FontSize="12"/>
					<Grid Grid.Row="1" Margin="0,0,0,8">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>
						<TextBlock x:Name="lbfontfilter" Text="筛选" VerticalAlignment="Center" Margin="0,0,8,0"/>
						<TextBox x:Name="efontfilter" Grid.Column="1" Height="32" Padding="8,4" Margin="0,0,8,0"
						         BorderBrush="{StaticResource BorderSoft}"
						         VerticalContentAlignment="Center"
						         AutomationProperties.AutomationId="font.filter"/>
						<Button x:Name="bfontrefresh" Grid.Column="2" Style="{StaticResource ToolBtn}" Margin="0,0,6,0"
						        AutomationProperties.AutomationId="font.refresh"/>
						<Button x:Name="bfontcopy" Grid.Column="3" Style="{StaticResource ToolBtn}"
						        AutomationProperties.AutomationId="font.copy"/>
					</Grid>
					<ListView x:Name="lvfont" Grid.Row="2" BorderBrush="{StaticResource BorderSoft}"
					          SelectionMode="Single"
					          AutomationProperties.AutomationId="font.list">
						<ListView.View>
							<GridView>
								<GridViewColumn x:Name="colfontname" Width="220"
								                DisplayMemberBinding="{Binding Name}"/>
								<GridViewColumn x:Name="colfontpreview" Width="360">
									<GridViewColumn.CellTemplate>
										<DataTemplate>
											<TextBlock Text="Aa Bb 0123 中文 日本語 한글"
											           FontFamily="{Binding Name}" FontSize="22"
											           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
										</DataTemplate>
									</GridViewColumn.CellTemplate>
								</GridViewColumn>
								<GridViewColumn x:Name="colfontfile" Width="300">
									<GridViewColumn.CellTemplate>
										<DataTemplate>
											<TextBlock Text="{Binding Files}" ToolTip="{Binding Files}"
											           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
										</DataTemplate>
									</GridViewColumn.CellTemplate>
								</GridViewColumn>
							</GridView>
						</ListView.View>
					</ListView>
					<TextBlock x:Name="lbfontstat" Grid.Row="3" Margin="0,8,0,0"
					           VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
				</Grid>
			</TabItem>
		</TabControl>
	</Grid>
</Window>
