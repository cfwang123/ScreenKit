<Window x:Class="ScreenKit.CastHud"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        Title="投屏">
	<Window.Resources>
		<Style x:Key="HudLinkBtn" TargetType="Button">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Foreground" Value="#111"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Padding" Value="8,0"/>
			<Setter Property="Height" Value="22"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="bd" Background="{TemplateBinding Background}"
						        CornerRadius="2" Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bd" Property="Background" Value="#33000000"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<Style x:Key="HudIconBtn" TargetType="Button" BasedOn="{StaticResource HudLinkBtn}">
			<Setter Property="Padding" Value="4,0"/>
			<Setter Property="Width" Value="26"/>
			<Setter Property="MinWidth" Value="26"/>
		</Style>
		<Style x:Key="HudGrip" TargetType="Border">
			<Setter Property="Background" Value="#02E53935"/>
			<Setter Property="IsHitTestVisible" Value="True"/>
			<Setter Property="SnapsToDevicePixels" Value="True"/>
		</Style>
		<Geometry x:Key="GeoStop">M 3,3 H 13 V 13 H 3 Z</Geometry>
		<Geometry x:Key="GeoChevronL">M 10,2.5 L 4,8 L 10,13.5</Geometry>
		<Geometry x:Key="GeoChevronR">M 4,2.5 L 10,8 L 4,13.5</Geometry>
	</Window.Resources>
	<Canvas x:Name="proot" Background="Transparent" ClipToBounds="False">
		<Rectangle x:Name="rborder" Stroke="#E53935" StrokeThickness="3"
		           Fill="Transparent" IsHitTestVisible="False"
		           SnapsToDevicePixels="True" UseLayoutRounding="True"/>
		<Rectangle x:Name="rdot" Width="8" Height="8" Fill="#E53935" RadiusX="4" RadiusY="4"
		           IsHitTestVisible="False"/>
		<Border x:Name="bdragN" Height="5" Cursor="SizeAll" Style="{StaticResource HudGrip}"
		        ToolTip="拖动移动投屏区域"/>
		<Border x:Name="bdragE" Width="5" Cursor="SizeAll" Style="{StaticResource HudGrip}"
		        ToolTip="拖动移动投屏区域"/>
		<Border x:Name="bdragS" Height="5" Cursor="SizeAll" Style="{StaticResource HudGrip}"
		        ToolTip="拖动移动投屏区域"/>
		<Border x:Name="bdragW" Width="5" Cursor="SizeAll" Style="{StaticResource HudGrip}"
		        ToolTip="拖动移动投屏区域"/>
		<Border x:Name="g_nw" Width="12" Height="12" Cursor="SizeNWSE" Style="{StaticResource HudGrip}"/>
		<Border x:Name="g_n" Height="8" Cursor="SizeNS" Style="{StaticResource HudGrip}"/>
		<Border x:Name="g_ne" Width="12" Height="12" Cursor="SizeNESW" Style="{StaticResource HudGrip}"/>
		<Border x:Name="g_e" Width="8" Cursor="SizeWE" Style="{StaticResource HudGrip}"/>
		<Border x:Name="g_se" Width="12" Height="12" Cursor="SizeNWSE" Style="{StaticResource HudGrip}"/>
		<Border x:Name="g_s" Height="8" Cursor="SizeNS" Style="{StaticResource HudGrip}"/>
		<Border x:Name="g_sw" Width="12" Height="12" Cursor="SizeNESW" Style="{StaticResource HudGrip}"/>
		<Border x:Name="g_w" Width="8" Cursor="SizeWE" Style="{StaticResource HudGrip}"/>

		<Border x:Name="bmini" Background="#F7E600" CornerRadius="4"
		        BorderBrush="#C4B800" BorderThickness="1"
		        Padding="2,3,4,3" Height="28" Visibility="Collapsed"
		        Cursor="SizeAll" ToolTip="拖动移动 · 展开 / 停止">
			<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
				<Button x:Name="bexpand" Style="{StaticResource HudIconBtn}" Width="22" Padding="0" Margin="0,0,2,0"
				        ToolTip="展开控制条" AutomationProperties.AutomationId="cast.hud.expand">
					<Path Data="{StaticResource GeoChevronR}" Stroke="#111" StrokeThickness="1.8"
					      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
					      Fill="Transparent" Stretch="Uniform" Width="10" Height="12"/>
				</Button>
				<Ellipse Width="8" Height="8" Fill="#C62828" Margin="2,0,6,0"/>
				<Button x:Name="bstopM" Style="{StaticResource HudIconBtn}" ToolTip="停止投屏"
				        AutomationProperties.AutomationId="cast.hud.stop.mini">
					<Path Data="{StaticResource GeoStop}" Fill="#111" Stretch="Uniform" Width="11" Height="11"/>
				</Button>
			</StackPanel>
		</Border>

		<Border x:Name="bbar" Background="#F7E600" BorderBrush="#C4B800" BorderThickness="1"
		        Padding="2,3,6,3" Height="28" Cursor="SizeAll"
		        ToolTip="拖动可移动控制条">
			<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
				<Button x:Name="bcollapse" Style="{StaticResource HudIconBtn}" Width="22" Padding="0" Margin="0,0,4,0"
				        ToolTip="收起控制条" AutomationProperties.AutomationId="cast.hud.collapse">
					<Path Data="{StaticResource GeoChevronL}" Stroke="#111" StrokeThickness="1.8"
					      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
					      Fill="Transparent" Stretch="Uniform" Width="10" Height="12"/>
				</Button>
				<Ellipse Width="8" Height="8" Fill="#C62828" Margin="0,0,8,0"/>
				<TextBlock x:Name="lbstate" Text="投屏中" FontSize="12" FontWeight="Bold"
				           Foreground="#111" VerticalAlignment="Center" Margin="0,0,10,0"/>
				<TextBlock x:Name="lbtime" Text="00:00:00" FontSize="12" FontFamily="Consolas, Cascadia Mono"
				           FontWeight="SemiBold" Foreground="#111" VerticalAlignment="Center"
				           Margin="0,0,10,0" MinWidth="58"/>
				<TextBlock x:Name="lbregion" Text="0×0" FontSize="12" FontWeight="SemiBold"
				           Foreground="#111" VerticalAlignment="Center" Margin="0,0,8,0"/>
				<TextBlock x:Name="lbto" Text="" FontSize="11" Foreground="#333"
				           VerticalAlignment="Center" Margin="0,0,8,0"
				           MaxWidth="220" TextTrimming="CharacterEllipsis"/>
				<Rectangle Width="1" Height="14" Fill="#99000000" Margin="0,0,4,0"/>
				<Button x:Name="bstop" Style="{StaticResource HudIconBtn}" ToolTip="停止投屏"
				        AutomationProperties.AutomationId="cast.hud.stop">
					<Path Data="{StaticResource GeoStop}" Fill="#111" Stretch="Uniform" Width="11" Height="11"/>
				</Button>
			</StackPanel>
		</Border>
	</Canvas>
</Window>
