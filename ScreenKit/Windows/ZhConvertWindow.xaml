<Window x:Class="ScreenKit.ZhConvertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="简繁转换"
        Width="720" Height="560"
        MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BgApp}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        AutomationProperties.AutomationId="zhconv.window">
	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
		<TextBlock x:Name="lbhint" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}"
		           Margin="0,0,0,10"/>
		<DockPanel Grid.Row="1">
			<TextBlock x:Name="lbin" DockPanel.Dock="Top" Text="输入" FontWeight="SemiBold" Margin="0,0,0,6"/>
			<TextBox x:Name="ein" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
			         Padding="8" BorderBrush="{StaticResource BorderSoft}"
			         AutomationProperties.AutomationId="zhconv.in"/>
		</DockPanel>
		<WrapPanel Grid.Row="2" Margin="0,10,0,10">
			<Button x:Name="btrad" Content="转为繁体" Style="{StaticResource ToolBtn}" Margin="0,0,6,6"
			        AutomationProperties.AutomationId="zhconv.trad"/>
			<Button x:Name="bsimp" Content="转为简体" Style="{StaticResource ToolBtn}" Margin="0,0,6,6"
			        AutomationProperties.AutomationId="zhconv.simp"/>
			<Button x:Name="bswap" Content="上下对调" Style="{StaticResource ToolBtn}" Margin="0,0,6,6"/>
		</WrapPanel>
		<DockPanel Grid.Row="3">
			<TextBlock x:Name="lbout" DockPanel.Dock="Top" Text="输出" FontWeight="SemiBold" Margin="0,0,0,6"/>
			<TextBox x:Name="eout" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
			         Padding="8" BorderBrush="{StaticResource BorderSoft}"
			         AutomationProperties.AutomationId="zhconv.out"/>
		</DockPanel>
		<TextBlock x:Name="lbstat" Grid.Row="4" Margin="0,8,0,8" Foreground="{StaticResource TextMuted}"/>
		<StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
			<Button x:Name="bcopy" Content="复制输出" Style="{StaticResource ToolBtn}"
			        AutomationProperties.AutomationId="zhconv.copy"/>
			<Button x:Name="bclose" Content="关闭" Style="{StaticResource ToolBtn}"
			        AutomationProperties.AutomationId="zhconv.close"/>
		</StackPanel>
	</Grid>
</Window>
