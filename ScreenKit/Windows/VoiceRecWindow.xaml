<Window x:Class="ScreenKit.VoiceRecWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScreenKit"
        Title="录音机"
        Width="600" Height="445"
        MinWidth="520" MinHeight="410"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BgApp}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        AutomationProperties.AutomationId="vrec.window">
	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>
		<TextBlock x:Name="lbhint" TextWrapping="Wrap" Margin="0,0,0,10"
		           Foreground="{StaticResource TextMuted}" FontSize="12"/>
		<DockPanel Grid.Row="1" Margin="0,0,0,8" LastChildFill="True">
			<CheckBox x:Name="cmic" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0"
			          IsChecked="True" AutomationProperties.AutomationId="vrec.mic"/>
			<Button x:Name="bdev" DockPanel.Dock="Right" Style="{StaticResource ToolBtn}" Margin="8,0,0,0"
			        AutomationProperties.AutomationId="vrec.refresh"/>
			<ComboBox x:Name="edev" Height="32" VerticalContentAlignment="Center"
			          AutomationProperties.AutomationId="vrec.dev"/>
		</DockPanel>
		<CheckBox x:Name="csys" Grid.Row="2" Margin="0,0,0,10"
		          AutomationProperties.AutomationId="vrec.sys"/>
		<Border Grid.Row="3" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderSoft}"
		        BorderThickness="1" CornerRadius="10" Padding="12,8,12,10" Margin="0,0,0,10">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>
				<Grid Grid.Row="0" Margin="0,0,0,5">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>
					<TextBlock x:Name="lbmiccap" Text="麦克风" FontSize="12" VerticalAlignment="Center"
					           Foreground="{StaticResource TextMuted}"/>
					<TextBlock x:Name="lbmicdev" Grid.Column="1" Margin="8,0,8,0" FontSize="12"
					           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
					           AutomationProperties.AutomationId="vrec.micdev"/>
					<StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
						<Ellipse x:Name="dotmic" Width="8" Height="8" Margin="0,0,5,0"
						         Fill="{StaticResource BorderSoft}"/>
						<TextBlock x:Name="lbmicstate" Text="静音" FontSize="12"
						           Foreground="{StaticResource TextMuted}"
						           AutomationProperties.AutomationId="vrec.micstate"/>
					</StackPanel>
				</Grid>
				<local:LevelBlocks x:Name="pmic" Grid.Row="1" Height="14" Margin="0,0,0,10"
				                   AutomationProperties.AutomationId="vrec.miclevel"/>
				<Grid Grid.Row="2" Margin="0,0,0,5">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>
					<TextBlock x:Name="lbsyscap" Text="系统声音" FontSize="12" VerticalAlignment="Center"
					           Foreground="{StaticResource TextMuted}"/>
					<TextBlock x:Name="lbsysdev" Grid.Column="1" Margin="8,0,8,0" FontSize="12"
					           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
					           AutomationProperties.AutomationId="vrec.sysdev"/>
					<StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
						<Ellipse x:Name="dotsys" Width="8" Height="8" Margin="0,0,5,0"
						         Fill="{StaticResource BorderSoft}"/>
						<TextBlock x:Name="lbsysstate" Text="静音" FontSize="12"
						           Foreground="{StaticResource TextMuted}"
						           AutomationProperties.AutomationId="vrec.sysstate"/>
					</StackPanel>
				</Grid>
				<local:LevelBlocks x:Name="psys" Grid.Row="3" Height="14"
				                   AutomationProperties.AutomationId="vrec.syslevel"/>
			</Grid>
		</Border>
		<TextBlock x:Name="lbtime" Grid.Row="4" Text="00:00.0" FontSize="40" FontWeight="SemiBold"
		           FontFamily="Consolas, Segoe UI" HorizontalAlignment="Center" Margin="0,0,0,8"
		           AutomationProperties.AutomationId="vrec.time"/>
		<WrapPanel Grid.Row="5">
			<Button x:Name="brec" Style="{StaticResource ToolBtn}" Margin="0,0,6,6"
			        AutomationProperties.AutomationId="vrec.rec"/>
			<Button x:Name="bpause" Style="{StaticResource ToolBtn}" Margin="0,0,6,6"
			        AutomationProperties.AutomationId="vrec.pause"/>
			<Button x:Name="bstop" Style="{StaticResource ToolBtn}" Margin="0,0,6,6"
			        AutomationProperties.AutomationId="vrec.stop"/>
			<Button x:Name="bplay" Style="{StaticResource ToolBtn}" Margin="0,0,6,6"
			        AutomationProperties.AutomationId="vrec.play"/>
			<Button x:Name="bopen" Style="{StaticResource ToolBtn}" Margin="0,0,6,6"
			        AutomationProperties.AutomationId="vrec.open"/>
			<Button x:Name="bsave" Style="{StaticResource ToolBtn}" Margin="0,0,6,6"
			        AutomationProperties.AutomationId="vrec.save"/>
		</WrapPanel>
		<TextBlock x:Name="lbstat" Grid.Row="6" Margin="0,8,0,0" TextWrapping="Wrap"
		           VerticalAlignment="Bottom"
		           Foreground="{StaticResource TextMuted}" FontSize="12"/>
	</Grid>
</Window>
