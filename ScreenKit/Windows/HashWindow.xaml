<Window x:Class="ScreenKit.HashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="校验哈希"
        Width="900" Height="560"
        MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BgApp}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        AllowDrop="True"
        AutomationProperties.AutomationId="hash.window">
	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
		<DockPanel Grid.Row="0" Margin="0,0,0,8">
			<TextBlock x:Name="lbcmp" DockPanel.Dock="Left" Text="比对" VerticalAlignment="Center" Margin="0,0,8,0"/>
			<TextBox x:Name="ecmp" Height="30" Padding="6,4"
			         BorderBrush="{StaticResource BorderSoft}"
			         VerticalContentAlignment="Center"
			         AutomationProperties.AutomationId="hash.compare"/>
		</DockPanel>
		<ListView x:Name="lv" Grid.Row="1" BorderBrush="{StaticResource BorderSoft}"
		          AutomationProperties.AutomationId="hash.list">
			<ListView.View>
				<GridView>
					<GridViewColumn x:Name="colname" Header="文件" Width="180" DisplayMemberBinding="{Binding Name}"/>
					<GridViewColumn x:Name="colsize" Header="大小" Width="80" DisplayMemberBinding="{Binding SizeText}"/>
					<GridViewColumn x:Name="colmd5" Header="MD5" Width="200" DisplayMemberBinding="{Binding Md5}"/>
					<GridViewColumn x:Name="colsha1" Header="SHA-1" Width="200" DisplayMemberBinding="{Binding Sha1}"/>
					<GridViewColumn x:Name="colsha256" Header="SHA-256" Width="220" DisplayMemberBinding="{Binding Sha256}"/>
					<GridViewColumn x:Name="colst" Header="状态" Width="80" DisplayMemberBinding="{Binding Match}"/>
				</GridView>
			</ListView.View>
		</ListView>
		<TextBlock x:Name="lbstat" Grid.Row="2" Margin="0,8,0,8" Foreground="{StaticResource TextMuted}"/>
		<DockPanel Grid.Row="3">
			<StackPanel Orientation="Horizontal">
				<Button x:Name="badd" Content="添加" Style="{StaticResource ToolBtn}"
				        AutomationProperties.AutomationId="hash.add"/>
				<Button x:Name="bclear" Content="清空" Style="{StaticResource ToolBtn}"
				        AutomationProperties.AutomationId="hash.clear"/>
			</StackPanel>
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
				<Button x:Name="bcopy" Content="复制 SHA-256" Style="{StaticResource ToolBtn}"
				        AutomationProperties.AutomationId="hash.copy"/>
				<Button x:Name="bclose" Content="关闭" Style="{StaticResource ToolBtn}"
				        AutomationProperties.AutomationId="hash.close"/>
			</StackPanel>
		</DockPanel>
	</Grid>
</Window>
