<Window x:Class="ScreenKit.JpYomiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="日文注音"
        Width="720" Height="560"
        MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BgApp}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        AutomationProperties.AutomationId="jpyomi.window">
	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
		<TextBlock x:Name="lbhint" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}"
		           Margin="0,0,0,10"/>
		<DockPanel Grid.Row="1">
			<TextBlock x:Name="lbin" DockPanel.Dock="Top" Text="日文" FontWeight="SemiBold" Margin="0,0,0,6"/>
			<TextBox x:Name="ein" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
			         Padding="8" BorderBrush="{StaticResource BorderSoft}"
			         AutomationProperties.AutomationId="jpyomi.in"/>
		</DockPanel>
		<WrapPanel Grid.Row="2" Margin="0,10,0,10">
			<Button x:Name="bword" Content="词组注音" Style="{StaticResource ToolBtn}" Margin="0,0,6,6"
			        AutomationProperties.AutomationId="jpyomi.word"/>
			<Button x:Name="bmono" Content="逐字注音" Style="{StaticResource ToolBtn}" Margin="0,0,6,6"
			        AutomationProperties.AutomationId="jpyomi.mono"/>
		</WrapPanel>
		<DockPanel Grid.Row="3">
			<TextBlock x:Name="lbout" DockPanel.Dock="Top" Text="注音" FontWeight="SemiBold" Margin="0,0,0,6"/>
			<TextBox x:Name="eout" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
			         Padding="8" BorderBrush="{StaticResource BorderSoft}"
			         AutomationProperties.AutomationId="jpyomi.out"/>
		</DockPanel>
		<TextBlock x:Name="lbstat" Grid.Row="4" Margin="0,8,0,8" Foreground="{StaticResource TextMuted}"/>
		<StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
			<Button x:Name="bcopy" Content="复制输出" Style="{StaticResource ToolBtn}"
			        AutomationProperties.AutomationId="jpyomi.copy"/>
			<Button x:Name="bclose" Content="关闭" Style="{StaticResource ToolBtn}"
			        AutomationProperties.AutomationId="jpyomi.close"/>
		</StackPanel>
	</Grid>
</Window>
