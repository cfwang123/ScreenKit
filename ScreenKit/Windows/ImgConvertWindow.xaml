<Window x:Class="ScreenKit.ImgConvertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="图片格式转换"
        Width="1280" Height="980"
        MinWidth="960" MinHeight="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BgApp}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        AllowDrop="True"
        AutomationProperties.AutomationId="imgconv.window">
	<Window.Resources>
		<ItemsPanelTemplate x:Key="panelWrap">
			<WrapPanel Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"/>
		</ItemsPanelTemplate>
		<ItemsPanelTemplate x:Key="panelStack">
			<VirtualizingStackPanel />
		</ItemsPanelTemplate>
		<Style x:Key="styleListItem" TargetType="ListViewItem">
			<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
			<Setter Property="ToolTip" Value="{Binding FilePath}"/>
			<Setter Property="Padding" Value="0,2"/>
		</Style>
		<Style x:Key="styleThumbItem" TargetType="ListViewItem">
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Top"/>
			<Setter Property="Width" Value="116"/>
			<Setter Property="Margin" Value="2"/>
			<Setter Property="Padding" Value="2"/>
			<Setter Property="ToolTip" Value="{Binding FilePath}"/>
		</Style>
		<DataTemplate x:Key="tplThumbImg">
			<Viewbox>
				<Image Source="{Binding Thumb}" Stretch="Uniform"
				       RenderOptions.BitmapScalingMode="HighQuality">
					<Image.LayoutTransform>
						<TransformGroup>
							<RotateTransform Angle="{Binding Rotate}"/>
							<ScaleTransform ScaleX="{Binding MirrorX}"/>
						</TransformGroup>
					</Image.LayoutTransform>
				</Image>
			</Viewbox>
		</DataTemplate>
		<DataTemplate x:Key="tplThumb">
			<StackPanel Width="108">
				<Border Width="88" Height="88" HorizontalAlignment="Center"
				        Background="{StaticResource BgImage}" CornerRadius="4"
				        ClipToBounds="True">
					<ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource tplThumbImg}"/>
				</Border>
				<TextBlock Text="{Binding FileName}" Margin="0,4,0,0"
				           FontSize="11" TextAlignment="Center"
				           TextTrimming="CharacterEllipsis"/>
				<TextBlock Text="{Binding Status}" FontSize="10"
				           Foreground="{StaticResource TextMuted}"
				           TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
			</StackPanel>
		</DataTemplate>
	</Window.Resources>
	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- 目标格式 -->
		<Grid Grid.Row="0" Margin="0,0,0,10">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" MinWidth="72"/>
				<ColumnDefinition Width="220"/>
				<ColumnDefinition Width="16"/>
				<ColumnDefinition Width="Auto" MinWidth="72"/>
				<ColumnDefinition Width="88"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>
			<TextBlock x:Name="lbfmt" Grid.Column="0" Text="目标格式" FontWeight="SemiBold"
			           VerticalAlignment="Center" Margin="0,0,8,0"/>
			<ComboBox x:Name="efmt" Grid.Column="1" Height="32"
			          VerticalContentAlignment="Center"
			          AutomationProperties.AutomationId="imgconv.fmt">
				<ComboBoxItem Content="JPG" Tag="jpg" IsSelected="True"/>
				<ComboBoxItem Content="PNG" Tag="png"/>
				<ComboBoxItem Content="BMP" Tag="bmp"/>
			</ComboBox>
			<TextBlock x:Name="lbjpgq" Grid.Column="3" Text="JPG 质量"
			           FontSize="12" Foreground="{StaticResource TextMuted}"
			           VerticalAlignment="Center" Margin="0,0,8,0"/>
			<TextBox x:Name="ejpgq" Grid.Column="4" Height="30" Padding="6,4" Text="60"
			         BorderBrush="{StaticResource BorderSoft}"
			         VerticalContentAlignment="Center"
			         ToolTip="1–100，越大越清晰、体积越大"
			         AutomationProperties.AutomationId="imgconv.quality"/>
		</Grid>

		<!-- 最大宽高 -->
		<StackPanel Grid.Row="1" Margin="0,0,0,10">
			<CheckBox x:Name="emaxen" Content="限制最大宽高（等比缩小进框内，不放大）"
			          Margin="0,0,0,8" IsChecked="False"
			          AutomationProperties.AutomationId="imgconv.maxen"/>
			<Grid IsEnabled="{Binding ElementName=emaxen, Path=IsChecked}" MaxWidth="520"
			      HorizontalAlignment="Left">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="16"/>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>
				<TextBlock x:Name="lbmaxw" Grid.Column="0" Text="最大宽" FontSize="12"
				           Foreground="{StaticResource TextMuted}"
				           VerticalAlignment="Center" Margin="0,0,8,0"/>
				<TextBox x:Name="emaxw" Grid.Column="1" Height="30" Padding="6,4" Text="1920"
				         BorderBrush="{StaticResource BorderSoft}" VerticalContentAlignment="Center"
				         AutomationProperties.AutomationId="imgconv.maxw"/>
				<TextBlock x:Name="lbmaxh" Grid.Column="3" Text="最大高" FontSize="12"
				           Foreground="{StaticResource TextMuted}"
				           VerticalAlignment="Center" Margin="0,0,8,0"/>
				<TextBox x:Name="emaxh" Grid.Column="4" Height="30" Padding="6,4" Text="1080"
				         BorderBrush="{StaticResource BorderSoft}" VerticalContentAlignment="Center"
				         AutomationProperties.AutomationId="imgconv.maxh"/>
			</Grid>
			<StackPanel Orientation="Horizontal" Margin="0,8,0,0">
				<CheckBox x:Name="ekeeporig" VerticalAlignment="Center" IsChecked="True" Margin="0,0,8,0"
				          AutomationProperties.AutomationId="imgconv.keeporig"/>
				<TextBox x:Name="ekeeppct" Width="48" Height="28" Padding="6,2" Text="80"
				         BorderBrush="{StaticResource BorderSoft}"
				         VerticalContentAlignment="Center" Margin="0,0,6,0"
				         IsEnabled="{Binding ElementName=ekeeporig, Path=IsChecked}"
				         AutomationProperties.AutomationId="imgconv.keeppct"/>
				<TextBlock x:Name="lbkeeppct" Text="% 时使用原图（旋转或缩放除外）"
				           FontSize="12" Foreground="{StaticResource TextMuted}"
				           VerticalAlignment="Center"/>
			</StackPanel>
		</StackPanel>

		<!-- 输出路径 -->
		<StackPanel Grid.Row="2" Margin="0,0,0,10">
			<TextBlock x:Name="lbout" Text="输出路径" FontWeight="SemiBold" Margin="0,0,0,6"/>
			<RadioButton x:Name="routsrc" GroupName="ImgConvOut" Margin="0,0,0,4"
			             Content="源文件下的 output/" IsChecked="True"
			             AutomationProperties.AutomationId="imgconv.outsrc"/>
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>
				<RadioButton x:Name="routother" Grid.Column="0" GroupName="ImgConvOut"
				             Content="其它" VerticalAlignment="Center" Margin="0,0,8,0"
				             AutomationProperties.AutomationId="imgconv.outother"/>
				<TextBox x:Name="eoutdir" Grid.Column="1" Height="30" Padding="6,4"
				         BorderBrush="{StaticResource BorderSoft}"
				         VerticalContentAlignment="Center" Margin="0,0,8,0"
				         AutomationProperties.AutomationId="imgconv.outdir"/>
				<Button x:Name="bbrowse" Grid.Column="2" Content="浏览…"
				        Style="{StaticResource ToolBtn}" Height="30" Padding="12,2"
				        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"
				        AutomationProperties.AutomationId="imgconv.browse"/>
			</Grid>
		</StackPanel>

		<!-- 列表工具条 -->
		<DockPanel Grid.Row="3" Margin="0,0,0,6" LastChildFill="False">
			<TextBlock x:Name="lbcount" DockPanel.Dock="Right"
			           VerticalAlignment="Center" FontSize="12"
			           Foreground="{StaticResource TextMuted}" Text="0 张"/>
			<StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
				<Button x:Name="badd" Content="添加" Style="{StaticResource ToolBtn}"
				        Height="30" Padding="12,2" Margin="0,0,6,0"
				        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"
				        AutomationProperties.AutomationId="imgconv.add"/>
				<Button x:Name="bremove" Content="删除" Style="{StaticResource ToolBtn}"
				        Height="30" Padding="12,2" Margin="0,0,6,0"
				        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"
				        AutomationProperties.AutomationId="imgconv.remove"/>
				<Button x:Name="bclear" Content="清空" Style="{StaticResource ToolBtn}"
				        Height="30" Padding="12,2" Margin="0,0,10,0"
				        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"
				        AutomationProperties.AutomationId="imgconv.clear"/>
				<ToggleButton x:Name="bviewlist" Style="{StaticResource ToolToggleSm}"
				              Width="32" Height="30" Padding="7,6" Margin="0,0,2,0"
				              BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"
				              AutomationProperties.AutomationId="imgconv.view.list"
				              AutomationProperties.Name="列表">
					<Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
					      StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
					      Stretch="Uniform" Width="14" Height="14"
					      Data="M1,3.5 H15 M1,8 H15 M1,12.5 H15"/>
				</ToggleButton>
				<ToggleButton x:Name="bviewthumb" Style="{StaticResource ToolToggleSm}"
				              Width="32" Height="30" Padding="7,6" IsChecked="True"
				              BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"
				              AutomationProperties.AutomationId="imgconv.view.thumb"
				              AutomationProperties.Name="图片">
					<Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
					      Stretch="Uniform" Width="14" Height="14"
					      Data="M1,1 h6 v6 h-6 z M9,1 h6 v6 h-6 z M1,9 h6 v6 h-6 z M9,9 h6 v6 h-6 z"/>
				</ToggleButton>
			</StackPanel>
		</DockPanel>

		<!-- 列表 + 预览 -->
		<Grid Grid.Row="4">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="420" MinWidth="280"/>
				<ColumnDefinition Width="8"/>
				<ColumnDefinition Width="*" MinWidth="360"/>
			</Grid.ColumnDefinitions>

			<Grid Grid.Column="0">
				<Grid.RowDefinitions>
					<RowDefinition Height="*"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>
				<Border Grid.Row="0" Background="{StaticResource BgPanel}"
				        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"
				        CornerRadius="8">
					<Grid>
						<ListView x:Name="lv" BorderThickness="0" Background="Transparent"
						          AllowDrop="True"
						          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
						          AutomationProperties.AutomationId="imgconv.list">
							<ListView.View>
								<GridView x:Name="gv">
									<GridViewColumn Width="44">
										<GridViewColumn.CellTemplate>
											<DataTemplate>
												<Viewbox Width="32" Height="32">
													<ContentPresenter Content="{Binding}"
													                  ContentTemplate="{StaticResource tplThumbImg}"/>
												</Viewbox>
											</DataTemplate>
										</GridViewColumn.CellTemplate>
									</GridViewColumn>
									<GridViewColumn x:Name="colname" Header="文件" Width="168"
									                DisplayMemberBinding="{Binding FileName}"/>
									<GridViewColumn x:Name="colxf" Header="变换" Width="72"
									                DisplayMemberBinding="{Binding XfText}"/>
									<GridViewColumn x:Name="colst" Header="状态" Width="100"
									                DisplayMemberBinding="{Binding Status}"/>
								</GridView>
							</ListView.View>
						</ListView>
						<TextBlock x:Name="lbdrop" Text="拖入图片或文件夹"
						           FontSize="15" FontWeight="SemiBold"
						           Foreground="{StaticResource TextMuted}"
						           HorizontalAlignment="Center" VerticalAlignment="Center"
						           IsHitTestVisible="False"
						           AutomationProperties.AutomationId="imgconv.drop"/>
					</Grid>
				</Border>
				<WrapPanel Grid.Row="1" Margin="0,10,0,0">
					<TextBlock x:Name="lbrot" Text="旋转"
					           FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
					<RadioButton x:Name="rrot0" GroupName="ImgConvRot" Content="不旋转"
					             VerticalAlignment="Center" Margin="0,0,12,0" IsChecked="True"
					             AutomationProperties.AutomationId="imgconv.rot0"/>
					<RadioButton x:Name="rrot90" GroupName="ImgConvRot" Content="90°"
					             VerticalAlignment="Center" Margin="0,0,12,0"
					             AutomationProperties.AutomationId="imgconv.rot90"/>
					<RadioButton x:Name="rrot180" GroupName="ImgConvRot" Content="180°"
					             VerticalAlignment="Center" Margin="0,0,12,0"
					             AutomationProperties.AutomationId="imgconv.rot180"/>
					<RadioButton x:Name="rrot270" GroupName="ImgConvRot" Content="270°"
					             VerticalAlignment="Center" Margin="0,0,16,0"
					             AutomationProperties.AutomationId="imgconv.rot270"/>
					<CheckBox x:Name="cmirror" Content="镜像" VerticalAlignment="Center"
					          AutomationProperties.AutomationId="imgconv.mirror"/>
				</WrapPanel>
			</Grid>

			<GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch"
			              Background="Transparent"/>

			<DockPanel Grid.Column="2">
				<TextBlock x:Name="lbprevinfo" DockPanel.Dock="Bottom"
				           FontSize="12" Foreground="{StaticResource TextMuted}"
				           Margin="0,8,0,0" TextWrapping="Wrap"
				           AutomationProperties.AutomationId="imgconv.preview.info"/>
				<Border Background="{StaticResource BgImage}" CornerRadius="8"
				        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1">
					<Grid>
						<Image x:Name="iprev" Stretch="Uniform" Margin="8"
						       RenderOptions.BitmapScalingMode="HighQuality"
						       AutomationProperties.AutomationId="imgconv.preview"/>
						<TextBlock x:Name="lbprevempty" Text="选中图片后预览转换效果"
						           FontSize="15" FontWeight="SemiBold"
						           Foreground="#A0AEC0"
						           HorizontalAlignment="Center" VerticalAlignment="Center"
						           TextWrapping="Wrap" TextAlignment="Center" Margin="16"
						           IsHitTestVisible="False"
						           AutomationProperties.AutomationId="imgconv.preview.empty"/>
					</Grid>
				</Border>
			</DockPanel>
		</Grid>

		<!-- 进度 -->
		<DockPanel Grid.Row="5" Margin="0,10,0,10">
			<TextBlock x:Name="lbpct" DockPanel.Dock="Right" MinWidth="40"
			           HorizontalAlignment="Right" VerticalAlignment="Center"
			           Foreground="{StaticResource TextMuted}" Text=""/>
			<ProgressBar x:Name="pbar" Height="10" Minimum="0" Maximum="100" Value="0"
			             AutomationProperties.AutomationId="imgconv.progress"/>
		</DockPanel>

		<DockPanel Grid.Row="6">
			<TextBlock x:Name="lbstatus" VerticalAlignment="Center"
			           FontSize="12" Foreground="{StaticResource TextMuted}"
			           TextWrapping="Wrap" Text=""
			           AutomationProperties.AutomationId="imgconv.status"/>
			<Button x:Name="bclose" DockPanel.Dock="Right" Content="关闭"
			        Style="{StaticResource ToolBtn}" Width="88" Height="32"
			        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"
			        IsCancel="True"
			        AutomationProperties.AutomationId="imgconv.close"/>
			<Button x:Name="bgo" DockPanel.Dock="Right" Content="全部转换"
			        Style="{StaticResource PrimaryBtn}" Width="108" Height="32"
			        Margin="0,0,8,0"
			        AutomationProperties.AutomationId="imgconv.go"/>
		</DockPanel>
	</Grid>
</Window>
