<Window x:Class="ScreenKit.RtspSrvWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RTSP 测试服务器" Height="600" Width="800"
        Background="#1E1E1E" WindowStartupLocation="CenterScreen">
	<Grid Margin="8">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="140"/>
		</Grid.RowDefinitions>
		<Border Grid.Row="0" Background="#252526" Padding="8" Margin="0,0,0,8" CornerRadius="4">
			<DockPanel>
				<StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
					<TextBlock x:Name="lbport" Text="端口" Foreground="#AAA" VerticalAlignment="Center" Margin="8,0,4,0"/>
					<TextBox x:Name="eport" Text="8554" Width="56" VerticalAlignment="Center"/>
					<TextBlock x:Name="lbw" Text="宽" Foreground="#AAA" VerticalAlignment="Center" Margin="8,0,4,0"/>
					<TextBox x:Name="ewidth" Text="640" Width="52" VerticalAlignment="Center"/>
					<TextBlock x:Name="lbh" Text="高" Foreground="#AAA" VerticalAlignment="Center" Margin="8,0,4,0"/>
					<TextBox x:Name="eheight" Text="480" Width="52" VerticalAlignment="Center"/>
					<TextBlock x:Name="lbfps" Text="帧率" Foreground="#AAA" VerticalAlignment="Center" Margin="8,0,4,0"/>
					<TextBox x:Name="efps" Text="30" Width="40" VerticalAlignment="Center"/>
					<TextBlock x:Name="lbbr" Text="码率" Foreground="#AAA" VerticalAlignment="Center" Margin="8,0,4,0"/>
					<TextBox x:Name="ebitrate" Text="1500" Width="56" VerticalAlignment="Center"/>
					<TextBlock Text="kbps" Foreground="#888" VerticalAlignment="Center" Margin="4,0,8,0"/>
					<Button x:Name="btoggle" Content="启动" Width="72" Height="26"/>
				</StackPanel>
				<StackPanel VerticalAlignment="Center">
					<TextBlock x:Name="lbstatus" Text="已停止" Foreground="#4EC9B0" FontWeight="SemiBold"/>
					<TextBlock x:Name="lbinfo" Text="" Foreground="#888" FontSize="11" Margin="0,2,0,0"/>
				</StackPanel>
			</DockPanel>
		</Border>
		<Border Grid.Row="1" Background="#111" CornerRadius="4" ClipToBounds="True">
			<Viewbox Stretch="Uniform">
				<Image x:Name="imgprev" Stretch="Fill"/>
			</Viewbox>
		</Border>
		<GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" Background="#333" Margin="0,4"/>
		<DockPanel Grid.Row="3" Margin="0,4,0,0">
			<DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
				<Button x:Name="bclear" DockPanel.Dock="Right" Content="清空" Width="56" Height="22"/>
				<TextBlock x:Name="lblog" Text="日志" Foreground="#AAA" VerticalAlignment="Center"/>
			</DockPanel>
			<TextBox x:Name="elog" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
			         Background="#1A1A1A" Foreground="#CCC" BorderBrush="#333" FontFamily="Consolas" FontSize="12"/>
		</DockPanel>
	</Grid>
</Window>
