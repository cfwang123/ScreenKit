<Window x:Class="ScreenKit.DocToMdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文档转 Markdown"
        Width="980" Height="720"
        MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BgApp}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        AllowDrop="True"
        AutomationProperties.AutomationId="doc2md.window">
	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>
		<DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
			<Button x:Name="bfile" Style="{StaticResource ToolBtn}" DockPanel.Dock="Left" Margin="0,0,8,0"
			        AutomationProperties.AutomationId="doc2md.file"/>
			<Button x:Name="bclose" Style="{StaticResource ToolBtn}" DockPanel.Dock="Right" Margin="8,0,0,0"
			        AutomationProperties.AutomationId="doc2md.close"/>
			<Button x:Name="bcopy" Style="{StaticResource ToolBtn}" DockPanel.Dock="Right" Margin="8,0,0,0"
			        AutomationProperties.AutomationId="doc2md.copy"/>
			<Button x:Name="bsave" Style="{StaticResource ToolBtn}" DockPanel.Dock="Right" Margin="8,0,0,0"
			        AutomationProperties.AutomationId="doc2md.save"/>
			<Button x:Name="bgo" Style="{StaticResource ToolBtn}" DockPanel.Dock="Right" Margin="8,0,0,0"
			        AutomationProperties.AutomationId="doc2md.convert"/>
			<TextBox x:Name="epath" Height="32" Padding="8,4" VerticalContentAlignment="Center"
			         AutomationProperties.AutomationId="doc2md.path"/>
		</DockPanel>
		<DockPanel Grid.Row="1" Margin="0,0,0,8" LastChildFill="True">
			<TextBlock x:Name="lbimg" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0"/>
			<ComboBox x:Name="eimgdir" DockPanel.Dock="Left" Width="240" Height="28" IsEditable="True"
			          VerticalContentAlignment="Center"
			          AutomationProperties.AutomationId="doc2md.imgdir">
				<ComboBoxItem Content="images"/>
				<ComboBoxItem Content="{}{name}"/>
				<ComboBoxItem Content="{}{name}_images"/>
			</ComboBox>
			<TextBlock x:Name="lbimgtip" VerticalAlignment="Center" Margin="10,0,0,0"
			           Foreground="{StaticResource TextMuted}" FontSize="12"
			           TextTrimming="CharacterEllipsis"/>
		</DockPanel>
		<TextBlock x:Name="lbstat" Grid.Row="2" Margin="0,0,0,8" TextWrapping="Wrap"
		           Foreground="{StaticResource TextMuted}"
		           AutomationProperties.AutomationId="doc2md.stat"/>
		<Border Grid.Row="3" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" Background="White">
			<TextBox x:Name="eout" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
			         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
			         FontFamily="Consolas, Microsoft YaHei UI" BorderThickness="0" Padding="10"
			         AutomationProperties.AutomationId="doc2md.out"/>
		</Border>
	</Grid>
</Window>
