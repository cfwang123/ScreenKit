<Window x:Class="ScreenKit.PinyinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="中文转拼音"
        Width="720" Height="560"
        MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BgApp}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        AutomationProperties.AutomationId="pinyin.window">
	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
		<TextBlock x:Name="lbhint" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}"
		           Margin="0,0,0,10"/>
		<DockPanel Grid.Row="1">
			<TextBlock x:Name="lbsrc" DockPanel.Dock="Top" Text="原文" FontWeight="SemiBold" Margin="0,0,0,6"/>
			<TextBox x:Name="esrc" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
			         Padding="8" BorderBrush="{StaticResource BorderSoft}"
			         AutomationProperties.AutomationId="pinyin.src"/>
		</DockPanel>
		<WrapPanel Grid.Row="2" Margin="0,10,0,10">
			<Button x:Name="bpy" Content="转拼音" Style="{StaticResource ToolBtn}" Margin="0,0,6,6"
			        AutomationProperties.AutomationId="pinyin.py"/>
			<Button x:Name="binit" Content="首字母" Style="{StaticResource ToolBtn}" Margin="0,0,6,6"
			        AutomationProperties.AutomationId="pinyin.init"/>
		</WrapPanel>
		<DockPanel Grid.Row="3">
			<TextBlock x:Name="lbout" DockPanel.Dock="Top" Text="结果" FontWeight="SemiBold" Margin="0,0,0,6"/>
			<TextBox x:Name="eout" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
			         IsReadOnly="True" Padding="8" BorderBrush="{StaticResource BorderSoft}"
			         AutomationProperties.AutomationId="pinyin.out"/>
		</DockPanel>
		<TextBlock x:Name="lbstat" Grid.Row="4" Margin="0,8,0,8" Foreground="{StaticResource TextMuted}"/>
		<StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
			<Button x:Name="bcopy" Content="复制输出" Style="{StaticResource ToolBtn}"
			        AutomationProperties.AutomationId="pinyin.copy"/>
			<Button x:Name="bclose" Content="关闭" Style="{StaticResource ToolBtn}"
			        AutomationProperties.AutomationId="pinyin.close"/>
		</StackPanel>
	</Grid>
</Window>
