<Window x:Class="ScreenKit.RecordOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="录屏选项"
        Width="520"
        MinWidth="460" MinHeight="320"
        MaxHeight="720"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource BgApp}"
        FontFamily="Segoe UI, Microsoft YaHei UI">
	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="*" MinHeight="180"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
		              HorizontalScrollBarVisibility="Disabled"
		              Padding="0,0,4,0">
			<StackPanel>
				<!-- 编码：label + combobox 半宽 -->
				<TextBlock Text="编码" FontWeight="SemiBold" Margin="0,0,0,6"/>
				<ComboBox x:Name="ecodec" Height="32" Margin="0,0,0,4"
				          VerticalContentAlignment="Center">
					<ComboBoxItem Content="x264 (H.264，兼容性好)" Tag="x264" IsSelected="True"/>
					<ComboBoxItem Content="x265 (H.265/HEVC，更小体积)" Tag="x265"/>
					<ComboBoxItem Content="AV1 (更小体积，需较新播放器)" Tag="av1"/>
					<ComboBoxItem Content="Media Foundation (系统 H.264，无需 FFmpeg)" Tag="mf"/>
				</ComboBox>
				<TextBlock x:Name="lbcode" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,14"
				           TextWrapping="Wrap"
				           Text=""/>

				<!-- 数值行：label: textbox  range/unit -->
				<Grid Margin="0,0,0,10">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" MinWidth="108"/>
						<ColumnDefinition Width="88"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>
					<TextBlock Grid.Column="0" Text="帧率 (FPS)" FontWeight="SemiBold"
					           VerticalAlignment="Center" Margin="0,0,8,0"/>
					<TextBox x:Name="efps" Grid.Column="1" Height="30" Padding="6,4" Text="24"
					         BorderBrush="{StaticResource BorderSoft}"
					         VerticalContentAlignment="Center" Margin="0,0,10,0"/>
					<TextBlock Grid.Column="2" Text="5 ~ 60" FontSize="12"
					           Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"
					           TextWrapping="Wrap"/>
				</Grid>

				<StackPanel x:Name="pcrf" Margin="0,0,0,10">
					<Grid Margin="0,0,0,4">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" MinWidth="108"/>
							<ColumnDefinition Width="88"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>
						<TextBlock Grid.Column="0" Text="CRF" FontWeight="SemiBold"
						           VerticalAlignment="Center" Margin="0,0,8,0"/>
						<TextBox x:Name="ecrf" Grid.Column="1" Height="30" Padding="6,4" Text="28"
						         BorderBrush="{StaticResource BorderSoft}"
						         VerticalContentAlignment="Center" Margin="0,0,10,0"/>
						<TextBlock Grid.Column="2" Text="x264/x265 · 0~51 · 越大文件越小"
						           FontSize="12" Foreground="{StaticResource TextMuted}"
						           VerticalAlignment="Center" TextWrapping="Wrap"/>
					</Grid>
					<TextBlock FontSize="11" Foreground="{StaticResource TextMuted}"
					           TextWrapping="Wrap"
					           Text="仅 x264/x265 使用。0 最清晰最大；18~28 常用。"/>
				</StackPanel>

				<StackPanel x:Name="pav1" Margin="0,0,0,14">
					<Grid Margin="0,0,0,4">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" MinWidth="108"/>
							<ColumnDefinition Width="88"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>
						<TextBlock Grid.Column="0" Text="AV1 CRF" FontWeight="SemiBold"
						           VerticalAlignment="Center" Margin="0,0,8,0"/>
						<TextBox x:Name="eav1crf" Grid.Column="1" Height="30" Padding="6,4" Text="56"
						         BorderBrush="{StaticResource BorderSoft}"
						         VerticalContentAlignment="Center" Margin="0,0,10,0"/>
						<TextBlock Grid.Column="2" Text="仅 AV1 · 0~63 · 越大文件越小"
						           FontSize="12" Foreground="{StaticResource TextMuted}"
						           VerticalAlignment="Center" TextWrapping="Wrap"/>
					</Grid>
					<TextBlock FontSize="11" Foreground="{StaticResource TextMuted}"
					           TextWrapping="Wrap"
					           Text="与 x264/x265 的 CRF 无关。默认 56 约等于 x265 CRF28 一半体积；45 约与 x265 同级；50~58 更小。"/>
				</StackPanel>

				<!-- 声音 -->
				<TextBlock Text="声音" FontWeight="SemiBold" Margin="0,0,0,6"/>
				<CheckBox x:Name="eauden" Content="录制声音" Margin="0,0,0,8" IsChecked="True"/>
				<Grid Margin="0,0,0,10">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>
					<ComboBox x:Name="eaudsrc" Grid.Column="0" Height="32"
					          VerticalContentAlignment="Center"
					          ToolTip="扬声器=系统正在播放的声音（环回）"
					          IsEnabled="{Binding ElementName=eauden, Path=IsChecked}">
						<ComboBoxItem Content="扬声器(听到的内容)" Tag="Speakers" IsSelected="True"/>
						<ComboBoxItem Content="麦克风" Tag="Mic"/>
						<ComboBoxItem Content="麦克风 + 扬声器" Tag="MicAndSpeakers"/>
					</ComboBox>
				</Grid>

				<Grid Margin="0,0,0,10"
				      IsEnabled="{Binding ElementName=eauden, Path=IsChecked}">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" MinWidth="108"/>
						<ColumnDefinition Width="88"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>
					<TextBlock Grid.Column="0" Text="码率 (kbps)" FontWeight="SemiBold"
					           VerticalAlignment="Center" Margin="0,0,8,0"/>
					<TextBox x:Name="eaudkbps" Grid.Column="1" Height="30" Padding="6,4" Text="96"
					         BorderBrush="{StaticResource BorderSoft}"
					         VerticalContentAlignment="Center" Margin="0,0,10,0"/>
					<TextBlock Grid.Column="2" Text="8 ~ 128 · 语音 32~64，音乐 96~128"
					           FontSize="12" Foreground="{StaticResource TextMuted}"
					           VerticalAlignment="Center" TextWrapping="Wrap"/>
				</Grid>

				<Grid Margin="0,0,0,10"
				      IsEnabled="{Binding ElementName=eauden, Path=IsChecked}">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" MinWidth="108"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>
					<TextBlock Grid.Column="0" Text="采样率 (Hz)" FontWeight="SemiBold"
					           VerticalAlignment="Center" Margin="0,0,8,0"/>
					<ComboBox x:Name="eaudhz" Grid.Column="1" Height="32"
					          VerticalContentAlignment="Center"
					          ToolTip="规范化输出采样率" Margin="0,0,10,0"/>
					<TextBlock Grid.Column="2" Text="默认 22050，越低越省体积"
					           FontSize="12" Foreground="{StaticResource TextMuted}"
					           VerticalAlignment="Center" TextWrapping="Wrap"/>
				</Grid>

				<CheckBox x:Name="eaudmono" Content="单声道"
				          Margin="0,0,0,4" IsChecked="False"
				          IsEnabled="{Binding ElementName=eauden, Path=IsChecked}"/>
				<TextBlock FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,14"
				           TextWrapping="Wrap"
				           Text="低码率（如 32kbps）建议开单声道，同等码率更清晰；音乐保留立体声。"/>

				<CheckBox x:Name="emaxen" Content="限制较短边（超过则等比缩小，不放大）"
				          Margin="0,0,0,8" IsChecked="False"/>
				<Grid Margin="0,0,0,6" IsEnabled="{Binding ElementName=emaxen, Path=IsChecked}">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" MinWidth="108"/>
						<ColumnDefinition Width="88"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>
					<TextBlock Grid.Column="0" Text="较短边" FontWeight="SemiBold"
					           VerticalAlignment="Center" Margin="0,0,8,0"/>
					<TextBox x:Name="eshort" Grid.Column="1" Height="30" Padding="6,4" Text="1080"
					         BorderBrush="{StaticResource BorderSoft}"
					         VerticalContentAlignment="Center" Margin="0,0,10,0"/>
					<TextBlock Grid.Column="2" Text="像素" FontSize="12"
					           Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
				</Grid>
				<TextBlock FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
				           Margin="0,0,0,14"
				           Text="宽和高里较小的一边超过这个值才等比缩小，不超过则不放大。"/>

				<!-- 鼠标 -->
				<TextBlock Text="鼠标" FontWeight="SemiBold" Margin="0,0,0,6"/>
				<CheckBox x:Name="emouse" Content="录制鼠标" Margin="0,0,0,4" IsChecked="True"
				          AutomationProperties.AutomationId="opt.record.mouse"
				          AutomationProperties.Name="录制鼠标"/>
				<CheckBox x:Name="eclickhl" Content="高亮鼠标点击" Margin="0,0,0,4" IsChecked="True"
				          AutomationProperties.AutomationId="opt.record.clickhl"
				          AutomationProperties.Name="高亮鼠标点击"/>
				<TextBlock FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
				           Margin="0,0,0,14"
				           Text="抓屏本身不含指针。勾选后叠加系统光标。点击高亮：左键黄圈、右键蓝圈、中键绿圈，约 0.45 秒散开。"/>

				<!-- HUD 选区 -->
				<TextBlock Text="选区" FontWeight="SemiBold" Margin="0,0,0,6"/>
				<CheckBox x:Name="elockasp" Content="录制中缩放选区时锁定宽高比"
				          Margin="0,0,0,4" IsChecked="True"/>
				<TextBlock FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
				           Margin="0,0,0,4"
				           Text="开始前可自由调整比例；点「开始」后按此选项决定是否锁定。"/>
			</StackPanel>
		</ScrollViewer>

		<StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
			<Button x:Name="bcancel" Content="取消" Style="{StaticResource ToolBtn}" Width="88" Margin="0,0,8,0"
			        IsCancel="True"/>
			<Button x:Name="bok" Content="确定" Style="{StaticResource PrimaryBtn}" Width="88" Margin="0"
			        IsDefault="True"/>
		</StackPanel>
	</Grid>
</Window>
