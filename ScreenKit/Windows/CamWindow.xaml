<Window x:Class="ScreenKit.CamWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="相机"
        Width="760" Height="680"
        MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BgApp}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        AutomationProperties.AutomationId="cam.window">
	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
		<TextBlock x:Name="lbhint" TextWrapping="Wrap" Margin="0,0,0,10"
		           Foreground="{StaticResource TextMuted}" FontSize="12"/>
		<DockPanel Grid.Row="1" Margin="0,0,0,12" LastChildFill="True">
			<TextBlock x:Name="lbdev" Text="摄像头" VerticalAlignment="Center" Margin="0,0,8,0"/>
			<Button x:Name="bdev" DockPanel.Dock="Right" Style="{StaticResource ToolBtn}" Margin="8,0,0,0"
			        AutomationProperties.AutomationId="cam.refresh"/>
			<ComboBox x:Name="edev" Height="32" VerticalContentAlignment="Center"
			          AutomationProperties.AutomationId="cam.dev"/>
		</DockPanel>
		<Border Grid.Row="2" Background="#111111" CornerRadius="8" ClipToBounds="True" Margin="0,0,0,12">
			<Image x:Name="eprev" Stretch="Uniform"
			       AutomationProperties.AutomationId="cam.preview"/>
		</Border>
		<DockPanel Grid.Row="3" Margin="0,0,0,8" LastChildFill="True">
			<CheckBox x:Name="ckmic" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0" IsChecked="True"
			          AutomationProperties.AutomationId="cam.mic"/>
			<WrapPanel>
				<Button x:Name="bshot" Style="{StaticResource ToolBtn}" Margin="0,0,6,6"
				        AutomationProperties.AutomationId="cam.shot"/>
				<Button x:Name="brec" Style="{StaticResource ToolBtn}" Margin="0,0,6,6"
				        AutomationProperties.AutomationId="cam.rec"/>
				<Button x:Name="bscan" Style="{StaticResource ToolBtn}" Margin="0,0,6,6"
				        AutomationProperties.AutomationId="cam.scan"/>
			</WrapPanel>
		</DockPanel>
		<TextBox x:Name="ecode" Grid.Row="4" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
		         MinHeight="72" MaxHeight="120" VerticalScrollBarVisibility="Auto"
		         AutomationProperties.AutomationId="cam.code"/>
		<TextBlock x:Name="lbstat" Grid.Row="5" Margin="0,8,0,0" TextWrapping="Wrap"
		           Foreground="{StaticResource TextMuted}" FontSize="12"
		           AutomationProperties.AutomationId="cam.stat"/>
	</Grid>
</Window>
