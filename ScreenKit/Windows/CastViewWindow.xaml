<Window x:Class="ScreenKit.CastViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="投屏" Width="960" Height="540"
        WindowStyle="None" ResizeMode="CanResize"
        Background="#000" Foreground="#EEE"
        WindowStartupLocation="CenterScreen"
        Focusable="True"
        KeyboardNavigation.TabNavigation="None"
        PreviewKeyDown="win_PreviewKeyDown"
        AutomationProperties.AutomationId="cast.view">
	<Window.Resources>
		<Style x:Key="barbtn" TargetType="Button">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="#EEE"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Width" Value="40"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{TemplateBinding Background}" Padding="0">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
			<Style.Triggers>
				<Trigger Property="IsMouseOver" Value="True">
					<Setter Property="Background" Value="#33FFFFFF"/>
				</Trigger>
			</Style.Triggers>
		</Style>
	</Window.Resources>
	<Window.ContextMenu>
		<ContextMenu x:Name="mn">
			<MenuItem x:Name="mnfull" Header="全屏" Click="mnfull_Click"/>
			<MenuItem x:Name="mnmax" Header="最大化/还原" Click="mnmax_Click"/>
			<MenuItem x:Name="mnmin" Header="最小化" Click="mnmin_Click"/>
			<Separator/>
			<MenuItem x:Name="mnset" Header="设置" Click="mnset_Click"/>
			<MenuItem x:Name="mndisc" Header="断开投出" Click="mndisc_Click"/>
			<Separator/>
			<MenuItem x:Name="mnclose" Header="关闭画面" Click="mnclose_Click"/>
		</ContextMenu>
	</Window.ContextMenu>
	<Grid x:Name="groot" Background="#000" ClipToBounds="True"
	      MouseMove="win_MouseMove"
	      MouseLeave="win_MouseLeave"
	      PreviewMouseLeftButtonDown="win_PreviewMouseLeftButtonDown"
	      MouseRightButtonUp="win_MouseRightButtonUp">
		<Viewbox Stretch="Uniform" StretchDirection="Both">
			<Grid x:Name="pimg" ClipToBounds="True">
				<Image x:Name="img" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top"
				       RenderOptions.BitmapScalingMode="HighQuality"/>
			</Grid>
		</Viewbox>
		<TextBlock x:Name="lbst" VerticalAlignment="Bottom" HorizontalAlignment="Left"
		           Margin="10,0,10,10" Padding="8,6" FontFamily="Consolas" FontSize="13"
		           Foreground="#F0FFFFFF" Background="#99000000" TextWrapping="Wrap"
		           Visibility="Collapsed" IsHitTestVisible="False"/>
		<Border x:Name="pbar" Height="36" VerticalAlignment="Top" Background="#E01E1E1E"
		        Visibility="Collapsed" MouseEnter="pbar_MouseEnter" MouseLeave="pbar_MouseLeave">
			<DockPanel>
				<Button x:Name="bclose" DockPanel.Dock="Right" Content="✕" Style="{StaticResource barbtn}" Click="bclose_Click"
				        ToolTip="关闭画面"/>
				<Button x:Name="bmax" DockPanel.Dock="Right" Content="☐" Style="{StaticResource barbtn}" Click="bmax_Click"
				        ToolTip="最大化"/>
				<Button x:Name="bmin" DockPanel.Dock="Right" Content="─" Style="{StaticResource barbtn}" Click="bmin_Click"
				        ToolTip="最小化"/>
				<TextBlock x:Name="lbname" Text="投屏" VerticalAlignment="Center" Margin="12,0,8,0"
				           FontSize="13" TextTrimming="CharacterEllipsis"/>
			</DockPanel>
		</Border>
	</Grid>
</Window>
