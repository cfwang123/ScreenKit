<Window x:Class="ScreenKit.WebFileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="网页文件管理"
        Width="440"
        MinWidth="400" MinHeight="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BgApp}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        AutomationProperties.AutomationId="sfweb.window">
	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<TextBlock x:Name="lbtitle" Grid.Row="0" FontSize="16" FontWeight="SemiBold"
		           Foreground="{StaticResource TextPrimary}"
		           Text="网页文件管理" Margin="0,0,0,8"
		           AutomationProperties.AutomationId="sfweb.title"/>

		<TextBlock x:Name="lbstatus" Grid.Row="1" FontSize="13"
		           Foreground="{StaticResource TextMuted}"
		           TextWrapping="Wrap" Text="" Margin="0,0,0,12"
		           AutomationProperties.AutomationId="sfweb.status"/>

		<Border Grid.Row="2" Width="248" Height="248" HorizontalAlignment="Center"
		        Background="White" CornerRadius="8"
		        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"
		        Margin="0,0,0,12">
			<Image x:Name="iqr" Stretch="Uniform" Margin="8"
			       RenderOptions.BitmapScalingMode="NearestNeighbor"
			       AutomationProperties.AutomationId="sfweb.qr"/>
		</Border>

		<DockPanel Grid.Row="3">
			<TextBlock x:Name="lburl" DockPanel.Dock="Top" FontSize="12"
			           Foreground="{StaticResource TextMuted}"
			           Text="网页地址" Margin="0,0,0,4"/>
			<ComboBox x:Name="eurl" Height="32" FontSize="12"
			          BorderBrush="{StaticResource BorderSoft}"
			          VerticalContentAlignment="Center"
			          AutomationProperties.AutomationId="sfweb.url"/>
		</DockPanel>

		<DockPanel Grid.Row="4" Margin="0,10,0,0">
			<TextBlock x:Name="lbpass" DockPanel.Dock="Top" FontSize="12"
			           Foreground="{StaticResource TextMuted}"
			           Text="登录密码" Margin="0,0,0,4"/>
			<TextBox x:Name="epass" Height="32" FontSize="13" IsReadOnly="True"
			         VerticalContentAlignment="Center" Padding="8,0"
			         BorderBrush="{StaticResource BorderSoft}"
			         AutomationProperties.AutomationId="sfweb.pass"/>
		</DockPanel>

		<TextBlock x:Name="lbhint" Grid.Row="5" FontSize="12" Margin="0,8,0,12"
		           Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
		           Text=""/>

		<DockPanel Grid.Row="6" LastChildFill="False">
			<Button x:Name="bclose" DockPanel.Dock="Right" Content="关闭"
			        Style="{StaticResource PrimaryBtn}" Width="88" Height="32"
			        IsCancel="True" IsDefault="True"
			        AutomationProperties.AutomationId="sfweb.close"/>
			<Button x:Name="bopen" DockPanel.Dock="Left" Content="打开网页"
			        Style="{StaticResource ToolBtn}" Height="32" Padding="12,2"
			        Margin="0,0,8,0" IsEnabled="False"
			        AutomationProperties.AutomationId="sfweb.open"/>
			<Button x:Name="bcopy" DockPanel.Dock="Left" Content="复制链接"
			        Style="{StaticResource ToolBtn}" Height="32" Padding="12,2"
			        Margin="0,0,8,0" IsEnabled="False"
			        AutomationProperties.AutomationId="sfweb.copy"/>
			<Button x:Name="bcopypass" DockPanel.Dock="Left" Content="复制密码"
			        Style="{StaticResource ToolBtn}" Height="32" Padding="12,2"
			        IsEnabled="False"
			        AutomationProperties.AutomationId="sfweb.copypass"/>
		</DockPanel>
	</Grid>
</Window>
