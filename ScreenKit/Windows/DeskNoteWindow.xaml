<Window x:Class="ScreenKit.DeskNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:System.Windows.Controls.Primitives"
        Title="桌面便笺"
        Width="340" Height="420"
        MinWidth="240" MinHeight="180"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        UseLayoutRounding="True"
        AutomationProperties.AutomationId="note.window">
	<Border x:Name="paper" Background="#E6F6E7A0" CornerRadius="12" BorderBrush="#66A16207" BorderThickness="1" Padding="8,6,8,8">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>
			<Grid x:Name="bar" Margin="2,0,0,6" Background="Transparent">
				<TextBlock x:Name="lbtitle" Text="桌面便笺" Foreground="#44403C" FontSize="13"
				           VerticalAlignment="Center"/>
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
					<Button x:Name="btodo" Content="待办" Width="46" Height="22" Margin="0,0,4,0" Padding="0"
					        FontSize="12" Background="#33A16207" Foreground="#292524" BorderThickness="0"
					        Cursor="Hand" AutomationProperties.AutomationId="note.todo"/>
					<Button x:Name="bclose" Content="×" Width="22" Height="22" Padding="0" FontSize="14"
					        Background="Transparent" Foreground="#44403C" BorderThickness="0"
					        Cursor="Hand" AutomationProperties.AutomationId="note.close"/>
				</StackPanel>
			</Grid>
			<TextBox x:Name="etext" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap"
			         BorderThickness="0" Background="Transparent" Foreground="#292524"
			         CaretBrush="#292524" FontSize="15" Padding="2,0"
			         VerticalScrollBarVisibility="Auto"
			         AutomationProperties.AutomationId="note.text"/>
			<ScrollViewer x:Name="ptodo" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
				<StackPanel x:Name="rows"/>
			</ScrollViewer>
			<Grid Grid.Row="2" Margin="0,4,0,0">
				<Button x:Name="badd" Content="添加" HorizontalAlignment="Left" Width="52" Height="22" Padding="0"
				        FontSize="12" Background="#33A16207" Foreground="#292524" BorderThickness="0"
				        Cursor="Hand" Visibility="Collapsed" AutomationProperties.AutomationId="note.add"/>
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
					<Button x:Name="bcolor" Width="16" Height="16" Margin="0,0,8,0" Padding="0"
					        BorderThickness="1" BorderBrush="#66292524" Cursor="Hand"
					        AutomationProperties.AutomationId="note.color">
						<Button.Template>
							<ControlTemplate TargetType="Button">
								<Border Background="{TemplateBinding Background}"
								        BorderBrush="{TemplateBinding BorderBrush}"
								        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2"/>
							</ControlTemplate>
						</Button.Template>
					</Button>
					<p:Thumb x:Name="bsz" Width="16" Height="16" Cursor="SizeNWSE" VerticalAlignment="Bottom">
						<p:Thumb.Template>
							<ControlTemplate TargetType="p:Thumb">
								<TextBlock x:Name="grip" Text="◢" FontSize="11" Foreground="#8844403C"
								           HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
							</ControlTemplate>
						</p:Thumb.Template>
					</p:Thumb>
				</StackPanel>
			</Grid>
		</Grid>
	</Border>
</Window>
