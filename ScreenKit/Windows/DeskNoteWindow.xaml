<Window x:Class="ScreenKit.DeskNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:System.Windows.Controls.Primitives"
        Title="桌面便笺"
        Width="340" Height="420"
        MinWidth="240" MinHeight="180"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        UseLayoutRounding="True"
        AutomationProperties.AutomationId="note.window">
	<Window.Resources>
		<Style x:Key="pinStyle" TargetType="ToggleButton">
			<Setter Property="Width" Value="22"/>
			<Setter Property="Height" Value="22"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ToggleButton">
						<Grid>
							<Border x:Name="pinbg" Background="{TemplateBinding Foreground}"
							        Opacity="0" CornerRadius="4"/>
							<Path x:Name="pinicon" Width="12" Height="12" Stretch="Uniform"
							      Fill="{TemplateBinding Foreground}" Opacity="0.55"
							      Data="M12,2 C10.9,2 10,2.9 10,4 C10,4.3 10.1,4.6 10.2,4.8 L7.4,7.6 L5.5,7.6 L4.5,8.6 L7.4,11.5 L3,16 L4,17 L8.5,12.6 L11.4,15.5 L12.4,14.5 L12.4,12.6 L15.2,9.8 C15.4,9.9 15.7,10 16,10 C17.1,10 18,9.1 18,8 L12,2 Z"/>
						</Grid>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="pinbg" Property="Opacity" Value="0.15"/>
								<Setter TargetName="pinicon" Property="Opacity" Value="0.9"/>
							</Trigger>
							<Trigger Property="IsChecked" Value="True">
								<Setter TargetName="pinbg" Property="Opacity" Value="0.35"/>
								<Setter TargetName="pinicon" Property="Opacity" Value="1"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>
	<Border x:Name="paper" Background="#E6F6E7A0" CornerRadius="12" BorderBrush="#66A16207" BorderThickness="1" Padding="8,6,8,8">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>
			<Grid x:Name="bar" Margin="2,0,0,6" Background="Transparent">
				<TextBlock x:Name="lbtitle" Text="桌面便笺" Foreground="#44403C" FontSize="13"
				           VerticalAlignment="Center"/>
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
					<ToggleButton x:Name="bpin" Style="{StaticResource pinStyle}" Margin="0,0,4,0"
					              AutomationProperties.AutomationId="note.pin"/>
					<Button x:Name="btodo" Content="待办" Width="46" Height="22" Margin="0,0,4,0" Padding="0"
					        FontSize="12" Background="#33A16207" Foreground="#292524" BorderThickness="0"
					        Cursor="Hand" AutomationProperties.AutomationId="note.todo"/>
					<Button x:Name="bclose" Content="×" Width="22" Height="22" Padding="0" FontSize="14"
					        Background="Transparent" Foreground="#44403C" BorderThickness="0"
					        Cursor="Hand" AutomationProperties.AutomationId="note.close"/>
				</StackPanel>
			</Grid>
			<TextBox x:Name="etext" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap"
			         BorderThickness="0" Background="Transparent" Foreground="#292524"
			         CaretBrush="#292524" FontSize="15" Padding="2,0"
			         VerticalScrollBarVisibility="Auto"
			         AutomationProperties.AutomationId="note.text"/>
			<ScrollViewer x:Name="ptodo" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
				<StackPanel x:Name="rows"/>
			</ScrollViewer>
			<Grid Grid.Row="2" Margin="0,4,0,0">
				<Button x:Name="badd" Content="添加" HorizontalAlignment="Left" Width="52" Height="22" Padding="0"
				        FontSize="12" Background="#33A16207" Foreground="#292524" BorderThickness="0"
				        Cursor="Hand" Visibility="Collapsed" AutomationProperties.AutomationId="note.add"/>
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
					<Button x:Name="bcolor" Width="16" Height="16" Margin="0,0,8,0" Padding="0"
					        BorderThickness="1" BorderBrush="#66292524" Cursor="Hand"
					        AutomationProperties.AutomationId="note.color">
						<Button.Template>
							<ControlTemplate TargetType="Button">
								<Border Background="{TemplateBinding Background}"
								        BorderBrush="{TemplateBinding BorderBrush}"
								        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2"/>
							</ControlTemplate>
						</Button.Template>
					</Button>
					<p:Thumb x:Name="bsz" Width="16" Height="16" Cursor="SizeNWSE" VerticalAlignment="Bottom">
						<p:Thumb.Template>
							<ControlTemplate TargetType="p:Thumb">
								<TextBlock x:Name="grip" Text="◢" FontSize="11" Foreground="#8844403C"
								           HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
							</ControlTemplate>
						</p:Thumb.Template>
					</p:Thumb>
				</StackPanel>
			</Grid>
		</Grid>
	</Border>
</Window>
